@@ -0,0 +1,211 @@
+//! Mob spawn data of pack biomes: the spawners of each category and the chance of a creature
+//! group at chunk generation.
+
+use pumpkin_data::biome::SpawnCosts;
+use pumpkin_data::chunk::{SpawnGroups, Spawner};
+use serde_json::Value;
+
+const NATURAL_MOB_SPAWNS: &str = "minecraft:gameplay/natural_mob_spawns";
+const CREATURE_WORLD_GEN_SPAWN_PROBABILITY: &str =
+    "minecraft:gameplay/creature_world_gen_spawn_probability";
+/// Default of the creature world generation spawn probability attribute.
+const DEFAULT_CREATURE_SPAWN_PROBABILITY: f32 = 0.1;
+
+/// The spawn data a pack biome defines.
+pub struct BiomeSpawnData {
+    pub creature_spawn_probability: f32,
+    pub spawners: SpawnGroups,
+    /// The `spawn_costs` by entity type (without `minecraft:`).
+    pub spawn_costs: &'static [(&'static str, SpawnCosts)],
+}
+
+fn leak<T>(value: T) -> &'static T {
+    Box::leak(Box::new(value))
+}
+
+/// `count` is a number or an int provider; the group size is sampled between its bounds.
+fn count_bounds(count: Option<&Value>) -> (i32, i32) {
+    let int = |v: &Value| v.as_i64().and_then(|n| i32::try_from(n).ok());
+    match count {
+        Some(Value::Object(provider)) => {
+            let min = provider
+                .get("min_inclusive")
+                .or_else(|| provider.get("min"))
+                .and_then(int)
+                .unwrap_or(1);
+            let max = provider
+                .get("max_inclusive")
+                .or_else(|| provider.get("max"))
+                .and_then(int)
+                .unwrap_or(min);
+            (min, max)
+        }
+        Some(value) => int(value).map_or((1, 1), |n| (n, n)),
+        None => (1, 1),
+    }
+}
+
+fn spawners(category: Option<&Value>) -> &'static [Spawner] {
+    let list: Vec<Spawner> = category
+        .and_then(Value::as_array)
+        .into_iter()
+        .flatten()
+        .filter_map(|entry| {
+            let name = entry.get("type")?.as_str()?;
+            let (min_count, max_count) = entry.get("count").map_or_else(
+                || {
+                    let int = |key| entry.get(key).and_then(Value::as_i64);
+                    let min = int("minCount").or_else(|| int("min_count")).unwrap_or(1);
+                    let max = int("maxCount").or_else(|| int("max_count")).unwrap_or(min);
+                    (
+                        i32::try_from(min).unwrap_or(1),
+                        i32::try_from(max).unwrap_or(1),
+                    )
+                },
+                |count| count_bounds(Some(count)),
+            );
+            let weight = entry
+                .get("weight")
+                .and_then(Value::as_i64)
+                .and_then(|w| i32::try_from(w).ok())
+                .unwrap_or(1);
+            Some(Spawner {
+                r#type: Box::leak(name.to_string().into_boxed_str()),
+                min_count,
+                max_count,
+                weight,
+            })
+        })
+        .collect();
+    Box::leak(list.into_boxed_slice())
+}
+
+/// The attribute `key` of a biome; the `minecraft:` namespace may be left off, as in vanilla.
+fn attribute<'a>(biome: &'a Value, key: &str) -> Option<&'a Value> {
+    let attributes = biome.get("attributes")?;
+    attributes
+        .get(key)
+        .or_else(|| attributes.get(key.strip_prefix("minecraft:")?))
+}
+
+fn spawn_costs(argument: Option<&Value>) -> &'static [(&'static str, SpawnCosts)] {
+    let costs: Vec<(&'static str, SpawnCosts)> = argument
+        .and_then(|a| a.get("spawn_costs"))
+        .and_then(Value::as_object)
+        .into_iter()
+        .flatten()
+        .filter_map(|(entity, cost)| {
+            let number = |key: &str| cost.get(key).and_then(Value::as_f64);
+            let name = entity.strip_prefix("minecraft:").unwrap_or(entity);
+            Some((
+                &*Box::leak(name.to_string().into_boxed_str()),
+                SpawnCosts {
+                    energy_budget: number("energy_budget")?,
+                    charge: number("charge")?,
+                },
+            ))
+        })
+        .collect();
+    Box::leak(costs.into_boxed_slice())
+}
+
+/// Reads the spawners and spawn costs of a biome JSON, from the 26.x `natural_mob_spawns` attribute
+/// or the older `spawners` object. A biome that lists none has no spawns, as in vanilla.
+#[must_use]
+pub fn biome_spawn_data(biome: &Value) -> &'static BiomeSpawnData {
+    let argument = attribute(biome, NATURAL_MOB_SPAWNS)
+        .map(|attribute| attribute.get("argument").unwrap_or(attribute));
+    let by_category = argument
+        .map(|argument| argument.get("spawns_by_category").unwrap_or(argument))
+        .or_else(|| biome.get("spawners"));
+    let category = |key: &str| spawners(by_category.and_then(|groups| groups.get(key)));
+    let probability = attribute(biome, CREATURE_WORLD_GEN_SPAWN_PROBABILITY)
+        .or_else(|| biome.get("creature_spawn_probability"))
+        .and_then(Value::as_f64)
+        .map_or(DEFAULT_CREATURE_SPAWN_PROBABILITY, |p| p as f32);
+    leak(BiomeSpawnData {
+        creature_spawn_probability: probability,
+        spawn_costs: spawn_costs(argument.or_else(|| biome.get("spawn_costs").map(|_| biome))),
+        spawners: SpawnGroups {
+            monster: category("monster"),
+            ambient: category("ambient"),
+            axolotls: category("axolotls"),
+            creature: category("creature"),
+            misc: category("misc"),
+            underground_water_creature: category("underground_water_creature"),
+            water_ambient: category("water_ambient"),
+            water_creature: category("water_creature"),
+        },
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn reads_attribute_and_legacy_spawners() {
+        let modern = json!({"attributes": {
+            "minecraft:gameplay/creature_world_gen_spawn_probability": 0.03,
+            "minecraft:gameplay/natural_mob_spawns": {"argument": {"spawns_by_category": {
+                "creature": [
+                    {"type": "minecraft:sheep", "count": 4, "weight": 12},
+                    {"type": "minecraft:horse", "weight": 5,
+                     "count": {"type": "minecraft:uniform", "min_inclusive": 2, "max_inclusive": 6}}
+                ],
+                "monster": [{"type": "minecraft:zombie", "count": 1, "weight": 90}]
+            }}, "modifier": "overlay"}
+        }});
+        let data = biome_spawn_data(&modern);
+        assert!((data.creature_spawn_probability - 0.03).abs() < 1e-6);
+        let creature = data.spawners.creature;
+        assert_eq!(creature.len(), 2);
+        assert_eq!(
+            (
+                creature[0].min_count,
+                creature[0].max_count,
+                creature[0].weight
+            ),
+            (4, 4, 12)
+        );
+        assert_eq!(
+            (
+                creature[1].min_count,
+                creature[1].max_count,
+                creature[1].weight
+            ),
+            (2, 6, 5)
+        );
+        assert_eq!(data.spawners.monster.len(), 1);
+        assert!(data.spawners.ambient.is_empty());
+
+        let legacy = json!({"creature_spawn_probability": 0.2, "spawners": {
+            "creature": [{"type": "minecraft:wolf", "weight": 8, "minCount": 4, "maxCount": 4}]
+        }});
+        let data = biome_spawn_data(&legacy);
+        assert!((data.creature_spawn_probability - 0.2).abs() < 1e-6);
+        assert_eq!(data.spawners.creature[0].weight, 8);
+        assert_eq!(data.spawners.creature[0].min_count, 4);
+
+        let none = biome_spawn_data(&json!({}));
+        assert!(none.spawners.creature.is_empty());
+        assert!((none.creature_spawn_probability - 0.1).abs() < 1e-6);
+    }
+
+    #[test]
+    fn reads_attributes_without_namespace_and_spawn_costs() {
+        let biome = json!({"attributes": {"gameplay/natural_mob_spawns": {
+            "spawns_by_category": {
+                "monster": [{"type": "minecraft:ghast", "weight": 40,
+                    "count": {"type": "uniform", "min_inclusive": 1, "max_inclusive": 1}}]
+            },
+            "spawn_costs": {"minecraft:ghast": {"energy_budget": 0.12, "charge": 1.0}}
+        }}});
+        let data = biome_spawn_data(&biome);
+        assert_eq!(data.spawners.monster[0].r#type, "minecraft:ghast");
+        let (entity, cost) = &data.spawn_costs[0];
+        assert_eq!(*entity, "ghast");
+        assert!((cost.energy_budget - 0.12).abs() < 1e-9 && (cost.charge - 1.0).abs() < 1e-9);
+    }
+}
