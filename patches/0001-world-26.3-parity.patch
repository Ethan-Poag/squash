+
+impl Loader<'_> {
+    pub(super) fn tree_feature(&mut self, config: &Value) -> Option<TreeFeature> {
+        let get = |key: &str| config.get(key);
+        let root_placer = match get("root_placer").filter(|root| !root.is_null()) {
+            Some(root) => Some(self.root_placer(root)?),
+            None => None,
+        };
+        Some(TreeFeature {
+            trunk_provider: self.state_provider(get("trunk_provider"))?,
+            trunk_placer: self.trunk_placer(get("trunk_placer")?)?,
+            foliage_provider: self.state_provider(get("foliage_provider"))?,
+            foliage_placer: self.foliage_placer(get("foliage_placer")?)?,
+            minimum_size: Self::feature_size(get("minimum_size").unwrap_or(&Value::Null)),
+            ignore_vines: get("ignore_vines").and_then(Value::as_bool).unwrap_or(true),
+            decorators: get("decorators")
+                .and_then(Value::as_array)
+                .map_or(&[][..], Vec::as_slice)
+                .iter()
+                .filter(|decorator| {
+                    // The generated tables leave this decorator out too.
+                    decorator.get("type").and_then(Value::as_str)
+                        != Some("minecraft:shelf_mushroom")
+                })
+                .map(|decorator| self.tree_decorator(decorator))
+                .collect::<Option<Vec<_>>>()?,
+            below_trunk_provider: self.state_provider(get("below_trunk_provider"))?,
+            root_placer,
+        })
+    }
+
+    pub(super) fn fallen_tree_feature(&mut self, config: &Value) -> Option<FallenTreeFeature> {
+        let get = |key: &str| config.get(key);
+        let mut decorators = |key: &str| {
+            get(key)
+                .and_then(Value::as_array)
+                .map_or(&[][..], Vec::as_slice)
+                .iter()
+                .map(|decorator| self.tree_decorator(decorator))
+                .collect::<Option<Vec<_>>>()
+        };
+        let stump_decorators = decorators("stump_decorators")?;
+        let log_decorators = decorators("log_decorators")?;
+        Some(FallenTreeFeature {
+            trunk_provider: self.state_provider(get("trunk_provider"))?,
+            log_length: self.int_provider(get("log_length"))?,
+            stump_decorators,
+            log_decorators,
+        })
+    }
+
+    fn root_placer(&mut self, v: &Value) -> Option<RootPlacer> {
+        let ty = v.get("type").and_then(Value::as_str).unwrap_or_default();
+        if ty.strip_prefix("minecraft:").unwrap_or(ty) != "mangrove_root_placer" {
+            return self.unsupported("tree root placer", ty);
+        }
+        let placement = v.get("mangrove_root_placement").unwrap_or(&Value::Null);
+        let above_root_placement = match v.get("above_root_placement").filter(|a| !a.is_null()) {
+            Some(above) => Some(AboveRootPlacement {
+                above_root_provider: self.state_provider(above.get("above_root_provider"))?,
+                above_root_placement_chance: float32(above.get("above_root_placement_chance"), 0.0),
+            }),
+            None => None,
+        };
+        Some(RootPlacer::Mangrove(MangroveRootPlacer {
+            trunk_offset_y: self.int_provider(v.get("trunk_offset_y"))?,
+            root_provider: self.state_provider(v.get("root_provider"))?,
+            above_root_placement,
+            mangrove_root_placement: MangroveRootPlacement {
+                can_grow_through: self.block_id_list(placement.get("can_grow_through"))?,
+                muddy_roots_in: self.block_id_list(placement.get("muddy_roots_in"))?,
+                muddy_roots_provider: self.state_provider(placement.get("muddy_roots_provider"))?,
+                max_root_width: int(placement.get("max_root_width"), 3),
+                max_root_length: int(placement.get("max_root_length"), 8),
+                random_skew_chance: float32(placement.get("random_skew_chance"), 0.0),
+            },
+        }))
+    }
+
+    /// Block ids of a list of blocks or of a `#tag`, as the trunk placers hold them.
+    fn block_id_list(&mut self, v: Option<&Value>) -> Option<&'static [u16]> {
+        match v {
+            Some(Value::String(tag)) if tag.starts_with('#') => Some(self.block_tag(tag)?.1),
+            Some(Value::Array(list)) => {
+                let ids = list
+                    .iter()
+                    .filter_map(Value::as_str)
+                    .map(|name| Some(self.block(name)?.id.as_u16()))
+                    .collect::<Option<Vec<_>>>()?;
+                Some(Vec::leak(ids))
+            }
+            _ => Some(&[]),
+        }
+    }
+
+    fn trunk_placer(&mut self, v: &Value) -> Option<TrunkPlacer> {
+        let ty = v.get("type").and_then(Value::as_str).unwrap_or_default();
+        let trunk_type = match ty.strip_prefix("minecraft:").unwrap_or(ty) {
+            "straight_trunk_placer" => TrunkType::Straight(StraightTrunkPlacer),
+            "forking_trunk_placer" => TrunkType::Forking(ForkingTrunkPlacer),
+            "giant_trunk_placer" => TrunkType::Giant(GiantTrunkPlacer),
+            "mega_jungle_trunk_placer" => TrunkType::MegaJungle(MegaJungleTrunkPlacer),
+            "dark_oak_trunk_placer" => TrunkType::DarkOak(DarkOakTrunkPlacer),
+            "fancy_trunk_placer" => TrunkType::Fancy(FancyTrunkPlacer),
+            "bending_trunk_placer" => TrunkType::Bending(BendingTrunkPlacer {
+                min_height_for_leaves: u32::try_from(uint(v.get("min_height_for_leaves"), 1))
+                    .unwrap_or(1),
+                bend_length: self.int_provider(v.get("bend_length"))?,
+            }),
+            "upwards_branching_trunk_placer" => {
+                TrunkType::UpwardsBranching(UpwardsBranchingTrunkPlacer {
+                    extra_branch_steps: self.int_provider(v.get("extra_branch_steps"))?,
+                    place_branch_per_log_probability: float32(
+                        v.get("place_branch_per_log_probability"),
+                        0.0,
+                    ),
+                    extra_branch_length: self.int_provider(v.get("extra_branch_length"))?,
+                    can_grow_through: self.block_id_list(v.get("can_grow_through"))?,
+                })
+            }
+            "cherry_trunk_placer" => {
+                let start = v.get("branch_start_offset_from_top");
+                TrunkType::Cherry(CherryTrunkPlacer {
+                    count: self.int_provider(v.get("branch_count"))?,
+                    horizontal_length: self.int_provider(v.get("branch_horizontal_length"))?,
+                    start_offset_from_top: UniformIntProvider {
+                        min_inclusive: int(start.and_then(|s| s.get("min_inclusive")), 0),
+                        max_inclusive: int(start.and_then(|s| s.get("max_inclusive")), 0),
+                    },
+                    end_offset_from_top: self.int_provider(v.get("branch_end_offset_from_top"))?,
+                })
+            }
+            "poplar_trunk_placer" => TrunkType::Poplar(PoplarTrunkPlacer {
+                trunk_height_above_branches: self
+                    .int_provider(v.get("trunk_height_above_branches"))?,
+                branch_amount: self.int_provider(v.get("branch_amount"))?,
+            }),
+            _ => return self.unsupported("trunk placer", ty),
+        };
+        Some(TrunkPlacer {
+            base_height: byte(v.get("base_height"), 5),
+            height_rand_a: byte(v.get("height_rand_a"), 0),
+            height_rand_b: byte(v.get("height_rand_b"), 0),
+            r#type: trunk_type,
+        })
+    }
+
+    fn foliage_placer(&mut self, v: &Value) -> Option<FoliagePlacer> {
+        let ty = v.get("type").and_then(Value::as_str).unwrap_or_default();
+        let height = |default| int(v.get("height"), default);
+        let foliage_type = match ty.strip_prefix("minecraft:").unwrap_or(ty) {
+            "blob_foliage_placer" => FoliageType::Blob(BlobFoliagePlacer { height: height(3) }),
+            "spruce_foliage_placer" => FoliageType::Spruce(SpruceFoliagePlacer {
+                trunk_height: self.int_provider(v.get("trunk_height"))?,
+            }),
+            "pine_foliage_placer" => FoliageType::Pine(PineFoliagePlacer {
+                height: self.int_provider(v.get("height"))?,
+            }),
+            "acacia_foliage_placer" => FoliageType::Acacia(AcaciaFoliagePlacer),
+            "bush_foliage_placer" => FoliageType::Bush(BushFoliagePlacer { height: height(2) }),
+            "fancy_foliage_placer" => {
+                FoliageType::Fancy(LargeOakFoliagePlacer { height: height(4) })
+            }
+            "jungle_foliage_placer" => {
+                FoliageType::Jungle(JungleFoliagePlacer { height: height(2) })
+            }
+            "mega_pine_foliage_placer" => FoliageType::MegaPine(MegaPineFoliagePlacer {
+                crown_height: self.int_provider(v.get("crown_height"))?,
+            }),
+            "dark_oak_foliage_placer" => FoliageType::DarkOak(DarkOakFoliagePlacer),
+            "random_spread_foliage_placer" => {
+                FoliageType::RandomSpread(RandomSpreadFoliagePlacer {
+                    foliage_height: self.int_provider(v.get("foliage_height"))?,
+                    leaf_placement_attempts: int(v.get("leaf_placement_attempts"), 128),
+                })
+            }
+            "cherry_foliage_placer" => FoliageType::Cherry(CherryFoliagePlacer {
+                height: self.int_provider(v.get("height"))?,
+                wide_bottom_layer_hole_chance: float32(v.get("wide_bottom_layer_hole_chance"), 0.0),
+                corner_hole_chance: float32(v.get("corner_hole_chance"), 0.0),
+                hanging_leaves_chance: float32(v.get("hanging_leaves_chance"), 0.0),
+                hanging_leaves_extension_chance: float32(
+                    v.get("hanging_leaves_extension_chance"),
+                    0.0,
+                ),
+            }),
+            "poplar_foliage_placer" => FoliageType::Poplar(PoplarFoliagePlacer {
+                height: self.int_provider(v.get("height"))?,
+                side_hole_chance: float32(v.get("side_hole_chance"), 0.0),
+            }),
+            _ => return self.unsupported("foliage placer", ty),
+        };
+        Some(FoliagePlacer {
+            radius: self.int_provider(v.get("radius"))?,
+            offset: self.int_provider(v.get("offset"))?,
+            r#type: foliage_type,
+        })
+    }
+
+    fn feature_size(v: &Value) -> FeatureSize {
+        let ty = v.get("type").and_then(Value::as_str).unwrap_or_default();
+        let size_type = match ty.strip_prefix("minecraft:").unwrap_or(ty) {
+            "three_layers_feature_size" => {
+                FeatureSizeType::ThreeLayersFeatureSize(ThreeLayersFeatureSize {
+                    limit: byte(v.get("limit"), 1),
+                    upper_limit: byte(v.get("upper_limit"), 1),
+                    lower_size: byte(v.get("lower_size"), 0),
+                    middle_size: byte(v.get("middle_size"), 1),
+                    upper_size: byte(v.get("upper_size"), 1),
+                })
+            }
+            _ => FeatureSizeType::TwoLayersFeatureSize(TwoLayersFeatureSize {
+                limit: byte(v.get("limit"), 1),
+                lower_size: byte(v.get("lower_size"), 0),
+                upper_size: byte(v.get("upper_size"), 1),
+            }),
+        };
+        FeatureSize {
+            min_clipped_height: v
+                .get("min_clipped_height")
+                .and_then(Value::as_u64)
+                .and_then(|n| u8::try_from(n).ok()),
+            r#type: size_type,
+        }
+    }
+
+    fn directions(&mut self, v: Option<&Value>) -> Option<Vec<pumpkin_data::BlockDirection>> {
+        v.and_then(Value::as_array)
+            .map_or(&[][..], Vec::as_slice)
+            .iter()
+            .filter_map(Value::as_str)
+            .map(|name| self.direction(Some(name)))
+            .collect()
+    }
+
+    fn tree_decorator(&mut self, v: &Value) -> Option<TreeDecorator> {
+        let ty = v.get("type").and_then(Value::as_str).unwrap_or_default();
+        let probability = || float32(v.get("probability"), 0.0);
+        Some(match ty.strip_prefix("minecraft:").unwrap_or(ty) {
+            "trunk_vine" => TreeDecorator::TrunkVine(TrunkVineTreeDecorator),
+            "leave_vine" => TreeDecorator::LeaveVine(LeavesVineTreeDecorator {
+                probability: probability(),
+            }),
+            "cocoa" => TreeDecorator::Cocoa(CocoaTreeDecorator {
+                probability: probability(),
+            }),
+            "beehive" => TreeDecorator::Beehive(BeehiveTreeDecorator {
+                probability: probability(),
+            }),
+            "alter_ground" => TreeDecorator::AlterGround(AlterGroundTreeDecorator {
+                provider: self.state_provider(v.get("provider"))?,
+            }),
+            "attached_to_logs" => TreeDecorator::AttachedToLogs(AttachedToLogsTreeDecorator {
+                probability: probability(),
+                block_provider: self.state_provider(v.get("block_provider"))?,
+                directions: self.directions(v.get("directions"))?,
+            }),
+            "attached_to_leaves" => {
+                TreeDecorator::AttachedToLeaves(AttachedToLeavesTreeDecorator {
+                    probability: probability(),
+                    exclusion_radius_xz: int(v.get("exclusion_radius_xz"), 0),
+                    exclusion_radius_y: int(v.get("exclusion_radius_y"), 0),
+                    block_provider: self.state_provider(v.get("block_provider"))?,
+                    required_empty_blocks: int(v.get("required_empty_blocks"), 1),
+                    directions: self.directions(v.get("directions"))?,
+                })
+            }
+            "place_on_ground" => TreeDecorator::PlaceOnGround(PlaceOnGroundTreeDecorator {
+                tries: int(v.get("tries"), 128),
+                radius: int(v.get("radius"), 2),
+                height: int(v.get("height"), 1),
+                block_state_provider: self.state_provider(v.get("block_state_provider"))?,
+            }),
+            "creaking_heart" => TreeDecorator::CreakingHeart(CreakingHeartTreeDecorator {
+                probability: probability(),
+            }),
+            "pale_moss" => TreeDecorator::PaleMoss(PaleMossTreeDecorator {
+                leaves_probability: float32(v.get("leaves_probability"), 0.0),
+                trunk_probability: float32(v.get("trunk_probability"), 0.0),
+                ground_probability: float32(v.get("ground_probability"), 0.0),
+            }),
+            _ => return self.unsupported("tree decorator", ty),
+        })
+    }
+}
diff --git a/crates/pumpkin-world/src/generation/datapack/material_rule.rs b/crates/pumpkin-world/src/generation/datapack/material_rule.rs
new file mode 100644
index 0000000..f92d824
--- /dev/null
+++ b/crates/pumpkin-world/src/generation/datapack/material_rule.rs
@@ -0,0 +1,363 @@
+//! Surface rules from raw worldgen datapack JSON, mirroring `tools/pumpkin-codegen/src/material_rule.rs`.
+
+use pumpkin_data::Block;
+use pumpkin_data::BlockState;
+use pumpkin_data::biome::Biome;
+use pumpkin_data::material_rule::{
+    AboveYMaterialCondition, BadLandsMaterialRule, BiomeMaterialCondition, BlockMaterialRule,
+    ConditionMaterialRule, HoleMaterialCondition, MaterialCondition, MaterialRule,
+    NoiseThresholdMaterialCondition, NotMaterialCondition, OffsetTemperatureMaterialCondition,
+    OreVeinMaterialRule, SequenceMaterialRule, SlopeMaterialCondition, StoneDepthMaterialCondition,
+    SurfaceMaterialCondition, VerticalGradientMaterialCondition, WaterMaterialCondition,
+};
+use pumpkin_util::math::vertical_surface_type::VerticalSurfaceType;
+use pumpkin_util::y_offset::{AboveBottom, Absolute, BelowTop, RelativeToSeaLevel, YOffset};
+use serde_json::{Map, Value};
+
+use super::noise::{NoiseTable, seed_lo_hi};
+use super::{DatapackSet, Result, normalize_id};
+
+/// Deepest chain of rule and condition references and nested definitions.
+const MAX_DEPTH: usize = 64;
+
+/// Ore vein height ranges, which the generated rules derive from the density function name.
+const IRON_VEIN_Y: (i32, i32) = (-60, -8);
+const COPPER_VEIN_Y: (i32, i32) = (0, 50);
+
+fn leak<T>(value: T) -> &'static T {
+    Box::leak(Box::new(value))
+}
+
+fn string<'a>(obj: &'a Map<String, Value>, kind: &str, key: &str) -> Result<&'a str> {
+    obj.get(key)
+        .and_then(Value::as_str)
+        .ok_or_else(|| format!("{kind} is missing {key}"))
+}
+
+fn integer(obj: &Map<String, Value>, kind: &str, key: &str) -> Result<i32> {
+    obj.get(key)
+        .and_then(Value::as_i64)
+        .and_then(|v| i32::try_from(v).ok())
+        .ok_or_else(|| format!("{kind} is missing integer {key}"))
+}
+
+fn boolean(obj: &Map<String, Value>, kind: &str, key: &str) -> Result<bool> {
+    obj.get(key)
+        .and_then(Value::as_bool)
+        .ok_or_else(|| format!("{kind} is missing boolean {key}"))
+}
+
+fn y_offset(value: Option<&Value>) -> Result<YOffset> {
+    let obj = value
+        .and_then(Value::as_object)
+        .ok_or("vertical anchor is not an object")?;
+    let int = |key: &str| obj.get(key).and_then(Value::as_i64);
+    if let Some(v) = int("absolute") {
+        Ok(YOffset::Absolute(Absolute {
+            absolute: i16::try_from(v).map_err(|_| "absolute anchor is out of range")?,
+        }))
+    } else if let Some(v) = int("above_bottom") {
+        Ok(YOffset::AboveBottom(AboveBottom {
+            above_bottom: i8::try_from(v).map_err(|_| "above_bottom anchor is out of range")?,
+        }))
+    } else if let Some(v) = int("below_top") {
+        Ok(YOffset::BelowTop(BelowTop {
+            below_top: i8::try_from(v).map_err(|_| "below_top anchor is out of range")?,
+        }))
+    } else if let Some(v) = int("relative_to_sea_level") {
+        Ok(YOffset::RelativeToSeaLevel(RelativeToSeaLevel {
+            relative_to_sea_level: i16::try_from(v)
+                .map_err(|_| "relative_to_sea_level anchor is out of range")?,
+        }))
+    } else {
+        Err("unknown vertical anchor".to_string())
+    }
+}
+
+/// Block names of 26.3 (`{"id": ..}`), the older `{"Name": ..}` and plain strings.
+/// Like the generated rules this uses the block's default state and ignores properties.
+pub fn block_state(value: &Value) -> Result<&'static BlockState> {
+    let name = match value {
+        Value::String(name) => name.as_str(),
+        Value::Object(obj) => obj
+            .get("id")
+            .or_else(|| obj.get("Name"))
+            .and_then(Value::as_str)
+            .ok_or("block state has no id")?,
+        _ => return Err("block state is not a string or object".to_string()),
+    };
+    Block::from_registry_key(name.strip_prefix("minecraft:").unwrap_or(name))
+        .map(|block| block.default_state)
+        .ok_or_else(|| format!("unknown block {name}"))
+}
+
+pub struct RuleParser<'a, 'b> {
+    set: &'a DatapackSet,
+    noises: &'a mut NoiseTable<'b>,
+    active: Vec<String>,
+    depth: usize,
+}
+
+impl<'a, 'b> RuleParser<'a, 'b> {
+    pub const fn new(set: &'a DatapackSet, noises: &'a mut NoiseTable<'b>) -> Self {
+        Self {
+            set,
+            noises,
+            active: Vec::new(),
+            depth: 0,
+        }
+    }
+
+    /// Tectonic's `BiomeMixin` lowers the height `getHeightAdjustedTemperature` sees by
+    /// `snow_start_offset`. Ported from Tectonic by Apollo (MIT License),
+    /// <https://github.com/Apollounknowndev/tectonic>.
+    fn snow_start_offset(&self) -> i32 {
+        if self.set.mods().contains("tectonic") {
+            self.set.config().snow_start_offset()
+        } else {
+            0
+        }
+    }
+
+    fn enter(&mut self) -> Result<()> {
+        self.depth += 1;
+        if self.depth > MAX_DEPTH {
+            return Err("material rule is nested too deeply".to_string());
+        }
+        Ok(())
+    }
+
+    fn reference(&self, registry: &str, id: &str) -> Result<Value> {
+        let id = normalize_id(id);
+        let key = format!("{registry}/{id}");
+        if self.active.contains(&key) {
+            return Err(format!("{registry} {id} refers to itself"));
+        }
+        self.set
+            .json(registry, &id)
+            .ok_or_else(|| format!("unknown {registry} {id}"))
+    }
+
+    pub fn parse_rule(&mut self, value: &Value) -> Result<MaterialRule> {
+        self.enter()?;
+        let result = self.parse_rule_node(value);
+        self.depth -= 1;
+        result
+    }
+
+    fn parse_rule_node(&mut self, value: &Value) -> Result<MaterialRule> {
+        match value {
+            Value::String(id) => {
+                let json = self.reference("material_rule", id)?;
+                let key = format!("material_rule/{}", normalize_id(id));
+                self.active.push(key);
+                let result = self.parse_rule(&json).map_err(|e| format!("{id}: {e}"));
+                self.active.pop();
+                result
+            }
+            Value::Object(obj) => {
+                let type_name = string(obj, "material rule", "type")?;
+                let kind = type_name.strip_prefix("minecraft:").unwrap_or(type_name);
+                match kind {
+                    "block" => Ok(MaterialRule::Block(BlockMaterialRule {
+                        result_state: block_state(
+                            obj.get("result_state")
+                                .ok_or("block rule has no result_state")?,
+                        )?,
+                    })),
+                    "sequence" => {
+                        let rules = obj
+                            .get("sequence")
+                            .and_then(Value::as_array)
+                            .ok_or("sequence rule has no sequence")?
+                            .iter()
+                            .map(|rule| self.parse_rule(rule))
+                            .collect::<Result<Vec<_>>>()?;
+                        Ok(MaterialRule::Sequence(SequenceMaterialRule {
+                            sequence: Box::leak(rules.into_boxed_slice()),
+                        }))
+                    }
+                    "condition" => {
+                        let if_true = self.parse_condition(
+                            obj.get("if_true").ok_or("condition rule has no if_true")?,
+                        )?;
+                        let then_run = self.parse_rule(
+                            obj.get("then_run")
+                                .ok_or("condition rule has no then_run")?,
+                        )?;
+                        Ok(MaterialRule::Condition(ConditionMaterialRule {
+                            if_true,
+                            then_run: leak(then_run),
+                        }))
+                    }
+                    "bandlands" | "badlands" => Ok(MaterialRule::Badlands(BadLandsMaterialRule)),
+                    "ore_vein" => {
+                        let state = |key: &str| block_state(obj.get(key).unwrap_or(&Value::Null));
+                        let is_iron = string(obj, kind, "density")?.contains("iron");
+                        let (min_y, max_y) = if is_iron { IRON_VEIN_Y } else { COPPER_VEIN_Y };
+                        Ok(MaterialRule::OreVein(OreVeinMaterialRule {
+                            ore_block: state("ore_block")?,
+                            raw_ore_block: state("raw_ore_block")?,
+                            filler_block: state("filler_block")?,
+                            raw_ore_chance: obj
+                                .get("raw_ore_chance")
+                                .and_then(Value::as_f64)
+                                .ok_or("ore_vein has no raw_ore_chance")?
+                                as f32,
+                            min_y,
+                            max_y,
+                            is_iron,
+                        }))
+                    }
+                    other => Err(format!("unknown material rule type {other}")),
+                }
+            }
+            _ => Err("material rule is not a string or object".to_string()),
+        }
+    }
+
+    pub fn parse_condition(&mut self, value: &Value) -> Result<MaterialCondition> {
+        self.enter()?;
+        let result = self.parse_condition_node(value);
+        self.depth -= 1;
+        result
+    }
+
+    fn parse_condition_node(&mut self, value: &Value) -> Result<MaterialCondition> {
+        match value {
+            Value::String(id) => {
+                let json = self.reference("material_condition", id)?;
+                let key = format!("material_condition/{}", normalize_id(id));
+                self.active.push(key);
+                let result = self
+                    .parse_condition(&json)
+                    .map_err(|e| format!("{id}: {e}"));
+                self.active.pop();
+                result
+            }
+            Value::Object(obj) => {
+                let type_name = string(obj, "material condition", "type")?;
+                let kind = type_name.strip_prefix("minecraft:").unwrap_or(type_name);
+                self.parse_condition_typed(obj, kind)
+            }
+            _ => Err("material condition is not a string or object".to_string()),
+        }
+    }
+
+    fn parse_condition_typed(
+        &mut self,
+        obj: &Map<String, Value>,
+        kind: &str,
+    ) -> Result<MaterialCondition> {
+        Ok(match kind {
+            "biome" => {
+                let names: Vec<&str> = match obj.get("biome_is") {
+                    Some(Value::String(name)) => vec![name.as_str()],
+                    Some(Value::Array(list)) => list
+                        .iter()
+                        .map(|v| v.as_str().ok_or("biome_is entry is not a string"))
+                        .collect::<std::result::Result<_, _>>()?,
+                    _ => return Err("biome condition has no biome_is".to_string()),
+                };
+                let biomes: Vec<&'static Biome> = names
+                    .into_iter()
+                    .map(crate::biome::unknown::biome_for_name)
+                    .collect();
+                MaterialCondition::Biome(BiomeMaterialCondition {
+                    biome_is: Box::leak(biomes.into_boxed_slice()),
+                })
+            }
+            "noise_threshold" => {
+                MaterialCondition::NoiseThreshold(NoiseThresholdMaterialCondition {
+                    noise: self.noises.get(string(obj, kind, "noise")?)?,
+                    min_threshold: obj
+                        .get("min_threshold")
+                        .and_then(Value::as_f64)
+                        .ok_or("noise_threshold has no min_threshold")?,
+                    max_threshold: obj
+                        .get("max_threshold")
+                        .and_then(Value::as_f64)
+                        .ok_or("noise_threshold has no max_threshold")?,
+                    is_3d: obj.get("is_3d").and_then(Value::as_bool).unwrap_or(false),
+                })
+            }
+            "vertical_gradient" => {
+                let (random_lo, random_hi) =
+                    seed_lo_hi(&normalize_id(string(obj, kind, "random_name")?));
+                MaterialCondition::VerticalGradient(VerticalGradientMaterialCondition {
+                    random_lo,
+                    random_hi,
+                    true_at_and_below: y_offset(obj.get("true_at_and_below"))?,
+                    false_at_and_above: y_offset(obj.get("false_at_and_above"))?,
+                })
+            }
+            "y_above" => MaterialCondition::YAbove(AboveYMaterialCondition {
+                anchor: y_offset(obj.get("anchor"))?,
+                surface_depth_multiplier: integer(obj, kind, "surface_depth_multiplier")?,
+                add_stone_depth: boolean(obj, kind, "add_stone_depth")?,
+            }),
+            "water" => MaterialCondition::Water(WaterMaterialCondition {
+                offset: integer(obj, kind, "offset")?,
+                surface_depth_multiplier: integer(obj, kind, "surface_depth_multiplier")?,
+                add_stone_depth: boolean(obj, kind, "add_stone_depth")?,
+            }),
+            "temperature" => match self.snow_start_offset() {
+                0 => MaterialCondition::Temperature,
+                y_offset => {
+                    MaterialCondition::OffsetTemperature(OffsetTemperatureMaterialCondition {
+                        y_offset,
+                    })
+                }
+            },
+            "steep" => MaterialCondition::Steep,
+            "not" => MaterialCondition::Not(NotMaterialCondition {
+                invert: leak(self.parse_condition(obj.get("invert").ok_or("not has no invert")?)?),
+            }),
+            "hole" => MaterialCondition::Hole(HoleMaterialCondition),
+            "above_preliminary_surface" => {
+                MaterialCondition::AbovePreliminarySurface(SurfaceMaterialCondition)
+            }
+            "stone_depth" => MaterialCondition::StoneDepth(StoneDepthMaterialCondition {
+                offset: integer(obj, kind, "offset")?,
+                add_surface_depth: boolean(obj, kind, "add_surface_depth")?,
+                secondary_depth_range: integer(obj, kind, "secondary_depth_range")?,
+                surface_type: match string(obj, kind, "surface_type")? {
+                    "ceiling" => VerticalSurfaceType::Ceiling,
+                    "floor" => VerticalSurfaceType::Floor,
+                    other => return Err(format!("unknown surface type {other}")),
+                },
+            }),
+            "lithostitched:slope" => {
+                let (min_inclusive, max_inclusive) = int_range(obj.get("height_difference"));
+                MaterialCondition::Slope(SlopeMaterialCondition {
+                    min_inclusive,
+                    max_inclusive,
+                })
+            }
+            other => return Err(format!("unknown material condition type {other}")),
+        })
+    }
+}
+
+/// An integer range as Lithostitched reads it: a number, `[min, max]` or `{min_inclusive, max_inclusive}`.
+/// Missing bounds are open; no range at all means a difference of 4 or more.
+fn int_range(value: Option<&Value>) -> (i32, i32) {
+    let bound = |v: Option<&Value>, default: i32| {
+        v.and_then(Value::as_i64)
+            .map_or(default, |v| i32::try_from(v).unwrap_or(default))
+    };
+    match value {
+        Some(number @ Value::Number(_)) => {
+            let n = bound(Some(number), 0);
+            (n, n)
+        }
+        Some(Value::Array(pair)) if pair.len() == 2 => {
+            (bound(pair.first(), i32::MIN), bound(pair.get(1), i32::MAX))
+        }
+        Some(Value::Object(range)) => (
+            bound(range.get("min_inclusive"), i32::MIN),
+            bound(range.get("max_inclusive"), i32::MAX),
+        ),
+        _ => (4, i32::MAX),
+    }
+}
