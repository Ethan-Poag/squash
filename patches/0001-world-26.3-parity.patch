+/// The density functions of a `noise_router`, each a tree of its own.
+pub struct RouterRoots {
+    barrier: Df,
+    fluid_level_floodedness: Df,
+    fluid_level_spread: Df,
+    lava: Df,
+    temperature: Df,
+    vegetation: Df,
+    continents: Df,
+    erosion: Df,
+    depth: Df,
+    ridges: Df,
+    preliminary_surface_level: Df,
+    final_density: Df,
+    vein_toggle: Df,
+    vein_ridged: Df,
+    vein_gap: Df,
+}
+
+impl RouterRoots {
+    const fn each_mut(&mut self) -> [&mut Df; 15] {
+        [
+            &mut self.barrier,
+            &mut self.fluid_level_floodedness,
+            &mut self.fluid_level_spread,
+            &mut self.lava,
+            &mut self.temperature,
+            &mut self.vegetation,
+            &mut self.continents,
+            &mut self.erosion,
+            &mut self.depth,
+            &mut self.ridges,
+            &mut self.preliminary_surface_level,
+            &mut self.final_density,
+            &mut self.vein_toggle,
+            &mut self.vein_ridged,
+            &mut self.vein_gap,
+        ]
+    }
+}
+
+/// Reads the `noise_router` of a noise settings file. Missing entries are zero; `settings_name`
+/// decides whether the overworld ore vein functions are filled in.
+pub fn parse_router(
+    parser: &mut DfParser,
+    settings: &Value,
+    settings_name: &str,
+) -> Result<RouterRoots> {
+    let router = settings
+        .get("noise_router")
+        .and_then(Value::as_object)
+        .ok_or("noise settings have no noise_router")?;
+    let aquifers = settings.get("aquifers");
+    let overworld_like = settings_name.starts_with("overworld")
+        || matches!(settings_name, "amplified" | "large_biomes");
+
+    let mut read =
+        |keys: &[&str], aquifer_key: Option<&str>, default: Option<&str>| -> Result<Df> {
+            let value = keys
+                .iter()
+                .find_map(|k| router.get(*k))
+                .or_else(|| aquifer_key.and_then(|k| aquifers.and_then(|a| a.get(k))));
+            match (value, default) {
+                (Some(value), _) => parser
+                    .parse(value)
+                    .map_err(|e| format!("noise_router.{}: {e}", keys[0])),
+                (None, Some(default)) if overworld_like => parser.reference(default),
+                (None, _) => Ok(Df::constant(0.0)),
+            }
+        };
+
+    Ok(RouterRoots {
+        barrier: read(&["barrier"], Some("barrier"), None)?,
+        fluid_level_floodedness: read(
+            &["fluid_level_floodedness"],
+            Some("fluid_level_floodedness"),
+            None,
+        )?,
+        fluid_level_spread: read(&["fluid_level_spread"], Some("fluid_level_spread"), None)?,
+        lava: read(&["lava"], Some("lava"), None)?,
+        temperature: read(&["temperature"], None, None)?,
+        vegetation: read(&["vegetation"], None, None)?,
+        continents: read(&["continents"], None, None)?,
+        erosion: read(&["erosion"], None, None)?,
+        depth: read(&["depth"], None, None)?,
+        ridges: read(&["ridges"], None, None)?,
+        preliminary_surface_level: read(
+            &["preliminary_surface_level", "chunk_surface_level"],
+            Some("surface_level"),
+            None,
+        )?,
+        final_density: read(&["final_density"], None, None)?,
+        vein_toggle: read(
+            &["vein_toggle"],
+            None,
+            Some("minecraft:overworld/ore_vein/toggle"),
+        )?,
+        vein_ridged: read(
+            &["vein_ridged"],
+            None,
+            Some("minecraft:overworld/ore_vein/mask"),
+        )?,
+        vein_gap: read(
+            &["vein_gap"],
+            None,
+            Some("minecraft:overworld/ore_vein/gap"),
+        )?,
+    })
+}
+
+/// Converts the router into the four component stacks, like the build-time conversion.
+pub fn build_base_routers(
+    mut roots: RouterRoots,
+    noises: &mut NoiseTable,
+) -> Result<BaseNoiseRouters> {
+    for root in roots.each_mut() {
+        root.optimize();
+    }
+    for root in roots.each_mut() {
+        root.slice_uniform_axes(AXES_ALL);
+    }
+
+    let mut noise = Emitter::new(noises);
+    let erosion = noise.index_for(&roots.erosion)?;
+    let depth = noise.index_for(&roots.depth)?;
+    let barrier_noise = noise.index_for(&roots.barrier)?;
+    let fluid_level_floodedness_noise = noise.index_for(&roots.fluid_level_floodedness)?;
+    let fluid_level_spread_noise = noise.index_for(&roots.fluid_level_spread)?;
+    let lava_noise = noise.index_for(&roots.lava)?;
+    let final_density = noise.index_for(&roots.final_density)?;
+    let vein_toggle = noise.index_for(&roots.vein_toggle)?;
+    let vein_ridged = noise.index_for(&roots.vein_ridged)?;
+    let vein_gap = noise.index_for(&roots.vein_gap)?;
+    let noise_stack = noise.stack;
+
+    let mut surface = Emitter::new(noises);
+    surface.index_for(&roots.preliminary_surface_level)?;
+    let surface_stack = surface.stack;
+
+    let mut multi = Emitter::new(noises);
+    let ridges = multi.index_for(&roots.ridges)?;
+    let temperature = multi.index_for(&roots.temperature)?;
+    let vegetation = multi.index_for(&roots.vegetation)?;
+    let continents = multi.index_for(&roots.continents)?;
+    let multi_erosion = multi.index_for(&roots.erosion)?;
+    let multi_depth = multi.index_for(&roots.depth)?;
+    let multi_stack = multi.stack;
+
+    let mut vein = Emitter::new(noises);
+    let vein_router_toggle = vein.index_for(&roots.vein_toggle)?;
+    let vein_router_ridged = vein.index_for(&roots.vein_ridged)?;
+    let vein_router_gap = vein.index_for(&roots.vein_gap)?;
+    let vein_stack = vein.stack;
+
+    Ok(BaseNoiseRouters {
+        noise: BaseNoiseRouter {
+            full_component_stack: leak_slice(noise_stack),
+            barrier_noise,
+            fluid_level_floodedness_noise,
+            fluid_level_spread_noise,
+            lava_noise,
+            erosion,
+            depth,
+            final_density,
+            vein_toggle,
+            vein_ridged,
+            vein_gap,
+        },
+        surface_estimator: BaseSurfaceEstimator {
+            full_component_stack: leak_slice(surface_stack),
+        },
+        multi_noise: BaseMultiNoiseRouter {
+            full_component_stack: leak_slice(multi_stack),
+            temperature,
+            vegetation,
+            continents,
+            erosion: multi_erosion,
+            depth: multi_depth,
+            ridges,
+        },
+        vein: BaseVeinRouter {
+            full_component_stack: leak_slice(vein_stack),
+            vein_toggle: vein_router_toggle,
+            vein_ridged: vein_router_ridged,
+            vein_gap: vein_router_gap,
+        },
+    })
+}
diff --git a/crates/pumpkin-world/src/generation/datapack/dimension_type.rs b/crates/pumpkin-world/src/generation/datapack/dimension_type.rs
new file mode 100644
index 0000000..c3d9faf
--- /dev/null
+++ b/crates/pumpkin-world/src/generation/datapack/dimension_type.rs
@@ -0,0 +1,131 @@
+//! Dimension types that world datapacks override (`data/<namespace>/dimension_type/`).
+
+use std::path::Path;
+
+use pumpkin_data::dimension::Dimension;
+use serde_json::Value;
+use tracing::{info, warn};
+
+use super::{DIMENSION_TYPE, DatapackSet};
+use crate::generation::positions;
+
+/// Vanilla's `DimensionType.MIN_Y` / `MAX_Y` / `Y_SIZE`.
+pub const MAX_Y: i32 = positions::MAX_COLUMN_HEIGHT as i32;
+pub const MIN_Y: i32 = positions::MIN_HEIGHT;
+const MAX_HEIGHT: i32 = positions::MAX_HEIGHT as i32;
+const SECTION_SIZE: i32 = 16;
+
+/// `base` with the vertical extent that the packs in `world_dir` give its dimension type.
+/// Without a pack entry, or with one that is not a valid extent, this is `base` itself.
+#[must_use]
+pub fn dimension_with_packs(world_dir: &Path, base: &Dimension) -> Dimension {
+    DatapackSet::load(world_dir).map_or_else(|| base.clone(), |set| dimension_for_set(&set, base))
+}
+
+/// [`dimension_with_packs`] for packs that are already read.
+#[must_use]
+pub fn dimension_for_set(set: &DatapackSet, base: &Dimension) -> Dimension {
+    let mut dimension = base.clone();
+    let Some(json) = set.pack_json(DIMENSION_TYPE, base.minecraft_name) else {
+        return dimension;
+    };
+    match extent(json, base) {
+        Some((min_y, height, logical_height)) => {
+            if (min_y, height, logical_height) != (base.min_y, base.height, base.logical_height) {
+                info!(
+                    "datapack dimension type {}: y {min_y}..{} (logical height {logical_height})",
+                    base.minecraft_name,
+                    min_y + height
+                );
+            }
+            dimension.min_y = min_y;
+            dimension.height = height;
+            dimension.logical_height = logical_height;
+        }
+        None => warn!(
+            "datapack dimension type {} has an invalid extent; keeping the vanilla one",
+            base.minecraft_name
+        ),
+    }
+    dimension
+}
+
+/// The `(min_y, height, logical_height)` of a pack's dimension type, with the vanilla values of
+/// `base` for the keys it leaves out. `None` when they are not a valid extent.
+#[must_use]
+pub fn extent(json: &Value, base: &Dimension) -> Option<(i32, i32, i32)> {
+    let int = |key: &str, default: i32| {
+        json.get(key)
+            .and_then(Value::as_i64)
+            .map_or(Some(default), |v| i32::try_from(v).ok())
+    };
+    let min_y = int("min_y", base.min_y)?;
+    let height = int("height", base.height)?;
+    let logical_height = int("logical_height", base.logical_height)?;
+    let valid = min_y % SECTION_SIZE == 0
+        && height % SECTION_SIZE == 0
+        && (MIN_Y..=MAX_Y).contains(&min_y)
+        && (SECTION_SIZE..=MAX_HEIGHT).contains(&height)
+        && min_y + height - 1 <= MAX_Y
+        && (0..=height).contains(&logical_height);
+    valid.then_some((min_y, height, logical_height))
+}
+
+/// Every dimension type the packs define, with its JSON when it is safe to send to clients: the
+/// server accepts its extent, so both sides agree on the height. `None` marks a refused one.
+#[must_use]
+pub fn synced_dimension_types(set: &DatapackSet) -> Vec<(&str, Option<&Value>)> {
+    set.pack_ids(DIMENSION_TYPE)
+        .into_iter()
+        .filter_map(|id| Some((id, set.pack_json(DIMENSION_TYPE, id)?)))
+        .map(|(id, json)| {
+            let accepted = Dimension::from_name(id).is_none_or(|base| extent(json, base).is_some());
+            (id, accepted.then_some(json))
+        })
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::fs;
+
+    fn world_with_type(tag: &str, json: &str) -> std::path::PathBuf {
+        let world =
+            std::env::temp_dir().join(format!("pumpkin_dimtype_{tag}_{}", std::process::id()));
+        let dir = world.join("datapacks/pack/data/minecraft/dimension_type");
+        fs::create_dir_all(&dir).unwrap();
+        fs::write(world.join("datapacks/pack/pack.mcmeta"), "{}").unwrap();
+        fs::write(dir.join("the_end.json"), json).unwrap();
+        world
+    }
+
+    #[test]
+    fn pack_height_replaces_the_vanilla_extent() {
+        let world = world_with_type("ok", r#"{"min_y":0,"height":384,"logical_height":384}"#);
+        let end = dimension_with_packs(&world, &Dimension::THE_END);
+        assert_eq!((end.min_y, end.height, end.logical_height), (0, 384, 384));
+        // Other dimensions are untouched.
+        let nether = dimension_with_packs(&world, &Dimension::THE_NETHER);
+        assert_eq!(nether.height, Dimension::THE_NETHER.height);
+        let _ = fs::remove_dir_all(world);
+    }
+
+    #[test]
+    fn invalid_extent_keeps_vanilla() {
+        let world = world_with_type("bad", r#"{"min_y":0,"height":100,"logical_height":100}"#);
+        let end = dimension_with_packs(&world, &Dimension::THE_END);
+        assert_eq!(end.height, Dimension::THE_END.height);
+        let _ = fs::remove_dir_all(world);
+    }
+
+    #[test]
+    fn no_packs_is_vanilla() {
+        let world =
+            std::env::temp_dir().join(format!("pumpkin_dimtype_none_{}", std::process::id()));
+        fs::create_dir_all(&world).unwrap();
+        let end = dimension_with_packs(&world, &Dimension::THE_END);
+        assert_eq!(end.height, 256);
+        let _ = fs::remove_dir_all(world);
+    }
+}
diff --git a/crates/pumpkin-world/src/generation/datapack/feature.rs b/crates/pumpkin-world/src/generation/datapack/feature.rs
