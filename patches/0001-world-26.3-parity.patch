new file mode 100644
index 0000000..ebdb320
--- /dev/null
+++ b/crates/pumpkin-world/src/generation/mob_spawn.rs
@@ -0,0 +1,702 @@
+//! Mobs placed while a chunk is generated.
+//!
+//! This is vanilla `NaturalSpawner.spawnMobsForChunkGeneration` and the spawn placement rules it
+//! needs. They read the generation cache because the chunk is not part of the world yet.
+
+use pumpkin_data::chunk::{Biome, Spawner};
+use pumpkin_data::entity::{EntityType, SpawnLocation};
+use pumpkin_data::tag::Block::{
+    MINECRAFT_ANIMALS_SPAWNABLE_ON, MINECRAFT_ARMADILLO_SPAWNABLE_ON,
+    MINECRAFT_CAMELS_SPAWNABLE_ON, MINECRAFT_FOXES_SPAWNABLE_ON, MINECRAFT_FROGS_SPAWNABLE_ON,
+    MINECRAFT_GOATS_SPAWNABLE_ON, MINECRAFT_LEAVES, MINECRAFT_MOOSHROOMS_SPAWNABLE_ON,
+    MINECRAFT_PARROTS_SPAWNABLE_ON, MINECRAFT_POLAR_BEARS_SPAWNABLE_ON_ALTERNATE,
+    MINECRAFT_PREVENT_MOB_SPAWNING_INSIDE, MINECRAFT_RABBITS_SPAWNABLE_ON, MINECRAFT_SAND,
+    MINECRAFT_WOLVES_SPAWNABLE_ON,
+};
+use pumpkin_data::tag::Fluid::{MINECRAFT_LAVA, MINECRAFT_WATER};
+use pumpkin_data::tag::Taggable;
+use pumpkin_data::tag::WorldgenBiome::{
+    MINECRAFT_ALLOWS_TROPICAL_FISH_SPAWNS_AT_ANY_HEIGHT,
+    MINECRAFT_POLAR_BEARS_SPAWN_ON_ALTERNATE_BLOCKS,
+};
+use pumpkin_data::{Block, BlockDirection, BlockState, SpawnFloorPredicate};
+use pumpkin_util::math::boundingbox::BoundingBox;
+use pumpkin_util::math::position::BlockPos;
+use pumpkin_util::math::vector3::Vector3;
+use pumpkin_util::random::RandomImpl;
+use pumpkin_util::random::legacy_rand::LegacyRand;
+
+use crate::generation::proto_chunk::GenerationCache;
+
+/// Light level an animal needs to spawn (vanilla `Animal.isBrightEnoughToSpawn`).
+const MIN_ANIMAL_SPAWN_BRIGHTNESS: u8 = 8;
+/// Vanilla `Mob.MAX_...`: attempts to place one mob of a group.
+const SPAWN_ATTEMPTS: i32 = 4;
+/// How far a group member wanders from the previous one, on each axis.
+const GROUP_SPREAD: i32 = 5;
+/// Turtles spawn this far above sea level at most.
+const TURTLE_SPAWN_HEIGHT_ABOVE_SEA: i32 = 4;
+
+/// Animals that only need `animals_spawnable_on` below them.
+const ANIMALS: &[&EntityType] = &[
+    &EntityType::CHICKEN,
+    &EntityType::COW,
+    &EntityType::DONKEY,
+    &EntityType::HAPPY_GHAST,
+    &EntityType::HORSE,
+    &EntityType::LLAMA,
+    &EntityType::MULE,
+    &EntityType::PIG,
+    &EntityType::SHEEP,
+    &EntityType::CAT,
+    &EntityType::PANDA,
+    &EntityType::TRADER_LLAMA,
+];
+
+/// Animals with their own block tag below them.
+const TAGGED_ANIMALS: &[(&EntityType, &pumpkin_data::tag::Tag)] = &[
+    (&EntityType::ARMADILLO, &MINECRAFT_ARMADILLO_SPAWNABLE_ON),
+    (&EntityType::CAMEL, &MINECRAFT_CAMELS_SPAWNABLE_ON),
+    (&EntityType::FROG, &MINECRAFT_FROGS_SPAWNABLE_ON),
+    (&EntityType::GOAT, &MINECRAFT_GOATS_SPAWNABLE_ON),
+    (&EntityType::MOOSHROOM, &MINECRAFT_MOOSHROOMS_SPAWNABLE_ON),
+    (&EntityType::PARROT, &MINECRAFT_PARROTS_SPAWNABLE_ON),
+    (&EntityType::RABBIT, &MINECRAFT_RABBITS_SPAWNABLE_ON),
+    (&EntityType::WOLF, &MINECRAFT_WOLVES_SPAWNABLE_ON),
+    (&EntityType::FOX, &MINECRAFT_FOXES_SPAWNABLE_ON),
+];
+
+/// What the generation loop needs from the server: turn an accepted position into a mob.
+pub trait ChunkGenerationSpawner {
+    /// A new group starts; its mobs share one spawn group data.
+    fn start_group(&mut self);
+
+    /// Creates, finalizes and adds the mob. `false` when it could not be placed, so the loop
+    /// tries again. `biome` is the biome at the position.
+    fn spawn(
+        &mut self,
+        entity_type: &'static EntityType,
+        pos: Vector3<f64>,
+        yaw: f32,
+        biome: &'static Biome,
+    ) -> bool;
+}
+
+/// The world facts the placement rules read.
+#[derive(Clone, Copy)]
+pub struct ChunkGenerationSpawnLevel {
+    pub seed: u64,
+    pub min_y: i32,
+    pub sea_level: i32,
+    pub has_ceiling: bool,
+}
+
+fn state_at(cache: &dyn GenerationCache, pos: &BlockPos) -> &'static BlockState {
+    GenerationCache::get_block_state(cache, &pos.0).to_state()
+}
+
+fn block_at(cache: &dyn GenerationCache, pos: &BlockPos) -> &'static Block {
+    Block::from_state_id(state_at(cache, pos).id)
+}
+
+/// Light at `pos` without the sky darkening (vanilla `getRawBrightness(pos, 0)`). Unlit data
+/// reads as dark.
+fn raw_brightness(cache: &dyn GenerationCache, pos: &BlockPos) -> u8 {
+    let Some(chunk) = cache.try_get_proto_chunk(pos.0.x >> 4, pos.0.z >> 4) else {
+        return 0;
+    };
+    let relative_y = pos.0.y - i32::from(chunk.bottom_y());
+    if relative_y < 0 {
+        return 0;
+    }
+    let section = (relative_y >> 4) as usize;
+    let (x, y, z) = (
+        (pos.0.x & 15) as usize,
+        (relative_y & 15) as usize,
+        (pos.0.z & 15) as usize,
+    );
+    let sky = chunk
+        .light
+        .sky_light
+        .get(section)
+        .map_or(0, |light| light.get(x, y, z));
+    let block = chunk
+        .light
+        .block_light
+        .get(section)
+        .map_or(0, |light| light.get(x, y, z));
+    sky.max(block)
+}
+
+fn is_bright_enough_to_spawn(cache: &dyn GenerationCache, pos: &BlockPos) -> bool {
+    raw_brightness(cache, pos) > MIN_ANIMAL_SPAWN_BRIGHTNESS
+}
+
+fn is_water(cache: &dyn GenerationCache, pos: &BlockPos) -> bool {
+    let state = state_at(cache, pos);
+    state.is_liquid() && Block::from_state_id(state.id).has_tag(&MINECRAFT_WATER)
+}
+
+/// Vanilla `WaterAnimal.checkSurfaceWaterAnimalSpawnRules`.
+fn check_surface_water_animal(
+    cache: &dyn GenerationCache,
+    level: &ChunkGenerationSpawnLevel,
+    pos: &BlockPos,
+) -> bool {
+    pos.0.y >= level.sea_level - 13
+        && pos.0.y <= level.sea_level
+        && is_water(cache, &pos.down())
+        && block_at(cache, &pos.up()) == &Block::WATER
+}
+
+/// The spawn placement predicate of `entity_type` for the reason chunk generation.
+#[must_use]
+pub fn check_spawn_rules(
+    cache: &dyn GenerationCache,
+    level: &ChunkGenerationSpawnLevel,
+    entity_type: &'static EntityType,
+    pos: &BlockPos,
+    random: &mut impl RandomImpl,
+) -> bool {
+    let id = entity_type.id;
+    if ANIMALS.iter().any(|animal| animal.id == id) {
+        return block_at(cache, &pos.down()).has_tag(&MINECRAFT_ANIMALS_SPAWNABLE_ON)
+            && is_bright_enough_to_spawn(cache, pos);
+    }
+    if let Some((_, tag)) = TAGGED_ANIMALS.iter().find(|(animal, _)| animal.id == id) {
+        return block_at(cache, &pos.down()).has_tag(tag) && is_bright_enough_to_spawn(cache, pos);
+    }
+    if id == EntityType::OCELOT.id {
+        return random.next_bounded_i32(3) != 0;
+    }
+    if id == EntityType::POLAR_BEAR.id {
+        let biome = cache.get_biome_for_terrain_gen(pos.0.x, pos.0.y, pos.0.z);
+        let below = block_at(cache, &pos.down());
+        return if biome.has_tag(&MINECRAFT_POLAR_BEARS_SPAWN_ON_ALTERNATE_BLOCKS) {
+            is_bright_enough_to_spawn(cache, pos)
+                && below.has_tag(&MINECRAFT_POLAR_BEARS_SPAWNABLE_ON_ALTERNATE)
+        } else {
+            below.has_tag(&MINECRAFT_ANIMALS_SPAWNABLE_ON) && is_bright_enough_to_spawn(cache, pos)
+        };
+    }
+    if id == EntityType::TURTLE.id {
+        return pos.0.y < level.sea_level + TURTLE_SPAWN_HEIGHT_ABOVE_SEA
+            && block_at(cache, &pos.down()).has_tag(&MINECRAFT_SAND)
+            && is_bright_enough_to_spawn(cache, pos);
+    }
+    if id == EntityType::COD.id
+        || id == EntityType::PUFFERFISH.id
+        || id == EntityType::SALMON.id
+        || id == EntityType::DOLPHIN.id
+        || id == EntityType::SQUID.id
+    {
+        return check_surface_water_animal(cache, level, pos);
+    }
+    if id == EntityType::TROPICAL_FISH.id {
+        if !is_water(cache, &pos.down()) || block_at(cache, &pos.up()) != &Block::WATER {
+            return false;
+        }
+        let biome = cache.get_biome_for_terrain_gen(pos.0.x, pos.0.y, pos.0.z);
+        return biome.has_tag(&MINECRAFT_ALLOWS_TROPICAL_FISH_SPAWNS_AT_ANY_HEIGHT)
+            || check_surface_water_animal(cache, level, pos);
+    }
+    if id == EntityType::AXOLOTL.id {
+        return block_at(cache, &pos.down())
+            .has_tag(&pumpkin_data::tag::Block::MINECRAFT_AXOLOTLS_SPAWNABLE_ON);
+    }
+    if entity_type.mob {
+        return is_valid_spawn_floor(state_at(cache, &pos.down()), entity_type);
+    }
+    true
+}
+
+/// Vanilla `Mob.checkSpawnObstruction` for the mobs a biome lists as creatures.
+fn check_spawn_obstruction(
+    cache: &dyn GenerationCache,
+    level: &ChunkGenerationSpawnLevel,
+    entity_type: &'static EntityType,
+    pos: &BlockPos,
+    bounds: &BoundingBox,
+) -> bool {
+    if !matches!(
+        entity_type.spawn_restriction.location,
+        SpawnLocation::InWater
+    ) && contains_any_liquid(cache, bounds)
+    {
+        return false;
+    }
+    if entity_type.id == EntityType::OCELOT.id {
+        let below = block_at(cache, &pos.down());
+        return pos.0.y >= level.sea_level
+            && (below == &Block::GRASS_BLOCK || below.has_tag(&MINECRAFT_LEAVES));
+    }
+    true
+}
+
+fn contains_any_liquid(cache: &dyn GenerationCache, bounds: &BoundingBox) -> bool {
+    BlockPos::iterate(bounds.min_block_pos(), bounds.max_block_pos()).any(|pos| {
+        let id = GenerationCache::get_block_state(cache, &pos.0);
+        id.to_state().is_liquid() || id.is_waterlogged()
+    })
+}
+
+/// Whether no block collides with `bounds` (vanilla `LevelReader.noCollision` on blocks).
+fn no_block_collision(cache: &dyn GenerationCache, bounds: &BoundingBox) -> bool {
+    BlockPos::iterate(bounds.min_block_pos(), bounds.max_block_pos()).all(|pos| {
+        let state = state_at(cache, &pos);
+        if state.is_air() || !state.is_solid() {
+            return true;
+        }
+        !state
+            .get_block_collision_shapes_at(&pos)
+            .any(|shape| shape.at_pos(pos).intersects(bounds))
+    })
+}
+
+/// A weighted pick from `spawners` (vanilla `WeightedList.getRandom`).
+fn pick_weighted<'a>(spawners: &'a [Spawner], random: &mut impl RandomImpl) -> Option<&'a Spawner> {
+    let total: i32 = spawners.iter().map(|spawner| spawner.weight.max(0)).sum();
+    if total <= 0 {
+        return None;
+    }
+    let mut roll = random.next_bounded_i32(total);
+    spawners.iter().find(|spawner| {
+        roll -= spawner.weight.max(0);
+        roll < 0
+    })
+}
+
+/// Samples the group size of `spawner`; a constant size draws nothing.
+fn sample_count(spawner: &Spawner, random: &mut impl RandomImpl) -> i32 {
+    if spawner.max_count <= spawner.min_count {
+        spawner.min_count
+    } else {
+        random.next_inbetween_i32(spawner.min_count, spawner.max_count)
+    }
+}
+
+#[must_use]
+pub fn get_top_non_colliding_pos(
+    cache: &dyn GenerationCache,
+    level: &ChunkGenerationSpawnLevel,
+    entity_type: &'static EntityType,
+    x: i32,
+    z: i32,
+) -> BlockPos {
+    let mut y = cache.get_top_y(&entity_type.spawn_restriction.heightmap, x, z);
+
+    if level.has_ceiling {
+        loop {
+            crate::generation::budget::tick();
+            y -= 1;
+            if state_at(cache, &BlockPos::new(x, y, z)).is_air() || y <= level.min_y {
+                break;
+            }
+        }
+        loop {
+            crate::generation::budget::tick();
+            y -= 1;
+            if !state_at(cache, &BlockPos::new(x, y, z)).is_air() || y <= level.min_y {
+                break;
+            }
+        }
+    }
+
+    adjust_spawn_position(cache, BlockPos::new(x, y, z), entity_type)
+}
+
+#[must_use]
+pub fn adjust_spawn_position(
+    cache: &dyn GenerationCache,
+    pos: BlockPos,
+    entity_type: &'static EntityType,
+) -> BlockPos {
+    if matches!(
+        entity_type.spawn_restriction.location,
+        SpawnLocation::OnGround
+    ) {
+        let below = pos.down();
+        let state = state_at(cache, &below);
+        if !state.is_full_cube() && !state.is_liquid() {
+            return below;
+        }
+    }
+    pos
+}
+
+#[must_use]
+pub fn is_spawn_position_ok(
+    cache: &dyn GenerationCache,
+    block_pos: &BlockPos,
+    entity_type: &'static EntityType,
+) -> bool {
+    let state = state_at(cache, block_pos);
+
+    match entity_type.spawn_restriction.location {
+        SpawnLocation::InLava => {
+            state.is_liquid() && Block::from_state_id(state.id).has_tag(&MINECRAFT_LAVA)
+        }
+        SpawnLocation::InWater => {
+            let above = state_at(cache, &block_pos.up());
+            state.is_liquid()
+                && Block::from_state_id(state.id).has_tag(&MINECRAFT_WATER)
+                && !above.is_solid_block()
+        }
+        SpawnLocation::OnGround => {
+            let down = state_at(cache, &block_pos.down());
+            let up = state_at(cache, &block_pos.up());
+            is_valid_spawn_floor(down, entity_type)
+                && is_valid_empty_spawn_block(state, entity_type)
+                && is_valid_empty_spawn_block(up, entity_type)
+        }
+        SpawnLocation::Unrestricted => true,
+    }
+}
+
+#[must_use]
+pub fn is_valid_empty_spawn_block(
+    state: &'static BlockState,
+    entity_type: &'static EntityType,
+) -> bool {
+    if state.is_full_cube() {
+        return false;
+    }
+    if state.is_liquid() {
+        return false;
+    }
+    if Block::from_state_id(state.id).has_tag(&MINECRAFT_PREVENT_MOB_SPAWNING_INSIDE) {
+        return false;
+    }
+    !is_block_dangerous(entity_type, state)
+}
+
+#[must_use]
+pub fn is_valid_spawn_floor(state: &'static BlockState, entity_type: &'static EntityType) -> bool {
+    match Block::from_state_id(state.id).spawn_floor_predicate() {
+        SpawnFloorPredicate::Default => {
+            state.is_side_solid(BlockDirection::Up) && state.luminance < 14
+        }
+        SpawnFloorPredicate::Never => false,
+        SpawnFloorPredicate::Always => true,
+        SpawnFloorPredicate::OcelotOrParrot => {
+            entity_type == &EntityType::OCELOT || entity_type == &EntityType::PARROT
+        }
+        SpawnFloorPredicate::PolarBear => entity_type == &EntityType::POLAR_BEAR,
+        SpawnFloorPredicate::FireImmune => entity_type.fire_immune,
+    }
+}
+
+fn is_block_dangerous(entity_type: &'static EntityType, state: &'static BlockState) -> bool {
+    let block = Block::from_state_id(state.id);
+    if !entity_type.fire_immune && is_burning_block(block) {
+        return true;
+    }
+    block.id == Block::WITHER_ROSE.id
+        || block.id == Block::SWEET_BERRY_BUSH.id
+        || block.id == Block::CACTUS.id
+        || block.id == Block::POWDER_SNOW.id
+}
+
+fn is_burning_block(block: &Block) -> bool {
+    block.has_tag(&pumpkin_data::tag::Block::MINECRAFT_FIRE)
+        || block.id == Block::LAVA.id
+        || block.id == Block::MAGMA_BLOCK.id
+        || block.id == Block::LAVA_CAULDRON.id
+        || block.id == Block::CAMPFIRE.id
+        || block.id == Block::SOUL_CAMPFIRE.id
+}
+
+/// Places the animals of a freshly generated chunk. The randomness is seeded by the chunk
+/// like vanilla's decoration seed, so a chunk always gets the same animals.
+pub fn spawn_mobs_for_chunk_generation(
+    cache: &dyn GenerationCache,
+    level: &ChunkGenerationSpawnLevel,
+    biome: &'static Biome,
+    chunk_x: i32,
+    chunk_z: i32,
+    spawner: &mut dyn ChunkGenerationSpawner,
+) {
+    let creatures = biome.spawners.creature;
+    if creatures.is_empty() {
+        return;
+    }
+
+    let xo = chunk_x << 4;
+    let zo = chunk_z << 4;
+    let mut random = LegacyRand::from_seed(LegacyRand::get_population_seed(level.seed, xo, zo));
+
+    while random.next_f32() < biome.creature_spawn_probability {
+        crate::generation::budget::tick();
+        let Some(spawner_data) = pick_weighted(creatures, &mut random) else {
+            continue;
+        };
+        let count = sample_count(spawner_data, &mut random);
+        let name = spawner_data
+            .r#type
+            .strip_prefix("minecraft:")
+            .unwrap_or(spawner_data.r#type);
+        let entity_type = EntityType::from_name(name);
+
+        spawner.start_group();
+        let mut x = xo + random.next_bounded_i32(16);
+        let mut z = zo + random.next_bounded_i32(16);
+        let start_x = x;
+        let start_z = z;
+
+        // An unknown entity type still advances the position draws, but spawns nothing.
+        let Some(entity_type) = entity_type.filter(|entity_type| entity_type.summonable) else {
+            continue;
+        };
+
+        for _ in 0..count {
+            let mut success = false;
+            let mut attempts = 0;
+            while !success && attempts < SPAWN_ATTEMPTS {
+                crate::generation::budget::tick();
+                attempts += 1;
+                let pos = get_top_non_colliding_pos(cache, level, entity_type, x, z);
+                if is_spawn_position_ok(cache, &pos, entity_type) {
+                    let width = f64::from(entity_type.dimension[0]);
+                    let fx =
+                        f64::from(x).clamp(f64::from(xo) + width, f64::from(xo) + 16.0 - width);
+                    let fz =
+                        f64::from(z).clamp(f64::from(zo) + width, f64::from(zo) + 16.0 - width);
+                    let y = f64::from(pos.0.y);
+                    let bounds = entity_type.get_spawn_bounding_box(fx, y, fz);
+                    let spawn_pos = BlockPos::new(fx.floor() as i32, pos.0.y, fz.floor() as i32);
+                    if !no_block_collision(cache, &bounds)
+                        || !check_spawn_rules(cache, level, entity_type, &spawn_pos, &mut random)
+                    {
+                        // Vanilla retries from the same column without moving.
+                        continue;
+                    }
+                    let yaw = random.next_f32() * 360.0;
+                    let mob_pos = BlockPos::new(fx.floor() as i32, pos.0.y, fz.floor() as i32);
+                    if check_spawn_obstruction(cache, level, entity_type, &mob_pos, &bounds) {
+                        let mob_biome =
+                            cache.get_biome_for_terrain_gen(mob_pos.0.x, mob_pos.0.y, mob_pos.0.z);
+                        success =
+                            spawner.spawn(entity_type, Vector3::new(fx, y, fz), yaw, mob_biome);
+                    }
+                }
+
+                x += random.next_bounded_i32(GROUP_SPREAD) - random.next_bounded_i32(GROUP_SPREAD);
+                z += random.next_bounded_i32(GROUP_SPREAD) - random.next_bounded_i32(GROUP_SPREAD);
+                while x < xo || x >= xo + 16 || z < zo || z >= zo + 16 {
+                    crate::generation::budget::tick();
+                    x = start_x + random.next_bounded_i32(GROUP_SPREAD)
+                        - random.next_bounded_i32(GROUP_SPREAD);
+                    z = start_z + random.next_bounded_i32(GROUP_SPREAD)
+                        - random.next_bounded_i32(GROUP_SPREAD);
+                }
+            }
+        }
+    }
+}
