+#[test]
+#[ignore = "diagnosis tool, needs PUMPKIN_TEST_PACKS and PUMPKIN_DIAG_STARTS"]
+fn diagnose_structure_starts() {
+    let (Ok(folder), Ok(list)) = (
+        std::env::var("PUMPKIN_TEST_PACKS"),
+        std::env::var("PUMPKIN_DIAG_STARTS"),
+    ) else {
+        return;
+    };
+    let mut report = String::new();
+    for entry in list.split(';').filter(|e| !e.is_empty()) {
+        let parts: Vec<&str> = entry.split(',').collect();
+        let (dimension, name) = (parts[0], parts[1]);
+        let (x, z): (i32, i32) = (parts[2].parse().unwrap(), parts[3].parse().unwrap());
+        let world_gen = dimension_world_gen(42069, dimension, Some(Path::new(&folder)));
+        let WorldGenerator::Noise(generator) = &*world_gen else {
