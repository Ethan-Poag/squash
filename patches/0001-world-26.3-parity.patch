+//! Terrain generation settings built from datapacks at runtime.
+
+use std::path::Path;
+use std::sync::{LazyLock, Mutex, PoisonError};
+
+use pumpkin_data::dimension::Dimension;
+use pumpkin_data::material_rule::MaterialRule;
+use pumpkin_data::noise_router::BaseNoiseRouters;
+use pumpkin_data::noise_settings::{GenerationShapeConfig, NoiseSettings};
+use pumpkin_data::{BlockState, chunk::ParameterPoint};
+use rustc_hash::FxHashMap;
+use serde_json::Value;
+use tracing::{info, warn};
+
+use super::biome_source::RuntimeMultiNoiseBiomeSupplier;
+use super::biome_source::climate_point;
+use super::biome_tree::build_tree;
+use super::carver::{CarverCache, biome_carvers};
+use super::density_function::{DfParser, build_base_routers, parse_router};
+use super::feature::{RuntimeFeatures, load_features};
+use super::material_rule::{RuleParser, block_state};
+use super::noise::NoiseTable;
+use super::spawns::biome_spawn_data;
+use super::{
+    BIOME, DIMENSION, DatapackSet, PARAMETER_LIST, Result, WORLDGEN_MODIFIER, normalize_id,
+};
+use crate::biome::end::TheEndBiomeSupplier;
+use crate::biome::{ActiveBiomeSupplier, RuntimeTreeBiomeSupplier};
+
+/// Everything about a dimension's terrain that a datapack can replace.
+pub struct RuntimeGeneration {
+    pub settings: &'static NoiseSettings,
+    pub router: &'static BaseNoiseRouters,
+    pub surface_rule: &'static MaterialRule,
+    pub biome_supplier: ActiveBiomeSupplier,
+    /// The feature lists of the biomes a pack defines. `None` keeps the vanilla ones.
+    pub features: Option<&'static RuntimeFeatures>,
+    /// Structure sets and structure biomes of the packs. `None` keeps the vanilla ones.
+    pub structures: Option<&'static super::structures::RuntimeStructures>,
+}
+
+/// Counts for the log line.
+struct Summary {
+    density_functions: usize,
+    noises: usize,
+    biomes: usize,
+}
+
+/// Names of the biomes `supplier` can produce, in the order its source lists them.
+fn source_biome_names(supplier: &ActiveBiomeSupplier) -> Vec<String> {
+    let ids: Vec<u8> = match supplier {
+        ActiveBiomeSupplier::Runtime(source) => {
+            let mut ids = Vec::new();
+            for id in source.biome_ids() {
+                if !ids.contains(&id) {
+                    ids.push(id);
+                }
+            }
+            ids
+        }
+        ActiveBiomeSupplier::RuntimeTree(source) => source.biome_ids().to_vec(),
+        ActiveBiomeSupplier::End(_) => TheEndBiomeSupplier::POSSIBLE_BIOMES
+            .iter()
+            .map(|biome| biome.id)
+            .collect(),
+        _ => Vec::new(),
+    };
+    ids.into_iter()
+        .filter_map(|id| {
+            crate::biome::unknown::unknown_name(id).or_else(|| {
+                pumpkin_data::chunk::Biome::from_id(id).map(|b| normalize_id(b.registry_id))
+            })
+        })
+        .collect()
+}
+
+fn leak<T>(value: T) -> &'static T {
+    Box::leak(Box::new(value))
+}
+
+/// Cell counts of vanilla noise settings that do not spell them out.
+const fn default_cell_sizes(settings_name: &str) -> (u8, u8) {
+    match settings_name.as_bytes() {
+        b"end" | b"floating_islands" => (2, 1),
+        _ => (1, 2),
+    }
+}
+
+fn state(settings: &Value, key: &str) -> Result<&'static BlockState> {
+    block_state(
+        settings
+            .get(key)
+            .ok_or_else(|| format!("noise settings have no {key}"))?,
+    )
+}
+
+/// The noise settings in `json`, with the generated height trimmed to `dimension`.
+pub fn noise_settings_from_json(
+    json: &Value,
+    settings_name: &str,
+    dimension: &Dimension,
+) -> Result<NoiseSettings> {
+    let noise = json
+        .get("noise")
+        .ok_or("noise settings have no noise shape")?;
+    let int = |key: &str| noise.get(key).and_then(Value::as_i64);
+    let (default_horizontal, default_vertical) = default_cell_sizes(settings_name);
+    let shape = GenerationShapeConfig {
+        min_y: i8::try_from(int("min_y").ok_or("noise has no min_y")?)
+            .map_err(|_| "noise min_y is out of range")?,
+        height: u16::try_from(int("height").ok_or("noise has no height")?)
+            .map_err(|_| "noise height is out of range")?,
+        size_horizontal: int("size_horizontal")
+            .filter(|v| *v != 0)
+            .and_then(|v| u8::try_from(v).ok())
+            .unwrap_or(default_horizontal),
+        size_vertical: int("size_vertical")
+            .filter(|v| *v != 0)
+            .and_then(|v| u8::try_from(v).ok())
+            .unwrap_or(default_vertical),
+    };
+    let trimmed = shape.trim_height(
+        dimension.min_y as i8,
+        (dimension.min_y + dimension.height) as u16,
+    );
+    if trimmed != shape {
+        info!(
+            "worldgen datapack: noise shape y {}..{} trimmed to the dimension's y {}..{}",
+            i32::from(shape.min_y),
+            shape.max_y(),
+            i32::from(trimmed.min_y),
+            trimmed.max_y()
+        );
+    }
+    let aquifers_enabled = json.get("aquifers").is_some()
+        || json
+            .get("aquifers_enabled")
+            .and_then(Value::as_bool)
+            .unwrap_or(false);
+    Ok(NoiseSettings {
+        aquifers_enabled,
+        ore_veins_enabled: json
+            .get("ore_veins_enabled")
+            .and_then(Value::as_bool)
+            .unwrap_or(aquifers_enabled),
+        legacy_random_source: json
+            .get("legacy_random_source")
+            .and_then(Value::as_bool)
+            .unwrap_or(false),
+        sea_level: json
+            .get("sea_level")
+            .and_then(Value::as_i64)
+            .and_then(|v| i32::try_from(v).ok())
+            .ok_or("noise settings have no sea_level")?,
+        default_fluid: state(json, "default_fluid")?,
+        shape: trimmed,
+        default_block: state(json, "default_block")?,
+        spawn_target: spawn_target_from_json(json.get("spawn_target")),
+    })
+}
+
+/// Spawn targets in the structured form. Anything else, such as the keyed-by-noise-name form,
+/// yields no targets, so the world spawns at the origin.
+fn spawn_target_from_json(value: Option<&Value>) -> &'static [ParameterPoint] {
+    use super::biome_source::climate_point;
+    let Some(list) = value.and_then(Value::as_array) else {
+        return &[];
+    };
+    list.iter()
+        .map(climate_point)
+        .collect::<Result<Vec<_>>>()
+        .map_or(&[], |points| Box::leak(points.into_boxed_slice()))
+}
+
+/// Noise settings, router and surface rule built from one noise settings file.
+pub struct Terrain {
+    pub settings: &'static NoiseSettings,
+    pub router: &'static BaseNoiseRouters,
+    pub surface_rule: &'static MaterialRule,
+    pub density_functions: usize,
+    pub noises: usize,
+}
+
+/// Builds the terrain described by the noise settings `json`, resolving references through `set`.
+pub fn build_terrain(
+    set: &DatapackSet,
+    json: &Value,
+    settings_id: &str,
+    dimension: &Dimension,
+) -> Result<Terrain> {
+    let settings_name = settings_id
+        .strip_prefix("minecraft:")
+        .unwrap_or(settings_id);
+    let mut noises = NoiseTable::new(set);
+    let settings = leak(noise_settings_from_json(json, settings_name, dimension)?);
+    let mut parser = DfParser::new(set);
+    let roots = parse_router(&mut parser, json, settings_name)?;
+    let density_functions = parser.resolved_count();
+    let router = leak(build_base_routers(roots, &mut noises)?);
+    let rule = json
+        .get("material_rule")
+        .or_else(|| json.get("surface_rule"))
+        .ok_or("noise settings have no material_rule")?;
+    let surface_rule = leak(RuleParser::new(set, &mut noises).parse_rule(rule)?);
+    Ok(Terrain {
+        settings,
+        router,
+        surface_rule,
+        density_functions,
+        noises: noises.len(),
+    })
+}
+
+/// Hands the carvers and spawners of a pack biome to the registry before its name is first used.
+/// A biome Pumpkin has data for keeps its own.
+fn register_pack_biome(set: &DatapackSet, carver_cache: &mut CarverCache, name: &str) {
+    if pumpkin_data::chunk::Biome::from_name(name.strip_prefix("minecraft:").unwrap_or(name))
+        .is_some()
+    {
+        return;
+    }
+    let Some(json) = set.pack_json(BIOME, name) else {
+        return;
+    };
+    if let Some(carvers) = biome_carvers(set, carver_cache, json) {
+        crate::biome::unknown::set_carvers(name, carvers);
+    }
+    crate::biome::unknown::set_spawn_data(name, biome_spawn_data(json));
+}
+
+/// The biome list of the parameter list `preset`, when a pack replaces it: Lithostitched's
+/// `lithostitched:biomes` (which replaces the preset's list), else an inline `biomes` list.
+fn parameter_list_supplier(set: &DatapackSet, preset: &str) -> Result<Option<ActiveBiomeSupplier>> {
+    let Some(list) = set.pack_json(PARAMETER_LIST, preset) else {
+        return Ok(None);
+    };
+    let Some(entries) = list
+        .get("lithostitched:biomes")
+        .or_else(|| list.get("biomes"))
+        .and_then(Value::as_array)
+    else {
+        return Ok(None);
+    };
+    let mut parsed = Vec::with_capacity(entries.len());
+    let mut carver_cache = CarverCache::default();
+    let mut seen = rustc_hash::FxHashSet::default();
+    for entry in entries {
+        let name = entry
+            .get("biome")
+            .and_then(Value::as_str)
+            .ok_or("biome entry has no biome")?;
+        let point = climate_point(
+            entry
+                .get("parameters")
+                .ok_or("biome entry has no parameters")?,
+        )?;
+        if seen.insert(name) {
+            register_pack_biome(set, &mut carver_cache, name);
+        }
+        parsed.push((point, crate::biome::unknown::biome_for_name(name)));
+    }
+    let tree = build_tree(&parsed)?;
+    Ok(Some(ActiveBiomeSupplier::RuntimeTree(leak(
+        RuntimeTreeBiomeSupplier::new(tree),
+    ))))
+}
+
+/// Whether a Lithostitched modifier predicate holds. Only Tectonic's config predicate is known.
+fn predicate_holds(set: &DatapackSet, predicate: &Value) -> Option<bool> {
+    let kind = predicate.get("type").and_then(Value::as_str)?;
+    match kind {
+        "tectonic:config" => predicate
+            .get("key")
+            .and_then(Value::as_str)
+            .map(|key| set.config().tectonic_test(key)),
+        _ => None,
+    }
+}
+
+/// Logs the Lithostitched worldgen modifiers that apply and that terrain generation does not
+/// apply. Tectonic's height limits, `remove_islands` and `remove_frozen_ocean_ice` do nothing with
+/// the default config, which is the case this supports.
+fn report_modifiers(set: &DatapackSet) {
+    let mut ignored: std::collections::BTreeMap<String, usize> = std::collections::BTreeMap::new();
+    for id in set.pack_ids(WORLDGEN_MODIFIER) {
+        let Some(json) = set.pack_json(WORLDGEN_MODIFIER, id) else {
+            continue;
+        };
+        let kind = json
+            .get("type")
+            .and_then(Value::as_str)
+            .unwrap_or("unknown");
+        match json.get("predicate").map(|p| predicate_holds(set, p)) {
+            Some(Some(false)) => continue,
+            Some(None) => {
+                warn!(
+                    "worldgen datapack: modifier {id} has a predicate that is not supported, skipped"
+                );
+                continue;
+            }
+            Some(Some(true)) | None => {}
+        }
+        if kind == "tectonic:set_height_limits" {
+            let config = set.config();
+            if config.tectonic_value("min_y") as i32 != -64
+                || config.tectonic_value("max_y") as i32 != 320
+            {
+                warn!(
+                    "worldgen datapack: tectonic height limits other than -64..320 are not supported"
+                );
+            }
+            continue;
+        }
+        *ignored.entry(kind.to_string()).or_default() += 1;
+    }
+    for (kind, count) in ignored {
+        if kind == "lithostitched:wrap_density_function" || kind == "lithostitched:set_pool_aliases"
+        {
+            warn!("worldgen datapack: {count} {kind} modifier(s) apply but are not supported");
+        } else {
+            info!(
+                "worldgen datapack: {count} {kind} modifier(s) are not applied by terrain generation"
+            );
+        }
+    }
+}
+
+/// Whether a pack replaces anything the overworld generator reads that is not its noise settings.
+fn overrides_overworld_terrain(set: &DatapackSet) -> bool {
+    ["density_function", "material_rule", "material_condition"]
+        .iter()
+        .any(|registry| {
+            set.pack_ids(registry)
+                .iter()
+                .any(|id| id.starts_with("minecraft:overworld"))
+        })
+}
+
+/// Builds the pieces of a dimension that datapacks override: noise settings with router and surface
+/// rule, and the biome source. Pieces no pack provides stay vanilla.
+#[expect(clippy::too_many_lines)]
+fn build(
+    set: &DatapackSet,
+    dimension: &Dimension,
+    default_settings: &str,
+) -> Result<Option<(RuntimeGeneration, Summary, String)>> {
+    let dimension_json = set.pack_json(DIMENSION, dimension.minecraft_name);
+    let generator = dimension_json.and_then(|d| d.get("generator"));
+    let settings_id = generator
+        .and_then(|g| g.get("settings"))
+        .and_then(Value::as_str)
+        .map_or_else(|| normalize_id(default_settings), normalize_id);
+    let is_overworld = dimension == &Dimension::OVERWORLD;
+    let settings_json = if set.pack_json("noise_settings", &settings_id).is_some()
+        || (is_overworld && overrides_overworld_terrain(set))
+    {
+        set.json("noise_settings", &settings_id)
+    } else {
+        None
+    };
+    let biome_source = generator.and_then(|g| g.get("biome_source"));
+
+    // The multi-noise source named by a dimension's biome source, or the dimension's default one.
+    let mut biomes = 0;
+    let mut biome_supplier = None;
+    let preset = match biome_source {
+        Some(source) => {
+            let source_type = source
+                .get("type")
+                .and_then(Value::as_str)
+                .unwrap_or_default();
+            match source_type
+                .strip_prefix("minecraft:")
+                .unwrap_or(source_type)
+            {
+                "multi_noise" if source.get("biomes").is_some() => {
+                    let mut carver_cache = CarverCache::default();
+                    for name in source
+                        .get("biomes")
+                        .and_then(Value::as_array)
+                        .into_iter()
+                        .flatten()
+                        .filter_map(|entry| entry.get("biome")?.as_str())
+                    {
+                        register_pack_biome(set, &mut carver_cache, name);
+                    }
+                    // Vanilla searches inline lists with the same R-tree as parameter lists; a
+                    // linear search breaks the many exact ties of packs like Incendium differently.
+                    let supplier = RuntimeMultiNoiseBiomeSupplier::from_json(source)?;
+                    let tree = RuntimeTreeBiomeSupplier::new(build_tree(supplier.entries())?);
+                    biomes = tree.biome_ids().len();
+                    biome_supplier = Some(ActiveBiomeSupplier::RuntimeTree(leak(tree)));
+                    None
+                }
+                "multi_noise" => source.get("preset").and_then(Value::as_str),
+                "the_end" => {
+                    biome_supplier = Some(ActiveBiomeSupplier::End(TheEndBiomeSupplier));
+                    None
+                }
+                other => return Err(format!("unsupported biome source {other}")),
+            }
+        }
+        None if is_overworld => Some("minecraft:overworld"),
+        None => None,
+    };
+    if let Some(preset) = preset {
+        biome_supplier = parameter_list_supplier(set, preset)?;
+        if let Some(ActiveBiomeSupplier::RuntimeTree(tree)) = biome_supplier {
+            biomes = tree.biome_ids().len();
+        }
+    }
+
+    if settings_json.is_none() && biome_supplier.is_none() {
+        return Ok(None);
+    }
+    if is_overworld {
+        report_modifiers(set);
+    }
+    let pack = settings_json
+        .as_ref()
+        .and_then(|_| set.pack_name("noise_settings", &settings_id))
+        .or_else(|| preset.and_then(|preset| set.pack_name(PARAMETER_LIST, preset)))
+        .or_else(|| set.pack_name(DIMENSION, dimension.minecraft_name))
+        .unwrap_or("datapack")
+        .to_string();
+
+    let mut density_functions = 0;
+    let mut noise_count = 0;
+
+    let (settings, router, surface_rule) = if let Some(json) = &settings_json {
+        let terrain = build_terrain(set, json, &settings_id, dimension)?;
+        density_functions = terrain.density_functions;
+        noise_count = terrain.noises;
+        (terrain.settings, terrain.router, terrain.surface_rule)
+    } else {
+        (
+            NoiseSettings::from_name(&settings_id)
+                .ok_or_else(|| format!("unknown noise settings {settings_id}"))?,
+            BaseNoiseRouters::from_name(&settings_id)
+                .ok_or_else(|| format!("unknown noise settings {settings_id}"))?,
+            MaterialRule::from_name(&settings_id)
+                .ok_or_else(|| format!("unknown noise settings {settings_id}"))?,
+        )
+    };
+    let biome_supplier =
+        biome_supplier.unwrap_or_else(|| ActiveBiomeSupplier::from_dimension(dimension));
+
+    let features = load_features(set, &source_biome_names(&biome_supplier)).map(|features| {
+        info!(
+            "worldgen datapack: {} placed features loaded, {} unsupported types",
+            features.loaded(),
+            features.unsupported().len()
+        );
+        for (id, feature) in features.pool_features() {
+            crate::generation::structure::structures::jigsaw::register_pack_feature(id, feature);
+        }
+        leak(features)
+    });
+
+    // Structure sets are shared by every dimension; each dimension keeps the ones whose biomes it has.
+    let structures = super::structures::load_structures(set);
+
+    Ok(Some((
+        RuntimeGeneration {
+            settings,
+            router,
+            surface_rule,
+            biome_supplier,
+            features,
+            structures,
+        },
+        Summary {
+            density_functions,
+            noises: noise_count,
+            biomes,
+        },
+        pack,
+    )))
+}
+
+static CACHE: LazyLock<Mutex<FxHashMap<String, &'static RuntimeGeneration>>> =
+    LazyLock::new(|| Mutex::new(FxHashMap::default()));
+
+/// Loads the datapacks of `world_dir` and returns the terrain they define for `dimension`.
+///
+/// Returns `None` when no pack overrides it or the packs cannot be used. Results live for the
+/// rest of the process, and each distinct set of packs is built once.
+#[must_use]
+pub fn load_dimension_generation(
+    world_dir: &Path,
+    dimension: &Dimension,
+    default_settings: &str,
+) -> Option<&'static RuntimeGeneration> {
+    let set = DatapackSet::load(world_dir)?;
+    generation_for_set(&set, dimension, default_settings)
+}
+
+/// [`load_dimension_generation`] for packs that are already read.
+#[must_use]
+pub fn generation_for_set(
+    set: &DatapackSet,
+    dimension: &Dimension,
+    default_settings: &str,
+) -> Option<&'static RuntimeGeneration> {
+    let key = format!("{}|{}", dimension.minecraft_name, set.fingerprint());
+    if let Some(found) = CACHE
+        .lock()
+        .unwrap_or_else(PoisonError::into_inner)
+        .get(&key)
+    {
+        return Some(found);
+    }
+    match build(set, dimension, default_settings) {
+        Ok(Some((generation, summary, pack))) => {
+            info!(
+                "worldgen datapack: {} from {pack} ({} density functions, {} noises, {} biomes)",
+                dimension
+                    .minecraft_name
+                    .strip_prefix("minecraft:")
+                    .unwrap_or(dimension.minecraft_name),
+                summary.density_functions,
+                summary.noises,
+                summary.biomes
+            );
+            let generation = leak(generation);
+            CACHE
+                .lock()
+                .unwrap_or_else(PoisonError::into_inner)
+                .insert(key, generation);
+            Some(generation)
+        }
+        Ok(None) => None,
+        Err(err) => {
+            warn!(
+                "worldgen datapack: {} falls back to vanilla: {err}",
+                dimension.minecraft_name
+            );
+            None
+        }
+    }
+}
