+/// Obsidian pillars of a Fabric 26.3 End generated with seed 42069 (s5/fabric-ref, measured
+/// from its region files): (centre x, centre z, bedrock y = spike height, guarded).
+const FABRIC_42069_SPIKES: [(i32, i32, i32, bool); 10] = [
+    (-42, -1, 97, false),
+    (-34, -25, 88, false),
+    (-34, 24, 103, false),
+    (-13, -40, 79, true),
+    (-13, 39, 82, true),
+    (12, -40, 91, false),
+    (12, 39, 100, false),
+    (33, -25, 94, false),
+    (33, 24, 76, false),
+    (42, 0, 85, false),
+];
+
+#[test]
+fn end_spikes_follow_the_world_seed_like_vanilla() {
+    use crate::generation::feature::features::end_spike::EndSpikeFeature;
+    let mut spikes = EndSpikeFeature::get_spikes_for_seed(42069).to_vec();
+    spikes.sort_by_key(|s| (s.center_x, s.center_z));
+    let layout: Vec<_> = spikes
+        .iter()
+        .map(|s| (s.center_x, s.center_z, s.height, s.guarded))
+        .collect();
+    assert_eq!(layout, FABRIC_42069_SPIKES.to_vec());
+
+    // And world generation actually places them that way (it used seed 0 before).
+    let world_gen = get_world_gen_with_all_settings(
+        Seed(42069),
+        Dimension::THE_END,
+        false,
+        Vec::new(),
+        String::new(),
+        Some("minecraft:end"),
+        None,
+        None,
+        None,
+    );
+    let mut world = FeatureWorld::new(&world_gen, true);
+    for (x, z, height, guarded) in FABRIC_42069_SPIKES {
+        let chunk = world.chunk(x >> 4, z >> 4);
+        let name =
+            |y: i32| block_state_name(chunk.get_block_state(&Vector3::new(x & 15, y, z & 15)));
+        assert_eq!(name(height), "minecraft:bedrock", "spike at {x},{z}");
+        assert_eq!(name(height - 1), "minecraft:obsidian", "spike at {x},{z}");
+        let bars = name(height + 3).starts_with("minecraft:iron_bars");
+        assert_eq!(bars, guarded, "cage on spike at {x},{z}");
+
+        // Every pillar carries an end crystal on its bedrock.
+        let crystal_on_top = chunk.pending_structure_entities().iter().any(|nbt| {
+            let pos = nbt.get_list("Pos").map(|pos| {
+                pos.iter()
+                    .filter_map(pumpkin_nbt::tag::NbtTag::extract_double)
+                    .collect::<Vec<_>>()
+            });
+            nbt.get_string("id") == Some("minecraft:end_crystal")
+                && pos
+                    == Some(vec![
+                        f64::from(x) + 0.5,
+                        f64::from(height + 1),
+                        f64::from(z) + 0.5,
+                    ])
+        });
+        assert!(crystal_on_top, "end crystal on spike at {x},{z}");
+    }
+}
