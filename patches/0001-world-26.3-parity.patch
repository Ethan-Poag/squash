@@ -0,0 +1,136 @@
+use std::collections::HashSet;
+
+use pumpkin_data::{Block, BlockDirection};
+use pumpkin_util::{
+    math::position::BlockPos,
+    random::{RandomGenerator, RandomImpl},
+};
+
+use super::{
+    block_state, grow_speleothem, is_base, is_empty_or_water, place_base_block_if_possible,
+};
+use crate::generation::feature::features::spring_feature::BlockWrapper;
+use crate::generation::proto_chunk::GenerationCache;
+
+/// Vanilla `SpeleothemFeature` (`minecraft:speleothem`, formerly `pointed_dripstone`).
+pub struct SpeleothemFeature {
+    pub base_block: &'static Block,
+    pub pointed_block: &'static Block,
+    replaceable_blocks: HashSet<u16>,
+    pub chance_of_taller_generation: f32,
+    pub chance_of_directional_spread: f32,
+    pub chance_of_spread_radius2: f32,
+    pub chance_of_spread_radius3: f32,
+}
+
+impl SpeleothemFeature {
+    #[must_use]
+    pub fn new(
+        base_block: &'static Block,
+        pointed_block: &'static Block,
+        replaceable_blocks: &BlockWrapper,
+        chance_of_taller_generation: f32,
+        chance_of_directional_spread: f32,
+        chance_of_spread_radius2: f32,
+        chance_of_spread_radius3: f32,
+    ) -> Self {
+        Self {
+            base_block,
+            pointed_block,
+            replaceable_blocks: replaceable_blocks.block_ids(),
+            chance_of_taller_generation,
+            chance_of_directional_spread,
+            chance_of_spread_radius2,
+            chance_of_spread_radius3,
+        }
+    }
+
+    pub fn generate<T: GenerationCache>(
+        &self,
+        chunk: &mut T,
+        random: &mut RandomGenerator,
+        origin: BlockPos,
+    ) -> bool {
+        let Some(tip_direction) = self.get_tip_direction(chunk, origin, random) else {
+            return false;
+        };
+        let root_pos = origin.offset(tip_direction.opposite().to_offset());
+        self.create_patch_of_base_blocks(chunk, random, root_pos);
+        let height = if random.next_f32() < self.chance_of_taller_generation
+            && is_empty_or_water(chunk, origin.offset(tip_direction.to_offset()))
+        {
+            2
+        } else {
+            1
+        };
+        grow_speleothem(
+            chunk,
+            origin,
+            tip_direction,
+            height,
+            false,
+            self.base_block,
+            self.pointed_block,
+            &self.replaceable_blocks,
+        );
+        true
+    }
+
+    fn get_tip_direction<T: GenerationCache>(
+        &self,
+        chunk: &T,
+        pos: BlockPos,
+        random: &mut RandomGenerator,
+    ) -> Option<BlockDirection> {
+        let can_place_above = is_base(
+            block_state(chunk, pos.up()),
+            self.base_block,
+            &self.replaceable_blocks,
+        );
+        let can_place_below = is_base(
+            block_state(chunk, pos.down()),
+            self.base_block,
+            &self.replaceable_blocks,
+        );
+        match (can_place_above, can_place_below) {
+            (true, true) => Some(if random.next_bool() {
+                BlockDirection::Down
+            } else {
+                BlockDirection::Up
+            }),
+            (true, false) => Some(BlockDirection::Down),
+            (false, true) => Some(BlockDirection::Up),
+            (false, false) => None,
+        }
+    }
+
+    fn place_base<T: GenerationCache>(&self, chunk: &mut T, pos: BlockPos) {
+        place_base_block_if_possible(chunk, pos, self.base_block, &self.replaceable_blocks);
+    }
+
+    fn create_patch_of_base_blocks<T: GenerationCache>(
+        &self,
+        chunk: &mut T,
+        random: &mut RandomGenerator,
+        pos: BlockPos,
+    ) {
+        self.place_base(chunk, pos);
+        for direction in BlockDirection::horizontal_worldgen() {
+            if random.next_f32() > self.chance_of_directional_spread {
+                continue;
+            }
+            let pos1 = pos.offset(direction.to_offset());
+            self.place_base(chunk, pos1);
+            if random.next_f32() > self.chance_of_spread_radius2 {
+                continue;
+            }
+            let pos2 = pos1.offset(BlockDirection::random(random).to_offset());
+            self.place_base(chunk, pos2);
+            if random.next_f32() > self.chance_of_spread_radius3 {
+                continue;
+            }
+            let pos3 = pos2.offset(BlockDirection::random(random).to_offset());
