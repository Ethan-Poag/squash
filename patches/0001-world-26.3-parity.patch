+/// Loads the loot tables and predicates of the jar/zip packs in `datapacks_dir`, like the
+/// worldgen loader reads their structures, so containers placed by those packs can resolve them.
+fn load_archive_packs(datapacks_dir: &Path, acc: &mut PackContentAccumulators<'_>) {
+    use pumpkin_world::generation::datapack::archive_resources;
+
+    let resources = archive_resources(datapacks_dir);
+    let mut predicates: HashMap<String, serde_json::Value> = HashMap::new();
+    for resource in resources.iter().filter(|r| r.kind == "predicate") {
+        if let Ok(value) = serde_json::from_str(resource.json.trim_start_matches('\u{feff}')) {
+            predicates.insert(resource.id.clone(), value);
+        }
+    }
+    let (mut loaded, mut failed) = (0, 0);
+    for resource in resources.iter().filter(|r| r.kind == "loot_table") {
+        let parsed = pumpkin_util::loot_table::parser::parse_loot_table_with_predicates(
+            resource.json.trim_start_matches('\u{feff}'),
+            &|name| {
+                let id = if name.contains(':') {
+                    name.to_string()
+                } else {
+                    format!("minecraft:{name}")
+                };
+                predicates
+                    .get(&id)
+                    .cloned()
+                    .or_else(|| pumpkin_data::loot_table::get_loot_predicate(&id).cloned())
+            },
+        );
+        match parsed {
+            Some(table) => {
+                acc.loot_tables
+                    .insert(resource.id.clone(), Arc::new(table));
+                loaded += 1;
+            }
+            None => {
+                failed += 1;
+                debug!("Failed to parse loot table {}", resource.id);
+            }
+        }
+    }
+    acc.predicates.extend(predicates);
+    if loaded > 0 {
+        info!("Loaded {loaded} loot table(s) from datapack archives ({failed} failed to parse)");
+    }
+}
