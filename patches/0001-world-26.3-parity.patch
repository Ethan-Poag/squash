--- /dev/null
+++ b/crates/pumpkin-world/src/generation/proto_chunk_test/seam.rs
@@ -0,0 +1,269 @@
+//! Env-gated measurement of the old/new terrain seam. See `seam_measurement`.
+#![allow(clippy::print_stdout)]
+
+use std::{collections::BTreeMap, fs, io::Write, path::Path};
+
+use pumpkin_config::chunk::ChunkConfig;
+use pumpkin_data::{Block, BlockState, BlockStateId, dimension::Dimension};
+use pumpkin_util::world_seed::Seed;
+use rayon::prelude::*;
+
+use super::surface_biomes;
+use crate::{
+    chunk::format::anvil::AnvilRegion,
+    chunk_system::chunk_state::StagedChunkEnum,
+    generation::{
+        blender::region_source::{RegionBlendingSource, is_ground},
+        generator::{VanillaGenerator, WorldGenerator},
+        get_world_gen,
+        proto_chunk::ProtoChunk,
+    },
+};
+
+const SEED: u64 = 42069;
+const MIN_Y: i32 = -64;
+const HEIGHT: usize = 384;
+
+struct Generated {
+    chunk_x: i32,
+    chunk_z: i32,
+    /// Block state ids, y outer, then z, then x.
+    blocks: Vec<u16>,
+    /// Biome ids, quart y outer, then z, then x.
+    biomes: Vec<u16>,
+}
+
+fn generate(world_gen: &WorldGenerator, chunk_x: i32, chunk_z: i32) -> Generated {
+    let WorldGenerator::Noise(generator) = world_gen else {
+        unreachable!()
+    };
+    let mut chunk = ProtoChunk::new(chunk_x, chunk_z, world_gen);
+    chunk.step_to_biomes(generator);
+    chunk.stage = StagedChunkEnum::StructureReferences;
+    chunk.step_to_noise(generator);
+    let neighborhood = surface_biomes(world_gen, chunk_x, chunk_z);
+    chunk.step_to_surface(generator, &neighborhood);
+
+    let mut blocks = Vec::with_capacity(16 * 16 * HEIGHT);
+    for y in 0..HEIGHT as i32 {
+        for z in 0..16 {
+            for x in 0..16 {
+                blocks.push(chunk.get_block_state_raw(x, y, z).as_u16());
+            }
+        }
+    }
+    let mut biomes = Vec::with_capacity(4 * 4 * HEIGHT / 4);
+    for qy in 0..(HEIGHT as i32 / 4) {
+        for qz in 0..4 {
+            for qx in 0..4 {
+                let id = chunk.get_biome(chunk_x * 4 + qx, MIN_Y / 4 + qy, chunk_z * 4 + qz);
+                biomes.push(u16::from(id.id));
+            }
+        }
+    }
+    Generated {
+        chunk_x,
+        chunk_z,
+        blocks,
+        biomes,
+    }
+}
+
+fn state_key(id: u16) -> String {
+    let id = BlockStateId::new_or_air(id);
+    let block = Block::from_state_id(id);
+    let mut name = format!("minecraft:{}", block.name);
+    if let Some(properties) = block.properties(id) {
+        let mut props: Vec<String> = properties
+            .to_props()
+            .iter()
+            .map(|p| format!("{}={}", p.key_str(), p.value_str()))
+            .collect();
+        props.sort();
+        if !props.is_empty() {
+            name = format!("{name}[{}]", props.join(","));
+        }
+    }
+    name
+}
+
+fn write_bin(path: &Path, chunk: &Generated) {
+    let mut ids: BTreeMap<u16, u16> = BTreeMap::new();
+    for &b in &chunk.blocks {
+        let next = ids.len() as u16;
+        ids.entry(b).or_insert(next);
+    }
+    let mut out = Vec::new();
+    out.extend_from_slice(b"PKD1");
+    out.extend_from_slice(&(ids.len() as u16).to_le_bytes());
+    let mut ordered: Vec<(u16, u16)> = ids.iter().map(|(&k, &v)| (v, k)).collect();
+    ordered.sort_unstable();
+    for (_, state) in &ordered {
+        let key = state_key(*state);
+        out.extend_from_slice(&(key.len() as u16).to_le_bytes());
+        out.extend_from_slice(key.as_bytes());
+    }
+    for b in &chunk.blocks {
+        out.extend_from_slice(&ids[b].to_le_bytes());
+    }
+    let mut biome_ids: BTreeMap<u16, u16> = BTreeMap::new();
+    for &b in &chunk.biomes {
+        let next = biome_ids.len() as u16;
+        biome_ids.entry(b).or_insert(next);
+    }
+    out.extend_from_slice(&(biome_ids.len() as u16).to_le_bytes());
+    let mut ordered: Vec<(u16, u16)> = biome_ids.iter().map(|(&k, &v)| (v, k)).collect();
+    ordered.sort_unstable();
+    for (_, id) in &ordered {
+        let name = pumpkin_data::chunk::Biome::from_id(*id as u8)
+            .map_or("minecraft:plains".to_string(), |b| {
+                format!("minecraft:{}", b.registry_id)
+            });
+        out.extend_from_slice(&(name.len() as u16).to_le_bytes());
+        out.extend_from_slice(name.as_bytes());
+    }
+    for b in &chunk.biomes {
+        out.extend_from_slice(&biome_ids[b].to_le_bytes());
+    }
+    fs::File::create(path)
+        .and_then(|mut f| f.write_all(&out))
+        .expect("write bin");
+}
+
+/// Surface height of a column of generated blocks, with the same ground rule as the blender.
+fn column_height(chunk: &Generated, x: usize, z: usize) -> Option<i32> {
+    (0..HEIGHT).rev().find_map(|y| {
+        let id = chunk.blocks[(y * 16 + z) * 16 + x];
+        is_ground(BlockState::from_id(BlockStateId::new_or_air(id))).then_some(y as i32 + MIN_Y + 1)
+    })
+}
+
+/// Generates strips beside the old area with and without blending, writes the chunks and prints
+/// the mean |height step| across the border. Run with
+/// `PUMPKIN_SEAM_WORLD=<copy of the world> PUMPKIN_SEAM_OUT=<dir> cargo test --release -p
+/// pumpkin-world --lib seam_measurement -- --ignored --nocapture`.
+#[test]
+#[expect(clippy::too_many_lines)]
+#[ignore = "needs PUMPKIN_SEAM_WORLD (copy of the old world) and PUMPKIN_SEAM_OUT"]
+fn seam_measurement() {
+    let (Ok(world), Ok(out)) = (
+        std::env::var("PUMPKIN_SEAM_WORLD"),
+        std::env::var("PUMPKIN_SEAM_OUT"),
+    ) else {
+        return;
+    };
+    let region_folder = Path::new(&world).join("region");
+    let out = Path::new(&out);
+
+    // East strip is continued along +x, south strip along +z.
+    let mut positions: Vec<(i32, i32, bool)> = Vec::new();
+    for cx in 32..40 {
+        for cz in -16..16 {
+            positions.push((cx, cz, true));
+        }
+    }
+    for cz in 32..40 {
+        for cx in -16..16 {
+            positions.push((cx, cz, false));
+        }
+    }
+
+    let source = RegionBlendingSource::<AnvilRegion>::new(region_folder.clone());
+    let mut results: BTreeMap<&str, Vec<(Generated, bool)>> = BTreeMap::new();
+    for mode in ["blend", "noblend"] {
+        let world_gen = get_world_gen(
+            Seed(SEED),
+            Dimension::OVERWORLD,
+            false,
+            Vec::new(),
+            String::new(),
+        );
+        if mode == "blend" {
+            let WorldGenerator::Noise(generator) = &*world_gen else {
+                unreachable!()
+            };
+            let generator: &VanillaGenerator = generator;
+            generator.enable_blending(
+                &ChunkConfig::Anvil(pumpkin_config::chunk::AnvilChunkConfig::default()),
+                region_folder.clone(),
+            );
+        }
+        let dir = out.join(mode);
+        fs::create_dir_all(&dir).expect("create out dir");
+        let generated: Vec<(Generated, bool)> = positions
+            .par_iter()
+            .map(|&(cx, cz, east)| {
+                let chunk = generate(&world_gen, cx, cz);
+                write_bin(&dir.join(format!("c.{cx}.{cz}.bin")), &chunk);
+                (chunk, east)
+            })
+            .collect();
+        results.insert(mode, generated);
+    }
+
+    // Old border column heights, computed with the same ground rule from the old chunks.
+    let old_height = |chunk_x: i32, chunk_z: i32, x: usize, z: usize| -> Option<i32> {
+        let data = source.read_chunk_data(chunk_x, chunk_z)?;
+        (MIN_Y..MIN_Y + HEIGHT as i32).rev().find_map(|y| {
+            let id = data.section.get_block_absolute_y(x, y, z)?;
+            is_ground(BlockState::from_id(id)).then_some(y + 1)
+        })
+    };
+
+    let distances = [0usize, 4, 8, 16, 32];
+    for mode in ["noblend", "blend"] {
+        let mut sums = vec![(0.0f64, 0u32); distances.len()];
+        for (chunk, east) in &results[mode] {
+            // The chunk touching the old area: first row of chunks of its strip.
+            let touches = if *east {
+                chunk.chunk_x == 32
+            } else {
+                chunk.chunk_z == 32
+            };
+            if !touches {
+                continue;
+            }
+            for along in 0..16usize {
+                let (old_cx, old_cz, ox, oz) = if *east {
+                    (31, chunk.chunk_z, 15, along)
+                } else {
+                    (chunk.chunk_x, 31, along, 15)
+                };
+                let Some(old_h) = old_height(old_cx, old_cz, ox, oz) else {
+                    continue;
+                };
+                for (i, &d) in distances.iter().enumerate() {
+                    let (cx, cz) = if *east {
+                        (chunk.chunk_x + (d / 16) as i32, chunk.chunk_z)
+                    } else {
+                        (chunk.chunk_x, chunk.chunk_z + (d / 16) as i32)
+                    };
+                    let Some((target, _)) = results[mode]
+                        .iter()
+                        .find(|(c, _)| c.chunk_x == cx && c.chunk_z == cz)
+                    else {
+                        continue;
+                    };
+                    let (x, z) = if *east {
+                        (d % 16, along)
+                    } else {
+                        (along, d % 16)
+                    };
+                    if let Some(h) = column_height(target, x, z) {
+                        sums[i].0 += f64::from((h - old_h).abs());
+                        sums[i].1 += 1;
+                    }
+                }
+            }
+        }
+        let line: Vec<String> = distances
+            .iter()
+            .zip(&sums)
+            .map(|(d, (sum, n))| format!("{d}b: {:.2} (n={n})", sum / f64::from((*n).max(1))))
+            .collect();
+        println!(
+            "seam mean |h(new) - h(old border col)| {mode}: {}",
+            line.join("  ")
+        );
+    }
+}
