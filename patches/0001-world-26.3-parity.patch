+/// Default block entities for every generated block that has one in vanilla; the ones a feature
+/// or template already made win. Covers blocks that got none from what placed them (sculk sensors, catalysts and shriekers from `sculk_patch`, bells,
+/// beds, ...), the default one vanilla saves for it, so it works once the chunk is loaded
+/// (a shrieker without one never summons a warden).
+fn default_block_entities(
+    proto_chunk: &ProtoChunk,
+) -> Vec<(pumpkin_util::math::position::BlockPos, NbtCompound)> {
+    let mut records = Vec::new();
+    let bottom_y = i32::from(proto_chunk.bottom_y());
+    let height = i32::from(proto_chunk.height());
+    let base_x = proto_chunk.x * 16;
+    let base_z = proto_chunk.z * 16;
+    for y in 0..height {
+        for x in 0..16 {
+            for z in 0..16 {
+                let state_id = proto_chunk.get_block_state_raw(x, y, z);
+                if state_id == BlockStateId::AIR {
+                    continue;
+                }
+                let state = pumpkin_data::BlockState::from_id(state_id);
+                if state.block_entity_type == u16::MAX {
+                    continue;
+                }
+                let Some(name) = pumpkin_data::block_properties::BLOCK_ENTITY_TYPES
+                    .get(state.block_entity_type as usize)
+                else {
+                    continue;
+                };
+                // Jigsaws are replaced by their final state; a moving piston only exists mid-push.
+                if matches!(*name, "jigsaw" | "piston") {
+                    continue;
+                }
+                let pos = pumpkin_util::math::position::BlockPos::new(
+                    base_x + x,
+                    bottom_y + y,
+                    base_z + z,
+                );
+                let mut nbt = NbtCompound::new();
+                nbt.put_string("id", format!("minecraft:{name}"));
+                nbt.put_int("x", pos.0.x);
+                nbt.put_int("y", pos.0.y);
+                nbt.put_int("z", pos.0.z);
+                records.push((pos, nbt));
+            }
+        }
+    }
+    records
+}
