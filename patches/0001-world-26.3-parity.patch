diff --git a/crates/pumpkin-world/tests/chunk_extra_keys_26_3.rs b/crates/pumpkin-world/tests/chunk_extra_keys_26_3.rs
new file mode 100644
index 0000000..bdf7378
--- /dev/null
+++ b/crates/pumpkin-world/tests/chunk_extra_keys_26_3.rs
@@ -0,0 +1,130 @@
+//! Pumpkin used to drop every top-level chunk key it does not model when it
+//! saved a chunk: `structures` (starts/references), `PostProcessing`,
+//! `blending_data`, `LastUpdate`, mod keys like `tectonic:blending_version`.
+//! This loads every chunk of a real 26.3 world, saves it twice and checks each
+//! such key comes back byte-for-byte equal, then checks `LastUpdate` follows
+//! the game time.
+//!
+//! Needs `PUMPKIN_2603_WORLD` (dir with `region/*.mca`). Skipped when unset.
+
+use std::io::Read;
+use std::path::Path;
+
+use pumpkin_nbt::compound::NbtCompound;
+use pumpkin_util::math::vector2::Vector2;
+use pumpkin_world::chunk::ChunkData;
+
+fn read_region(path: &Path) -> Vec<(i32, i32, Vec<u8>)> {
+    let data = std::fs::read(path).unwrap();
+    let name = path.file_name().unwrap().to_str().unwrap();
+    let parts: Vec<&str> = name.split('.').collect();
+    let (rx, rz): (i32, i32) = (parts[1].parse().unwrap(), parts[2].parse().unwrap());
+    let mut out = Vec::new();
+    for i in 0..1024 {
+        let off = u32::from_be_bytes([0, data[i * 4], data[i * 4 + 1], data[i * 4 + 2]]) as usize;
+        if off == 0 {
+            continue;
+        }
+        let o = off * 4096;
+        let len = u32::from_be_bytes(data[o..o + 4].try_into().unwrap()) as usize;
+        let raw = &data[o + 5..o + 4 + len];
+        let mut v = Vec::new();
+        match data[o + 4] {
+            1 => drop(flate2::read::GzDecoder::new(raw).read_to_end(&mut v).unwrap()),
+            2 => drop(flate2::read::ZlibDecoder::new(raw).read_to_end(&mut v).unwrap()),
+            3 => v = raw.to_vec(),
+            other => panic!("unsupported compression {other} in {name}"),
+        }
+        out.push((rx * 32 + (i % 32) as i32, rz * 32 + (i / 32) as i32, v));
+    }
+    out
+}
+
+fn parse(bytes: &[u8]) -> NbtCompound {
+    let mut reader = pumpkin_nbt::deserializer::NbtReadHelperJava::new(std::io::Cursor::new(bytes));
+    if bytes.starts_with(&[0x0a, 0x00, 0x00]) {
+        pumpkin_nbt::Nbt::read(&mut reader)
+    } else {
+        pumpkin_nbt::Nbt::read_unnamed(&mut reader)
+    }
+    .unwrap()
+    .root_tag
+}
+
+/// `(section_y, palette, the 64 biome names of the section)` straight from chunk NBT.
+/// Keys Pumpkin regenerates itself, so they are not expected to be verbatim.
+const MODELED: &[&str] = &[
+    "DataVersion", "xPos", "zPos", "yPos", "Status", "Heightmaps", "sections",
+    "block_ticks", "fluid_ticks", "block_entities", "isLightOn", "InhabitedTime",
+    "PumpkinCustomData", "BukkitValues",
+];
+
+/// Keys a 26.3 Fabric world must keep; the fixture world has all of them.
+const MUST_SURVIVE: &[&str] =
+    &["structures", "PostProcessing", "blending_data", "LastUpdate", "tectonic:blending_version"];
+
+#[test]
+fn unmodeled_chunk_keys_survive_load_save_reload() {
+    let Some(world) = std::env::var_os("PUMPKIN_2603_WORLD").map(std::path::PathBuf::from) else {
+        eprintln!("PUMPKIN_2603_WORLD unset; skipping");
+        return;
+    };
+    let mut regions: Vec<_> = std::fs::read_dir(world.join("region"))
+        .unwrap()
+        .map(|e| e.unwrap().path())
+        .filter(|p| p.extension().is_some_and(|e| e == "mca"))
+        .collect();
+    regions.sort();
+    let mut kept: std::collections::BTreeMap<String, usize> = Default::default();
+    let (mut chunks, mut structure_starts, mut structure_refs) = (0usize, 0usize, 0usize);
+    let mut sample = None;
+    for region in &regions {
+        for (cx, cz, bytes) in read_region(region) {
+            let source = parse(&bytes);
+            let first = ChunkData::internal_from_bytes(&bytes, Vector2::new(cx, cz)).unwrap();
+            let saved_once = first.internal_to_bytes();
+            let second = ChunkData::internal_from_bytes(&saved_once, Vector2::new(cx, cz)).unwrap();
+            let saved_twice = second.internal_to_bytes();
+            for saved in [parse(&saved_once), parse(&saved_twice)] {
+                for (key, tag) in &source.child_tags {
+                    if MODELED.contains(&key.as_ref()) {
+                        continue;
+                    }
+                    assert_eq!(saved.get(key), Some(tag), "chunk {cx},{cz}: key {key} not kept verbatim");
+                }
+            }
+            for key in source.child_tags.keys() {
+                if !MODELED.contains(&key.as_ref()) {
+                    *kept.entry(key.to_string()).or_default() += 1;
+                }
+            }
+            if let Some(s) = source.get_compound("structures") {
+                structure_starts += s.get_compound("starts").map_or(0, |c| c.child_tags.len());
+                structure_refs += s.get_compound("References").map_or(0, |c| c.child_tags.len());
+            }
+            if sample.is_none() && source.get_long("LastUpdate").is_some_and(|t| t > 0) {
+                sample = Some((cx, cz, bytes));
+            }
+            chunks += 1;
+        }
+    }
+    println!("{} regions, {chunks} chunks; unmodeled keys kept verbatim through two saves (chunks with key):", regions.len());
+    for (k, n) in &kept {
+        println!("  {k}: {n}");
+    }
+    println!("structure starts {structure_starts}, structure reference entries {structure_refs}");
+    assert!(chunks > 0);
+    for key in MUST_SURVIVE {
+        assert!(kept.get(*key).copied().unwrap_or(0) > 0, "fixture world has no {key}; test proves nothing for it");
+    }
+
+    // LastUpdate follows the game time once a world ticks, and never goes backwards.
+    let (cx, cz, bytes) = sample.expect("a chunk with LastUpdate > 0");
+    let stored = parse(&bytes).get_long("LastUpdate").unwrap();
+    let chunk = ChunkData::internal_from_bytes(&bytes, Vector2::new(cx, cz)).unwrap();
+    pumpkin_world::chunk::set_chunk_save_game_time(stored + 1234);
+    assert_eq!(parse(&chunk.internal_to_bytes()).get_long("LastUpdate"), Some(stored + 1234));
+    pumpkin_world::chunk::set_chunk_save_game_time(5);
+    assert_eq!(parse(&chunk.internal_to_bytes()).get_long("LastUpdate"), Some(stored));
+    println!("LastUpdate: stored {stored}, game time {} -> {}, game time 5 -> {stored}", stored + 1234, stored + 1234);
+}
