+/// Writes the chunks named by `PUMPKIN_DUMP_CHUNKS` (`x,z;x,z`) of `PUMPKIN_DUMP_DIMENSION`
+/// (`the_end` by default, or `overworld`) generated up to `PUMPKIN_DUMP_STAGE`:
+/// `surface` (default), `carvers`, or `full` (through the feature stage; the older `PUMPKIN_DUMP_FULL=1`
+/// means `full`). `PUMPKIN_DUMP_STRUCTURES=1` adds structure starts.
+/// Also needs `PUMPKIN_DUMP_SEED`, `PUMPKIN_DUMP_DATAPACKS` (a folder holding the packs) and `PUMPKIN_DUMP_OUT`.
+///
+/// The End is written as `PKD1` (y 0..256, 64 quarter rows). The overworld is written as `PKD2`: the same
+/// layout after `PKD2`, an `i32` LE min y and a `u16` LE height, with `height` block rows and `height / 4`
+/// biome rows.
+#[test]
+#[ignore = "dump tool, configured through PUMPKIN_DUMP_* variables"]
+#[expect(clippy::too_many_lines)]
+fn dump_chunks() {
+    let var = |name: &str| std::env::var(name).unwrap_or_else(|_| panic!("{name} is not set"));
+    let seed: u64 = var("PUMPKIN_DUMP_SEED").parse().expect("seed");
+    let out_dir = std::path::PathBuf::from(var("PUMPKIN_DUMP_OUT"));
+    fs::create_dir_all(&out_dir).expect("out dir");
+    let dimension_name = std::env::var("PUMPKIN_DUMP_DIMENSION").unwrap_or_default();
+    // Every dimension but the End is written as PKD2.
+    let overworld = dimension_name.ends_with("overworld") || dimension_name.ends_with("nether");
+    let (dimension, settings) = if dimension_name.ends_with("overworld") {
+        (Dimension::OVERWORLD, "minecraft:overworld")
+    } else if dimension_name.ends_with("nether") {
+        (Dimension::THE_NETHER, "minecraft:nether")
+    } else {
+        (Dimension::THE_END, "minecraft:end")
+    };
+    let set = DatapackSet::load_folder(Path::new(&var("PUMPKIN_DUMP_DATAPACKS"))).expect("packs");
+    let runtime = generation_for_set(&set, &dimension, settings);
+    let world_gen = get_world_gen_with_all_settings(
+        Seed(seed),
+        dimension,
+        false,
+        Vec::new(),
+        String::new(),
+        Some(settings),
+        None,
+        None,
+        runtime,
+    );
+
+    let stage = std::env::var("PUMPKIN_DUMP_STAGE").unwrap_or_else(|_| {
+        if std::env::var("PUMPKIN_DUMP_FULL").is_ok_and(|v| v == "1") {
+            "full".to_string()
+        } else {
+            "surface".to_string()
+        }
+    });
+    assert!(
+        ["surface", "carvers", "full"].contains(&stage.as_str()),
+        "PUMPKIN_DUMP_STAGE must be surface, carvers or full"
+    );
+    let structures = std::env::var("PUMPKIN_DUMP_STRUCTURES").is_ok_and(|v| v == "1");
+    let mut feature_world = (stage == "full").then(|| FeatureWorld::new(&world_gen, structures));
+    let WorldGenerator::Noise(generator) = &*world_gen else {
+        unreachable!()
+    };
+
+    for pair in var("PUMPKIN_DUMP_CHUNKS")
+        .split(';')
+        .filter(|p| !p.is_empty())
+    {
+        let (x, z) = pair.split_once(',').expect("x,z");
+        let (x, z): (i32, i32) = (x.trim().parse().expect("x"), z.trim().parse().expect("z"));
+        let plain = feature_world.is_none().then(|| {
+            let mut chunk = generate_chunk(&world_gen, x, z, structures);
+            if stage == "carvers" {
+                chunk.step_to_carvers(generator);
+            }
+            chunk
+        });
+        let chunk = plain.as_ref().unwrap_or_else(|| {
+            feature_world
+                .as_mut()
+                .expect("a feature world is set when no plain chunk was made")
+                .chunk(x, z)
+        });
+        let min_y = i32::from(chunk.bottom_y());
+        let height = i32::from(chunk.height());
+
+        let mut block_names: Vec<String> = Vec::new();
+        let mut block_indices: Vec<u16> = Vec::new();
+        let mut palette_of = rustc_hash::FxHashMap::default();
+        for y in 0..height {
+            for lz in 0..16 {
+                for lx in 0..16 {
+                    let id = chunk.get_block_state_raw(lx, y, lz);
+                    let index = *palette_of.entry(id.as_u16()).or_insert_with(|| {
+                        block_names.push(block_state_name(id));
+                        (block_names.len() - 1) as u16
+                    });
+                    block_indices.push(index);
+                }
+            }
+        }
+
+        let mut biome_names: Vec<String> = Vec::new();
+        let mut biome_indices: Vec<u16> = Vec::new();
+        let mut biome_palette = rustc_hash::FxHashMap::default();
+        for y in 0..height / 4 {
+            for lz in 0..4 {
+                for lx in 0..4 {
+                    let id = chunk.get_biome_id(lx, min_y / 4 + y, lz);
+                    let index = *biome_palette.entry(id).or_insert_with(|| {
+                        let biome = crate::biome::unknown::generation_biome(id);
+                        biome_names.push(if biome.registry_id.contains(':') {
+                            biome.registry_id.to_string()
+                        } else {
+                            format!("minecraft:{}", biome.registry_id)
+                        });
+                        (biome_names.len() - 1) as u16
+                    });
+                    biome_indices.push(index);
+                }
+            }
+        }
+
+        let mut bytes = if overworld {
+            let mut header = b"PKD2".to_vec();
+            header.extend(min_y.to_le_bytes());
+            header.extend((height as u16).to_le_bytes());
+            header
+        } else {
+            b"PKD1".to_vec()
+        };
+        write_palette(&mut bytes, &block_names);
+        bytes.extend(block_indices.iter().flat_map(|i| i.to_le_bytes()));
+        write_palette(&mut bytes, &biome_names);
+        bytes.extend(biome_indices.iter().flat_map(|i| i.to_le_bytes()));
+        fs::write(out_dir.join(format!("c.{x}.{z}.bin")), bytes).expect("write dump");
+    }
+}
