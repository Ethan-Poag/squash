+/// Fills each sky light section a lit chunk did not save from the bottom layer of the nearest
+/// saved section above it (vanilla `SkyLightSectionStorage`), or with 15 above every saved one.
+fn fill_unsaved_sky_light(sky_lights: &mut [LightContainer], saved: &[bool]) {
+    let dim = LightContainer::DIM;
+    let mut layer = [15u8; LightContainer::DIM * LightContainer::DIM];
+    for index in (0..sky_lights.len()).rev() {
+        if saved[index] {
+            for x in 0..dim {
+                for z in 0..dim {
+                    layer[x * dim + z] = sky_lights[index].get(x, 0, z);
+                }
+            }
+            continue;
+        }
+        let first = layer[0];
+        if layer.iter().all(|&v| v == first) {
+            sky_lights[index] = LightContainer::new_empty(first);
+        } else {
+            let mut section = LightContainer::new_filled(0);
+            for x in 0..dim {
+                for z in 0..dim {
+                    section.set_column_y_range(x, z, 0, dim, layer[x * dim + z]);
+                }
+            }
+            sky_lights[index] = section;
+        }
+    }
+}
