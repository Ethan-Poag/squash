+/// A proto chunk another server started (Fabric) carries keys Pumpkin does not model:
+/// its structure starts/references, `PostProcessing`, mod keys. Finishing the chunk in
+/// Pumpkin must write them back instead of dropping them (sandbox: 529 border chunks
+/// lost `structures`, so Fabric would never complete structures started there).
+#[test]
+fn unmodeled_keys_survive_finishing_a_resumed_proto_chunk() {
+    use crate::chunk::ChunkData;
+    use crate::chunk_system::chunk_state::Chunk;
+    use pumpkin_config::lighting::LightingEngineConfig;
+    use pumpkin_nbt::compound::NbtCompound;
+    use pumpkin_util::math::vector2::Vector2;
+
+    let seed = Seed(4242);
+    let world_gen = get_world_gen(seed, Dimension::OVERWORLD, false, Vec::new(), String::new());
+    let WorldGenerator::Noise(generator) = &*world_gen else {
+        unreachable!()
+    };
+
+    let mut proto = ProtoChunk::new(5, 7, &world_gen);
+    proto.step_to_biomes(generator);
+    proto.set_structure_starts(generator);
+    let mut staged = Chunk::Proto(Box::new(proto));
+    staged.upgrade_to_level_chunk(&Dimension::OVERWORLD, &LightingEngineConfig::Default);
+    let Chunk::Level(saved) = staged else {
+        unreachable!()
+    };
+
+    // What the other server wrote next to the blocks.
+    let mut start = NbtCompound::new();
+    start.put_string("id", "dungeons_and_taverns:example".to_string());
+    start.put_int("ChunkX", 5);
+    start.put_int("ChunkZ", 7);
+    let mut starts = NbtCompound::new();
+    starts.put_compound("dungeons_and_taverns:example", start);
+    let mut structures = NbtCompound::new();
+    structures.put_compound("starts", starts);
+    structures.put_compound("References", NbtCompound::new());
+    let read_root = |bytes: &[u8]| {
+        let mut cursor = std::io::Cursor::new(bytes);
+        let mut reader = pumpkin_nbt::deserializer::NbtReadHelperJava::new(&mut cursor);
+        pumpkin_nbt::Nbt::read(&mut reader).expect("valid nbt").root_tag
+    };
+    let mut root = read_root(saved.internal_to_bytes().as_ref());
+    root.put_compound("structures", structures.clone());
+    root.put_int("tectonic:blending_version", 3);
+    let on_disk_bytes = pumpkin_nbt::Nbt::new(String::new(), root).write();
+    let on_disk =
+        ChunkData::internal_from_bytes(&on_disk_bytes, Vector2::new(5, 7)).expect("chunk parses");
+
+    // Pumpkin resumes and finishes it.
+    let mut resumed = ProtoChunk::from_chunk_data(&on_disk, &world_gen);
+    resumed.stage = StagedChunkEnum::Full;
+    let mut finished = Chunk::Proto(Box::new(resumed));
+    finished.upgrade_to_level_chunk(&Dimension::OVERWORLD, &LightingEngineConfig::Default);
+    let Chunk::Level(finished) = finished else {
+        unreachable!()
+    };
+    let written = read_root(finished.internal_to_bytes().as_ref());
+    assert_eq!(written.get_string("Status"), Some("minecraft:full"));
+    assert_eq!(written.get_compound("structures"), Some(&structures));
+    assert_eq!(written.get_int("tectonic:blending_version"), Some(3));
+}
