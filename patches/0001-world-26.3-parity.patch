+/// Vanilla `SpeleothemUtils.getSpeleothemHeight`.
+pub(super) fn get_speleothem_height(
+    mut xz_distance_from_center: f64,
+    speleothem_radius: f64,
+    scale: f64,
+    bluntness: f64,
+) -> f64 {
+    const CUTOFF: f64 = 0.384;
+    if xz_distance_from_center < bluntness {
+        xz_distance_from_center = bluntness;
+    }
+    let r = xz_distance_from_center / speleothem_radius * CUTOFF;
+    let part1 = 0.75 * r.powf(1.333_333_333_333_333_3);
+    let part2 = r.powf(0.666_666_666_666_666_6);
+    let part3 = 0.333_333_333_333_333_3 * r.ln();
+    let height_relative_to_max_radius = (scale * (part1 - part2 - part3)).max(0.0);
+    height_relative_to_max_radius / CUTOFF * speleothem_radius
+}
+
+/// Vanilla `SpeleothemUtils.isCircleMostlyEmbeddedInStone`.
+pub(super) fn is_circle_mostly_embedded_in_stone<T: GenerationCache>(
+    chunk: &T,
+    center: BlockPos,
+    xz_radius: i32,
+) -> bool {
+    if is_empty_or_water_or_lava(chunk, center) {
+        return false;
+    }
+    let angle_increment = 6.0f32 / xz_radius as f32;
+    let mut angle = 0.0f32;
+    while angle < std::f32::consts::TAU {
+        let dx = (pumpkin_util::math::cos(angle) * xz_radius as f32) as i32;
+        let dz = (pumpkin_util::math::sin(angle) * xz_radius as f32) as i32;
+        if is_empty_or_water_or_lava(chunk, center.add(dx, 0, dz)) {
+            return false;
+        }
+        angle += angle_increment;
+    }
+    true
+}
+
+/// Vanilla `Column`: the free space between a floor and a ceiling, either of which may be missing.
+#[derive(Clone, Copy)]
+pub(super) struct Column {
+    pub floor: Option<i32>,
+    pub ceiling: Option<i32>,
+}
+
+impl Column {
+    /// The distance between floor and ceiling, if both exist.
+    pub fn height(&self) -> Option<i32> {
+        Some(self.ceiling? - self.floor? - 1)
+    }
+
+    /// Vanilla `Column.scan`: walks up and down from `pos` through `inside_column` blocks and
+    /// takes the first block beyond them as the edge if it satisfies `valid_edge`.
+    pub fn scan<T: GenerationCache>(
+        chunk: &T,
+        pos: BlockPos,
+        search_range: i32,
+        inside_column: impl Fn(BlockStateId) -> bool,
+        valid_edge: impl Fn(BlockStateId) -> bool,
+    ) -> Option<Self> {
+        if !inside_column(block_state(chunk, pos)) {
+            return None;
+        }
+        let scan_direction = |step: i32| {
+            let mut y = pos.0.y;
+            let mut i = 1;
+            while i < search_range && inside_column(block_state(chunk, at_y(pos, y))) {
+                y += step;
+                i += 1;
+            }
+            valid_edge(block_state(chunk, at_y(pos, y))).then_some(y)
+        };
+        Some(Self {
+            ceiling: scan_direction(1),
+            floor: scan_direction(-1),
+        })
+    }
+}
