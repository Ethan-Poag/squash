+//! Tests for runtime overworld generation from datapacks.
+
+use std::path::PathBuf;
+
+use super::DatapackSet;
+
+const PACKS_ENV: &str = "PUMPKIN_TEST_PACKS";
+
+/// The folder with the real packs, when the environment names one.
+fn real_packs() -> Option<PathBuf> {
+    std::env::var(PACKS_ENV).ok().map(PathBuf::from)
+}
+
+#[test]
+fn real_packs_load_nested_packs_and_conditions() {
+    let Some(folder) = real_packs() else {
+        return;
+    };
+    let set = DatapackSet::load_folder(&folder).expect("packs");
+    // Tectonic's data is in a nested pack and wins over Terralith.
+    let pack = set
+        .pack_name("noise_settings", "minecraft:overworld")
+        .expect("overworld noise settings");
+    assert!(pack.contains("tectonic"), "{pack}");
