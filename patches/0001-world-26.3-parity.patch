diff --git a/crates/pumpkin-world/src/generation/feature/features/template.rs b/crates/pumpkin-world/src/generation/feature/features/template.rs
new file mode 100644
index 0000000..6461ab1
--- /dev/null
+++ b/crates/pumpkin-world/src/generation/feature/features/template.rs
@@ -0,0 +1,107 @@
+use pumpkin_data::{BlockState, BlockStateId, Rotation};
+use pumpkin_util::{
+    math::{position::BlockPos, vector3::Vector3},
+    random::{RandomGenerator, RandomImpl},
+};
+
+use crate::generation::{
+    proto_chunk::GenerationCache,
+    structure::template::{
+        BlockPlacer, get_template, place_template_with_options, processor::load_processor_list,
+    },
+};
+use pumpkin_nbt::compound::NbtCompound;
+
+/// A template a `minecraft:template` feature can place, with how often it is picked.
+pub struct TemplateEntry {
+    pub weight: u32,
+    pub template: String,
+    pub rotations: Vec<Rotation>,
+}
+
+pub struct TemplateFeature {
+    pub templates: Vec<TemplateEntry>,
+    /// The processor list applied to the placed blocks.
+    pub processors: Option<String>,
+}
+
+/// Lets the template placement write through a generation cache.
+struct CachePlacer<'a, T: GenerationCache>(&'a mut T);
+
+impl<T: GenerationCache> BlockPlacer for CachePlacer<'_, T> {
+    fn get_block_state(&self, pos: &Vector3<i32>) -> BlockStateId {
+        GenerationCache::get_block_state(self.0, pos)
+    }
+
+    fn set_block_state(&mut self, pos: &Vector3<i32>, state: &BlockState) {
+        GenerationCache::set_block_state(self.0, pos, state);
+    }
+
+    fn add_block_entity(&mut self, nbt: NbtCompound) {
+        let (Some(x), Some(y), Some(z)) = (nbt.get_int("x"), nbt.get_int("y"), nbt.get_int("z"))
+        else {
+            return;
+        };
+        self.0.add_block_entity(&Vector3::new(x, y, z), nbt);
+    }
+}
+
+impl TemplateFeature {
+    pub fn generate<T: GenerationCache>(
+        &self,
+        chunk: &mut T,
+        random: &mut RandomGenerator,
+        origin: BlockPos,
+    ) -> bool {
+        let total: u32 = self.templates.iter().map(|entry| entry.weight).sum();
+        if total == 0 {
+            return false;
+        }
+        let mut roll = random.next_bounded_i32(i32::try_from(total).unwrap_or(i32::MAX));
+        let Some(entry) = self.templates.iter().find(|entry| {
+            roll -= i32::try_from(entry.weight).unwrap_or(i32::MAX);
+            roll < 0
+        }) else {
+            return false;
+        };
+        let rotation = if entry.rotations.is_empty() {
+            return false;
+        } else {
+            let index = random.next_bounded_i32(entry.rotations.len() as i32);
+            entry.rotations[index as usize]
+        };
+        let Some(template) = get_template(&entry.template) else {
+            return false;
+        };
+
+        // The template is centered on the origin, then rotated around that corner.
+        let size = template.size;
+        let (offset_x, offset_z) = rotation.rotate_offset(-(size.x / 2), -(size.z / 2));
+        // `place_template_with_options` keeps the rotated template in its own bounds, vanilla
+        // rotates around the corner: the difference is the rotated corner.
+        let corner = rotation.transform_pos(Vector3::new(0, 0, 0), size);
+        let origin = Vector3::new(
+            origin.0.x + offset_x - corner.x,
+            origin.0.y,
+            origin.0.z + offset_z - corner.z,
+        );
+        let processors = self
+            .processors
+            .as_deref()
+            .map(load_processor_list)
+            .unwrap_or_default();
+        place_template_with_options(
+            &mut CachePlacer(chunk),
+            &template,
+            origin,
+            (0, 0),
+            rotation,
+            false,
+            false,
+            &processors,
+            None,
+            false,
+        );
+        true
+    }
+}
