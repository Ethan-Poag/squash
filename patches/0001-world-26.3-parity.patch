+/// End chunks taken through the feature stage the way the chunk pipeline does it: a chunk is
+/// decorated once its 3x3 neighbours are at the carvers stage, and its features may write into
+/// them. A chunk handed out has had the features of all eight neighbours applied as well.
+struct FeatureWorld<'a> {
+    world_gen: &'a WorldGenerator,
+    chunks: std::collections::HashMap<(i32, i32), ProtoChunk>,
+    carved: std::collections::HashSet<(i32, i32)>,
+    decorated: std::collections::HashSet<(i32, i32)>,
+    structures: bool,
+}
+
+impl<'a> FeatureWorld<'a> {
+    fn new(world_gen: &'a WorldGenerator, structures: bool) -> Self {
+        Self {
+            world_gen,
+            chunks: std::collections::HashMap::new(),
+            carved: std::collections::HashSet::new(),
+            decorated: std::collections::HashSet::new(),
+            structures,
+        }
+    }
+
+    fn generator(&self) -> &'a crate::generation::generator::VanillaGenerator {
+        let WorldGenerator::Noise(generator) = self.world_gen else {
+            unreachable!()
+        };
+        generator
+    }
+
+    fn ensure_carvers(&mut self, x: i32, z: i32) {
+        let generator = self.generator();
+        let world_gen = self.world_gen;
+        let structures = self.structures;
+        let chunk = self.chunks.entry((x, z)).or_insert_with(|| {
+            let mut chunk = ProtoChunk::new(x, z, world_gen);
+            chunk.step_to_biomes(generator);
+            if structures {
+                chunk.set_structure_starts(generator);
+                chunk.set_structure_references(generator);
+            }
+            chunk
+        });
+        if self.carved.insert((x, z)) {
+            chunk.step_to_noise(generator);
+            chunk.step_to_surface(generator, &surface_biomes(world_gen, x, z));
+            chunk.step_to_carvers(generator);
+        }
+    }
+
+    fn decorate(&mut self, cx: i32, cz: i32) {
+        if !self.decorated.insert((cx, cz)) {
+            return;
+        }
+        let mut neighbourhood = std::collections::HashMap::new();
+        for nx in cx - 1..=cx + 1 {
+            for nz in cz - 1..=cz + 1 {
+                self.ensure_carvers(nx, nz);
+                if let Some(chunk) = self.chunks.remove(&(nx, nz)) {
+                    neighbourhood.insert((nx, nz), chunk);
+                }
+            }
+        }
+        let generator = self.generator();
+        let mut cache = TestGridCache {
+            center_pos: (cx, cz),
+            chunks: neighbourhood,
+            runtime_features: generator.runtime_features(),
+            runtime_structures: generator.runtime_structures(),
+            world_seed: Some(generator.random_config.seed),
+        };
+        ProtoChunk::generate_features_and_structure(
+            &mut cache,
+            &TestBlockRegistry,
+            &generator.random_config,
+        );
+        self.chunks.extend(cache.chunks);
+    }
+
+    /// The chunk at (`x`, `z`) after the features of its whole neighbourhood.
+    fn chunk(&mut self, x: i32, z: i32) -> &ProtoChunk {
+        for dx in -1..=1 {
+            for dz in -1..=1 {
+                self.decorate(x + dx, z + dz);
+            }
+        }
+        &self.chunks[&(x, z)]
+    }
+}
