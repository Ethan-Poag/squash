+    /// The elements to try for a jigsaw whose pool is `pool` (Lithostitched `getPoolElements`):
+    /// `None` when there is nothing to try and the fallback is not tried either.
+    fn alternate_candidates(
+        &self,
+        pool: &Arc<TemplatePool>,
+        checked_pools: &mut Vec<String>,
+        depth: i32,
+        first_iteration: bool,
+        random: &mut RandomGenerator,
