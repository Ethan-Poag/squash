+        let mut components = NbtCompound::new();
+        components.put("minecraft:tooltip_display", NbtTag::End);
+        components.put_string("minecraft:rarity", "uncommon".into());
+        let mut item = NbtCompound::new();
+        item.put_compound("components", components);
+        item.put_list("l", vec![NbtTag::End, NbtTag::String("a".into()), NbtTag::End]);
+        let mut expected_components = NbtCompound::new();
+        expected_components.put_string("minecraft:rarity", "uncommon".into());
+        let mut expected = NbtCompound::new();
+        expected.put_compound("components", expected_components);
+        expected.put_list("l", vec![NbtTag::String("a".into())]);
+        // Child order is not fixed, so compare what a reader gets back.
+        let bytes = Nbt::from(item).write_unnamed();
+        let read = Nbt::read_unnamed(&mut crate::deserializer::NbtReadHelperJava::new(
+            std::io::Cursor::new(&bytes[..]),
+        ))
+        .unwrap();
+        assert_eq!(read.root_tag, expected);
+    }
+}
