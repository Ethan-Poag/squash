+++ b/crates/pumpkin-world/src/generation/datapack/feature.rs
@@ -0,0 +1,1934 @@
+//! Biome feature lists and the configured/placed features they name, read from datapacks at runtime.
+//!
+//! The JSON is turned into the same feature structs the generated vanilla tables use, so the native
+//! feature code runs unchanged. `minecraft:*` names a pack does not define resolve to the generated
+//! vanilla entries. A feature with a type this module does not know is logged once and skipped.
+
+use std::collections::{BTreeSet, HashMap};
+use std::fmt::Display;
+
+use pumpkin_data::chunk::Biome;
+use pumpkin_data::placed_feature::PlacedFeature as VanillaPlacedFeature;
+use pumpkin_data::tag::{self, RegistryKey, Tag};
+use pumpkin_data::{Block, BlockDirection, BlockId, BlockState, Rotation};
+use pumpkin_util::DoublePerlinNoiseParametersCodec;
+use pumpkin_util::HeightMap;
+use pumpkin_util::math::float_provider::FloatProvider;
+use pumpkin_util::math::int_provider::{IntProvider, NormalIntProvider, UniformIntProvider};
+use pumpkin_util::math::pool::Weighted;
+use pumpkin_util::math::position::BlockPos;
+use pumpkin_util::math::vector3::Vector3;
+use pumpkin_util::math::vertical_surface_type::VerticalSurfaceType;
+use pumpkin_util::y_offset::{AboveBottom, Absolute, BelowTop, RelativeToSeaLevel, YOffset};
+use rustc_hash::{FxHashMap, FxHashSet};
+use serde_json::Value;
+use tracing::warn;
+
+use super::{BIOME, BLOCK_STATE_PROVIDER, BLOCK_TAG, DatapackSet, FEATURE, PLACED_FEATURE, normalize_id};
+use crate::block::BlockStateCodec;
+use crate::generation::block_predicate::{
+    AllOfBlockPredicate, AnyOfBlockPredicate, BlockPredicate, HasSturdyFacePredicate,
+    HeightRangeBlockPredicate, InsideWorldBoundsBlockPredicate, MatchingBlockTagPredicate,
+    MatchingBlocksBlockPredicate, MatchingBlocksWrapper, MatchingFluidsBlockPredicate,
+    NotBlockPredicate, OffsetBlocksBlockPredicate, ReplaceableBlockPredicate, SolidBlockPredicate,
+    WouldSurviveBlockPredicate,
+};
+use crate::generation::block_state_provider::{
+    BlockStateProvider, BlockStateRule, DualNoiseBlockStateProvider, NoiseBlockStateProvider,
+    NoiseBlockStateProviderBase, NoiseThresholdBlockStateProvider, PillarBlockStateProvider,
+    RandomizedIntBlockStateProvider, RuleBasedBlockStateProvider, SimpleStateProvider,
+    WeightedBlockStateProvider,
+};
+use crate::generation::feature::configured_features::ConfiguredFeature;
+use crate::generation::feature::features::{
+    block_column::{BlockColumnFeature, Layer},
+    bamboo::BambooFeature,
+    block_pile::BlockPileFeature,
+    chorus_plant::ChorusPlantFeature,
+    disk::DiskFeature,
+    drip_stone::{
+        large_dripstone::LargeDripstoneFeature, speleothem::SpeleothemFeature,
+        speleothem_cluster::SpeleothemClusterFeature,
+    },
+    end_gateway::EndGatewayFeature,
+    end_island::EndIslandFeature,
+    end_platform::EndPlatformFeature,
+    end_podium::EndPodiumFeature,
+    end_spike::{EndSpikeFeature, Spike},
+    forest_rock::ForestRockFeature,
+    geode::GeodeFeature,
+    glowstone_blob::GlowstoneBlobFeature,
+    multiface_growth::MultifaceGrowthFeature,
+    netherrack_replace_blobs::ReplaceBlobsFeature,
+    ore::{OreFeature, OreTarget},
+    overlay::OverlayFeature,
+    random_boolean_selector::RandomBooleanFeature,
+    random_patch::RandomPatchFeature,
+    random_selector::{RandomFeature, RandomFeatureEntry},
+    replace_single_block::ReplaceSingleBlockFeature,
+    root_system::RootSystemFeature,
+    scattered_ore::ScatteredOreFeature,
+    sculk_patch::SculkPatchFeature,
+    sequence::SequenceFeature,
+    simple_block::SimpleBlockFeature,
+    simple_random_selector::SimpleRandomFeature,
+    spring_feature::{BlockWrapper, SpringFeatureFeature},
+    template::{TemplateEntry, TemplateFeature},
+    underwater_magma::UnderwaterMagmaFeature,
+    vines::VinesFeature,
+    vegetation_patch::VegetationPatchFeature,
+    waterlogged_vegetation_patch::WaterloggedVegetationPatchFeature,
+    weighted_random_selector::{WeightedRandomFeature, WeightedRandomFeatureEntry},
+};
+use crate::generation::feature::placed_features::{
+    BlockFilterPlacementModifier, CountOnEveryLayerPlacementModifier, CountPlacementModifier,
+    EnvironmentScanPlacementModifier, Feature, HeightRangePlacementModifier,
+    HeightmapPlacementModifier, NoiseBasedCountPlacementModifier,
+    NoiseThresholdCountPlacementModifier, OffsetPlacementModifier, PlacedFeature,
+    PlacedFeatureWrapper, PlacementModifier, RandomChancePlacementModifier, RarityFilterPlacementModifier,
+    RuntimeBiomePlacementModifier, SquarePlacementModifier,
+    SurfaceThresholdFilterPlacementModifier, SurfaceWaterDepthFilterPlacementModifier,
+};
+use crate::generation::feature_order::sort_biome_features;
+use crate::generation::height_provider::{
+    BiasedToBottomHeightProvider, HeightProvider, TrapezoidHeightProvider, UniformHeightProvider,
+    VeryBiasedToBottomHeightProvider,
+};
+use crate::generation::structure::template::processor::register_pack_processor_list;
+use crate::generation::rule::{
+    RuleTest, block_match::BlockMatchRuleTest, block_state_match::BlockStateMatchRuleTest,
+    random_block_match::RandomBlockMatchRuleTest,
+    random_block_state_match::RandomBlockStateMatchRuleTest, tag_match::TagMatchRuleTest,
+};
+
+mod tree;
+
+/// Nesting limit for predicates, providers and features read from JSON.
+const MAX_DEPTH: usize = 64;
+
+/// A placed feature in a biome's feature list: one of the generated vanilla ones or one a pack defines.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, PartialOrd, Ord)]
+pub enum FeatureRef {
+    Vanilla(VanillaPlacedFeature),
+    Runtime(u32),
+}
+
+/// The biome feature lists and placed features of a dimension whose biomes come from a datapack.
+pub struct RuntimeFeatures {
+    /// Pack placed features by `FeatureRef::Runtime` index. `None` marks one that failed to load.
+    placed: Vec<Option<&'static PlacedFeature>>,
+    /// Per biome id, the features of each generation step.
+    biomes: FxHashMap<u8, Vec<FxHashSet<FeatureRef>>>,
+    /// Every feature of each step in generation order (vanilla's `FeatureSorter`).
+    per_step: Vec<Vec<FeatureRef>>,
+    unsupported: Vec<String>,
+    warnings: Vec<String>,
+    /// Pack placed features that jigsaw `feature_pool_element`s name, by id.
+    pool_features: Vec<(String, FeatureRef)>,
+}
+
+impl RuntimeFeatures {
+    /// The pack placed features that template pools of the packs name, loaded for the jigsaw structures.
+    pub fn pool_features(&self) -> impl Iterator<Item = (&str, &'static PlacedFeature)> {
+        self.pool_features
+            .iter()
+            .filter_map(|(id, feature)| Some((id.as_str(), self.placed(*feature)?)))
+    }
+
+    /// The name features from a pack run under: the vanilla name only matters to the vanilla
+    /// biome filter, and pack features carry their own.
+    pub const PLACEHOLDER_NAME: VanillaPlacedFeature = VanillaPlacedFeature::EndSpike;
+
+    /// The placed features of `step` that any of `biome_ids` lists, with their index in the step's
+    /// full ordering, which seeds the feature's random.
+    #[must_use]
+    pub fn select(&self, biome_ids: &[u8], step: usize) -> Vec<(usize, FeatureRef)> {
+        let mut selected = FxHashSet::default();
+        for id in biome_ids {
+            if let Some(features) = self.biomes.get(id).and_then(|steps| steps.get(step)) {
+                selected.extend(features.iter().copied());
+            }
+        }
+        self.per_step
+            .get(step)
+            .into_iter()
+            .flatten()
+            .copied()
+            .enumerate()
+            .filter(|(_, feature)| selected.contains(feature))
+            .collect()
+    }
+
+    /// The pack placed feature `feature` refers to.
+    #[must_use]
+    pub fn placed(&self, feature: FeatureRef) -> Option<&'static PlacedFeature> {
+        match feature {
+            FeatureRef::Runtime(index) => self.placed.get(index as usize).copied().flatten(),
+            FeatureRef::Vanilla(_) => None,
+        }
+    }
+
+    /// Whether the biome lists `feature` in any step.
+    #[must_use]
+    pub fn biome_has(&self, biome_id: u8, feature: FeatureRef) -> bool {
+        self.biomes
+            .get(&biome_id)
+            .is_some_and(|steps| steps.iter().any(|step| step.contains(&feature)))
+    }
+
+    /// Feature, placement, predicate and provider types met while loading that are not supported.
+    #[must_use]
+    pub fn unsupported(&self) -> &[String] {
+        &self.unsupported
+    }
+
+    /// Everything logged while loading, in order.
+    #[must_use]
+    pub fn warnings(&self) -> &[String] {
+        &self.warnings
+    }
+
+    /// Number of placed features loaded from packs.
+    #[must_use]
+    pub fn loaded(&self) -> usize {
+        self.placed.iter().flatten().count()
+    }
+}
+
+/// Reads the feature lists of `biome_names` (the dimension's biomes in source order) and everything
+/// they reference.
+///
+/// Returns `None` when no pack defines any of these biomes, in which case the vanilla lists apply.
+#[must_use]
+pub fn load_features(set: &DatapackSet, biome_names: &[String]) -> Option<RuntimeFeatures> {
+    let overridden = biome_names
+        .iter()
+        .any(|name| set.pack_json(BIOME, name).is_some());
+    if !overridden {
+        return None;
+    }
+    let mut loader = Loader::new(set);
+
+    let mut per_biome: Vec<Vec<Vec<FeatureRef>>> = Vec::new();
+    let mut biomes: FxHashMap<u8, Vec<FxHashSet<FeatureRef>>> = FxHashMap::default();
+    for name in biome_names {
+        let id = crate::biome::unknown::id_for_name(name);
+        if biomes.contains_key(&id) {
+            continue;
+        }
+        let steps = loader.biome_features(name);
+        biomes.insert(
+            id,
+            steps
+                .iter()
+                .map(|step| step.iter().copied().collect::<FxHashSet<_>>())
+                .collect(),
+        );
+        per_biome.push(steps);
+    }
+
+    let per_step = sort_biome_features(&per_biome).unwrap_or_else(|| {
+        warn!("worldgen datapack: the biomes' feature lists order their features in a cycle");
+        Vec::new()
+    });
+    let pool_features = loader.pool_features();
+    Some(RuntimeFeatures {
+        placed: loader.placed,
+        biomes,
+        per_step,
+        unsupported: loader.unsupported.into_iter().collect(),
+        warnings: loader.warnings,
+        pool_features,
+    })
+}
+
+fn leak<T>(value: T) -> &'static T {
+    Box::leak(Box::new(value))
+}
+
+struct Loader<'a> {
+    set: &'a DatapackSet,
+    placed: Vec<Option<&'static PlacedFeature>>,
+    placed_ids: FxHashMap<String, FeatureRef>,
+    /// `None` while the feature is being read, which is how cycles show up.
+    configured: FxHashMap<String, Option<&'static ConfiguredFeature>>,
+    tags: FxHashMap<String, Option<Tag>>,
+    unsupported: BTreeSet<String>,
+    warned: FxHashSet<String>,
+    warnings: Vec<String>,
+    /// Placed features currently read in place, to stop references that loop.
+    reading: Vec<String>,
+    /// Inline processor lists of template features registered so far.
+    inline_processors: usize,
+    depth: usize,
+}
+
+impl<'a> Loader<'a> {
+    fn new(set: &'a DatapackSet) -> Self {
+        Self {
+            set,
+            placed: Vec::new(),
+            placed_ids: FxHashMap::default(),
+            configured: FxHashMap::default(),
+            tags: FxHashMap::default(),
+            unsupported: BTreeSet::new(),
+            warned: FxHashSet::default(),
+            warnings: Vec::new(),
+            reading: Vec::new(),
+            inline_processors: 0,
+            depth: 0,
+        }
+    }
+
+    /// Logs `message` the first time it comes up.
+    fn warn_once(&mut self, message: String) {
+        if self.warned.insert(message.clone()) {
+            warn!("worldgen datapack: {message}");
+            self.warnings.push(message);
+        }
+    }
+
+    /// Records an unsupported `kind` of the given `name` and yields no value.
+    fn unsupported<T>(&mut self, kind: &str, name: impl Display) -> Option<T> {
+        let entry = format!("{kind} {name}");
+        self.unsupported.insert(entry.clone());
+        self.warn_once(format!(
+            "unsupported {entry}, skipping the features that use it"
+        ));
+        None
+    }
+
+    /// Records an unsupported `kind` that is replaced by a feature that does nothing.
+    fn unsupported_noop(&mut self, kind: &str, name: impl Display) {
+        let entry = format!("{kind} {name}");
+        self.unsupported.insert(entry.clone());
+        self.warn_once(format!("unsupported {entry}, it places nothing"));
+    }
+
+    fn invalid<T>(&mut self, what: &str, detail: impl Display) -> Option<T> {
+        self.warn_once(format!("invalid {what}: {detail}"));
+        None
+    }
+
+    fn enter(&mut self) -> Option<()> {
+        if self.depth >= MAX_DEPTH {
+            return self.invalid("feature json", "nested too deeply");
+        }
+        self.depth += 1;
+        Some(())
+    }
+
+    const fn leave(&mut self) {
+        self.depth -= 1;
+    }
+
+    /// The feature lists of one biome, per step.
+    fn biome_features(&mut self, name: &str) -> Vec<Vec<FeatureRef>> {
+        if let Some(json) = self.set.pack_json(BIOME, name) {
+            let steps = json
+                .get("features")
+                .and_then(Value::as_array)
+                .cloned()
+                .unwrap_or_default();
+            return steps
+                .iter()
+                .map(|step| {
+                    step.as_array()
+                        .into_iter()
+                        .flatten()
+                        .filter_map(|entry| self.feature_list_entry(entry, name))
+                        .collect()
+                })
+                .collect();
+        }
+        let short = name.strip_prefix("minecraft:").unwrap_or(name);
+        if let Some(biome) = Biome::from_name(short) {
+            // A vanilla biome the packs leave alone still names its placed features by id, so a
+            // pack's override of e.g. `minecraft:ore_diorite_upper` applies here too, and the
+            // feature is the same entry in the step ordering as in the pack's own biomes.
+            return biome
+                .features
+                .iter()
+                .map(|step| {
+                    step.iter()
+                        .map(|feature| self.placed_ref(&format!("minecraft:{}", feature.to_name())))
+                        .collect()
+                })
+                .collect();
+        }
+        self.warn_once(format!(
+            "biome {name} has no definition, it gets no features"
+        ));
+        Vec::new()
+    }
+
+    fn feature_list_entry(&mut self, entry: &Value, biome: &str) -> Option<FeatureRef> {
+        let Some(name) = entry.as_str() else {
+            return self.unsupported("inline placed feature in biome", biome);
+        };
+        if name.starts_with('#') {
+            return self.unsupported("placed feature tag in biome", name);
+        }
+        Some(self.placed_ref(&normalize_id(name)))
+    }
+
+    /// The reference for the placed feature `id`: the pack's definition if it has one, else vanilla's.
+    /// Features that cannot be loaded keep their slot, so the others keep their position in the order.
+    /// Loads the pack placed features named by `feature_pool_element`s of the packs' template pools.
+    fn pool_features(&mut self) -> Vec<(String, FeatureRef)> {
+        fn collect(element: &Value, out: &mut Vec<String>) {
+            if element.get("element_type").and_then(Value::as_str)
+                == Some("minecraft:feature_pool_element")
+                && let Some(feature) = element.get("feature").and_then(Value::as_str)
+            {
+                out.push(normalize_id(feature));
+            }
+            for child in element
+                .get("elements")
+                .and_then(Value::as_array)
+                .into_iter()
+                .flatten()
+            {
+                collect(child, out);
+            }
+        }
+        let mut ids = Vec::new();
+        for pool in self.set.pack_ids(super::TEMPLATE_POOL) {
+            let Some(json) = self.set.pack_json(super::TEMPLATE_POOL, pool) else {
+                continue;
+            };
+            for entry in json
+                .get("elements")
+                .and_then(Value::as_array)
+                .into_iter()
+                .flatten()
+            {
+                if let Some(element) = entry.get("element") {
+                    collect(element, &mut ids);
+                }
+            }
+        }
+        ids.sort_unstable();
+        ids.dedup();
+        ids.into_iter()
+            .filter(|id| self.set.pack_json(PLACED_FEATURE, id).is_some())
+            .map(|id| {
+                let reference = self.placed_ref(&id);
+                (id, reference)
+            })
+            .collect()
+    }
+
+    fn placed_ref(&mut self, id: &str) -> FeatureRef {
+        if let Some(found) = self.placed_ids.get(id) {
+            return *found;
+        }
+        let in_pack = self.set.pack_json(PLACED_FEATURE, id).cloned();
+        if in_pack.is_none()
+            && let Some(vanilla) = VanillaPlacedFeature::from_name(id)
+        {
+            let reference = FeatureRef::Vanilla(vanilla);
+            self.placed_ids.insert(id.to_string(), reference);
+            return reference;
+        }
+        let index = u32::try_from(self.placed.len()).unwrap_or(u32::MAX);
+        self.placed.push(None);
+        let reference = FeatureRef::Runtime(index);
+        self.placed_ids.insert(id.to_string(), reference);
+        match in_pack {
+            Some(json) => {
+                if let Some(feature) = self.placed_feature(&json, Some(reference)) {
+                    if let Some(slot) = self.placed.get_mut(index as usize) {
+                        *slot = Some(leak(feature));
+                    }
+                } else {
+                    self.warn_once(format!(
+                        "placed feature {id} could not be loaded and is skipped"
+                    ));
+                }
+            }
+            None => self.warn_once(format!("placed feature {id} does not exist")),
+        }
+        reference
+    }
+
+    /// A placed feature reference that a configured feature holds.
+    fn placed_wrapper(&mut self, value: &Value) -> Option<PlacedFeatureWrapper> {
+        match value {
+            Value::String(name) => {
+                let id = normalize_id(name);
+                match self.placed_ref(&id) {
+                    FeatureRef::Vanilla(vanilla) => Some(PlacedFeatureWrapper::Named(vanilla)),
+                    reference @ FeatureRef::Runtime(index) => {
+                        let found = self.placed.get(index as usize).copied().flatten();
+                        if found.is_none() {
+                            self.warn_once(format!(
+                                "invalid placed feature reference: {id} is missing or refers back to itself ({reference:?})"
+                            ));
+                        }
+                        found.map(PlacedFeatureWrapper::Resolved)
+                    }
+                }
+            }
+            Value::Object(_) => Some(PlacedFeatureWrapper::Direct(
+                self.placed_feature(value, None)?,
+            )),
+            _ => self.invalid("placed feature reference", value),
+        }
+    }
+
+    /// `top` is the feature's own reference when it is placed through a biome list.
+    fn placed_feature(&mut self, json: &Value, top: Option<FeatureRef>) -> Option<PlacedFeature> {
+        self.enter()?;
+        let result = (|| {
+            let Some(feature) = json.get("feature") else {
+                return self.invalid("placed feature", "it has no feature");
+            };
+            let feature = match feature {
+                Value::String(name) => self.configured_ref(&normalize_id(name))?,
+                inline @ Value::Object(_) => {
+                    Feature::Inlined(Box::new(self.configured_feature(inline)?))
+                }
+                other => return self.invalid("placed feature", other),
+            };
+            let mut placement = Vec::new();
+            for modifier in json
+                .get("placement")
+                .and_then(Value::as_array)
+                .map_or(&[][..], Vec::as_slice)
+            {
+                let ty = modifier.get("type").and_then(Value::as_str);
+                if ty.map(|t| t.strip_prefix("minecraft:").unwrap_or(t)) == Some("biome") {
+                    // Vanilla only filters the top level feature by biome.
+                    if let Some(feature) = top {
+                        placement.push(PlacementModifier::RuntimeBiome(
+                            RuntimeBiomePlacementModifier { feature },
+                        ));
+                    }
+                } else {
+                    placement.push(self.placement_modifier(modifier)?);
+                }
+            }
+            Some(PlacedFeature { feature, placement })
+        })();
+        self.leave();
+        result
+    }
+
+    /// An owned placed feature for a field that holds one by value. A reference to a pack feature
+    /// is read again from its definition.
+    fn inline_placed_feature(&mut self, json: &Value) -> Option<PlacedFeature> {
+        let Value::String(name) = json else {
+            return self.placed_feature(json, None);
+        };
+        let id = normalize_id(name);
+        let Some(definition) = self.set.pack_json(PLACED_FEATURE, &id).cloned() else {
+            return self.unsupported("placed feature reference to a vanilla feature", id);
+        };
+        if self.reading.contains(&id) {
+            return self.invalid(
+                "placed feature reference",
+                format!("{id} refers back to itself"),
+            );
+        }
+        self.reading.push(id);
+        let feature = self.placed_feature(&definition, None);
+        self.reading.pop();
+        feature
+    }
+
+    fn configured_ref(&mut self, id: &str) -> Option<Feature> {
+        if let Some(found) = self.configured.get(id) {
+            let found = *found;
+            if found.is_none() {
+                self.warn_once(format!(
+                    "invalid configured feature: {id} is missing or refers back to itself"
+                ));
+            }
+            return found.map(Feature::Resolved);
+        }
+        let Some(json) = self.set.pack_json(FEATURE, id).cloned() else {
+            if let Some(vanilla) =
+                pumpkin_data::configured_feature::ConfiguredFeature::from_name(id)
+            {
+                return Some(Feature::Named(vanilla));
+            }
+            return self.invalid("configured feature", format!("{id} does not exist"));
+        };
+        self.configured.insert(id.to_string(), None);
+        let feature = self.configured_feature(&json).map(leak);
+        self.configured.insert(id.to_string(), feature);
+        feature.map(Feature::Resolved)
+    }
+
+    // ---- placement modifiers -------------------------------------------------------------
+
+    fn placement_modifier(&mut self, v: &Value) -> Option<PlacementModifier> {
+        let ty = v.get("type").and_then(Value::as_str).unwrap_or_default();
+        let modifier = match ty.strip_prefix("minecraft:").unwrap_or(ty) {
+            "in_square" => PlacementModifier::InSquare(SquarePlacementModifier),
+            "fixed_placement" => {
+                let positions = v
+                    .get("positions")
+                    .and_then(Value::as_array)
+                    .into_iter()
+                    .flatten()
+                    .map(|p| Some(BlockPos::new(int_at(p, 0)?, int_at(p, 1)?, int_at(p, 2)?)))
+                    .collect::<Option<Vec<_>>>();
+                let Some(positions) = positions else {
+                    return self.invalid("fixed_placement", "a position is not three numbers");
+                };
+                PlacementModifier::FixedPlacement(positions)
+            }
+            "heightmap" => PlacementModifier::Heightmap(HeightmapPlacementModifier {
+                heightmap: self.height_map(v.get("heightmap"))?,
+            }),
+            "height_range" => PlacementModifier::HeightRange(HeightRangePlacementModifier {
+                height: self.height_provider(v.get("height")?)?,
+            }),
+            "count" => PlacementModifier::Count(CountPlacementModifier {
+                count: self.int_provider(v.get("count"))?,
+            }),
+            "count_on_every_layer" => {
+                PlacementModifier::CountOnEveryLayer(CountOnEveryLayerPlacementModifier {
+                    count: self.int_provider(v.get("count"))?,
+                })
+            }
+            "rarity_filter" => PlacementModifier::RarityFilter(RarityFilterPlacementModifier {
+                chance: u32::try_from(uint(v.get("chance"), 1)).unwrap_or(1),
+            }),
+            "random_chance" => PlacementModifier::RandomChance(RandomChancePlacementModifier {
+                chance: v.get("chance").and_then(Value::as_f64).unwrap_or(1.0) as f32,
+            }),
+            "block_predicate_filter" => {
+                PlacementModifier::BlockPredicateFilter(BlockFilterPlacementModifier {
+                    predicate: self.block_predicate(v.get("predicate"))?,
+                })
+            }
+            "surface_relative_threshold_filter" => {
+                PlacementModifier::SurfaceRelativeThresholdFilter(
+                    SurfaceThresholdFilterPlacementModifier {
+                        heightmap: self.height_map(v.get("heightmap"))?,
+                        min_inclusive: opt_int(v.get("min_inclusive")),
+                        max_inclusive: opt_int(v.get("max_inclusive")),
+                    },
+                )
+            }
+            "surface_water_depth_filter" => PlacementModifier::SurfaceWaterDepthFilter(
+                SurfaceWaterDepthFilterPlacementModifier {
+                    max_water_depth: int(v.get("max_water_depth"), 0),
+                },
+            ),
+            "noise_based_count" => {
+                PlacementModifier::NoiseBasedCount(NoiseBasedCountPlacementModifier {
+                    to_count_ratio: int(v.get("noise_to_count_ratio"), 0),
+                    factor: float(v.get("noise_factor"), 1.0),
+                    offset: float(v.get("noise_offset"), 0.0),
+                })
+            }
+            "noise_threshold_count" => {
+                PlacementModifier::NoiseThresholdCount(NoiseThresholdCountPlacementModifier {
+                    noise_level: float(v.get("noise_level"), 0.0),
+                    below_noise: int(v.get("below_noise"), 0),
+                    above_noise: int(v.get("above_noise"), 0),
+                })
+            }
+            "environment_scan" => {
+                PlacementModifier::EnvironmentScan(EnvironmentScanPlacementModifier {
+                    direction_of_search: self
+                        .direction(v.get("direction_of_search").and_then(Value::as_str))?,
+                    target_condition: self.block_predicate(v.get("target_condition"))?,
+                    allowed_search_condition: match v.get("allowed_search_condition") {
+                        Some(p) if p.is_object() => Some(self.block_predicate(Some(p))?),
+                        _ => None,
+                    },
+                    max_steps: int(v.get("max_steps"), 1),
+                })
+            }
+            "random_offset" => {
+                let spread = self.int_provider(v.get("xz_spread"))?;
+                PlacementModifier::Offset(OffsetPlacementModifier {
+                    x: spread.clone(),
+                    y: self.int_provider(v.get("y_spread"))?,
+                    z: spread,
+                })
+            }
+            "randomly_selected" => PlacementModifier::RandomlySelected(
+                v.get("placements")
+                    .and_then(Value::as_array)
+                    .map_or(&[][..], Vec::as_slice)
+                    .iter()
+                    .map(|modifier| self.placement_modifier(modifier))
+                    .collect::<Option<Vec<_>>>()?,
+            ),
+            "offset" => PlacementModifier::Offset(OffsetPlacementModifier {
+                x: self.int_provider(v.get("x"))?,
+                y: self.int_provider(v.get("y"))?,
+                z: self.int_provider(v.get("z"))?,
+            }),
+            _ => return self.unsupported("placement modifier", ty),
+        };
+        Some(modifier)
+    }
+
+    // ---- values --------------------------------------------------------------------------
+
+    fn height_map(&mut self, v: Option<&Value>) -> Option<HeightMap> {
+        let name = v.and_then(Value::as_str).unwrap_or("MOTION_BLOCKING");
+        Some(match name {
+            "WORLD_SURFACE_WG" => HeightMap::WorldSurfaceWg,
+            "WORLD_SURFACE" => HeightMap::WorldSurface,
+            "OCEAN_FLOOR_WG" => HeightMap::OceanFloorWg,
+            "OCEAN_FLOOR" => HeightMap::OceanFloor,
+            "MOTION_BLOCKING" => HeightMap::MotionBlocking,
+            "MOTION_BLOCKING_NO_LEAVES" => HeightMap::MotionBlockingNoLeaves,
+            _ => return self.unsupported("heightmap", name),
+        })
+    }
+
+    fn direction(&mut self, name: Option<&str>) -> Option<BlockDirection> {
+        let name = name.unwrap_or("down");
+        Some(match name.to_lowercase().as_str() {
+            "down" => BlockDirection::Down,
+            "up" => BlockDirection::Up,
+            "north" => BlockDirection::North,
+            "south" => BlockDirection::South,
+            "west" => BlockDirection::West,
+            "east" => BlockDirection::East,
+            _ => return self.invalid("direction", name),
+        })
+    }
+
+    fn int_provider(&mut self, v: Option<&Value>) -> Option<IntProvider> {
+        match v {
+            None | Some(Value::Null) => Some(IntProvider::Constant(0)),
+            Some(value) => match serde_json::from_value(with_namespaced_types(value.clone())) {
+                Ok(provider) => Some(provider),
+                Err(err) => self.invalid("int provider", format!("{err} ({value})")),
+            },
+        }
+    }
+
+    /// Like `int_provider`, but a missing value is `uniform(min, max)`.
+    fn int_provider_or_uniform(
+        &mut self,
+        v: Option<&Value>,
+        min_inclusive: i32,
+        max_inclusive: i32,
+    ) -> Option<IntProvider> {
+        match v {
+            None | Some(Value::Null) => Some(IntProvider::Object(NormalIntProvider::Uniform(
+                UniformIntProvider {
+                    min_inclusive,
+                    max_inclusive,
+                },
+            ))),
+            some => self.int_provider(some),
+        }
+    }
+
+    fn y_offset(v: &Value) -> YOffset {
+        let number = |key: &str| v.get(key).and_then(Value::as_i64);
+        let short = |n| i16::try_from(n).unwrap_or(0);
+        let byte = |n| i8::try_from(n).unwrap_or(0);
+        match [
+            "absolute",
+            "above_bottom",
+            "below_top",
+            "relative_to_sea_level",
+        ]
+        .into_iter()
+        .find_map(|key| Some((key, number(key)?)))
+        {
+            Some(("absolute", n)) => YOffset::Absolute(Absolute { absolute: short(n) }),
+            Some(("above_bottom", n)) => YOffset::AboveBottom(AboveBottom {
+                above_bottom: byte(n),
+            }),
+            Some(("below_top", n)) => YOffset::BelowTop(BelowTop { below_top: byte(n) }),
+            Some((_, n)) => YOffset::RelativeToSeaLevel(RelativeToSeaLevel {
+                relative_to_sea_level: short(n),
+            }),
+            None => YOffset::Absolute(Absolute { absolute: 0 }),
+        }
+    }
+
+    fn height_provider(&mut self, v: &Value) -> Option<HeightProvider> {
+        // A bare vertical anchor stands for a constant height.
+        if v.get("type").is_none() && !v.is_null() {
+            let y = Self::y_offset(v);
+            return Some(HeightProvider::Uniform(UniformHeightProvider {
+                min_inclusive: y,
+                max_inclusive: y,
+            }));
+        }
+        let ty = v.get("type").and_then(Value::as_str).unwrap_or_default();
+        let min = || Self::y_offset(v.get("min_inclusive").unwrap_or(&Value::Null));
+        let max = || Self::y_offset(v.get("max_inclusive").unwrap_or(&Value::Null));
+        let inner = || {
+            v.get("inner")
+                .and_then(Value::as_u64)
+                .and_then(|n| u32::try_from(n).ok())
+                .and_then(std::num::NonZero::new)
+        };
+        Some(match ty.strip_prefix("minecraft:").unwrap_or(ty) {
+            "uniform" => HeightProvider::Uniform(UniformHeightProvider {
+                min_inclusive: min(),
+                max_inclusive: max(),
+            }),
+            "trapezoid" => HeightProvider::Trapezoid(TrapezoidHeightProvider {
+                min_inclusive: min(),
+                max_inclusive: max(),
+                plateau: opt_int(v.get("plateau")),
+            }),
+            "biased_to_bottom" => HeightProvider::BiasedToBottom(BiasedToBottomHeightProvider {
+                min_inclusive: min(),
+                max_inclusive: max(),
+                inner: inner(),
+            }),
+            "very_biased_to_bottom" => {
+                HeightProvider::VeryBiasedToBottom(VeryBiasedToBottomHeightProvider {
+                    min_inclusive: min(),
+                    max_inclusive: max(),
+                    inner: inner(),
+                })
+            }
+            "constant" => {
+                let y = Self::y_offset(v.get("value").unwrap_or(&Value::Null));
+                HeightProvider::Uniform(UniformHeightProvider {
+                    min_inclusive: y,
+                    max_inclusive: y,
+                })
+            }
+            _ => return self.unsupported("height provider", ty),
+        })
+    }
+
+    fn block(&mut self, name: &str) -> Option<&'static Block> {
+        let block = Block::from_registry_key(name.strip_prefix("minecraft:").unwrap_or(name));
+        if block.is_none() {
+            self.warn_once(format!("invalid block: {name} is not a known block"));
+        }
+        block
+    }
+
+    fn block_state(&mut self, v: &Value) -> Option<&'static BlockState> {
+        let codec = self.block_state_codec(v)?;
+        Some(codec.get_state())
+    }
+
+    fn block_state_codec(&mut self, v: &Value) -> Option<BlockStateCodec> {
+        let (name, properties) = match v {
+            Value::String(name) => (name.as_str(), None),
+            Value::Object(object) => (
+                object
+                    .get("Name")
+                    .or_else(|| object.get("id"))
+                    .and_then(Value::as_str)
+                    .unwrap_or("minecraft:air"),
+                object
+                    .get("Properties")
+                    .or_else(|| object.get("properties"))
+                    .and_then(Value::as_object),
+            ),
+            _ => return self.invalid("block state", v),
+        };
+        let block = self.block(name)?;
+        // Generated property lookups panic for a block that has no properties at all.
+        let properties = properties
+            .filter(|_| block.properties(block.default_state.id).is_some())
+            .map(|map| {
+                map.iter()
+                    .map(|(key, value)| {
+                        let value = value
+                            .as_str()
+                            .map_or_else(|| value.to_string(), str::to_string);
+                        (key.clone(), value)
+                    })
+                    .collect::<HashMap<_, _>>()
+            });
+        Some(BlockStateCodec {
+            name: block,
+            properties,
+        })
+    }
+
+    /// Resolves a block tag, merging the pack's definition into the vanilla one unless it replaces it.
+    fn block_tag(&mut self, name: &str) -> Option<Tag> {
+        let id = normalize_id(name.strip_prefix('#').unwrap_or(name));
+        if let Some(found) = self.tags.get(&id) {
+            return *found;
+        }
+        let mut blocks: Vec<&'static Block> = Vec::new();
+        let found = self.collect_tag(&id, &mut blocks, &mut FxHashSet::default());
+        let tag = found.then(|| {
+            blocks.dedup_by_key(|b| b.id);
+            let names: Vec<&'static str> = blocks.iter().map(|b| b.name).collect();
+            let ids: Vec<u16> = blocks.iter().map(|b| b.id.as_u16()).collect();
+            (&*Vec::leak(names), &*Vec::leak(ids))
+        });
+        if tag.is_none() {
+            self.warn_once(format!("block tag {id} does not exist"));
+        }
+        self.tags.insert(id, tag);
+        tag
+    }
+
+    /// Adds the blocks of tag `id` to `out`. Returns whether the tag exists anywhere.
+    fn collect_tag(
+        &mut self,
+        id: &str,
+        out: &mut Vec<&'static Block>,
+        visiting: &mut FxHashSet<String>,
+    ) -> bool {
+        if !visiting.insert(id.to_string()) {
+            return true;
+        }
+        let vanilla = tag::get_latest_map(RegistryKey::Block).get(id).copied();
+        let pack = self.set.pack_json(BLOCK_TAG, id).cloned();
+        if vanilla.is_none() && pack.is_none() {
+            return false;
+        }
+        let replaced = pack
+            .as_ref()
+            .and_then(|p| p.get("replace"))
+            .and_then(Value::as_bool)
+            .unwrap_or(false);
+        if let Some((_, ids)) = vanilla
+            && !replaced
+        {
+            out.extend(
+                ids.iter()
+                    .filter_map(|block_id| BlockId::new(*block_id))
+                    .map(Block::from_id),
+            );
+        }
+        for entry in pack
+            .iter()
+            .filter_map(|p| p.get("values").and_then(Value::as_array))
+            .flatten()
+        {
+            let value = entry
+                .as_str()
+                .or_else(|| entry.get("id").and_then(Value::as_str));
+            let Some(value) = value else { continue };
+            if let Some(reference) = value.strip_prefix('#') {
+                self.collect_tag(&normalize_id(reference), out, visiting);
+            } else if let Some(block) =
+                Block::from_registry_key(value.strip_prefix("minecraft:").unwrap_or(value))
+            {
+                out.push(block);
+            }
+        }
+        true
+    }
+
+    fn matching_blocks(v: Option<&Value>) -> MatchingBlocksWrapper {
+        match v {
+            Some(Value::String(name)) => MatchingBlocksWrapper::Single(name.clone()),
+            Some(Value::Array(list)) => MatchingBlocksWrapper::Multiple(
+                list.iter()
+                    .filter_map(Value::as_str)
+                    .map(str::to_string)
+                    .collect(),
+            ),
+            _ => MatchingBlocksWrapper::Single(String::new()),
+        }
+    }
+
+    fn offset_predicate(v: Option<&Value>) -> OffsetBlocksBlockPredicate {
+        let offset = match v {
+            Some(p @ Value::Array(_)) => Some(Vector3::new(
+                int_at(p, 0).unwrap_or(0),
+                int_at(p, 1).unwrap_or(0),
+                int_at(p, 2).unwrap_or(0),
+            )),
+            _ => None,
+        };
+        OffsetBlocksBlockPredicate { offset }
+    }
+
+    fn block_predicate(&mut self, v: Option<&Value>) -> Option<BlockPredicate> {
+        let v = v.unwrap_or(&Value::Null);
+        self.enter()?;
+        let result = self.block_predicate_inner(v);
+        self.leave();
+        result
+    }
+
+    fn block_predicate_inner(&mut self, v: &Value) -> Option<BlockPredicate> {
+        if let Some(s) = v.as_str() {
+            return match s.strip_prefix('#') {
+                Some(tag) => Some(BlockPredicate::MatchingBlockTag(
+                    MatchingBlockTagPredicate {
+                        offset: OffsetBlocksBlockPredicate { offset: None },
+                        tag: self.block_tag(tag)?,
+                    },
+                )),
+                None => Some(BlockPredicate::AlwaysTrue),
+            };
+        }
+        let ty = v.get("type").and_then(Value::as_str).unwrap_or_default();
+        let offset = || Self::offset_predicate(v.get("offset"));
+        Some(match ty.strip_prefix("minecraft:").unwrap_or(ty) {
+            "true" | "volume_match" | "" => BlockPredicate::AlwaysTrue,
+            "matching_blocks" => BlockPredicate::MatchingBlocks(MatchingBlocksBlockPredicate {
+                offset: offset(),
+                blocks: Self::matching_blocks(v.get("blocks")),
+            }),
+            "matching_block_tag" => BlockPredicate::MatchingBlockTag(MatchingBlockTagPredicate {
+                offset: offset(),
+                tag: self.block_tag(v.get("tag").and_then(Value::as_str).unwrap_or_default())?,
+            }),
+            "matching_fluids" => BlockPredicate::MatchingFluids(MatchingFluidsBlockPredicate {
+                offset: offset(),
+                fluids: Self::matching_blocks(v.get("fluids")),
+            }),
+            "has_sturdy_face" => BlockPredicate::HasSturdyFace(HasSturdyFacePredicate {
+                offset: offset(),
+                direction: self.direction(v.get("direction").and_then(Value::as_str))?,
+            }),
+            "solid" => BlockPredicate::Solid(SolidBlockPredicate { offset: offset() }),
+            "replaceable" => {
+                BlockPredicate::Replaceable(ReplaceableBlockPredicate { offset: offset() })
+            }
+            "would_survive" => BlockPredicate::WouldSurvive(WouldSurviveBlockPredicate {
+                offset: offset(),
+                state: self.block_state_codec(v.get("state")?)?,
+            }),
+            "inside_world_bounds" => {
+                let offset = v.get("offset").filter(|o| o.is_array());
+                BlockPredicate::InsideWorldBounds(InsideWorldBoundsBlockPredicate {
+                    offset: offset.map_or_else(
+                        || Vector3::new(0, 0, 0),
+                        |o| {
+                            Vector3::new(
+                                int_at(o, 0).unwrap_or(0),
+                                int_at(o, 1).unwrap_or(0),
+                                int_at(o, 2).unwrap_or(0),
+                            )
+                        },
+                    ),
+                })
+            }
+            "any_of" => BlockPredicate::AnyOf(AnyOfBlockPredicate {
+                predicates: self.block_predicates(v.get("predicates"))?,
+            }),
+            "all_of" => BlockPredicate::AllOf(AllOfBlockPredicate {
+                predicates: self.block_predicates(v.get("predicates"))?,
+            }),
+            "not" => BlockPredicate::Not(NotBlockPredicate {
+                predicate: Box::new(self.block_predicate(v.get("predicate"))?),
+            }),
+            "height_range" => BlockPredicate::HeightRange(HeightRangeBlockPredicate {
+                min_inclusive: Self::y_offset(v.get("min_inclusive").unwrap_or(&Value::Null)),
+                max_inclusive: Self::y_offset(v.get("max_inclusive").unwrap_or(&Value::Null)),
+            }),
+            _ => return self.unsupported("block predicate", ty),
+        })
+    }
+
+    fn block_predicates(&mut self, v: Option<&Value>) -> Option<Vec<BlockPredicate>> {
+        v.and_then(Value::as_array)
+            .map_or(&[][..], Vec::as_slice)
+            .iter()
+            .map(|p| self.block_predicate(Some(p)))
+            .collect()
+    }
+
+    fn block_wrapper(v: Option<&Value>) -> BlockWrapper {
+        match v {
+            Some(Value::String(name)) => BlockWrapper::Single(name.clone()),
+            Some(Value::Array(list)) => BlockWrapper::Multi(
+                list.iter()
+                    .filter_map(Value::as_str)
+                    .map(str::to_string)
+                    .collect(),
+            ),
+            _ => BlockWrapper::Single(String::new()),
+        }
+    }
+
+    /// A block list whose `#tag` entries are expanded, so pack-defined tags work too.
+    fn block_set_wrapper(&mut self, v: Option<&Value>) -> BlockWrapper {
+        let entries: Vec<&str> = match v {
+            Some(Value::String(name)) => vec![name.as_str()],
+            Some(Value::Array(list)) => list.iter().filter_map(Value::as_str).collect(),
+            _ => Vec::new(),
+        };
+        let mut names = Vec::new();
+        for entry in entries {
+            if entry.starts_with('#') {
+                if let Some((tag_names, _)) = self.block_tag(entry) {
+                    names.extend(tag_names.iter().map(|name| (*name).to_string()));
+                }
+            } else {
+                names.push(entry.to_string());
+            }
+        }
+        BlockWrapper::Multi(names)
+    }
+
+    fn noise_parameters(v: Option<&Value>) -> DoublePerlinNoiseParametersCodec {
+        let v = v.unwrap_or(&Value::Null);
+        let first_octave = v
+            .get("firstOctave")
+            .and_then(Value::as_i64)
+            .or_else(|| v.get("base_octave").and_then(Value::as_i64))
+            .and_then(|n| i32::try_from(n).ok())
+            .unwrap_or(-7);
+        let amplitudes = v
+            .get("amplitudes")
+            .or_else(|| v.get("amplitude_modifiers"))
+            .and_then(Value::as_array)
+            .map(|list| list.iter().filter_map(Value::as_f64).collect())
+            .or_else(|| {
+                v.get("octave_count")
+                    .and_then(Value::as_u64)
+                    .map(|n| vec![1.0; usize::try_from(n).unwrap_or(1).clamp(1, 64)])
+            })
+            .unwrap_or_else(|| vec![1.0]);
+        let scale = super::noise::amplitude_scale(v, first_octave, &amplitudes);
+        DoublePerlinNoiseParametersCodec {
+            first_octave,
+            amplitudes: amplitudes.into_iter().map(|a| a * scale).collect(),
+        }
+    }
+
+    fn states(&mut self, v: Option<&Value>) -> Option<Vec<&'static BlockState>> {
+        v.and_then(Value::as_array)
+            .map_or(&[][..], Vec::as_slice)
+            .iter()
+            .map(|state| self.block_state(state))
+            .collect()
+    }
+
+    fn noise_base(v: &Value) -> NoiseBlockStateProviderBase {
+        NoiseBlockStateProviderBase {
+            seed: v.get("seed").and_then(Value::as_i64).unwrap_or(0),
+            noise: Self::noise_parameters(v.get("noise")),
+            scale: float32(v.get("scale"), 1.0),
+        }
+    }
+
+    fn state_provider(&mut self, v: Option<&Value>) -> Option<BlockStateProvider> {
+        let v = v?;
+        self.enter()?;
+        let result = self.state_provider_inner(v);
+        self.leave();
+        result
+    }
+
+    #[expect(clippy::too_many_lines)]
+    fn state_provider_inner(&mut self, v: &Value) -> Option<BlockStateProvider> {
+        if let Value::String(name) = v {
+            // A pack can name a state provider it defines; anything else is a block.
+            let id = normalize_id(name);
+            if let Some(definition) = self.set.pack_json(BLOCK_STATE_PROVIDER, &id).cloned() {
+                if self.reading.contains(&id) {
+                    return self.invalid("state provider", format!("{id} refers back to itself"));
+                }
+                self.reading.push(id);
+                let provider = self.state_provider(Some(&definition));
+                self.reading.pop();
+                return provider;
+            }
+        }
+        if v.is_string()
+            || (v.get("type").is_none() && (v.get("id").is_some() || v.get("Name").is_some()))
+        {
+            return Some(BlockStateProvider::Simple(SimpleStateProvider {
+                state: self.block_state(v)?,
+            }));
+        }
+        let ty = v.get("type").and_then(Value::as_str).unwrap_or_default();
+        let ty = ty.strip_prefix("minecraft:").unwrap_or(ty);
+        Some(match ty {
+            "simple_state_provider" | "simple" => {
+                let state = v.get("state").unwrap_or(v);
+                BlockStateProvider::Simple(SimpleStateProvider {
+                    state: self.block_state(state)?,
+                })
+            }
+            "weighted_state_provider" | "weighted" => {
+                let entries = v
+                    .get("entries")
+                    .and_then(Value::as_array)
+                    .map_or(&[][..], Vec::as_slice)
+                    .iter()
+                    .map(|e| {
+                        Some(Weighted {
+                            data: self.block_state(e.get("data")?)?,
+                            weight: int(e.get("weight"), 1),
+                        })
+                    })
+                    .collect::<Option<Vec<_>>>()?;
+                BlockStateProvider::Weighted(WeightedBlockStateProvider { entries })
+            }
+            "rotated_block_provider" | "rotated" => {
+                BlockStateProvider::Pillar(PillarBlockStateProvider {
+                    state: self.block_state(v.get("state")?)?,
+                })
+            }
+            "noise_provider" | "noise" => {
+                BlockStateProvider::NoiseProvider(NoiseBlockStateProvider {
+                    base: Self::noise_base(v),
+                    states: self.states(v.get("states"))?,
+                })
+            }
+            "dual_noise_provider" | "dual_noise" => {
+                // Either an inclusive range object or the older `[min, max]` pair.
+                let variety = |index: usize| {
+                    let range = v.get("variety")?;
+                    let key = ["min_inclusive", "max_inclusive"][index];
+                    range
+                        .get(index)
+                        .or_else(|| range.get(key))
+                        .and_then(Value::as_u64)
+                        .and_then(|n| u32::try_from(n).ok())
+                };
+                BlockStateProvider::DualNoise(DualNoiseBlockStateProvider {
+                    base: NoiseBlockStateProvider {
+                        base: Self::noise_base(v),
+                        states: self.states(v.get("states"))?,
+                    },
+                    variety: [variety(0).unwrap_or(2), variety(1).unwrap_or(4)],
+                    slow_noise: Self::noise_parameters(v.get("slow_noise")),
+                    slow_scale: float(v.get("slow_scale"), 1.0),
+                })
+            }
+            "noise_threshold_provider" | "noise_threshold" => {
+                BlockStateProvider::NoiseThreshold(NoiseThresholdBlockStateProvider {
+                    base: Self::noise_base(v),
+                    threshold: float32(v.get("threshold"), 0.0),
+                    high_chance: float32(v.get("high_chance"), 0.0),
+                    default_state: self.block_state(v.get("default_state")?)?,
+                    low_states: self.states(v.get("low_states"))?,
+                    high_states: self.states(v.get("high_states"))?,
+                })
+            }
+            "randomized_int_state_provider" | "randomized_int" => {
+                let property = v
+                    .get("property")
+                    .and_then(Value::as_str)
+                    .unwrap_or_default();
+                let Some(property) = pumpkin_data::PropertyKey::from_str(property) else {
+                    return self.invalid("block property", property);
+                };
+                BlockStateProvider::RandomizedInt(RandomizedIntBlockStateProvider {
+                    source: Box::new(self.state_provider(v.get("source"))?),
+                    property,
+                    values: self.int_provider(v.get("values"))?,
+                })
+            }
+            "rule_based_state_provider" | "rule_based" => {
+                let fallback = match v.get("fallback") {
+                    Some(f) if !f.is_null() => Some(Box::new(self.state_provider(Some(f))?)),
+                    _ => None,
+                };
+                let rules = v
+                    .get("rules")
+                    .and_then(Value::as_array)
+                    .map_or(&[][..], Vec::as_slice)
+                    .iter()
+                    .map(|rule| {
+                        Some(BlockStateRule {
+                            if_true: self.block_predicate(rule.get("if_true"))?,
+                            then: self.state_provider(rule.get("then"))?,
+                        })
+                    })
+                    .collect::<Option<Vec<_>>>()?;
+                BlockStateProvider::Rule(RuleBasedBlockStateProvider { fallback, rules })
+            }
+            _ => return self.unsupported("block state provider", ty),
+        })
+    }
+
+    fn rule_test(&mut self, v: Option<&Value>) -> Option<RuleTest> {
+        let v = v.unwrap_or(&Value::Null);
+        self.enter()?;
+        let result = self.rule_test_inner(v);
+        self.leave();
+        result
+    }
+
+    fn rule_test_inner(&mut self, v: &Value) -> Option<RuleTest> {
+        let ty = v
+            .get("predicate_type")
+            .and_then(Value::as_str)
+            .unwrap_or_default();
+        let probability = || float32(v.get("probability"), 0.5);
+        let block_id = |this: &mut Self| -> Option<BlockId> {
+            let name = v
+                .get("block")
+                .and_then(Value::as_str)
+                .unwrap_or("minecraft:stone");
+            Some(this.block(name)?.id)
+        };
+        Some(match ty.strip_prefix("minecraft:").unwrap_or(ty) {
+            "always_true" | "" => RuleTest::AlwaysTrue,
+            "block_match" => RuleTest::BlockMatch(BlockMatchRuleTest {
+                block: block_id(self)?,
+            }),
+            "blockstate_match" => RuleTest::BlockStateMatch(BlockStateMatchRuleTest {
+                block_state: self.block_state(v.get("block_state")?)?.id,
+            }),
+            "tag_match" => RuleTest::TagMatch(TagMatchRuleTest {
+                tag: self.block_tag(v.get("tag").and_then(Value::as_str).unwrap_or_default())?,
+            }),
+            "random_block_match" => RuleTest::RandomBlockMatch(RandomBlockMatchRuleTest {
+                block: block_id(self)?,
+                probability: probability(),
+            }),
+            "random_blockstate_match" => {
+                RuleTest::RandomBlockStateMatch(RandomBlockStateMatchRuleTest {
+                    block_state: self.block_state(v.get("block_state")?)?.id,
+                    probability: probability(),
+                })
+            }
+            "any_of" | "all_of" => {
+                let rules = v
+                    .get("rules")
+                    .and_then(Value::as_array)
+                    .map_or(&[][..], Vec::as_slice)
+                    .iter()
+                    .map(|rule| self.rule_test(Some(rule)))
+                    .collect::<Option<Vec<_>>>()?;
+                if ty.ends_with("any_of") {
+                    RuleTest::AnyOf(rules)
+                } else {
+                    RuleTest::AllOf(rules)
+                }
+            }
+            "not" => RuleTest::Not(Box::new(self.rule_test(v.get("rule"))?)),
+            "height_match" => RuleTest::HeightMatch {
+                min_inclusive: int(v.get("min_inclusive"), i32::MIN),
+                max_inclusive: int(v.get("max_inclusive"), i32::MAX),
+            },
+            _ => return self.unsupported("rule test", ty),
+        })
+    }
+
+    fn ore_targets(&mut self, v: Option<&Value>) -> Option<Vec<OreTarget>> {
+        v.and_then(Value::as_array)
+            .map_or(&[][..], Vec::as_slice)
+            .iter()
+            .map(|t| {
+                Some(OreTarget {
+                    target: self.rule_test(t.get("target"))?,
+                    state: self.block_state(t.get("state")?)?,
+                })
+            })
+            .collect()
+    }
+
+    // ---- configured features -------------------------------------------------------------
+
+    fn configured_feature(&mut self, v: &Value) -> Option<ConfiguredFeature> {
+        self.enter()?;
+        let result = self.configured_feature_inner(v);
+        self.leave();
+        result
+    }
+
+    #[expect(clippy::too_many_lines)]
+    fn configured_feature_inner(&mut self, v: &Value) -> Option<ConfiguredFeature> {
+        let ty = v.get("type").and_then(Value::as_str).unwrap_or_default();
+        let config = v.get("config").filter(|c| c.is_object()).unwrap_or(v);
+        let get = |key: &str| config.get(key);
+        Some(match ty.strip_prefix("minecraft:").unwrap_or(ty) {
+            "no_op" => ConfiguredFeature::NoOp,
+            "template" => ConfiguredFeature::Template(self.template_feature(config)?),
+            "simple_block" => ConfiguredFeature::SimpleBlock(SimpleBlockFeature {
+                to_place: self.state_provider(get("to_place"))?,
+                schedule_tick: get("schedule_tick").and_then(Value::as_bool),
+            }),
+            "ore" => ConfiguredFeature::Ore(OreFeature {
+                size: int(get("size"), 0),
+                discard_chance_on_air_exposure: float32(get("discard_chance_on_air_exposure"), 0.0),
+                targets: self.ore_targets(get("targets"))?,
+            }),
+            "scattered_ore" => ConfiguredFeature::ScatteredOre(ScatteredOreFeature {
+                size: int(get("size"), 0),
+                discard_chance_on_air_exposure: float32(get("discard_chance_on_air_exposure"), 0.0),
+                targets: self.ore_targets(get("targets"))?,
+            }),
+            "replace_single_block" => {
+                ConfiguredFeature::ReplaceSingleBlock(ReplaceSingleBlockFeature {
+                    targets: self.ore_targets(get("targets"))?,
+                })
+            }
+            "block_column" => {
+                let layers = get("layers")
+                    .and_then(Value::as_array)
+                    .map_or(&[][..], Vec::as_slice)
+                    .iter()
+                    .map(|layer| {
+                        Some(Layer {
+                            height: self.int_provider(layer.get("height"))?,
+                            provider: self.state_provider(layer.get("provider"))?,
+                        })
+                    })
+                    .collect::<Option<Vec<_>>>()?;
+                ConfiguredFeature::BlockColumn(BlockColumnFeature {
+                    layers,
+                    direction: self.direction(Some(
+                        get("direction").and_then(Value::as_str).unwrap_or("up"),
+                    ))?,
+                    allowed_placement: self.block_predicate(get("allowed_placement"))?,
+                    prioritize_tip: get("prioritize_tip")
+                        .and_then(Value::as_bool)
+                        .unwrap_or(false),
+                })
+            }
+            "random_patch" | "flower" | "no_bonemeal_flower" => {
+                let patch = RandomPatchFeature {
+                    tries: u8::try_from(uint(get("tries"), 128)).unwrap_or(u8::MAX),
+                    xz_spread: u8::try_from(uint(get("xz_spread"), 7)).unwrap_or(u8::MAX),
+                    y_spread: u8::try_from(uint(get("y_spread"), 3)).unwrap_or(u8::MAX),
+                    feature: Box::new(self.inline_placed_feature(get("feature")?)?),
+                };
+                match ty.strip_prefix("minecraft:").unwrap_or(ty) {
+                    "flower" => ConfiguredFeature::Flower(patch),
+                    "no_bonemeal_flower" => ConfiguredFeature::NoBonemealFlower(patch),
+                    _ => ConfiguredFeature::RandomPatch(patch),
+                }
+            }
+            "random_selector" => {
+                let features = get("features")
+                    .and_then(Value::as_array)
+                    .map_or(&[][..], Vec::as_slice)
+                    .iter()
+                    .map(|entry| {
+                        Some(RandomFeatureEntry {
+                            feature: self.placed_wrapper(entry.get("feature")?)?,
+                            chance: float32(entry.get("chance"), 0.1),
+                        })
+                    })
+                    .collect::<Option<Vec<_>>>()?;
+                ConfiguredFeature::RandomSelector(RandomFeature {
+                    features,
+                    default: Box::new(self.placed_wrapper(get("default")?)?),
+                })
+            }
+            "weighted_random_selector" => {
+                let entries = get("features")
+                    .and_then(Value::as_array)
+                    .map_or(&[][..], Vec::as_slice);
+                let weights: Vec<i32> = entries
+                    .iter()
+                    .map(|e| int(e.get("weight"), 1).max(0))
+                    .collect();
+                let features = entries
+                    .iter()
+                    .zip(&weights)
+                    .map(|(entry, weight)| {
+                        Some(WeightedRandomFeatureEntry {
+                            feature: self.placed_wrapper(entry.get("data")?)?,
+                            weight: *weight,
+                        })
+                    })
+                    .collect::<Option<Vec<_>>>()?;
+                ConfiguredFeature::WeightedRandomSelector(WeightedRandomFeature {
+                    features,
+                    total_weight: weights.iter().sum(),
+                })
+            }
+            "simple_random_selector" => {
+                let features = get("features")
+                    .and_then(Value::as_array)
+                    .map_or(&[][..], Vec::as_slice)
+                    .iter()
+                    .map(|f| self.inline_placed_feature(f))
+                    .collect::<Option<Vec<_>>>()?;
+                ConfiguredFeature::SimpleRandomSelector(SimpleRandomFeature { features })
+            }
+            "overlay" | "sequence" => {
+                let features = get("features")
+                    .and_then(Value::as_array)
+                    .map_or(&[][..], Vec::as_slice)
+                    .iter()
+                    .map(|f| self.placed_wrapper(f))
+                    .collect::<Option<Vec<_>>>()?;
+                if ty.ends_with("overlay") {
+                    ConfiguredFeature::Overlay(OverlayFeature { features })
+                } else {
+                    ConfiguredFeature::Sequence(SequenceFeature { features })
+                }
+            }
+            "sculk_patch" => ConfiguredFeature::SculkPatch(SculkPatchFeature {
+                charge_count: int(get("charge_count"), 1),
+                amount_per_charge: int(get("amount_per_charge"), 1),
+                spread_attempts: int(get("spread_attempts"), 1),
+                growth_rounds: int(get("growth_rounds"), 0),
+                spread_rounds: int(get("spread_rounds"), 0),
+            }),
+            "random_boolean_selector" => {
+                ConfiguredFeature::RandomBooleanSelector(RandomBooleanFeature {
+                    feature_true: Box::new(self.placed_wrapper(get("feature_true")?)?),
+                    feature_false: Box::new(self.placed_wrapper(get("feature_false")?)?),
+                })
+            }
+            "end_spike" => {
+                let spikes = get("spikes")
+                    .and_then(Value::as_array)
+                    .map_or(&[][..], Vec::as_slice)
+                    .iter()
+                    .map(|s| Spike {
+                        center_x: int(s.get("centerX"), 0),
+                        center_z: int(s.get("centerZ"), 0),
+                        radius: int(s.get("radius"), 0),
+                        height: int(s.get("height"), 0),
+                        guarded: s.get("guarded").and_then(Value::as_bool).unwrap_or(false),
+                    })
+                    .collect();
+                ConfiguredFeature::EndSpike(EndSpikeFeature {
+                    crystal_invulnerable: get("crystal_invulnerable")
+                        .and_then(Value::as_bool)
+                        .unwrap_or(false),
+                    spikes,
+                })
+            }
+            "end_gateway" => ConfiguredFeature::EndGateway(EndGatewayFeature {
+                exit: get("exit").and_then(Value::as_array).map(|exit| {
+                    BlockPos::new(
+                        exit.first().and_then(Value::as_i64).map_or(0, clamp_i32),
+                        exit.get(1).and_then(Value::as_i64).map_or(0, clamp_i32),
+                        exit.get(2).and_then(Value::as_i64).map_or(0, clamp_i32),
+                    )
+                }),
+                exact: get("exact").and_then(Value::as_bool).unwrap_or(false),
+            }),
+            "end_island" => ConfiguredFeature::EndIsland(EndIslandFeature {}),
+            "end_platform" => ConfiguredFeature::EndPlatform(EndPlatformFeature),
+            "end_podium" => ConfiguredFeature::EndPodium(EndPodiumFeature::new(
+                get("active").and_then(Value::as_bool).unwrap_or(false),
+            )),
+            "chorus_plant" => ConfiguredFeature::ChorusPlant(ChorusPlantFeature {}),
+            "glowstone_blob" => ConfiguredFeature::GlowstoneBlob(GlowstoneBlobFeature {}),
+            "disk" => ConfiguredFeature::Disk(DiskFeature {
+                state_provider: self.state_provider(get("state_provider"))?,
+                target: self.block_predicate(get("target"))?,
+                radius: self.int_provider(get("radius"))?,
+                half_height: int(get("half_height"), 1),
+            }),
+            "netherrack_replace_blobs" => {
+                ConfiguredFeature::NetherrackReplaceBlobs(ReplaceBlobsFeature {
+                    target: self.block_state(get("target")?)?,
+                    state: self.block_state(get("state")?)?,
+                    radius: self.int_provider(get("radius"))?,
+                })
+            }
+            "multiface_growth" => {
+                let place_block = self.block(
+                    get("block")
+                        .and_then(Value::as_str)
+                        .unwrap_or("minecraft:glow_lichen"),
+                )?;
+                let can_be_placed_on = match get("can_be_placed_on") {
+                    Some(Value::String(tag)) if tag.starts_with('#') => self
+                        .block_tag(tag)?
+                        .0
+                        .iter()
+                        .filter_map(|name| Some(Block::from_registry_key(name)?.id))
+                        .collect(),
+                    Some(Value::Array(list)) => list
+                        .iter()
+                        .filter_map(Value::as_str)
+                        .map(|name| Some(self.block(name)?.id))
+                        .collect::<Option<Vec<_>>>()?,
+                    Some(Value::String(name)) => vec![self.block(name)?.id],
+                    _ => Vec::new(),
+                };
+                let flag = |key| get(key).and_then(Value::as_bool).unwrap_or(false);
+                ConfiguredFeature::MultifaceGrowth(MultifaceGrowthFeature {
+                    place_block: place_block.id,
+                    search_range: int(get("search_range"), 10),
