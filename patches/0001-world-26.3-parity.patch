@@ -0,0 +1,62 @@
+//! Embeds the vanilla worldgen JSON that runtime datapack loading resolves `minecraft:*` references against.
+
+use std::fmt::Write as _;
+use std::path::{Path, PathBuf};
+use std::{env, fs};
+
+const KINDS: [&str; 6] = [
+    "density_function",
+    "noise",
+    "material_rule",
+    "material_condition",
+    "noise_settings",
+    "carver",
+];
+
+fn collect(root: &Path, dir: &Path, out: &mut Vec<(String, PathBuf)>) {
+    let Ok(entries) = fs::read_dir(dir) else {
+        return;
+    };
+    let mut entries: Vec<_> = entries.flatten().map(|e| e.path()).collect();
+    entries.sort();
+    for path in entries {
+        if path.is_dir() {
+            collect(root, &path, out);
+        } else if path.extension().is_some_and(|ext| ext == "json")
+            && let Ok(rel) = path.strip_prefix(root)
+        {
+            let id = rel
+                .with_extension("")
+                .components()
+                .map(|c| c.as_os_str().to_string_lossy().into_owned())
+                .collect::<Vec<_>>()
+                .join("/");
+            out.push((id, path));
+        }
+    }
+}
+
+fn main() {
+    let manifest = PathBuf::from(env::var("CARGO_MANIFEST_DIR").unwrap_or_default());
+    let base = manifest.join("../../assets/datapack/data/minecraft/worldgen");
+    println!("cargo:rerun-if-changed={}", base.display());
+
+    let mut table = String::from("pub static VANILLA_WORLDGEN: &[(&str, &str, &str)] = &[\n");
+    for kind in KINDS {
+        let root = base.join(kind);
+        let mut files = Vec::new();
+        collect(&root, &root, &mut files);
+        for (id, path) in files {
+            let path = path.canonicalize().unwrap_or(path);
+            let _ = writeln!(
+                table,
+                "    ({kind:?}, {id:?}, include_str!({:?})),",
+                path.display().to_string()
+            );
+        }
+    }
+    table.push_str("];\n");
+
+    let out = PathBuf::from(env::var("OUT_DIR").unwrap_or_default()).join("vanilla_worldgen.rs");
+    let _ = fs::write(out, table);
+}
