+//! Structures, structure sets and their biomes built from datapacks at runtime.
+//!
+//! Jigsaw structures of the packs become runtime structures (`StructureKeys::Dynamic`); their template
+//! pools, processor lists and templates are registered with the jigsaw machinery, which resolves
+//! them by id. Structure sets of the packs are added to the generated ones, replacing a generated one
+//! of the same id. Biome tags (`tags/worldgen/biome`) of the packs extend the biomes of the generated
+//! structures.
+
+use std::sync::{Arc, LazyLock, Mutex, PoisonError};
+
+use pumpkin_data::structures::{
+    BoundingBoxType, ConcentricRingsStructurePlacement, ExclusionZone, FrequencyReductionMethod, GenerationStep, HeightProvider,
+    PoolAliasBinding, RandomSpreadStructurePlacement, SpawnEntry, SpawnOverride, SpreadType,
+    Structure, StructureKeys, StructurePlacement, StructurePlacementType, StructureSet,
+    StructureType, TerrainAdaptation, TrapezoidHeightProvider, UniformHeightProvider,
+    VeryBiasedToBottomHeightProvider, WeightedEntry, WeightedPoolAliasGroup,
+    WeightedPoolAliasTarget,
+};
+use pumpkin_data::structures_dynamic;
+use rustc_hash::FxHashMap;
+use serde_json::Value;
+use tracing::{info, warn};
+
+use super::carver::y_offset;
+use super::{
+    DatapackSet, PROCESSOR_LIST, Result, STRUCTURE, STRUCTURE_SET, TEMPLATE_POOL, normalize_id,
+};
+use crate::generation::structure::structures::jigsaw::register_pack_template_pool_json;
+use crate::generation::structure::template::{
+    global_cache, processor::register_pack_processor_list,
+};
+
+/// What the packs change about structures.
+pub struct RuntimeStructures {
+    /// Every structure set by registry name: the generated ones first, in the order of
+    /// `StructureSet::ALL` (replaced in place when a pack defines the same id), then the packs' own.
+    pub sets: Vec<(String, &'static StructureSet)>,
+    /// The biomes of the structures whose biomes a pack changed, and of the pack's own structures.
+    pub biomes: FxHashMap<StructureKeys, &'static [u16]>,
+    /// The structures of each generation step, in registry order (vanilla `Structure` registry:
+    /// by path, then namespace). The index in the list seeds the structure's placement.
+    pub steps: [Vec<StructureKeys>; 11],
+    /// The biomes of the preferred biome tags of concentric rings placements that differ from the
+    /// generated tags, by tag (`#namespace:path`): a pack changed the tag, or the tag is its own.
+    pub ring_biomes: FxHashMap<&'static str, &'static [u16]>,
+    /// Lithostitched is among the packs with `breaks_seed_parity`: jigsaw structures are placed like
+    /// its `AlternateJigsawGenerator` does.
+    pub alternate_jigsaw: bool,
+}
+
+fn leak<T>(value: T) -> &'static T {
+    Box::leak(Box::new(value))
+}
+
+fn leak_str(text: &str) -> &'static str {
+    Box::leak(text.to_string().into_boxed_str())
+}
+
+fn leak_slice<T>(values: Vec<T>) -> &'static [T] {
+    Box::leak(values.into_boxed_slice())
+}
+
+static CACHE: LazyLock<Mutex<FxHashMap<String, Option<&'static RuntimeStructures>>>> =
+    LazyLock::new(|| Mutex::new(FxHashMap::default()));
+
+/// The structure data of `set`, or `None` when the packs leave structures as they are or cannot be used.
+/// Each distinct set of packs is built once and lives for the rest of the process.
+#[must_use]
+pub fn load_structures(set: &DatapackSet) -> Option<&'static RuntimeStructures> {
+    let key = set.fingerprint().to_string();
+    if let Some(found) = CACHE
+        .lock()
+        .unwrap_or_else(PoisonError::into_inner)
+        .get(&key)
+    {
+        return *found;
+    }
+    register_dimension_biomes(set);
+    let built = build(set).map(leak);
+    CACHE
+        .lock()
+        .unwrap_or_else(PoisonError::into_inner)
+        .insert(key, built);
+    built
+}
+
+/// Gives every biome of the packs' inline dimension biome sources an id before the structures'
+/// biome tags are resolved: the structure data is shared by all dimensions, so the Nether's and
+/// the End's pack biomes (Nullscape's `shadowlands` in `#c:end_islands`) must resolve too even
+/// when the Overworld loads first.
+fn register_dimension_biomes(set: &DatapackSet) {
+    for dimension in ["minecraft:overworld", "minecraft:the_nether", "minecraft:the_end"] {
+        let biomes = set
+            .pack_json(super::DIMENSION, dimension)
+            .and_then(|json| json.get("generator")?.get("biome_source")?.get("biomes")?.as_array());
+        for name in biomes
+            .into_iter()
+            .flatten()
+            .filter_map(|entry| entry.get("biome")?.as_str())
+        {
+            let _ = crate::biome::unknown::biome_for_name(name);
+        }
+    }
+}
+
+fn sorted(ids: &[u16]) -> Vec<u16> {
+    let mut ids = ids.to_vec();
+    ids.sort_unstable();
+    ids.dedup();
+    ids
+}
+
+/// The biomes a structure's `biomes` field names: a `#tag`, a biome id or a list of them.
+fn holder_set(set: &DatapackSet, value: &Value) -> Result<Vec<u16>> {
+    let mut ids = Vec::new();
+    let mut add = |entry: &str| -> Result<()> {
+        if let Some(tag) = entry.strip_prefix('#') {
+            ids.extend(
+                set.biome_tag(tag)
+                    .ok_or_else(|| format!("unknown biome tag {entry}"))?,
+            );
+        } else if let Some(id) = crate::biome::unknown::lookup_id(entry) {
+            ids.push(u16::from(id));
+        }
+        Ok(())
+    };
+    match value {
+        Value::String(entry) => add(entry)?,
+        Value::Array(list) => {
+            for entry in list.iter().filter_map(Value::as_str) {
+                add(entry)?;
+            }
+        }
+        other => return Err(format!("invalid biomes {other}")),
+    }
+    Ok(sorted(&ids))
+}
+
+fn generation_step(name: &str) -> Option<GenerationStep> {
+    Some(match name {
+        "raw_generation" => GenerationStep::RawGeneration,
+        "lakes" => GenerationStep::Lakes,
+        "local_modifications" => GenerationStep::LocalModifications,
+        "underground_structures" => GenerationStep::UndergroundStructures,
+        "surface_structures" => GenerationStep::SurfaceStructures,
+        "strongholds" => GenerationStep::Strongholds,
+        "underground_ores" => GenerationStep::UndergroundOres,
+        "underground_decoration" => GenerationStep::UndergroundDecoration,
+        "fluid_springs" => GenerationStep::FluidSprings,
+        "vegetal_decoration" => GenerationStep::VegetalDecoration,
+        "top_layer_modification" => GenerationStep::TopLayerModification,
+        _ => return None,
+    })
+}
+
+fn terrain_adaptation(name: &str) -> Option<TerrainAdaptation> {
+    Some(match name {
+        "none" => TerrainAdaptation::None,
+        "beard_thin" => TerrainAdaptation::BeardThin,
+        "beard_box" => TerrainAdaptation::BeardBox,
+        "bury" => TerrainAdaptation::Bury,
+        "encapsulate" => TerrainAdaptation::Encapsulate,
+        _ => return None,
+    })
+}
+
+fn short_name(value: &Value) -> &str {
+    let name = value.as_str().unwrap_or_default();
+    name.strip_prefix("minecraft:").unwrap_or(name)
+}
+
+fn int(value: &Value, key: &str) -> Option<i32> {
+    value
+        .get(key)
+        .and_then(Value::as_i64)
+        .and_then(|n| i32::try_from(n).ok())
+}
+
+fn height_provider(value: &Value) -> Result<HeightProvider> {
+    let anchor = |key: &str| y_offset(value.get(key).unwrap_or(&Value::Null));
+    let ty = value.get("type").and_then(Value::as_str);
+    let inner = value
+        .get("inner")
+        .and_then(Value::as_u64)
+        .and_then(|n| u32::try_from(n).ok())
+        .and_then(std::num::NonZero::new);
+    Ok(
+        match ty.map(|t| t.strip_prefix("minecraft:").unwrap_or(t)) {
+            // A bare anchor is a constant height.
+            None => {
+                let y = y_offset(value);
+                HeightProvider::Uniform(UniformHeightProvider {
+                    min_inclusive: y,
+                    max_inclusive: y,
+                })
+            }
+            Some("constant") => {
+                let y = y_offset(value.get("value").unwrap_or(&Value::Null));
+                HeightProvider::Uniform(UniformHeightProvider {
+                    min_inclusive: y,
+                    max_inclusive: y,
+                })
+            }
+            Some("uniform") => HeightProvider::Uniform(UniformHeightProvider {
+                min_inclusive: anchor("min_inclusive"),
+                max_inclusive: anchor("max_inclusive"),
+            }),
+            Some("trapezoid") => HeightProvider::Trapezoid(TrapezoidHeightProvider {
+                min_inclusive: anchor("min_inclusive"),
+                max_inclusive: anchor("max_inclusive"),
+                plateau: int(value, "plateau"),
+            }),
+            Some("very_biased_to_bottom") => {
+                HeightProvider::VeryBiasedToBottom(VeryBiasedToBottomHeightProvider {
+                    min_inclusive: anchor("min_inclusive"),
+                    max_inclusive: anchor("max_inclusive"),
+                    inner,
+                })
+            }
+            Some(other) => return Err(format!("unsupported start height {other}")),
+        },
+    )
+}
+
+fn pool_alias(value: &Value) -> Option<PoolAliasBinding> {
+    let text = |key: &str| value.get(key).and_then(Value::as_str).map(leak_str);
+    let weight = |entry: &Value| {
+        entry
+            .get("weight")
+            .and_then(Value::as_u64)
+            .and_then(|n| u32::try_from(n).ok())
+            .unwrap_or(1)
+    };
+    let ty = short_name(value.get("type")?);
+    Some(match ty {
+        "direct" => PoolAliasBinding::Direct {
+            alias: text("alias")?,
+            target: text("target")?,
+        },
+        "random" => PoolAliasBinding::Random {
+            alias: text("alias")?,
+            targets: leak_slice(
+                value
+                    .get("targets")?
+                    .as_array()?
+                    .iter()
+                    .map(|entry| {
+                        Some(WeightedPoolAliasTarget {
+                            target: entry.get("data")?.as_str().map(leak_str)?,
+                            weight: weight(entry),
+                        })
+                    })
+                    .collect::<Option<Vec<_>>>()?,
+            ),
+        },
+        "random_group" => PoolAliasBinding::RandomGroup {
+            groups: leak_slice(
+                value
+                    .get("groups")?
+                    .as_array()?
+                    .iter()
+                    .map(|entry| {
+                        Some(WeightedPoolAliasGroup {
+                            bindings: leak_slice(
+                                entry
+                                    .get("data")?
+                                    .as_array()?
+                                    .iter()
+                                    .map(pool_alias)
+                                    .collect::<Option<Vec<_>>>()?,
+                            ),
+                            weight: weight(entry),
+                        })
+                    })
+                    .collect::<Option<Vec<_>>>()?,
+            ),
+        },
+        _ => return None,
+    })
+}
+
+fn spawn_overrides(value: &Value) -> Vec<SpawnOverride> {
+    let Some(map) = value.as_object() else {
+        return Vec::new();
+    };
+    map.iter()
+        .map(|(category, entry)| SpawnOverride {
+            category: leak_str(category),
+            bounding_box: if entry.get("bounding_box").and_then(Value::as_str) == Some("piece") {
+                BoundingBoxType::Piece
+            } else {
+                BoundingBoxType::Full
+            },
+            spawns: leak_slice(
+                entry
+                    .get("spawns")
+                    .and_then(Value::as_array)
+                    .map(|spawns| {
+                        spawns
+                            .iter()
+                            .filter_map(|spawn| {
+                                let count = |key: &str| {
+                                    spawn
+                                        .get(key)
+                                        .and_then(Value::as_u64)
+                                        .and_then(|n| u32::try_from(n).ok())
+                                        .unwrap_or(1)
+                                };
+                                Some(SpawnEntry {
+                                    entity_type: spawn.get("type")?.as_str().map(leak_str)?,
+                                    min_count: count("minCount"),
+                                    max_count: count("maxCount"),
+                                    weight: count("weight"),
+                                })
+                            })
+                            .collect()
+                    })
+                    .unwrap_or_default(),
+            ),
+        })
+        .collect()
+}
+
+/// A `minecraft:jigsaw` structure definition (`worldgen/structure/<name>.json`).
+fn jigsaw_structure(json: &Value) -> Result<Structure> {
+    let ty = short_name(json.get("type").unwrap_or(&Value::Null));
+    if ty != "jigsaw" {
+        return Err(format!("structure type {ty} is not supported"));
+    }
+    let step = generation_step(short_name(json.get("step").unwrap_or(&Value::Null)))
+        .ok_or("missing generation step")?;
+    let adaptation = json
+        .get("terrain_adaptation")
+        .and_then(Value::as_str)
+        .map_or(Some(TerrainAdaptation::None), terrain_adaptation)
+        .ok_or("invalid terrain adaptation")?;
+    let start_pool = json
+        .get("start_pool")
+        .and_then(Value::as_str)
+        .ok_or("missing start pool")?;
+    let padding = json.get("dimension_padding");
+    let (bottom, top) = match padding {
+        Some(Value::Object(_)) => (
+            padding.and_then(|p| int(p, "bottom")),
+            padding.and_then(|p| int(p, "top")),
+        ),
+        Some(single) => {
+            let both = single.as_i64().and_then(|n| i32::try_from(n).ok());
+            (both, both)
+        }
+        None => (None, None),
+    };
+    let distance = json.get("max_distance_from_center");
+    Ok(Structure {
+        biomes: "",
+        step,
+        start_pool: Some(leak_str(start_pool)),
+        start_jigsaw_name: json
+            .get("start_jigsaw_name")
+            .and_then(Value::as_str)
+            .map(leak_str),
+        size: int(json, "size").or(Some(7)),
+        terrain_adaptation: adaptation,
+        start_height: json.get("start_height").map(height_provider).transpose()?,
+        project_start_to_heightmap: json
+            .get("project_start_to_heightmap")
+            .and_then(Value::as_str)
+            .map(leak_str),
+        max_distance_from_center: match distance {
+            Some(Value::Object(_)) => distance.and_then(|d| int(d, "horizontal")),
+            Some(single) => single.as_i64().and_then(|n| i32::try_from(n).ok()),
+            None => None,
+        },
+        liquid_settings: json
+            .get("liquid_settings")
+            .and_then(Value::as_str)
+            .map(leak_str),
+        dimension_padding: bottom,
+        dimension_padding_top: top,
+        use_expansion_hack: json.get("use_expansion_hack").and_then(Value::as_bool),
+        pool_aliases: leak_slice(
+            json.get("pool_aliases")
+                .and_then(Value::as_array)
+                .map(|list| list.iter().filter_map(pool_alias).collect())
+                .unwrap_or_default(),
+        ),
+        spawn_overrides: leak_slice(
+            json.get("spawn_overrides")
+                .map(spawn_overrides)
+                .unwrap_or_default(),
+        ),
+        is_beached: None,
+        mineshaft_type: None,
+        biome_temp: None,
+        cluster_probability: None,
+        large_probability: None,
+        structure_type: StructureType::Jigsaw,
+    })
+}
+
+fn frequency_reduction_method(name: &str) -> Option<FrequencyReductionMethod> {
+    Some(match name {
+        "default" => FrequencyReductionMethod::Default,
+        "legacy_type_1" => FrequencyReductionMethod::LegacyType1,
+        "legacy_type_2" => FrequencyReductionMethod::LegacyType2,
+        "legacy_type_3" => FrequencyReductionMethod::LegacyType3,
+        _ => return None,
+    })
+}
+
+/// A `minecraft:random_spread` or `minecraft:concentric_rings` structure placement.
+fn placement(json: &Value) -> Result<StructurePlacement> {
+    let ty = short_name(json.get("type").unwrap_or(&Value::Null));
+    let placement_type = match ty {
+        "random_spread" => {
+            let spacing = int(json, "spacing").ok_or("missing spacing")?;
+            let separation = int(json, "separation").ok_or("missing separation")?;
+            if spacing <= 0 || separation < 0 || separation >= spacing {
+                return Err(format!(
+                    "invalid spacing {spacing} and separation {separation}"
+                ));
+            }
+            let spread_type = match json.get("spread_type").and_then(Value::as_str) {
+                None => None,
+                Some(name) => Some(match name.strip_prefix("minecraft:").unwrap_or(name) {
+                    "linear" => SpreadType::Linear,
+                    "triangular" => SpreadType::Triangular,
+                    other => return Err(format!("unknown spread type {other}")),
+                }),
+            };
+            StructurePlacementType::RandomSpread(RandomSpreadStructurePlacement {
+                spacing,
+                separation,
+                spread_type,
+            })
+        }
+        "concentric_rings" => {
+            let distance = int(json, "distance").ok_or("missing distance")?;
+            let spread = int(json, "spread").ok_or("missing spread")?;
+            let count = int(json, "count").ok_or("missing count")?;
+            if distance <= 0 || spread <= 0 || count <= 0 {
+                return Err(format!(
+                    "invalid rings: distance {distance}, spread {spread}, count {count}"
+                ));
+            }
+            let biomes = json
+                .get("preferred_biomes")
+                .and_then(Value::as_str)
+                .ok_or("preferred_biomes must be a biome tag")?;
+            StructurePlacementType::ConcentricRings(ConcentricRingsStructurePlacement {
+                spread,
+                distance,
+                count,
+                preferred_biomes: leak_str(&normalize_biome_tag(biomes)),
+            })
+        }
+        _ => return Err(format!("structure placement {ty} is not supported")),
+    };
+    // Packs write large salts, which wrap like the 32 bit seed arithmetic that uses them.
+    let salt = json
+        .get("salt")
+        .and_then(Value::as_i64)
+        .map(|n| n as u32)
+        .ok_or("invalid salt")?;
+    Ok(StructurePlacement {
+        frequency_reduction_method: json
+            .get("frequency_reduction_method")
+            .and_then(Value::as_str)
+            .and_then(|name| {
+                frequency_reduction_method(name.strip_prefix("minecraft:").unwrap_or(name))
+            }),
+        frequency: json
+            .get("frequency")
+            .and_then(Value::as_f64)
+            .map(|f| f as f32),
+        salt,
+        exclusion_zone: json.get("exclusion_zone").and_then(|zone| {
+            Some(ExclusionZone {
+                other_set: leak_str(zone.get("other_set")?.as_str()?),
+                chunk_count: int(zone, "chunk_count")?,
+            })
+        }),
+        placement_type,
+    })
+}
+
+/// `#namespace:path` of a biome tag, with the default namespace made explicit.
+fn normalize_biome_tag(tag: &str) -> String {
+    format!("#{}", normalize_id(tag.strip_prefix('#').unwrap_or(tag)))
+}
+
+/// Reads one structure set (`worldgen/structure_set/<name>.json`). `resolve` maps a structure id to its key.
+fn structure_set(
+    json: &Value,
+    resolve: &impl Fn(&str) -> Option<StructureKeys>,
+) -> Result<StructureSet> {
+    let placement = placement(json.get("placement").ok_or("missing placement")?)?;
+    let mut structures = Vec::new();
+    for entry in json
+        .get("structures")
+        .and_then(Value::as_array)
+        .ok_or("missing structures")?
+    {
+        let id = entry
+            .get("structure")
+            .and_then(Value::as_str)
+            .ok_or("missing structure")?;
+        // A structure of a mod that is not installed is left out, as for a dangling holder.
+        let Some(structure) = resolve(id) else {
+            warn!("worldgen datapack: structure {id} is unknown, left out of its set");
+            continue;
+        };
+        structures.push(WeightedEntry {
+            structure,
+            weight: entry
+                .get("weight")
+                .and_then(Value::as_u64)
+                .and_then(|n| u32::try_from(n).ok())
+                .unwrap_or(1),
+        });
+    }
+    if structures.is_empty() {
+        return Err("no known structure".to_string());
+    }
+    Ok(StructureSet {
+        placement,
+        structures: leak_slice(structures),
+    })
+}
+
+/// Replaces the `#tag` in the `processor_lists` of `apply_random` processors with the lists it holds,
+/// so the processor needs no access to the packs.
+fn expand_processor_list_tags(set: &DatapackSet, json: &mut Value) {
+    match json {
+        Value::Object(map) => {
+            if let Some(Value::String(tag)) = map.get("processor_lists")
+                && let Some(tag) = tag.strip_prefix('#')
+            {
+                let lists = set.processor_list_tag(tag);
+                map.insert("processor_lists".to_string(), Value::from(lists));
+            }
+            for child in map.values_mut() {
+                expand_processor_list_tags(set, child);
+            }
+        }
+        Value::Array(list) => {
+            for child in list {
+                expand_processor_list_tags(set, child);
+            }
+        }
+        _ => {}
+    }
+}
+
+/// Hands the pools, processor lists and templates of the packs to the jigsaw machinery.
+fn register_resources(set: &DatapackSet) {
+    let mut pools = 0;
+    for id in set.pack_ids(TEMPLATE_POOL) {
+        let Some(json) = set.pack_json(TEMPLATE_POOL, id) else {
+            continue;
+        };
+        match register_pack_template_pool_json(id, &json.to_string()) {
+            Ok(_) => pools += 1,
+            Err(err) => warn!("worldgen datapack: template pool {id}: {err}"),
+        }
+    }
+    let mut lists = 0;
+    for id in set.pack_ids(PROCESSOR_LIST) {
+        let Some(json) = set.pack_json(PROCESSOR_LIST, id) else {
+            continue;
+        };
+        let mut json = json.clone();
+        expand_processor_list_tags(set, &mut json);
+        match register_pack_processor_list(id, &json.to_string()) {
+            Ok(_) => lists += 1,
+            Err(err) => warn!("worldgen datapack: processor list {id}: {err}"),
+        }
+    }
+    for (id, template) in set.templates() {
+        let template = template.clone();
+        global_cache().register_pack_template_loader(id, Arc::new(move || template.read()));
+    }
+    info!(
+        "worldgen datapack: {pools} template pools, {lists} processor lists, {} templates",
+        set.templates().len()
+    );
+}
+
+fn build(set: &DatapackSet) -> Option<RuntimeStructures> {
+    let structure_ids = set.pack_ids(STRUCTURE);
+    let set_ids = set.pack_ids(STRUCTURE_SET);
+
+    // The biomes of generated structures, where a pack's tags changed them.
+    let mut biomes: FxHashMap<StructureKeys, &'static [u16]> = FxHashMap::default();
+    for name in StructureKeys::all_names() {
+        let Some(key) = StructureKeys::from_name(name) else {
+            continue;
+        };
+        let tag = Structure::get(&key).biomes;
+        let tag = tag.strip_prefix('#').unwrap_or(tag);
+        let Some(vanilla) =
+            pumpkin_data::tag::get_tag_ids(pumpkin_data::tag::RegistryKey::WorldgenBiome, tag)
+        else {
+            continue;
+        };
+        if let Some(merged) = set.biome_tag(tag) {
+            let merged = sorted(&merged);
+            if merged != sorted(vanilla) {
+                biomes.insert(key, leak_slice(merged));
+            }
+        }
+    }
+    let mut ring_biomes: FxHashMap<&'static str, &'static [u16]> = FxHashMap::default();
+    for set_placement in StructureSet::ALL.iter().map(|set| &set.placement) {
+        add_ring_biomes(set, set_placement, &mut ring_biomes);
+    }
+    let alternate_jigsaw =
+        set.mods().contains("lithostitched") && set.config().breaks_seed_parity();
+    if structure_ids.is_empty()
+        && set_ids.is_empty()
+        && biomes.is_empty()
+        && ring_biomes.is_empty()
+        && !alternate_jigsaw
+    {
+        return None;
+    }
+
+    register_resources(set);
+
+    let scope = set.fingerprint();
+    let mut pack_keys: FxHashMap<String, StructureKeys> = FxHashMap::default();
+    for id in structure_ids {
+        let Some(json) = set.pack_json(STRUCTURE, id) else {
+            continue;
+        };
+        let parsed = jigsaw_structure(json).and_then(|structure| {
+            let ids = holder_set(set, json.get("biomes").unwrap_or(&Value::Null))?;
+            Ok((structure, ids))
+        });
+        match parsed {
+            Ok((structure, ids)) => {
+                let Some(key) = structures_dynamic::register_structure(scope, id, structure) else {
+                    warn!("worldgen datapack: too many structures, {id} is left out");
+                    continue;
+                };
+                biomes.insert(key, leak_slice(ids));
+                pack_keys.insert(normalize_id(id), key);
+            }
+            Err(err) => warn!("worldgen datapack: structure {id}: {err}"),
+        }
+    }
+
+    let resolve = |id: &str| -> Option<StructureKeys> {
+        let full = normalize_id(id);
+        pack_keys
+            .get(&full)
+            .copied()
+            .or_else(|| StructureKeys::from_name(&full))
+    };
+    let mut sets: Vec<(String, &'static StructureSet)> = StructureSet::NAMES
+        .iter()
+        .map(|name| (*name).to_string())
+        .zip(StructureSet::ALL.iter())
+        .collect();
+    for id in set_ids {
+        let Some(json) = set.pack_json(STRUCTURE_SET, id) else {
+            continue;
+        };
+        let runtime_set = match structure_set(json, &resolve) {
+            Ok(runtime_set) => leak(runtime_set),
+            Err(err) => {
+                warn!("worldgen datapack: structure set {id}: {err}");
+                continue;
+            }
+        };
+        add_ring_biomes(set, &runtime_set.placement, &mut ring_biomes);
+        structures_dynamic::register_structure_set(id, runtime_set);
+        let full = normalize_id(id);
+        let generated = full
+            .strip_prefix("minecraft:")
+            .and_then(|short| sets.iter().position(|(name, _)| name == short));
+        match generated {
+            Some(index) => sets[index].1 = runtime_set,
+            None => sets.push((full, runtime_set)),
+        }
+    }
+    info!(
+        "worldgen datapack: {} structure sets, {} pack structures",
+        sets.len(),
+        pack_keys.len()
+    );
+    Some(RuntimeStructures {
+        sets,
+        biomes,
+        ring_biomes,
+        steps: structure_steps(&pack_keys),
+        alternate_jigsaw,
+    })
+}
+
+/// Records the biomes of `placement`'s preferred biome tag when they differ from the generated tag.
+fn add_ring_biomes(
+    set: &DatapackSet,
+    placement: &StructurePlacement,
+    out: &mut FxHashMap<&'static str, &'static [u16]>,
+) {
+    let StructurePlacementType::ConcentricRings(rings) = &placement.placement_type else {
+        return;
+    };
+    let tag = rings.preferred_biomes.strip_prefix('#').unwrap_or(rings.preferred_biomes);
+    let merged = sorted(&set.biome_tag(tag).unwrap_or_default());
+    let vanilla = pumpkin_data::tag::get_tag_ids(pumpkin_data::tag::RegistryKey::WorldgenBiome, tag);
+    if vanilla.is_none_or(|vanilla| sorted(vanilla) != merged) {
+        out.insert(rings.preferred_biomes, leak_slice(merged));
+    }
+}
+
+/// The structures of each generation step in registry order: by path, then namespace, a structure of a
+/// pack replacing the generated one of the same id.
+fn structure_steps(pack_keys: &FxHashMap<String, StructureKeys>) -> [Vec<StructureKeys>; 11] {
+    let mut every: Vec<(String, StructureKeys)> = StructureKeys::all_names()
+        .iter()
+        .filter_map(|name| Some((normalize_id(name), StructureKeys::from_name(name)?)))
+        .collect();
+    for (id, key) in pack_keys {
+        match every.iter_mut().find(|(name, _)| name == id) {
+            Some(slot) => slot.1 = *key,
+            None => every.push((id.clone(), *key)),
+        }
+    }
+    every.sort_by(|(a, _), (b, _)| {
+        let (a_namespace, a_path) = a.split_once(':').unwrap_or(("", a));
+        let (b_namespace, b_path) = b.split_once(':').unwrap_or(("", b));
+        a_path
+            .cmp(b_path)
+            .then_with(|| a_namespace.cmp(b_namespace))
+    });
+    let mut steps: [Vec<StructureKeys>; 11] = Default::default();
+    for (_, key) in every {
+        steps[Structure::get(&key).step.ordinal()].push(key);
+    }
+    steps
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
