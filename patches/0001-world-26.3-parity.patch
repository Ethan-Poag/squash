--- /dev/null
+++ b/crates/pumpkin-world/src/generation/feature/features/sequence.rs
@@ -0,0 +1,69 @@
+use pumpkin_util::{math::position::BlockPos, random::RandomGenerator};
+
+use crate::{
+    generation::{feature::placed_features::PlacedFeatureWrapper, proto_chunk::GenerationCache},
+    world::WorldPortalExt,
+};
+
+/// Places its features in order at the origin and stops at the first one that fails.
+pub struct SequenceFeature {
+    pub features: Vec<PlacedFeatureWrapper>,
+}
+
+impl SequenceFeature {
+    #[expect(clippy::too_many_arguments)]
+    pub fn generate<T: GenerationCache>(
+        &self,
+        chunk: &mut T,
+        block_registry: &dyn WorldPortalExt,
+        min_y: i8,
+        height: u16,
+        feature_name: pumpkin_data::placed_feature::PlacedFeature,
+        random: &mut RandomGenerator,
+        origin: BlockPos,
+    ) -> bool {
+        for feature_wrapper in &self.features {
+            let Some(placed_feature) = feature_wrapper.get() else {
+                return false;
+            };
+            if !placed_feature.generate(
+                chunk,
+                block_registry,
+                min_y,
+                height,
+                feature_wrapper.name_or(feature_name),
+                random,
+                origin,
+            ) {
+                return false;
+            }
+        }
+        true
+    }
+
+    /// Same as [`Self::generate`] for a proto chunk, so nested sculk patches get bounds-aware access.
+    pub fn generate_in_proto_chunk(
+        &self,
+        chunk: &mut crate::ProtoChunk,
+        block_registry: &dyn WorldPortalExt,
+        feature_name: pumpkin_data::placed_feature::PlacedFeature,
+        random: &mut RandomGenerator,
+        origin: BlockPos,
+    ) -> bool {
+        for feature_wrapper in &self.features {
+            let Some(placed_feature) = feature_wrapper.get() else {
+                return false;
+            };
+            if !placed_feature.generate_in_proto_chunk(
+                chunk,
+                block_registry,
+                feature_wrapper.name_or(feature_name),
+                random,
+                origin,
+            ) {
+                return false;
+            }
+        }
+        true
+    }
+}
