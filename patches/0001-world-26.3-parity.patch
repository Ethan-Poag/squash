+/// A pack that repeats vanilla's overworld settings and biome list generates what the generated data does.
+#[test]
+fn vanilla_overworld_in_a_pack_generates_identical_chunks() {
+    use std::fmt::Write as _;
+
+    use pumpkin_data::chunk::OVERWORLD_BIOME_SOURCE;
+    use pumpkin_data::dimension::Dimension;
+    use pumpkin_util::world_seed::Seed;
+
+    use super::VANILLA_WORLDGEN;
+    use super::runtime::load_dimension_generation;
+    use super::tests::{SEED, chunk_blocks_and_biomes, generate_end_chunk};
+    use crate::generation::generator::WorldGenerator;
+    use crate::generation::get_world_gen_with_all_settings;
+
+    let world = tempfile::tempdir().expect("tempdir");
+    let data = world.path().join("datapacks/copy/data/minecraft/worldgen");
+    std::fs::create_dir_all(data.join("noise_settings")).expect("dirs");
+    std::fs::create_dir_all(data.join("multi_noise_biome_source_parameter_list")).expect("dirs");
+    let text = VANILLA_WORLDGEN
+        .iter()
+        .find(|(kind, path, _)| *kind == "noise_settings" && *path == "overworld")
+        .map(|(_, _, text)| *text)
+        .expect("embedded overworld settings");
+    std::fs::write(data.join("noise_settings/overworld.json"), text).expect("write");
+
+    let mut entries = Vec::new();
+    tree_entries(&OVERWORLD_BIOME_SOURCE, &mut entries);
+    let mut list = String::from("{\"preset\":\"minecraft:overworld\",\"lithostitched:biomes\":[");
+    for (i, (p, biome)) in entries.iter().enumerate() {
+        let q = |v: i64| v as f64 / 10_000.0;
+        let range = |r: pumpkin_data::chunk::Parameter| format!("[{},{}]", q(r.min), q(r.max));
+        let _ = write!(
+            list,
+            "{}{{\"biome\":\"minecraft:{}\",\"parameters\":{{\"temperature\":{},\"humidity\":{},\"continentalness\":{},\"erosion\":{},\"depth\":{},\"weirdness\":{},\"offset\":{}}}}}",
+            if i == 0 { "" } else { "," },
+            biome.registry_id,
+            range(p.temperature),
+            range(p.humidity),
+            range(p.continentalness),
+            range(p.erosion),
+            range(p.depth),
+            range(p.weirdness),
+            q(p.offset)
+        );
+    }
+    list.push_str("]}");
+    std::fs::write(
+        data.join("multi_noise_biome_source_parameter_list/overworld.json"),
+        list,
+    )
+    .expect("write");
+
+    let runtime =
+        load_dimension_generation(world.path(), &Dimension::OVERWORLD, "minecraft:overworld")
+            .expect("pack should override the overworld");
+    let make = |runtime| {
+        get_world_gen_with_all_settings(
+            Seed(SEED),
+            Dimension::OVERWORLD,
+            false,
+            Vec::new(),
+            String::new(),
+            Some("minecraft:overworld"),
+            None,
+            None,
+            runtime,
+        )
+    };
+    let from_pack = make(Some(runtime));
+    let vanilla = make(None);
+    for (x, z) in [(0, 0), (3, -2), (-9, 7), (40, 41)] {
+        let mut a = generate_end_chunk(&from_pack, x, z);
+        let mut b = generate_end_chunk(&vanilla, x, z);
+        let (WorldGenerator::Noise(ga), WorldGenerator::Noise(gb)) = (&*from_pack, &*vanilla)
+        else {
+            unreachable!()
+        };
+        assert!(
+            chunk_blocks_and_biomes(&a) == chunk_blocks_and_biomes(&b),
+            "surface of chunk ({x}, {z}) differs"
+        );
+        a.step_to_carvers(ga);
+        b.step_to_carvers(gb);
+        assert!(
+            chunk_blocks_and_biomes(&a) == chunk_blocks_and_biomes(&b),
+            "carvers of chunk ({x}, {z}) differ"
+        );
+    }
+}
