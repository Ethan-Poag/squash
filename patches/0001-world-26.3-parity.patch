+        fn item(id: &str, count: i32, components: NbtCompound) -> NbtCompound {
+            let mut nbt = NbtCompound::new();
+            nbt.put_string("id", id.to_string());
+            nbt.put_int("count", count);
+            if !components.is_empty() {
+                nbt.put_compound("components", components);
+            }
+            nbt
+        }
+        fn levels(pairs: &[(&str, i32)]) -> NbtCompound {
+            let mut c = NbtCompound::new();
+            for (k, v) in pairs {
+                c.put_int(k, *v);
+            }
+            c
+        }
+        let mut sword = NbtCompound::new();
+        sword.put_compound(
+            "minecraft:enchantments",
+            levels(&[("minecraft:sharpness", 5), ("minecraft:unbreaking", 3)]),
+        );
+        sword.put_string("minecraft:custom_name", "Test Sword".to_string());
+        let mut book = NbtCompound::new();
+        book.put_compound("minecraft:stored_enchantments", levels(&[("minecraft:mending", 1)]));
+        let mut bow = NbtCompound::new();
+        bow.put_compound("minecraft:enchantments", levels(&[("minecraft:power", 5)]));
+        bow.put_int("minecraft:damage", 100);
+        let mut written = NbtCompound::new();
+        let mut content = NbtCompound::new();
+        let mut title = NbtCompound::new();
+        title.put_string("raw", "Test Book".to_string());
+        content.put_compound("title", title);
+        content.put_string("author", "MC Engineer".to_string());
+        let mut page = NbtCompound::new();
+        page.put_string("raw", "Page one".to_string());
+        content.put_list("pages", vec![NbtTag::Compound(page)]);
+        written.put_compound("minecraft:written_book_content", content);
+        let mut shulker = NbtCompound::new();
+        let mut entry = NbtCompound::new();
+        entry.put_int("slot", 0);
+        entry.put_compound("item", item("minecraft:diamond", 5, NbtCompound::new()));
+        shulker.put_list("minecraft:container", vec![NbtTag::Compound(entry)]);
+        // An ominous banner as it sits in this world's chests: tooltip_display is a
+        // component Pumpkin only stubs; plus attribute modifiers and a modded component.
+        let mut banner = NbtCompound::new();
+        let mut tooltip = NbtCompound::new();
+        tooltip.put_list(
+            "hidden_components",
+            vec![NbtTag::String("minecraft:banner_patterns".into())],
+        );
+        banner.put_compound("minecraft:tooltip_display", tooltip);
+        banner.put_string("minecraft:rarity", "uncommon".to_string());
+        let mut axe = NbtCompound::new();
+        let mut modifier = NbtCompound::new();
+        modifier.put_string("type", "minecraft:attack_damage".to_string());
+        modifier.put_string("id", "minecraft:test".to_string());
+        modifier.put_double("amount", 4.0);
+        modifier.put_string("operation", "add_value".to_string());
+        modifier.put_string("slot", "mainhand".to_string());
+        axe.put_list("minecraft:attribute_modifiers", vec![NbtTag::Compound(modifier)]);
+        let mut modded = NbtCompound::new();
+        modded.put_int("somemod:charge", 7);
+        vec![
+            item("minecraft:white_banner", 1, banner),
+            item("minecraft:iron_axe", 1, axe),
+            item("minecraft:stick", 3, modded),
+            item("minecraft:diamond", 5, NbtCompound::new()),
+            item("minecraft:diamond_sword", 1, sword),
+            item("minecraft:enchanted_book", 1, book),
+            item("minecraft:bow", 1, bow),
+            item("minecraft:written_book", 1, written),
+            item("minecraft:shulker_box", 1, shulker),
+        ]
+    }
+
+    fn written(stack: &ItemStack) -> NbtCompound {
+        let mut nbt = NbtCompound::new();
+        stack.write_item_stack(&mut nbt);
+        nbt
+    }
+
+    /// Live bug (Nov 9 2026, sandbox join test): items put into a chest were gone after
+    /// the player logged out and back in. The chunk system unloaded (and saved) the chunk
+    /// with the chest's NBT from when it was placed; the entity cleanup then tried to
+    /// write the live chest into the already-unloaded chunk (a silent no-op) and dropped
+    /// the live chest. This drives the real chunk system: place chest, fill it, unload
+    /// the chunk, run the cleanup, reload, read the chest.
+    #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+    async fn chest_items_survive_chunk_unload_and_reload() -> Result<(), Box<dyn std::error::Error>> {
+        use crate::block::entities::chest::ChestBlockEntity;
+        use pumpkin_data::Block;
+        use pumpkin_world::chunk::{ChunkData, io::{Dirtiable, FileIO}};
+        use pumpkin_world::world::WorldPortalExt;
+
+        let folder = tempfile::tempdir()?;
+        let world = crate::entity::ai::test_support::world(&folder);
+        let portal: Arc<dyn WorldPortalExt> = Arc::new(crate::world::WorldPortal(world.clone()));
+        world.level.world_portal.store(Arc::new(Some(portal)));
+
+        let pos = BlockPos::new(40, 64, 8);
+        let (chunk_pos, relative) = pos.chunk_and_chunk_relative_position();
+        let chunk = ChunkData::empty_sync(chunk_pos.x, chunk_pos.y);
+        chunk.set_block_absolute_y(
+            relative.x as usize,
+            relative.y,
+            relative.z as usize,
+            Block::CHEST.default_state.id,
+        );
+        chunk.light_populated.store(true, std::sync::atomic::Ordering::Relaxed);
+        chunk.mark_dirty(true);
+        world.level.write_chunks(vec![(chunk_pos, chunk)]).await;
+        world.level.chunk_saver.flush_all().await;
+
+        // Load it through the chunk system, like a player walking up to it.
+        world.level.get_or_fetch_chunk(chunk_pos, |_| ()).await;
+
+        // Place the chest (setblock / player placement adds a fresh, empty chest).
+        let chest = Arc::new(ChestBlockEntity::new(pos));
+        world.add_block_entity(chest.clone());
+        // The player puts items in and closes the screen.
+        let items: Vec<ItemStack> = test_item_nbts()
+            .iter()
+            .map(|nbt| ItemStack::read_item_stack(nbt).expect("test item parses"))
+            .collect();
+        for (slot, stack) in items.iter().enumerate() {
+            chest.set_stack(slot, stack.clone());
+        }
+        let expected: Vec<NbtCompound> = items.iter().map(written).collect();
+
+        // The player logs out: the chunk loses its ticket and the chunk system unloads it.
+        {
+            let mut loading = world
+                .level
+                .chunk_loading
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            loading.remove_force_ticket(chunk_pos);
+            loading.send_change();
+        }
+        tokio::time::timeout(std::time::Duration::from_secs(30), async {
+            while world.level.is_chunk_loaded(&chunk_pos) {
+                world.level.should_unload.store(true, std::sync::atomic::Ordering::Relaxed);
+                world.level.level_channel.notify();
+                tokio::time::sleep(std::time::Duration::from_millis(50)).await;
+            }
+        })
+        .await?;
+        // Entity-chunk cleanup (every 100 ticks) then drops the live block entities.
+        world.remove_entities_in_chunks([chunk_pos]).await;
+        assert!(world.block_entities.get(&chunk_pos).is_none(), "live chest should be dropped");
+
+        // The player comes back.
+        world.level.get_or_fetch_chunk(chunk_pos, |_| ()).await;
+        let inventory = world
+            .get_block_entity(&pos)
+            .and_then(BlockEntity::get_inventory)
+            .expect("chest is still there after reload");
+        let got: Vec<NbtCompound> = (0..items.len()).map(|i| written(&inventory.get_stack(i))).collect();
+        assert_eq!(got, expected, "chest contents changed across unload/reload");
+        world.level.shutdown().await;
+        Ok(())
+    }
+
+    /// Same value, ignoring encodings vanilla treats as equal: a text component
+    /// `{text: "x"}` vs the string `"x"`, and an empty `components` compound.
+    fn normalized(tag: &pumpkin_nbt::tag::NbtTag) -> pumpkin_nbt::tag::NbtTag {
+        use pumpkin_nbt::tag::NbtTag;
+        match tag {
+            NbtTag::Compound(c) => {
+                if c.child_tags.len() == 1
+                    && let Some(NbtTag::String(text)) = c.get("text")
+                {
+                    return NbtTag::String(text.clone());
+                }
+                let mut out = NbtCompound::new();
+                for (k, v) in &c.child_tags {
+                    if k.as_ref() == "components" && matches!(v, NbtTag::Compound(x) if x.is_empty()) {
+                        continue;
+                    }
+                    out.put(k, normalized(v));
+                }
+                NbtTag::Compound(out)
+            }
+            NbtTag::List(items) => NbtTag::List(items.iter().map(normalized).collect()),
+            other => other.clone(),
+        }
+    }
+
+    /// Items Pumpkin rewrites (chests, player inventories) must keep their
+    /// components: enchantments, names, damage, book text, shulker contents, and
+    /// components Pumpkin cannot model (tooltip_display, attribute_modifiers, modded).
+    #[test]
+    fn item_components_round_trip_through_nbt() {
+        use pumpkin_nbt::tag::NbtTag;
+        let mut failures = Vec::new();
+        for source in test_item_nbts() {
+            let stack = ItemStack::read_item_stack(&source).expect("test item parses");
+            let out = written(&stack);
+            let again = written(&ItemStack::read_item_stack(&out).expect("rewritten item parses"));
+            let want = normalized(&NbtTag::Compound(source.get_compound("components").cloned().unwrap_or_default()));
+            let got = normalized(&NbtTag::Compound(out.get_compound("components").cloned().unwrap_or_default()));
+            if got != want || out != again {
+                failures.push(format!("{}: wrote {got:?}, want {want:?}", source.get_string("id").unwrap()));
+            }
+        }
+        assert!(failures.is_empty(), "components lost:\n{}", failures.join("\n"));
+    }
+
+    /// The world clocks start from level.dat / world_clocks.dat instead of 0.
+    #[tokio::test(flavor = "multi_thread")]
+    async fn world_clocks_continue_from_level_data() {
+        use pumpkin_world::world_info::LevelData;
+        let folder = tempfile::tempdir().unwrap();
+        let mut info = LevelData::default(pumpkin_util::world_seed::Seed(0));
+        info.game_time = 6_675_614;
+        info.day_time = 8_264_715;
+        let dimension = pumpkin_data::dimension::Dimension::OVERWORLD.clone();
+        let world = crate::world::World::load(
+            pumpkin_world::level::Level::from_root_folder(
+                &pumpkin_config::world::LevelConfig::default(),
+                folder.path().to_path_buf(),
+                0,
+                dimension.clone(),
+            ),
+            Arc::new(arc_swap::ArcSwap::from_pointee(info)),
+            dimension,
+            crate::block::registry::default_registry(),
+            std::sync::Weak::new(),
+        );
+        assert_eq!(world.get_world_age(), 6_675_614);
+        assert_eq!(world.get_time_of_day(), 8_264_715);
+    }
 }
