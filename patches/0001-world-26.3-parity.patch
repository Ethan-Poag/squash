+
+    fn template_feature(&mut self, config: &Value) -> Option<TemplateFeature> {
+        let templates = config
+            .get("templates")
+            .and_then(Value::as_array)
+            .map_or(&[][..], Vec::as_slice)
+            .iter()
+            .map(|entry| {
+                // An entry is `{"weight": .., "data": {"id": .., "rotations": [..]}}`.
+                let data = entry.get("data")?;
+                let rotations = match data.get("rotations").and_then(Value::as_array) {
+                    None => (0..4).map(Rotation::from_index).collect(),
+                    Some(list) => list
+                        .iter()
+                        .filter_map(Value::as_str)
+                        .map(|name| match name.strip_prefix("minecraft:").unwrap_or(name) {
+                            "clockwise_90" => Rotation::Clockwise90,
+                            "180" | "clockwise_180" => Rotation::Rotate180,
+                            "counterclockwise_90" => Rotation::CounterClockwise90,
+                            _ => Rotation::None,
+                        })
+                        .collect(),
+                };
+                Some(TemplateEntry {
+                    weight: u32::try_from(uint(entry.get("weight"), 1)).unwrap_or(1),
+                    template: normalize_id(data.get("id")?.as_str()?),
+                    rotations,
+                })
+            })
+            .collect::<Option<Vec<_>>>();
+        let Some(templates) = templates.filter(|list| !list.is_empty()) else {
+            return self.invalid("template feature", "it lists no template");
+        };
+        let processors = match config.get("processors") {
+            Some(Value::String(name)) => Some(normalize_id(name)),
+            Some(inline @ (Value::Object(_) | Value::Array(_))) => {
+                let name = format!("feature_inline/{}", self.inline_processors);
+                self.inline_processors += 1;
+                register_pack_processor_list(&name, &inline.to_string()).ok()?;
+                Some(name)
+            }
+            _ => None,
+        };
+        Some(TemplateFeature {
+            templates,
+            processors,
+        })
+    }
+
+    fn vegetation_patch(&mut self, config: &Value) -> Option<VegetationPatchFeature> {
+        let get = |key: &str| config.get(key);
+        Some(VegetationPatchFeature {
+            replaceable: self.block_predicate(get("replaceable"))?,
+            ground_state: self.state_provider(get("ground_state"))?,
+            vegetation_feature: Box::new(self.inline_placed_feature(get("vegetation_feature")?)?),
+            surface: match get("surface").and_then(Value::as_str).unwrap_or("floor") {
+                "ceiling" => VerticalSurfaceType::Ceiling,
+                _ => VerticalSurfaceType::Floor,
+            },
+            depth: self.int_provider(get("depth"))?,
+            extra_bottom_block_chance: float32(get("extra_bottom_block_chance"), 0.0),
+            vertical_range: int(get("vertical_range"), 0),
+            vegetation_chance: float32(get("vegetation_chance"), 0.0),
+            xz_radius: self.int_provider(get("xz_radius"))?,
+            extra_edge_column_chance: float32(get("extra_edge_column_chance"), 0.0),
+        })
+    }
+
+    fn speleothem_blocks(
+        &mut self,
+        config: &Value,
+    ) -> Option<(&'static Block, &'static Block, BlockWrapper)> {
+        let base = self.block_ref(config.get("base_block"), "dripstone_block")?;
+        let pointed = self.block_ref(config.get("pointed_block"), "pointed_dripstone")?;
+        let replaceable = self.block_set_wrapper(config.get("replaceable_blocks"));
+        Some((base, pointed, replaceable))
+    }
+
+    fn block_ref(&mut self, v: Option<&Value>, default: &str) -> Option<&'static Block> {
+        let name = v
+            .and_then(|v| v.as_str().or_else(|| {
+                v.get("Name")
+                    .or_else(|| v.get("id"))
+                    .and_then(Value::as_str)
+            }))
+            .unwrap_or(default);
+        self.block(name)
+    }
+
+    fn float_provider(&mut self, v: Option<&Value>) -> Option<FloatProvider> {
+        let value = v.unwrap_or(&Value::Null);
+        match serde_json::from_value(value.clone()) {
+            Ok(provider) => Some(provider),
+            Err(err) => self.invalid("float provider", err),
+        }
+    }
+
+    fn speleothem(&mut self, config: &Value) -> Option<SpeleothemFeature> {
+        let (base, pointed, replaceable) = self.speleothem_blocks(config)?;
+        let get = |key: &str| config.get(key);
+        Some(SpeleothemFeature::new(
+            base,
+            pointed,
+            &replaceable,
+            float32(get("chance_of_taller_generation"), 0.2),
+            float32(get("chance_of_directional_spread"), 0.7),
+            float32(get("chance_of_spread_radius2"), 0.5),
+            float32(get("chance_of_spread_radius3"), 0.5),
+        ))
+    }
+
+    fn speleothem_cluster(&mut self, config: &Value) -> Option<SpeleothemClusterFeature> {
+        let (base, pointed, replaceable) = self.speleothem_blocks(config)?;
+        let get = |key: &str| config.get(key);
+        Some(SpeleothemClusterFeature::new(
+            base,
+            pointed,
+            &replaceable,
+            int(get("floor_to_ceiling_search_range"), 0),
+            self.int_provider(get("height"))?,
+            self.int_provider(get("radius"))?,
+            int(get("max_stalagmite_stalactite_height_diff"), 0),
+            int(get("height_deviation"), 1),
+            self.int_provider(get("speleothem_block_layer_thickness"))?,
+            self.float_provider(get("density"))?,
+            self.float_provider(get("wetness"))?,
+            float32(get("chance_of_speleothem_at_max_distance_from_center"), 0.0),
+            int(
+                get("max_distance_from_edge_affecting_chance_of_speleothem"),
+                1,
+            ),
+            int(get("max_distance_from_center_affecting_height_bias"), 1),
+        ))
+    }
+
+    fn large_dripstone(&mut self, config: &Value) -> Option<LargeDripstoneFeature> {
+        let replaceable = self.block_set_wrapper(config.get("replaceable_blocks"));
+        let get = |key: &str| config.get(key);
+        Some(LargeDripstoneFeature::new(
+            &replaceable,
+            int(get("floor_to_ceiling_search_range"), 30),
+            self.int_provider(get("column_radius"))?,
+            self.float_provider(get("height_scale"))?,
+            float32(get("max_column_radius_to_cave_height_ratio"), 0.1),
+            self.float_provider(get("stalactite_bluntness"))?,
+            self.float_provider(get("stalagmite_bluntness"))?,
+            self.float_provider(get("wind_speed"))?,
+            int(get("min_radius_for_wind"), 0),
+            float32(get("min_bluntness_for_wind"), 0.0),
+        ))
+    }
+
+    fn geode(&mut self, config: &Value) -> Option<GeodeFeature> {
+        let blocks = config.get("blocks").unwrap_or(&Value::Null);
+        let layers = config.get("layers").unwrap_or(&Value::Null);
+        let crack = config.get("crack").unwrap_or(&Value::Null);
+        let get = |key: &str| config.get(key);
+        Some(GeodeFeature {
+            filling_provider: self.state_provider(blocks.get("filling_provider"))?,
+            inner_layer_provider: self.state_provider(blocks.get("inner_layer_provider"))?,
+            alternate_inner_layer_provider: self
+                .state_provider(blocks.get("alternate_inner_layer_provider"))?,
+            middle_layer_provider: self.state_provider(blocks.get("middle_layer_provider"))?,
+            outer_layer_provider: self.state_provider(blocks.get("outer_layer_provider"))?,
+            inner_placements: blocks
+                .get("inner_placements")
+                .and_then(Value::as_array)
+                .map_or(&[][..], Vec::as_slice)
+                .iter()
+                .map(|state| self.block_state_codec(state))
+                .collect::<Option<Vec<_>>>()?,
+            cannot_replace: self.block_set_wrapper(blocks.get("cannot_replace")),
+            invalid_blocks: self.block_set_wrapper(blocks.get("invalid_blocks")),
+            filling: float(layers.get("filling"), 1.7),
+            inner_layer: float(layers.get("inner_layer"), 2.2),
+            middle_layer: float(layers.get("middle_layer"), 3.2),
+            outer_layer: float(layers.get("outer_layer"), 4.2),
+            generate_crack_chance: float(crack.get("generate_crack_chance"), 1.0),
+            base_crack_size: float(crack.get("base_crack_size"), 2.0),
+            crack_point_offset: int(crack.get("crack_point_offset"), 2),
+            use_potential_placements_chance: float(get("use_potential_placements_chance"), 0.35),
+            use_alternate_layer0_chance: float(get("use_alternate_layer0_chance"), 0.0),
+            placements_require_layer0_alternate: get("placements_require_layer0_alternate")
+                .and_then(Value::as_bool)
+                .unwrap_or(true),
+            outer_wall_distance: self.int_provider_or_uniform(get("outer_wall_distance"), 4, 5)?,
+            distribution_points: self.int_provider_or_uniform(get("distribution_points"), 3, 4)?,
+            point_offset: self.int_provider_or_uniform(get("point_offset"), 1, 2)?,
+            min_gen_offset: int(get("min_gen_offset"), -16),
+            max_gen_offset: int(get("max_gen_offset"), 16),
+            noise_multiplier: float(get("noise_multiplier"), 0.05),
+            invalid_blocks_threshold: int(get("invalid_blocks_threshold"), 0),
+        })
+    }
+}
+
+// ---- number helpers (the defaults mirror the generated tables) ------------------------------
+
+/// Gives every provider `type` the `minecraft:` namespace that omitting it means.
+fn with_namespaced_types(mut value: Value) -> Value {
+    match &mut value {
+        Value::Object(map) => {
+            if let Some(Value::String(ty)) = map.get_mut("type")
+                && !ty.contains(':')
+            {
+                *ty = format!("minecraft:{ty}");
+            }
+            for child in map.values_mut() {
+                *child = with_namespaced_types(child.take());
+            }
+        }
+        Value::Array(list) => {
+            for child in list {
+                *child = with_namespaced_types(child.take());
+            }
+        }
+        _ => {}
+    }
+    value
+}
+
+fn clamp_i32(n: i64) -> i32 {
+    i32::try_from(n).unwrap_or(if n < 0 { i32::MIN } else { i32::MAX })
+}
+
+fn int(v: Option<&Value>, default: i32) -> i32 {
+    v.and_then(Value::as_i64).map_or(default, clamp_i32)
+}
+
+fn uint(v: Option<&Value>, default: u64) -> u64 {
+    v.and_then(Value::as_u64).unwrap_or(default)
+}
+
+fn opt_int(v: Option<&Value>) -> Option<i32> {
+    v.and_then(Value::as_i64).map(clamp_i32)
+}
+
+fn int_at(v: &Value, index: usize) -> Option<i32> {
+    v.get(index).and_then(Value::as_i64).map(clamp_i32)
+}
+
+fn float(v: Option<&Value>, default: f64) -> f64 {
+    v.and_then(Value::as_f64).unwrap_or(default)
+}
+
+#[expect(clippy::cast_possible_truncation)]
+fn float32(v: Option<&Value>, default: f32) -> f32 {
+    v.and_then(Value::as_f64).map_or(default, |f| f as f32)
+}
