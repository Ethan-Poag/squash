diff --git a/crates/pumpkin-world/src/biome/unknown.rs b/crates/pumpkin-world/src/biome/unknown.rs
new file mode 100644
index 0000000..b2565c0
--- /dev/null
+++ b/crates/pumpkin-world/src/biome/unknown.rs
@@ -0,0 +1,356 @@
+//! Biomes found in a world that Pumpkin has no data for, e.g. `terralith:*`,
+//! `incendium:*` or `nullscape:*` from mods and datapacks.
+//!
+//! Each unknown name gets a process-local id at or above [`FIRST_UNKNOWN_ID`], so
+//! it survives the chunk in memory (including the relight/proto-chunk path) and
+//! is written back to disk verbatim. Clients only know the vanilla registry, so
+//! anything sent to them uses [`vanilla_id`] / [`vanilla_biome`], a vanilla
+//! biome picked from the name.
+
+use std::sync::{LazyLock, RwLock};
+
+use pumpkin_data::chunk::Biome;
+use tracing::warn;
+
+use crate::generation::datapack::spawns::BiomeSpawnData;
+
+/// Vanilla biome ids are dense from 0 (67 in 26.3) and stay below this; every id from here to
+/// 255 is free for pack biomes (176 slots: a large pack set can register 102, so 128 left too
+/// little room once a world also carries biomes of packs it no longer loads).
+pub const FIRST_UNKNOWN_ID: u8 = 80;
+
+struct Unknown {
+    name: Box<str>,
+    fallback: &'static Biome,
+    /// The fallback's data under the unknown id and name, for the generation stages.
+    biome: &'static Biome,
+}
+
+static UNKNOWN: LazyLock<RwLock<Vec<Unknown>>> = LazyLock::new(|| RwLock::new(Vec::new()));
+
+type Carvers = &'static [&'static pumpkin_data::carver::CarverConfig];
+
+/// Carvers a datapack lists for a biome, by full name. Used when the name is first registered.
+static CARVERS: LazyLock<RwLock<rustc_hash::FxHashMap<String, Carvers>>> =
+    LazyLock::new(|| RwLock::new(rustc_hash::FxHashMap::default()));
+
+/// Gives the biome `name` its own carvers instead of its stand-in's. Only takes effect for a
+/// name that is not registered yet.
+pub fn set_carvers(name: &str, carvers: Carvers) {
+    let full = if name.contains(':') {
+        name.to_string()
+    } else {
+        format!("minecraft:{name}")
+    };
+    CARVERS
+        .write()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .insert(full.clone(), carvers);
+    rebuild(&full);
+}
+
+/// Rebuilds the biome object of `full` when the name was registered before its data arrived.
+fn rebuild(full: &str) {
+    let mut table = UNKNOWN
+        .write()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if let Some(index) = table.iter().position(|u| *u.name == *full) {
+        let id = FIRST_UNKNOWN_ID + index as u8;
+        let fallback = table[index].fallback;
+        table[index].biome = leak_unknown_biome(id, full, fallback);
+    }
+}
+
+/// Spawn data a datapack lists for a biome, by full name. Used when the name is first registered.
+static SPAWN_DATA: LazyLock<RwLock<rustc_hash::FxHashMap<String, &'static BiomeSpawnData>>> =
+    LazyLock::new(|| RwLock::new(rustc_hash::FxHashMap::default()));
+
+/// Gives the biome `name` its own spawners instead of its stand-in's. Only takes effect for a
+/// name that is not registered yet.
+pub fn set_spawn_data(name: &str, data: &'static BiomeSpawnData) {
+    let full = if name.contains(':') {
+        name.to_string()
+    } else {
+        format!("minecraft:{name}")
+    };
+    SPAWN_DATA
+        .write()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .insert(full.clone(), data);
+    rebuild(&full);
+}
+
+/// The spawn cost of the entity `entity` (`minecraft:` prefix left off) in `biome`: the datapack's own
+/// for a pack biome that has spawn data, else the cost of the vanilla biome that stands in for it.
+#[must_use]
+pub fn spawn_cost(
+    biome: &'static Biome,
+    entity: &str,
+) -> Option<&'static pumpkin_data::biome::SpawnCosts> {
+    if biome.id >= FIRST_UNKNOWN_ID {
+        let pack = SPAWN_DATA
+            .read()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .get(biome.registry_id)
+            .copied();
+        if let Some(data) = pack {
+            return data
+                .spawn_costs
+                .iter()
+                .find(|(name, _)| *name == entity)
+                .map(|(_, cost)| cost);
+        }
+        return vanilla_biome(biome.id).spawn_costs.get(entity);
+    }
+    biome.spawn_costs.get(entity)
+}
+
+/// The id of a vanilla biome or an unknown one registered earlier. Never registers a name.
+#[must_use]
+pub fn lookup_id(name: &str) -> Option<u8> {
+    let short = name.strip_prefix("minecraft:").unwrap_or(name);
+    if let Some(biome) = Biome::from_name(short) {
+        return Some(biome.id);
+    }
+    let full = if name.contains(':') {
+        name.to_string()
+    } else {
+        format!("minecraft:{name}")
+    };
+    UNKNOWN
+        .read()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .iter()
+        .position(|u| *u.name == *full)
+        .map(|i| FIRST_UNKNOWN_ID + i as u8)
+}
+
+/// Resolves a biome name from disk to an id, registering names Pumpkin does not know.
+#[must_use]
+pub fn id_for_name(name: &str) -> u8 {
+    let short = name.strip_prefix("minecraft:").unwrap_or(name);
+    if let Some(biome) = Biome::from_name(short) {
+        return biome.id;
+    }
+    let full = if name.contains(':') {
+        name.to_string()
+    } else {
+        format!("minecraft:{name}")
+    };
+    if let Some(i) = UNKNOWN
+        .read()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .iter()
+        .position(|u| *u.name == *full)
+    {
+        return FIRST_UNKNOWN_ID + i as u8;
+    }
+    let mut table = UNKNOWN
+        .write()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if let Some(i) = table.iter().position(|u| *u.name == *full) {
+        return FIRST_UNKNOWN_ID + i as u8;
+    }
+    let fallback = guess_vanilla(&full);
+    if table.len() >= usize::from(u8::MAX - FIRST_UNKNOWN_ID) + 1 {
+        warn!(
+            "Too many unknown biomes; {full} will be saved as {}",
+            fallback.registry_id
+        );
+        return fallback.id;
+    }
+    let id = FIRST_UNKNOWN_ID + table.len() as u8;
+    let biome = leak_unknown_biome(id, &full, fallback);
+    table.push(Unknown {
+        name: full.into_boxed_str(),
+        fallback,
+        biome,
+    });
+    id
+}
+
+/// A leaked copy of `fallback` that carries the unknown biome's id and name and the spawners its
+/// datapack lists. Spawn costs are not copied.
+fn leak_unknown_biome(id: u8, name: &str, fallback: &'static Biome) -> &'static Biome {
+    use pumpkin_data::chunk::SpawnGroups;
+    let pack_spawns = SPAWN_DATA
+        .read()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .get(name)
+        .copied();
+    let spawners = pack_spawns.map_or(&fallback.spawners, |data| &data.spawners);
+    let carvers = CARVERS
+        .read()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .get(name)
+        .copied()
+        .unwrap_or(fallback.carvers);
+    Box::leak(Box::new(Biome {
+        id,
+        registry_id: Box::leak(name.to_string().into_boxed_str()),
+        be_network_id: fallback.be_network_id,
+        weather: fallback.weather.clone(),
+        carvers,
+        features: fallback.features,
+        creature_spawn_probability: pack_spawns
+            .map_or(fallback.creature_spawn_probability, |data| {
+                data.creature_spawn_probability
+            }),
+        spawners: SpawnGroups {
+            monster: spawners.monster,
+            ambient: spawners.ambient,
+            axolotls: spawners.axolotls,
+            creature: spawners.creature,
+            misc: spawners.misc,
+            underground_water_creature: spawners.underground_water_creature,
+            water_ambient: spawners.water_ambient,
+            water_creature: spawners.water_creature,
+        },
+        spawn_costs: phf::Map::new(),
+    }))
+}
+
+/// The name an unknown id was registered with, e.g. `terralith:brushland`.
+#[must_use]
+pub fn unknown_name(id: u8) -> Option<String> {
+    let index = usize::from(id.checked_sub(FIRST_UNKNOWN_ID)?);
+    UNKNOWN
+        .read()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .get(index)
+        .map(|u| u.name.to_string())
+}
+
+/// The vanilla biome used for gameplay and clients in place of `id`.
+#[must_use]
+pub fn vanilla_biome(id: u8) -> &'static Biome {
+    if let Some(biome) = Biome::from_id(id) {
+        return biome;
+    }
+    id.checked_sub(FIRST_UNKNOWN_ID)
+        .and_then(|index| {
+            UNKNOWN
+                .read()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .get(usize::from(index))
+                .map(|u| u.fallback)
+        })
+        .unwrap_or(&Biome::PLAINS)
+}
+
+/// The biome object for `id` during generation: a vanilla biome, or the object registered for an
+/// unknown id, so a stored id always resolves to the biome that produced it.
+#[must_use]
+pub fn generation_biome(id: u8) -> &'static Biome {
+    if let Some(biome) = Biome::from_id(id) {
+        return biome;
+    }
+    id.checked_sub(FIRST_UNKNOWN_ID)
+        .and_then(|index| {
+            UNKNOWN
+                .read()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .get(usize::from(index))
+                .map(|u| u.biome)
+        })
+        .unwrap_or(&Biome::PLAINS)
+}
+
+/// [`generation_biome`] of the id [`id_for_name`] returns.
+#[must_use]
+pub fn biome_for_name(name: &str) -> &'static Biome {
+    generation_biome(id_for_name(name))
+}
+
+/// Network id of [`vanilla_biome`].
+#[must_use]
+pub fn vanilla_id(id: u8) -> u8 {
+    if id < FIRST_UNKNOWN_ID {
+        id
+    } else {
+        vanilla_biome(id).id
+    }
+}
+
+/// Picks a vanilla stand-in from the biome's name. It only affects colours,
+/// fog and weather on clients and gameplay lookups; the saved name never changes.
+fn guess_vanilla(name: &str) -> &'static Biome {
+    let (namespace, path) = name.split_once(':').unwrap_or(("minecraft", name));
+    match namespace {
+        "incendium" => return &Biome::NETHER_WASTES,
+        "nullscape" => return &Biome::END_HIGHLANDS,
+        _ => {}
+    }
+    const RULES: &[(&[&str], &Biome)] = &[
+        (&["deep_dark"], &Biome::DEEP_DARK),
+        (&["lush"], &Biome::LUSH_CAVES),
+        (&["cave"], &Biome::DRIPSTONE_CAVES),
+        (&["ocean", "sea"], &Biome::OCEAN),
+        (&["river"], &Biome::RIVER),
+        (&["beach", "shore", "coast"], &Biome::BEACH),
+        (
+            &["snow", "frozen", "ice", "glacial", "tundra", "frost"],
+            &Biome::SNOWY_PLAINS,
+        ),
+        (&["badlands", "mesa", "canyon"], &Biome::BADLANDS),
+        (&["desert", "dune"], &Biome::DESERT),
+        (
+            &["savanna", "shrub", "brush", "arid", "steppe"],
+            &Biome::SAVANNA,
+        ),
+        (&["jungle", "tropical", "rainforest"], &Biome::JUNGLE),
+        (
+            &["swamp", "bayou", "marsh", "mangrove", "wetland"],
+            &Biome::SWAMP,
+        ),
+        (&["birch"], &Biome::BIRCH_FOREST),
+        (&["taiga", "spruce", "pine", "boreal"], &Biome::TAIGA),
+        (&["forest", "wood", "grove", "orchard"], &Biome::FOREST),
+        (
+            &[
+                "peak", "mountain", "highland", "cliff", "alpine", "hill", "crag",
+            ],
+            &Biome::WINDSWEPT_HILLS,
+        ),
+    ];
+    RULES
+        .iter()
+        .find(|(keys, _)| keys.iter().any(|k| path.contains(k)))
+        .map_or(&Biome::PLAINS, |(_, biome)| biome)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn vanilla_biome_ids_stay_below_the_unknown_range() {
+        assert!(Biome::ALL.iter().all(|biome| biome.id < FIRST_UNKNOWN_ID));
+    }
+
+    #[test]
+    fn unknown_biomes_round_trip_and_map_to_vanilla() {
+        assert_eq!(id_for_name("minecraft:savanna"), Biome::SAVANNA.id);
+        assert_eq!(id_for_name("savanna"), Biome::SAVANNA.id);
+        let id = id_for_name("terralith:brushland");
+        assert!(id >= FIRST_UNKNOWN_ID);
+        assert_eq!(id_for_name("terralith:brushland"), id);
+        assert_eq!(unknown_name(id).as_deref(), Some("terralith:brushland"));
+        assert_eq!(vanilla_id(id), Biome::SAVANNA.id);
+        assert_eq!(
+            vanilla_biome(id_for_name("terralith:cave/mantle_caves")).id,
+            Biome::DRIPSTONE_CAVES.id
+        );
+        assert_eq!(
+            vanilla_biome(id_for_name("incendium:ash_barrens")).id,
+            Biome::NETHER_WASTES.id
+        );
+        assert_eq!(unknown_name(Biome::SAVANNA.id), None);
+
+        let object = biome_for_name("terralith:brushland");
+        assert_eq!(object.id, id);
+        assert_eq!(object.registry_id, "terralith:brushland");
+        assert!(std::ptr::eq(object, generation_biome(id)));
+        assert_eq!(biome_for_name("savanna").id, Biome::SAVANNA.id);
+    }
+}
