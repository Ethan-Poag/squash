new file mode 100644
index 0000000..e871590
--- /dev/null
+++ b/crates/pumpkin-data/src/structures_dynamic.rs
@@ -0,0 +1,102 @@
+//! Structures and structure sets that datapacks define at runtime.
+//!
+//! A runtime structure is a leaked [`Structure`] addressed by [`StructureKeys::Dynamic`]. Entries are
+//! never removed, so a reload with the same packs reuses the same keys.
+
+use std::collections::HashMap;
+use std::sync::{LazyLock, RwLock};
+
+use crate::structures::{Structure, StructureKeys, StructureSet};
+
+struct Entry {
+    scope: Box<str>,
+    name: &'static str,
+    structure: &'static Structure,
+}
+
+static STRUCTURES: LazyLock<RwLock<Vec<Entry>>> = LazyLock::new(|| RwLock::new(Vec::new()));
+static SETS: LazyLock<RwLock<HashMap<String, &'static StructureSet>>> =
+    LazyLock::new(|| RwLock::new(HashMap::new()));
+
+fn full_name(name: &str) -> String {
+    if name.contains(':') {
+        name.to_string()
+    } else {
+        format!("minecraft:{name}")
+    }
+}
+
+/// Registers `structure` as `name`. `scope` identifies the pack set it comes from: the same
+/// scope and name always give the same key, and different scopes never share a key.
+pub fn register_structure(scope: &str, name: &str, structure: Structure) -> Option<StructureKeys> {
+    let name = full_name(name);
+    let mut table = STRUCTURES
+        .write()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if let Some(index) = table
+        .iter()
+        .position(|e| *e.scope == *scope && e.name == name)
+    {
+        return u16::try_from(index).ok().map(StructureKeys::Dynamic);
+    }
+    let index = u16::try_from(table.len()).ok()?;
+    table.push(Entry {
+        scope: scope.into(),
+        name: Box::leak(name.into_boxed_str()),
+        structure: Box::leak(Box::new(structure)),
+    });
+    Some(StructureKeys::Dynamic(index))
+}
+
+/// The key of the runtime structure registered as `name`; the latest registration wins when
+/// several pack sets define it.
+#[must_use]
+pub fn find(name: &str) -> Option<StructureKeys> {
+    let name = full_name(name);
+    let table = STRUCTURES
+        .read()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let index = table.iter().rposition(|e| e.name == name)?;
+    u16::try_from(index).ok().map(StructureKeys::Dynamic)
+}
+
+/// The registry name of the runtime structure `index`, e.g. `terralith:fortified_village`.
+#[must_use]
+pub fn name(index: u16) -> &'static str {
+    STRUCTURES
+        .read()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .get(usize::from(index))
+        .map_or("minecraft:empty", |e| e.name)
+}
+
+/// The runtime structure `index`. Keys only come from [`register_structure`].
+#[must_use]
+pub fn structure(index: u16) -> &'static Structure {
+    STRUCTURES
+        .read()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .get(usize::from(index))
+        .map_or(&Structure::PILLAGER_OUTPOST, |e| e.structure)
+}
+
+/// Registers a structure set under `name` so exclusion zones of other sets can find it.
+pub fn register_structure_set(name: &str, set: &'static StructureSet) {
+    SETS.write()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .insert(full_name(name), set);
+}
+
+/// A structure set by registry name: a runtime one first, then the generated vanilla one.
+#[must_use]
+pub fn structure_set(name: &str) -> Option<&'static StructureSet> {
+    let full = full_name(name);
+    if let Some(set) = SETS
+        .read()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .get(&full)
+    {
+        return Some(set);
+    }
+    StructureSet::get(full.strip_prefix("minecraft:")?)
+}
