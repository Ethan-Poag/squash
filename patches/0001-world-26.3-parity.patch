--- /dev/null
+++ b/crates/pumpkin-world/src/generation/budget.rs
@@ -0,0 +1,162 @@
+//! A time budget for one world-generation step (one placed feature, one structure start).
+//!
+//! A step that runs past its budget is abandoned instead of freezing its chunk-generation
+//! thread forever: [`tick`] is called from the block accessors and from long search loops, and
+//! once the deadline has passed it unwinds back to [`run_bounded`], which logs the step and
+//! returns `None`. The chunk keeps whatever the step had already written.
+//!
+//! Only steps run through [`run_bounded`] are bounded; everywhere else [`tick`] is one
+//! thread-local read.
+
+use std::cell::Cell;
+use std::panic::{self, AssertUnwindSafe};
+use std::sync::OnceLock;
+use std::time::{Duration, Instant};
+
+/// How many ticks pass between two clock reads.
+const TICKS_PER_CHECK: u32 = 4096;
+
+/// Default budget per step. Real features and structure starts take milliseconds.
+const DEFAULT_BUDGET: Duration = Duration::from_secs(10);
+
+thread_local! {
+    /// Ticks left until the next clock read; 0 when no step on this thread is bounded.
+    static TICKS_LEFT: Cell<u32> = const { Cell::new(0) };
+    static DEADLINE: Cell<Option<Instant>> = const { Cell::new(None) };
+}
+
+/// Whether this thread runs a bounded generation step right now.
+///
+/// A panic inside such a step only abandons the step, so the server's panic hook uses this to
+/// log it instead of stopping the server (one broken pack feature must not take the world down).
+#[must_use]
+pub fn in_bounded_step() -> bool {
+    DEADLINE.with(Cell::get).is_some()
+}
+
+/// The unwinding payload of a step that ran out of time.
+#[derive(Debug)]
+pub struct BudgetExceeded;
+
+/// The budget for one step: `PUMPKIN_GEN_STEP_BUDGET_MS`, or 10 s.
+#[must_use]
+pub fn step_budget() -> Duration {
+    static BUDGET: OnceLock<Duration> = OnceLock::new();
+    *BUDGET.get_or_init(|| {
+        std::env::var("PUMPKIN_GEN_STEP_BUDGET_MS")
+            .ok()
+            .and_then(|v| v.parse::<u64>().ok())
+            .filter(|&ms| ms > 0)
+            .map_or(DEFAULT_BUDGET, Duration::from_millis)
+    })
+}
+
+/// Marks progress inside a bounded step; unwinds with [`BudgetExceeded`] once it is over time.
+#[inline]
+pub fn tick() {
+    TICKS_LEFT.with(|left| {
+        let n = left.get();
+        if n > 1 {
+            left.set(n - 1);
+        } else if n == 1 {
+            check_deadline(left);
+        }
+    });
+}
+
+#[cold]
+fn check_deadline(left: &Cell<u32>) {
+    match DEADLINE.with(Cell::get) {
+        Some(deadline) if Instant::now() >= deadline => {
+            // Disarm first so the unwind and any code it runs are not bounded again.
+            left.set(0);
+            panic::resume_unwind(Box::new(BudgetExceeded));
+        }
+        Some(_) => left.set(TICKS_PER_CHECK),
+        None => left.set(0),
+    }
+}
+
+/// Runs one generation step with at most `budget` of time.
+///
+/// Returns `None` (after logging `what`) when the step ran out of time or panicked; the chunk
+/// keeps what the step wrote before. Nested calls keep the outer, earlier deadline.
+pub fn run_bounded<R>(budget: Duration, what: impl FnOnce() -> String, step: impl FnOnce() -> R) -> Option<R> {
+    let outer_deadline = DEADLINE.with(Cell::get);
+    let outer_ticks = TICKS_LEFT.with(Cell::get);
+    if outer_deadline.is_some() {
+        // Already inside a bounded step: its deadline covers this one too.
+        return Some(step());
+    }
+    let started = Instant::now();
+    DEADLINE.with(|d| d.set(Some(started + budget)));
+    TICKS_LEFT.with(|t| t.set(TICKS_PER_CHECK));
+    let result = panic::catch_unwind(AssertUnwindSafe(step));
+    DEADLINE.with(|d| d.set(outer_deadline));
+    TICKS_LEFT.with(|t| t.set(outer_ticks));
+    match result {
+        Ok(value) => Some(value),
+        Err(payload) if payload.is::<BudgetExceeded>() => {
+            tracing::error!(
+                "World generation step ran for over {:?} and was abandoned: {}",
+                started.elapsed(),
+                what()
+            );
+            None
+        }
+        Err(payload) => {
+            let message = payload
+                .downcast_ref::<&str>()
+                .copied()
+                .or_else(|| payload.downcast_ref::<String>().map(String::as_str))
+                .unwrap_or("<unknown panic>");
+            tracing::error!(
+                "World generation step panicked and was skipped: {}: {message}",
+                what()
+            );
+            None
+        }
+    }
+}
+
+#[cfg(test)]
+#[allow(clippy::panic)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_step_that_never_ends_is_abandoned() {
+        let started = Instant::now();
+        let result = run_bounded(Duration::from_millis(50), || "endless".into(), || loop {
+            tick();
+        });
+        assert!(result.is_none());
+        assert!(started.elapsed() < Duration::from_secs(5));
+        // The thread is unbounded again afterwards.
+        for _ in 0..(TICKS_PER_CHECK * 4) {
+            tick();
+        }
+    }
+
+    #[test]
+    fn a_step_that_finishes_returns_its_value() {
+        let result = run_bounded(Duration::from_secs(5), || "short".into(), || {
+            for _ in 0..10_000 {
+                tick();
+            }
+            7
+        });
+        assert_eq!(result, Some(7));
+    }
+
+    #[test]
+    fn a_step_that_panics_is_skipped() {
+        let result: Option<()> = run_bounded(Duration::from_secs(5), || "panics".into(), || {
+            assert!(in_bounded_step());
+            panic!("boom")
+        });
+        assert!(result.is_none());
+        assert!(!in_bounded_step());
+        assert_eq!(DEADLINE.with(Cell::get), None);
+    }
+}
diff --git a/crates/pumpkin-world/src/generation/datapack/biome_source.rs b/crates/pumpkin-world/src/generation/datapack/biome_source.rs
new file mode 100644
index 0000000..c9f7054
--- /dev/null
+++ b/crates/pumpkin-world/src/generation/datapack/biome_source.rs
@@ -0,0 +1,120 @@
+//! A multi-noise biome source built from the inline `biomes` list of a dimension's `generator`.
+
+use pumpkin_data::chunk::{Biome, Parameter, ParameterPoint, quantize_coord};
+use serde_json::Value;
+
+use super::Result;
+use crate::biome::BiomeSupplier;
+use crate::generation::noise::router::multi_noise_sampler::MultiNoiseSampler;
+
+/// Picks the entry whose parameter point is nearest to the sampled climate, by the vanilla
+/// `Climate` fitness (squared distances to each range plus the squared offset).
+///
+/// The search is linear over the list. When two entries are equally near the earlier one wins;
+/// vanilla's R-tree breaks such ties by its own node order, so these can differ on exact ties.
+pub struct RuntimeMultiNoiseBiomeSupplier {
+    entries: Box<[(ParameterPoint, &'static Biome)]>,
+}
+
+fn parameter(value: Option<&Value>, name: &str) -> Result<Parameter> {
+    let bad = || format!("biome parameter {name} is not a number or a [min, max] pair");
+    let value = value.ok_or_else(|| format!("biome parameters have no {name}"))?;
+    let (min, max) = match value {
+        Value::Number(n) => {
+            let n = n.as_f64().ok_or_else(bad)?;
+            (n, n)
+        }
+        Value::Array(pair) if pair.len() == 2 => (
+            pair[0].as_f64().ok_or_else(bad)?,
+            pair[1].as_f64().ok_or_else(bad)?,
+        ),
+        _ => return Err(bad()),
+    };
+    if min > max {
+        return Err(format!("biome parameter {name} has min above max"));
+    }
+    Ok(Parameter::new(
+        quantize_coord(min as f32),
+        quantize_coord(max as f32),
+    ))
+}
+
+/// A point in climate space: the six parameters, each a number or a `[min, max]` pair, and an optional offset.
+pub fn climate_point(p: &Value) -> Result<ParameterPoint> {
+    let offset = p.get("offset").and_then(Value::as_f64).unwrap_or(0.0);
+    Ok(ParameterPoint::new(
+        parameter(p.get("temperature"), "temperature")?,
+        parameter(p.get("humidity"), "humidity")?,
+        parameter(p.get("continentalness"), "continentalness")?,
+        parameter(p.get("erosion"), "erosion")?,
+        parameter(p.get("depth"), "depth")?,
+        parameter(p.get("weirdness"), "weirdness")?,
+        quantize_coord(offset as f32),
+    ))
+}
+
+impl RuntimeMultiNoiseBiomeSupplier {
+    /// Reads the `biomes` of a `minecraft:multi_noise` source.
+    pub fn from_json(source: &Value) -> Result<Self> {
+        let list = source
+            .get("biomes")
+            .and_then(Value::as_array)
+            .ok_or("multi_noise biome source has no inline biomes list")?;
+        if list.is_empty() {
+            return Err("multi_noise biome source has no biomes".to_string());
+        }
+        let mut entries = Vec::with_capacity(list.len());
+        for entry in list {
+            let name = entry
+                .get("biome")
+                .and_then(Value::as_str)
+                .ok_or("biome entry has no biome")?;
+            let point = climate_point(
+                entry
+                    .get("parameters")
+                    .ok_or("biome entry has no parameters")?,
+            )?;
+            entries.push((point, crate::biome::unknown::biome_for_name(name)));
+        }
+        Ok(Self {
+            entries: entries.into_boxed_slice(),
+        })
+    }
+
+    #[must_use]
+    pub fn len(&self) -> usize {
+        self.entries.len()
+    }
+
+    #[must_use]
+    pub fn is_empty(&self) -> bool {
+        self.entries.is_empty()
+    }
+
+    /// The parsed `(parameter point, biome)` entries, in list order.
+    #[must_use]
+    pub fn entries(&self) -> &[(ParameterPoint, &'static Biome)] {
+        &self.entries
+    }
+
+    /// Ids of the biomes the source can produce.
+    pub fn biome_ids(&self) -> impl Iterator<Item = u8> {
+        self.entries.iter().map(|(_, biome)| biome.id)
+    }
+}
+
+impl BiomeSupplier for RuntimeMultiNoiseBiomeSupplier {
+    fn biome(&self, x: i32, y: i32, z: i32, noise: &mut MultiNoiseSampler<'_>) -> &'static Biome {
+        let target = noise.sample(x, y, z);
+        let mut best = self.entries[0].1;
+        let mut best_fitness = i64::MAX;
+        for (point, biome) in &self.entries {
+            let fitness = point.fitness(&target);
+            if fitness < best_fitness {
+                best_fitness = fitness;
+                best = biome;
+            }
+        }
+        best
+    }
+}
diff --git a/crates/pumpkin-world/src/generation/datapack/biome_tree.rs b/crates/pumpkin-world/src/generation/datapack/biome_tree.rs
new file mode 100644
index 0000000..c69c8cf
--- /dev/null
+++ b/crates/pumpkin-world/src/generation/datapack/biome_tree.rs
@@ -0,0 +1,180 @@
+//! Builds the multi-noise search tree from a parameter list at runtime, like vanilla's
+//! `Climate.RTree.create`, in the shape the generated vanilla trees have.
+
+use pumpkin_data::chunk::{Biome, BiomeTree, Parameter, ParameterPoint};
+
+use super::Result;
+
+const DIMENSIONS: usize = 7;
+
+enum Node {
+    Leaf {
+        space: [Parameter; DIMENSIONS],
+        biome: &'static Biome,
+    },
+    SubTree {
+        space: [Parameter; DIMENSIONS],
+        children: Vec<Self>,
+    },
+}
+
+impl Node {
+    const fn space(&self) -> &[Parameter; DIMENSIONS] {
+        match self {
+            Self::Leaf { space, .. } | Self::SubTree { space, .. } => space,
+        }
+    }
+
+    fn sub_tree(children: Vec<Self>) -> Self {
+        Self::SubTree {
+            space: build_parameter_space(&children),
+            children,
+        }
+    }
+
+    fn clone_node(&self) -> Self {
+        match self {
+            Self::Leaf { space, biome } => Self::Leaf {
+                space: *space,
+                biome,
+            },
+            Self::SubTree { space, children } => Self::SubTree {
+                space: *space,
+                children: children.iter().map(Self::clone_node).collect(),
+            },
+        }
+    }
+}
+
+/// Java's `(min + max) / 2L`, which rounds toward zero like `midpoint`.
+const fn center(parameter: &Parameter) -> i64 {
+    i64::midpoint(parameter.min, parameter.max)
+}
+
+fn build_parameter_space(children: &[Node]) -> [Parameter; DIMENSIONS] {
+    let mut bounds = *children[0].space();
+    for child in &children[1..] {
+        for (bound, other) in bounds.iter_mut().zip(child.space()) {
+            *bound = Parameter::new(bound.min.min(other.min), bound.max.max(other.max));
+        }
+    }
+    bounds
+}
+
+fn cost(space: &[Parameter; DIMENSIONS]) -> i64 {
+    space.iter().map(|p| (p.max - p.min).abs()).sum()
+}
+
+/// `RTree.sort`: by the centre of `dimension`, then of the following dimensions in turn.
+fn sort(nodes: &mut [Node], dimension: usize, absolute: bool) {
+    nodes.sort_by(|a, b| {
+        for offset in 0..DIMENSIONS {
+            let d = (dimension + offset) % DIMENSIONS;
+            let key = |node: &Node| {
+                let c = center(&node.space()[d]);
+                if absolute { c.abs() } else { c }
+            };
+            let ordering = key(a).cmp(&key(b));
+            if ordering.is_ne() {
+                return ordering;
+            }
+        }
+        std::cmp::Ordering::Equal
+    });
+}
+
+fn bucketize(nodes: &[Node]) -> Vec<Node> {
+    let mut buckets = Vec::new();
+    let mut current = Vec::new();
+    let expected = 6f64.powf(((nodes.len() as f64 - 0.01).ln() / 6f64.ln()).floor()) as usize;
+    for node in nodes {
+        current.push(node.clone_node());
+        if current.len() >= expected {
+            buckets.push(Node::sub_tree(std::mem::take(&mut current)));
+        }
+    }
+    if !current.is_empty() {
+        buckets.push(Node::sub_tree(current));
+    }
+    buckets
+}
+
+fn build(mut children: Vec<Node>) -> Node {
+    if children.len() == 1 {
+        return children.remove(0);
+    }
+    if children.len() <= 6 {
+        children.sort_by_key(|node| node.space().iter().map(|p| center(p).abs()).sum::<i64>());
+        return Node::sub_tree(children);
+    }
+    let mut min_cost = i64::MAX;
+    let mut min_dimension = 0;
+    let mut min_buckets = Vec::new();
+    for d in 0..DIMENSIONS {
+        sort(&mut children, d, false);
+        let buckets = bucketize(&children);
+        let total: i64 = buckets.iter().map(|b| cost(b.space())).sum();
+        if min_cost > total {
+            min_cost = total;
+            min_dimension = d;
+            min_buckets = buckets;
+        }
+    }
+    sort(&mut min_buckets, min_dimension, true);
+    Node::sub_tree(
+        min_buckets
+            .into_iter()
+            .map(|bucket| match bucket {
+                Node::SubTree { children, .. } => build(children),
+                leaf @ Node::Leaf { .. } => leaf,
+            })
+            .collect(),
+    )
+}
+
+fn leak<T>(value: T) -> &'static T {
+    Box::leak(Box::new(value))
+}
+
+fn convert(node: Node) -> BiomeTree {
+    match node {
+        Node::Leaf { space, biome } => BiomeTree::Leaf {
+            parameters: space,
+            biome,
+        },
+        Node::SubTree { space, children } => BiomeTree::Branch {
+            parameters: space,
+            nodes: Box::leak(
+                children
+                    .into_iter()
+                    .map(convert)
+                    .collect::<Vec<_>>()
+                    .into_boxed_slice(),
+            ),
+        },
+    }
+}
+
+/// The search tree for `entries`, in list order. The tree lives for the rest of the process.
+pub fn build_tree(entries: &[(ParameterPoint, &'static Biome)]) -> Result<&'static BiomeTree> {
+    if entries.is_empty() {
+        return Err("the biome list is empty".to_string());
+    }
+    let leaves: Vec<Node> = entries
+        .iter()
+        .map(|(point, biome)| Node::Leaf {
+            space: point.parameter_space(),
+            biome,
+        })
+        .collect();
+    Ok(leak(match build(leaves) {
+        Node::Leaf { space, biome } => BiomeTree::Branch {
+            parameters: space,
+            nodes: Box::leak(Box::new([BiomeTree::Leaf {
+                parameters: space,
+                biome,
+            }])),
+        },
+        sub @ Node::SubTree { .. } => convert(sub),
+    }))
+}
diff --git a/crates/pumpkin-world/src/generation/datapack/carver.rs b/crates/pumpkin-world/src/generation/datapack/carver.rs
new file mode 100644
index 0000000..42d1a5b
--- /dev/null
+++ b/crates/pumpkin-world/src/generation/datapack/carver.rs
@@ -0,0 +1,188 @@
+//! Carvers of pack biomes. A biome lists carvers by id; a pack can also replace a vanilla carver.
+
+use std::num::NonZero;
+
+use pumpkin_data::carver::{
+    CanyonCarverConfig, CanyonShapeConfig, CarverAdditionalConfig, CarverConfig, CaveCarverConfig,
+    HeightProvider, TrapezoidHeightProvider, UniformHeightProvider,
+    VeryBiasedToBottomHeightProvider,
+};
+use pumpkin_util::math::float_provider::FloatProvider;
+use pumpkin_util::y_offset::{AboveBottom, Absolute, BelowTop, RelativeToSeaLevel, YOffset};
+use rustc_hash::FxHashMap;
+use serde::de::DeserializeOwned;
+use serde_json::Value;
+
+use super::{DatapackSet, Result};
+
+fn field<T: DeserializeOwned>(json: &Value, key: &str) -> Result<T> {
+    let value = json
+        .get(key)
+        .ok_or_else(|| format!("carver has no {key}"))?;
+    serde_json::from_value(value.clone()).map_err(|e| format!("carver {key}: {e}"))
+}
+
+fn float(json: &Value, key: &str) -> f32 {
+    json.get(key).and_then(Value::as_f64).unwrap_or(0.0) as f32
+}
+
+pub(super) fn y_offset(v: &Value) -> YOffset {
+    let short = |n| i16::try_from(n).unwrap_or(0);
+    let byte = |n| i8::try_from(n).unwrap_or(0);
+    [
+        "absolute",
+        "above_bottom",
+        "below_top",
+        "relative_to_sea_level",
+    ]
+    .into_iter()
+    .find_map(|key| Some((key, v.get(key)?.as_i64()?)))
+    .map_or(
+        YOffset::Absolute(Absolute { absolute: 0 }),
+        |(key, n)| match key {
+            "absolute" => YOffset::Absolute(Absolute { absolute: short(n) }),
+            "above_bottom" => YOffset::AboveBottom(AboveBottom {
+                above_bottom: byte(n),
+            }),
+            "below_top" => YOffset::BelowTop(BelowTop { below_top: byte(n) }),
+            _ => YOffset::RelativeToSeaLevel(RelativeToSeaLevel {
+                relative_to_sea_level: short(n),
+            }),
+        },
+    )
+}
+
+fn height_provider(v: &Value) -> Result<HeightProvider> {
+    let min = y_offset(v.get("min_inclusive").unwrap_or(&Value::Null));
+    let max = y_offset(v.get("max_inclusive").unwrap_or(&Value::Null));
+    let ty = v.get("type").and_then(Value::as_str).unwrap_or("uniform");
+    let inner = v
+        .get("inner")
+        .and_then(Value::as_u64)
+        .and_then(|n| u32::try_from(n).ok())
+        .and_then(NonZero::new);
+    Ok(match ty.strip_prefix("minecraft:").unwrap_or(ty) {
+        "uniform" => HeightProvider::Uniform(UniformHeightProvider {
+            min_inclusive: min,
+            max_inclusive: max,
+        }),
+        "trapezoid" => HeightProvider::Trapezoid(TrapezoidHeightProvider {
+            min_inclusive: min,
+            max_inclusive: max,
+            plateau: v
+                .get("plateau")
+                .and_then(Value::as_i64)
+                .and_then(|n| i32::try_from(n).ok()),
+        }),
+        "very_biased_to_bottom" => {
+            HeightProvider::VeryBiasedToBottom(VeryBiasedToBottomHeightProvider {
+                min_inclusive: min,
+                max_inclusive: max,
+                inner,
+            })
+        }
+        other => return Err(format!("unsupported carver height provider {other}")),
+    })
+}
+
+/// A carver definition (`worldgen/carver/<name>.json`), read like the build-time conversion does.
+pub fn carver_from_json(json: &Value) -> Result<CarverConfig> {
+    let kind = json.get("type").and_then(Value::as_str).unwrap_or_default();
+    let additional = match kind {
+        "minecraft:cave" | "minecraft:nether_cave" => {
+            CarverAdditionalConfig::Cave(CaveCarverConfig {
+                count: field(json, "count")?,
+                horizontal_radius_multiplier: field(json, "horizontal_radius_multiplier")?,
+                vertical_radius_multiplier: field(json, "vertical_radius_multiplier")?,
+                floor_level: field(json, "floor_level")?,
+                room_vertical_radius_multiplier: field(json, "room_vertical_radius_multiplier")?,
+                start_vertical_radius_multiplier: json
+                    .get("start_vertical_radius_multiplier")
+                    .map_or(Ok(FloatProvider::Constant(1.0)), |_| {
+                        field(json, "start_vertical_radius_multiplier")
+                    })?,
+                thickness: field(json, "thickness")?,
+                weird_thickness_bias: json
+                    .get("weird_thickness_bias")
+                    .and_then(Value::as_bool)
+                    .unwrap_or(false),
+            })
+        }
+        "minecraft:canyon" => {
+            let shape = json.get("shape").ok_or("canyon has no shape")?;
+            CarverAdditionalConfig::Canyon(CanyonCarverConfig {
+                vertical_rotation: field(json, "vertical_rotation")?,
+                shape: CanyonShapeConfig {
+                    distance_factor: field(shape, "distance_factor")?,
+                    thickness: field(shape, "thickness")?,
+                    width_smoothness: shape
+                        .get("width_smoothness")
+                        .and_then(Value::as_i64)
+                        .and_then(|n| i32::try_from(n).ok())
+                        .unwrap_or(0),
+                    horizontal_radius_factor: field(shape, "horizontal_radius_factor")?,
+                    vertical_radius_default_factor: float(shape, "vertical_radius_default_factor"),
+                    vertical_radius_center_factor: float(shape, "vertical_radius_center_factor"),
+                    y_scale: field(shape, "y_scale")?,
+                },
+            })
+        }
+        other => return Err(format!("unsupported carver type {other}")),
+    };
+    Ok(CarverConfig {
+        probability: float(json, "probability"),
+        y: height_provider(json.get("y").ok_or("carver has no y")?)?,
+        additional,
+    })
+}
+
+/// The carvers resolved so far, so biomes that list the same carver share one config.
+#[derive(Default)]
+pub struct CarverCache(FxHashMap<String, &'static CarverConfig>);
+
+/// The carver `id` as a pack defines it, or the generated vanilla one. Pack definitions live for
+/// the rest of the process.
+fn resolve(set: &DatapackSet, cache: &mut CarverCache, id: &str) -> Result<&'static CarverConfig> {
+    let id = super::normalize_id(id);
+    if let Some(found) = cache.0.get(&id) {
+        return Ok(found);
+    }
+    let config: &'static CarverConfig = if let Some(json) = set.pack_json("carver", &id) {
+        Box::leak(Box::new(
+            carver_from_json(json).map_err(|e| format!("carver {id}: {e}"))?,
+        ))
+    } else {
+        match id.strip_prefix("minecraft:").unwrap_or(&id) {
+            "cave" => &pumpkin_data::carver::CAVE,
+            "cave_extra_underground" => &pumpkin_data::carver::CAVE_EXTRA_UNDERGROUND,
+            "canyon" => &pumpkin_data::carver::CANYON,
+            "nether_cave" => &pumpkin_data::carver::NETHER_CAVE,
+            _ => return Err(format!("unknown carver {id}")),
+        }
+    };
+    cache.0.insert(id, config);
+    Ok(config)
+}
+
+/// The carvers a biome JSON lists, or `None` when it lists none or one that cannot be resolved
+/// (the caller keeps the stand-in biome's carvers then).
+#[must_use]
+pub fn biome_carvers(
+    set: &DatapackSet,
+    cache: &mut CarverCache,
+    biome: &Value,
+) -> Option<&'static [&'static CarverConfig]> {
+    let list: Vec<&str> = match biome.get("carvers")? {
+        Value::String(one) => vec![one.as_str()],
+        Value::Array(many) => many.iter().filter_map(Value::as_str).collect(),
+        _ => return None,
+    };
+    let configs: Result<Vec<_>> = list.iter().map(|id| resolve(set, cache, id)).collect();
+    match configs {
+        Ok(configs) => Some(Box::leak(configs.into_boxed_slice())),
+        Err(err) => {
+            tracing::warn!("worldgen datapack: {err}; the stand-in biome's carvers are used");
+            None
+        }
+    }
+}
diff --git a/crates/pumpkin-world/src/generation/datapack/config.rs b/crates/pumpkin-world/src/generation/datapack/config.rs
new file mode 100644
index 0000000..ce3b6f8
--- /dev/null
+++ b/crates/pumpkin-world/src/generation/datapack/config.rs
@@ -0,0 +1,507 @@
+//! Mod configuration and load conditions that decide which pack files and overlays apply.
+//!
+//! The Tectonic parts are ported from Tectonic by Apollo (MIT License),
+//! <https://github.com/Apollounknowndev/tectonic> (`ConfigState`, `NoiseState`).
+
+use std::collections::BTreeSet;
+use std::path::{Path, PathBuf};
+
+use serde_json::{Value, json};
+use tracing::warn;
+
+/// The configuration files the packs' conditions and density functions read.
+#[derive(Clone, Debug)]
+pub struct PackConfig {
+    tectonic: Value,
+    terralith: Value,
+    lithostitched: Value,
+}
+
+/// A Tectonic noise setting (`NoiseState`).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct NoiseState {
+    pub scale: f64,
+    pub multiplier: f64,
+    pub offset: f64,
+    pub smoother_scaling: bool,
+}
+
+impl NoiseState {
+    const DEFAULT: Self = Self::new(0.25, 1.0, 0.0);
+
+    const fn new(scale: f64, multiplier: f64, offset: f64) -> Self {
+        Self {
+            scale,
+            multiplier,
+            offset,
+            smoother_scaling: false,
+        }
+    }
+}
+
+/// Removes `//` and `/* */` comments and trailing commas, which the config files may contain.
+#[must_use]
+pub fn strip_lenient_json(text: &str) -> String {
+    let chars: Vec<char> = text.trim_start_matches('\u{feff}').chars().collect();
+    let mut out = String::with_capacity(text.len());
+    let mut i = 0;
+    let mut in_string = false;
+    while i < chars.len() {
+        let c = chars[i];
+        if in_string {
+            out.push(c);
+            if c == '\\' && i + 1 < chars.len() {
+                out.push(chars[i + 1]);
+                i += 1;
+            } else if c == '"' {
+                in_string = false;
+            }
+        } else if c == '"' {
+            in_string = true;
+            out.push(c);
+        } else if c == '/' && chars.get(i + 1) == Some(&'/') {
+            while i < chars.len() && chars[i] != '\n' {
+                i += 1;
+            }
+            continue;
+        } else if c == '/' && chars.get(i + 1) == Some(&'*') {
+            i += 2;
+            while i + 1 < chars.len() && !(chars[i] == '*' && chars[i + 1] == '/') {
+                i += 1;
+            }
+            i += 2;
+            continue;
+        } else if c == ',' {
+            let next = chars[i + 1..].iter().find(|c| !c.is_whitespace());
+            if !matches!(next, Some('}' | ']')) {
+                out.push(c);
+            }
+        } else {
+            out.push(c);
+        }
+        i += 1;
+    }
+    out
+}
+
+fn merge(base: &mut Value, over: Value) {
+    match (base, over) {
+        (Value::Object(base), Value::Object(over)) => {
+            for (key, value) in over {
+                match base.get_mut(&key) {
+                    Some(slot) => merge(slot, value),
+                    None => {
+                        base.insert(key, value);
+                    }
+                }
+            }
+        }
+        (slot, over) => *slot = over,
+    }
+}
+
+fn tectonic_defaults() -> Value {
+    json!({
+        "general": {"mod_enabled": true, "snow_start_offset": 128},
+        "global_terrain": {
+            "vertical_scale": 1.125, "elevation_boost": 0.0, "min_y": -64, "max_y": 320,
+            "lava_tunnels": true, "ultrasmooth": false
+        },
+        "continents": {
+            "ocean_offset": -0.8, "continents_scale": 0.13, "erosion_scale": 0.25,
+            "ridge_scale": 0.25, "underground_rivers": true, "river_lanterns": true,
+            "river_ice": false, "flat_terrain_skew": 0.1, "rolling_hills": true,
+            "jungle_pillars": true
+        },
+        "islands": {"enabled": true, "noise_scale": 0.11, "noise_multiplier": 1.0, "noise_offset": 0.0},
+        "oceans": {
+            "ocean_depth": -0.22, "deep_ocean_depth": -0.45, "monument_offset": -30,
+            "remove_frozen_ocean_ice": false
+        },
+        "biomes": {
+            "temperature_scale": 0.25, "temperature_multiplier": 1.0, "temperature_offset": 0.0,
+            "vegetation_scale": 0.25, "vegetation_multiplier": 1.0, "vegetation_offset": 0.0
+        },
+        "caves": {
+            "depth_cutoff_start": 0.1, "depth_cutoff_size": 0.1, "cheese_enabled": true,
+            "cheese_additive": 0.27, "noodle_enabled": true, "noodle_additive": -0.075,
+            "spaghetti_enabled": true, "carvers_enabled": true, "ore_fix": false
+        },
+        "experimental": {"alternate_erosion_scaling": false, "alternate_continents_scaling": false}
+    })
+}
+
+fn terralith_defaults() -> Value {
+    json!({"modules": {
+        "custom_structures": true, "fog_tweaks": true, "intro_message": true,
+        "recipe_changes": false, "skylands": true, "terrain_slabs": true,
+        "vanilla_stone_gen": false
+    }})
+}
+
+fn lithostitched_defaults() -> Value {
+    json!({"breaks_seed_parity": true})
+}
+
+fn read_config(candidates: &[PathBuf], defaults: Value, name: &str) -> Value {
+    let mut value = defaults;
+    for path in candidates {
+        let Ok(text) = std::fs::read_to_string(path) else {
+            continue;
+        };
+        match serde_json::from_str::<Value>(&strip_lenient_json(&text)) {
+            Ok(file) => merge(&mut value, file),
+            Err(err) => warn!(
+                "worldgen datapack: ignoring {name} config {}: {err}",
+                path.display()
+            ),
+        }
+        break;
+    }
+    value
+}
+
+impl Default for PackConfig {
+    fn default() -> Self {
+        Self {
+            tectonic: tectonic_defaults(),
+            terralith: terralith_defaults(),
+            lithostitched: lithostitched_defaults(),
+        }
+    }
+}
+
+impl PackConfig {
+    /// Reads `config/tectonic.json` and `config/terralith.json` from the first place that has them:
+    /// the `PUMPKIN_TECTONIC_CONFIG` / `PUMPKIN_TERRALITH_CONFIG` variables,
+    /// `<world_dir>/../config/`, then `./config/`. Missing files give the mods' defaults.
+    #[must_use]
+    pub fn load(world_dir: Option<&Path>) -> Self {
+        let candidates = |env: &str, file: &str| {
+            let mut list = Vec::new();
+            if let Ok(path) = std::env::var(env) {
+                list.push(PathBuf::from(path));
+            }
+            if let Some(world) = world_dir {
+                list.push(world.join("..").join("config").join(file));
+            }
+            list.push(Path::new("config").join(file));
+            list
+        };
+        Self {
+            tectonic: read_config(
+                &candidates("PUMPKIN_TECTONIC_CONFIG", "tectonic.json"),
+                tectonic_defaults(),
+                "tectonic",
+            ),
+            terralith: read_config(
+                &candidates("PUMPKIN_TERRALITH_CONFIG", "terralith.json"),
+                terralith_defaults(),
+                "terralith",
+            ),
+            lithostitched: read_config(
+                &candidates("PUMPKIN_LITHOSTITCHED_CONFIG", "lithostitched.json"),
+                lithostitched_defaults(),
+                "lithostitched",
+            ),
+        }
+    }
+
+    /// Lithostitched's `breaks_seed_parity` option (on by default): its jigsaw placement then shuffles
+    /// template pools by weighted random keys instead of vanilla's.
+    #[must_use]
+    pub fn breaks_seed_parity(&self) -> bool {
+        self.lithostitched
+            .get("breaks_seed_parity")
+            .and_then(Value::as_bool)
+            .unwrap_or(true)
+    }
+
+    fn tectonic_number(&self, group: &str, key: &str) -> f64 {
+        self.tectonic
+            .get(group)
+            .and_then(|g| g.get(key))
+            .and_then(Value::as_f64)
+            .unwrap_or(0.0)
+    }
+
+    fn tectonic_flag(&self, group: &str, key: &str) -> bool {
+        self.tectonic
+            .get(group)
+            .and_then(|g| g.get(key))
+            .and_then(Value::as_bool)
+            .unwrap_or(false)
+    }
+
+    /// `ConfigState.getValue`.
+    #[must_use]
+    pub fn tectonic_value(&self, option: &str) -> f64 {
+        let n = |group, key| self.tectonic_number(group, key);
+        let flag = |group, key| f64::from(u8::from(self.tectonic_flag(group, key)));
+        match option {
+            "vertical_scale" => n("global_terrain", "vertical_scale"),
+            "elevation_boost" => n("global_terrain", "elevation_boost"),
+            "min_y" => n("global_terrain", "min_y"),
+            "max_y" => n("global_terrain", "max_y"),
+            "lava_tunnels" => flag("global_terrain", "lava_tunnels"),
+            "ocean_offset" => n("continents", "ocean_offset"),
+            "alternate_erosion_scale" => n("continents", "erosion_scale") * 4.0,
+            "underground_rivers" => {
+                if self.tectonic_flag("continents", "underground_rivers") {
+                    -1.0
+                } else {
+                    0.0
+                }
+            }
+            "flat_terrain_skew" => n("continents", "flat_terrain_skew"),
+            "rolling_hills" => flag("continents", "rolling_hills"),
+            "jungle_pillars" => flag("continents", "jungle_pillars"),
+            "ocean_depth" => n("oceans", "ocean_depth"),
+            "deep_ocean_depth" => n("oceans", "deep_ocean_depth"),
+            "depth_cutoff_start" => n("caves", "depth_cutoff_start"),
+            "depth_cutoff_size" => n("caves", "depth_cutoff_size"),
+            "cheese_enabled" => flag("caves", "cheese_enabled"),
+            "cheese_additive" => n("caves", "cheese_additive"),
+            "noodle_enabled" => flag("caves", "noodle_enabled"),
+            "noodle_additive" => n("caves", "noodle_additive"),
+            _ => 0.0,
+        }
+    }
+
+    /// `ConfigState.getNoiseState`. `None` for an unknown option.
+    #[must_use]
+    pub fn tectonic_noise_state(&self, option: &str) -> Option<NoiseState> {
+        let group = |group: &str, prefix: &str| NoiseState {
+            scale: self.tectonic_number(group, &format!("{prefix}_scale")),
+            multiplier: self.tectonic_number(group, &format!("{prefix}_multiplier")),
+            offset: self.tectonic_number(group, &format!("{prefix}_offset")),
+            smoother_scaling: false,
+        };
+        let smoother = self.tectonic_flag("experimental", "alternate_erosion_scaling");
+        Some(match option {
+            "continents" => NoiseState {
+                smoother_scaling: smoother,
+                ..NoiseState::new(
+                    self.tectonic_number("continents", "continents_scale"),
+                    1.0,
+                    0.0,
+                )
+            },
+            "erosion" => NoiseState {
+                smoother_scaling: smoother,
+                ..NoiseState::new(
+                    self.tectonic_number("continents", "erosion_scale"),
+                    1.0,
+                    0.0,
+                )
+            },
+            "ridge" => NoiseState::new(self.tectonic_number("continents", "ridge_scale"), 1.0, 0.0),
+            "island" => group("islands", "noise"),
+            "temperature" => group("biomes", "temperature"),
+            "vegetation" => group("biomes", "vegetation"),
+            "default" => NoiseState::DEFAULT,
+            _ => return None,
+        })
+    }
+
+    /// `ConfigState.test`.
+    #[must_use]
+    pub fn tectonic_test(&self, key: &str) -> bool {
+        match key {
+            "disable_islands" => {
+                !self.tectonic_flag("islands", "enabled")
+                    && self.tectonic_number("continents", "ocean_offset") < -0.49
+            }
+            "increased_height" => self.tectonic_number("global_terrain", "max_y") > 320.0,
+            "ultrasmooth" => self.tectonic_flag("global_terrain", "ultrasmooth"),
+            "remove_frozen_ocean_ice" => self.tectonic_flag("oceans", "remove_frozen_ocean_ice"),
+            "river_lanterns" => self.tectonic_flag("continents", "river_lanterns"),
+            "river_ice" => self.tectonic_flag("continents", "river_ice"),
+            "ore_fix" => self.tectonic_flag("caves", "ore_fix"),
+            "no_carvers" => !self.tectonic_flag("caves", "carvers_enabled"),
+            _ => false,
+        }
+    }
+
+    /// `snow_start_offset` of Tectonic's general settings (`BiomeMixin`).
+    #[must_use]
+    pub fn snow_start_offset(&self) -> i32 {
+        self.tectonic_number("general", "snow_start_offset") as i32
+    }
+
+    fn terralith_module(&self, key: &str) -> bool {
+        self.terralith
+            .get("modules")
+            .and_then(|m| m.get(key))
+            .and_then(Value::as_bool)
+            .unwrap_or(true)
+    }
+}
+
+/// Evaluates the load conditions of pack files and overlays.
+pub struct ConditionContext<'a> {
+    pub mods: &'a BTreeSet<String>,
+    pub config: &'a PackConfig,
+}
+
+impl ConditionContext<'_> {
+    /// Whether the mod `id` counts as loaded: the ids found in the packs, plus the platform.
+    #[must_use]
+    pub fn mod_loaded(&self, id: &str) -> bool {
+        id == "minecraft" || id.starts_with("fabric") || self.mods.contains(id)
+    }
+
+    /// Conditions of a pack file: `fabric:load_conditions` (an object or a list of them), else
+    /// `neoforge:conditions`. All must hold.
+    #[must_use]
+    pub fn file_enabled(&self, json: &Value) -> bool {
+        let Some(conditions) = json
+            .get("fabric:load_conditions")
+            .or_else(|| json.get("neoforge:conditions"))
+        else {
+            return true;
+        };
+        match conditions {
+            Value::Array(list) => list.iter().all(|c| self.test(c)),
+            other => self.test(other),
+        }
+    }
+
+    fn values(condition: &Value) -> Vec<&Value> {
+        condition
+            .get("values")
+            .and_then(Value::as_array)
+            .map(|a| a.iter().collect())
+            .unwrap_or_default()
+    }
+
+    fn mod_ids(condition: &Value) -> Vec<&str> {
+        let mut ids: Vec<&str> = condition
+            .get("values")
+            .and_then(Value::as_array)
+            .map(|a| a.iter().filter_map(Value::as_str).collect())
+            .unwrap_or_default();
+        ids.extend(condition.get("modid").and_then(Value::as_str));
+        ids
+    }
+
+    /// One condition object, in the Fabric (`condition`) or `NeoForge` (`type`) form.
+    /// Unknown conditions do not hold.
+    #[must_use]
+    pub fn test(&self, condition: &Value) -> bool {
+        let Some(kind) = condition
+            .get("condition")
+            .or_else(|| condition.get("type"))
+            .and_then(Value::as_str)
+        else {
+            warn!("worldgen datapack: load condition without a type");
+            return false;
+        };
+        let kind = kind
+            .strip_prefix("fabric:")
+            .or_else(|| kind.strip_prefix("neoforge:"))
+            .unwrap_or(kind);
+        match kind {
+            "true" => true,
+            "not" => condition.get("value").is_some_and(|v| !self.test(v)),
+            "and" => Self::values(condition).into_iter().all(|v| self.test(v)),
+            "or" => Self::values(condition).into_iter().any(|v| self.test(v)),
+            "all_mods_loaded" | "mod_loaded" => Self::mod_ids(condition)
+                .iter()
+                .all(|id| self.mod_loaded(id)),
+            "any_mods_loaded" => Self::mod_ids(condition)
+                .iter()
+                .any(|id| self.mod_loaded(id)),
+            "none_mods_loaded" => !Self::mod_ids(condition)
+                .iter()
+                .any(|id| self.mod_loaded(id)),
+            "tectonic:config" => condition
+                .get("key")
+                .and_then(Value::as_str)
+                .is_some_and(|key| self.config.tectonic_test(key)),
+            "terralith:config" => {
+                let value = condition
+                    .get("key")
+                    .and_then(Value::as_str)
+                    .is_some_and(|key| self.config.terralith_module(key));
+                value
+                    != condition
+                        .get("invert")
+                        .and_then(Value::as_bool)
+                        .unwrap_or(false)
+            }
+            other => {
+                warn!("worldgen datapack: unknown load condition {other}, treated as false");
+                false
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn context<'a>(mods: &'a BTreeSet<String>, config: &'a PackConfig) -> ConditionContext<'a> {
+        ConditionContext { mods, config }
+    }
+
+    #[test]
+    fn lenient_json_strips_comments_and_trailing_commas() {
+        let text = "{\n // note, with comma\n \"a\": \"x//y,}\", /* c */ \"b\": [1, 2,],\n}";
+        let value: Value = serde_json::from_str(&strip_lenient_json(text)).unwrap();
+        assert_eq!(value, json!({"a": "x//y,}", "b": [1, 2]}));
+    }
+
+    #[test]
+    fn user_values_override_defaults() {
+        let mut config = PackConfig::default();
+        assert!((config.tectonic_value("vertical_scale") - 1.125).abs() < 1e-12);
+        merge(
+            &mut config.tectonic,
+            json!({"global_terrain": {"vertical_scale": 2.0}}),
+        );
+        assert!((config.tectonic_value("vertical_scale") - 2.0).abs() < 1e-12);
+        assert!((config.tectonic_value("ocean_offset") + 0.8).abs() < 1e-12);
+        assert!((config.tectonic_value("underground_rivers") + 1.0).abs() < 1e-12);
+    }
+
+    #[test]
+    fn default_overlays_do_not_apply() {
+        let config = PackConfig::default();
+        let mods = BTreeSet::new();
+        let ctx = context(&mods, &config);
+        for key in ["no_carvers", "ore_fix", "ultrasmooth"] {
+            assert!(!ctx.test(&json!({"condition": "tectonic:config", "key": key})));
+        }
+        assert!(
+            !ctx.test(&json!({"condition": "terralith:config", "key": "skylands", "invert": true}))
+        );
+        assert!(ctx.test(&json!({"condition": "terralith:config", "key": "skylands"})));
+        assert!(!ctx.test(&json!({"condition": "terralith:config", "key": "vanilla_stone_gen"})));
+        assert!(!ctx.test(&json!({"condition": "mystery:thing"})));
+    }
+
+    #[test]
+    fn mod_conditions() {
+        let config = PackConfig::default();
+        let mods: BTreeSet<String> = ["lithostitched".to_string()].into();
+        let ctx = context(&mods, &config);
+        let not_litho = json!({
+            "fabric:load_conditions": {"condition": "fabric:not",
+                "value": {"condition": "fabric:all_mods_loaded", "values": ["lithostitched"]}},
+            "neoforge:conditions": []
+        });
+        assert!(!ctx.file_enabled(&not_litho));
+        let neo = json!({"neoforge:conditions": [{"type": "neoforge:not",
+            "value": {"type": "neoforge:mod_loaded", "modid": "lithostitched"}}]});
+        assert!(!ctx.file_enabled(&neo));
+        let any =
+            json!([{"condition": "fabric:any_mods_loaded", "values": ["nothing", "fabric-api"]}]);
+        assert!(ctx.file_enabled(&json!({"fabric:load_conditions": any})));
+        assert!(ctx.file_enabled(&json!({"x": 1})));
+        let or = json!({"condition": "fabric:or", "values": [
+            {"condition": "fabric:all_mods_loaded", "values": ["nothing"]}, {"condition": "fabric:true"}]});
+        assert!(ctx.test(&or));
+    }
+}
diff --git a/crates/pumpkin-world/src/generation/datapack/density_function.rs b/crates/pumpkin-world/src/generation/datapack/density_function.rs
new file mode 100644
index 0000000..dcb9b28
--- /dev/null
+++ b/crates/pumpkin-world/src/generation/datapack/density_function.rs
@@ -0,0 +1,1459 @@
+//! Density functions from raw worldgen datapack JSON, converted into the component stacks that
+//! [`ProtoNoiseRouters`](crate::generation::noise::router::proto_noise_router::ProtoNoiseRouters)
+//! interprets.
+//!
+//! This mirrors `tools/pumpkin-codegen/src/noise_router.rs` (parse, constant folding, axis slicing,
+//! deduplication of identical subtrees), so a vanilla router built here samples like the generated one.
+
+use std::collections::BTreeMap;
+use std::hash::{DefaultHasher, Hash, Hasher};
+use std::mem::discriminant;
+
+use pumpkin_data::noise_parameter::DoublePerlinNoiseParameters;
+use pumpkin_data::noise_router::{
+    Axis, BaseMultiNoiseRouter, BaseNoiseFunctionComponent, BaseNoiseRouter, BaseNoiseRouters,
+    BaseSurfaceEstimator, BaseVeinRouter, BinaryData, BinaryOperation, ClampData, DistanceMetric,
+    DistanceToPointData, FindTopSurfaceData, GradientData, InterpolatedNoiseSamplerData,
+    LinearData, LinearOperation, NoiseData, RangeChoiceData, RoundingData, RoundingOperation,
+    ShiftedNoiseData, SplinePoint, SplineRepr, Tiling, UnaryData, UnaryOperation, WrapperType,
+};
+use rustc_hash::FxHashMap;
+use serde_json::{Map, Value};
+
+use super::noise::NoiseTable;
+use super::{DatapackSet, Result, normalize_id};
+
+/// Deepest chain of density function references and nested definitions.
+const MAX_DEPTH: usize = 128;
+
+/// `minecraft:y` is the clamped gradient over the full coordinate range.
+const Y_RANGE: (i32, i32) = (-4064, 4062);
+
+#[derive(Clone, Copy)]
+struct F32(f32);
+
+impl Hash for F32 {
+    fn hash<H: Hasher>(&self, state: &mut H) {
+        self.0.to_bits().hash(state);
+    }
+}
+
+#[derive(Clone, Copy)]
+struct F64(f64);
+
+impl Hash for F64 {
+    fn hash<H: Hasher>(&self, state: &mut H) {
+        self.0.to_bits().hash(state);
+    }
+}
+
+/// Hashes a fieldless enum by its variant.
+#[derive(Clone, Copy)]
+struct Tag<T>(T);
+
+impl<T> Hash for Tag<T> {
+    fn hash<H: Hasher>(&self, state: &mut H) {
+        discriminant(&self.0).hash(state);
+    }
+}
+
+#[derive(Clone, Copy, Hash)]
+enum Wrapper {
+    Interpolated { cell_size_xz: i32, cell_size_y: i32 },
+    Cache,
+}
+
+#[derive(Clone, Hash)]
+enum Spline {
+    Standard {
+        location_function: Box<Df>,
+        locations: Box<[F32]>,
+        values: Box<[Self]>,
+        derivatives: Box<[F32]>,
+    },
+    Fixed(F32),
+}
+
+/// A density function tree. Identical subtrees hash equal and share one stack entry.
+#[derive(Clone, Hash)]
+enum Df {
+    Beardifier,
+    BlendAlpha,
+    BlendOffset,
+    EndIslands,
+    BlendDensity(Box<Self>),
+    FindTopSurface {
+        density: Box<Self>,
+        upper_bound: Box<Self>,
+        lower_bound: i32,
+        cell_height: i32,
+    },
+    Noise {
+        noise: String,
+        xz_scale: F64,
+        y_scale: F64,
+    },
+    ShiftA(String),
+    ShiftB(String),
+    ShiftedNoise {
+        shift_x: Box<Self>,
+        shift_y: Box<Self>,
+        shift_z: Box<Self>,
+        noise: String,
+        xz_scale: F64,
+        y_scale: F64,
+    },
+    InterpolatedNoise {
+        xz_scale: F64,
+        y_scale: F64,
+        xz_factor: F64,
+        y_factor: F64,
+        smear_scale_multiplier: F64,
+    },
+    IntervalSelect {
+        input: Box<Self>,
+        thresholds: Box<[F32]>,
+        functions: Box<[Self]>,
+    },
+    Wrapper {
+        input: Box<Self>,
+        wrapper: Wrapper,
+    },
+    Constant(F32),
+    Gradient {
+        axis: Tag<Axis>,
+        tiling: Tag<Tiling>,
+        from_coordinate: i32,
+        to_coordinate: i32,
+        from_value: F32,
+        to_value: F32,
+    },
+    DistanceToPoint {
+        point: [i32; 3],
+        metric: Tag<DistanceMetric>,
+    },
+    Lerp {
+        alpha: Box<Self>,
+        first: Box<Self>,
+        second: Box<Self>,
+    },
+    Rounding {
+        input: Box<Self>,
+        multiple: Box<Self>,
+        operation: Tag<RoundingOperation>,
+    },
+    Slice {
+        axis: Tag<Axis>,
+        coordinate: i32,
+        input: Box<Self>,
+    },
+    Binary {
+        argument1: Box<Self>,
+        argument2: Box<Self>,
+        operation: Tag<BinaryOperation>,
+    },
+    Linear {
+        input: Box<Self>,
+        operation: Tag<LinearOperation>,
+        argument: F32,
+    },
+    Unary {
+        input: Box<Self>,
+        operation: Tag<UnaryOperation>,
+    },
+    Clamp {
+        input: Box<Self>,
+        min_value: F32,
+        max_value: F32,
+    },
+    RangeChoice {
+        input: Box<Self>,
+        when_in_range: Box<Self>,
+        when_out_range: Box<Self>,
+        min_inclusive: F32,
+        max_exclusive: F32,
+    },
+    Spline(Spline),
+}
+
+impl Df {
+    const fn constant(value: f32) -> Self {
+        Self::Constant(F32(value))
+    }
+}
+
+fn boxed(df: Df) -> Box<Df> {
+    Box::new(df)
+}
+
+// ---------------------------------------------------------------------------------------------
+// Parsing
+// ---------------------------------------------------------------------------------------------
+
+fn parse_axis(s: &str) -> Result<Axis> {
+    match s {
+        "x" | "X" => Ok(Axis::X),
+        "y" | "Y" => Ok(Axis::Y),
+        "z" | "Z" => Ok(Axis::Z),
+        other => Err(format!("unknown axis {other}")),
+    }
+}
+
+fn parse_tiling(s: &str) -> Tiling {
+    match s {
+        "repeat" => Tiling::Repeat,
+        "mirrored_repeat" => Tiling::MirroredRepeat,
+        _ => Tiling::ClampToEdge,
+    }
+}
+
+fn parse_metric(s: &str) -> Result<DistanceMetric> {
+    match s {
+        "euclidean" => Ok(DistanceMetric::Euclidean),
+        "euclidean_squared" => Ok(DistanceMetric::EuclideanSquared),
+        "manhattan" => Ok(DistanceMetric::Manhattan),
+        "chebyshev" => Ok(DistanceMetric::Chebyshev),
+        other => Err(format!("unknown distance metric {other}")),
+    }
+}
+
+fn field<'a>(obj: &'a Map<String, Value>, names: &[&str]) -> Option<&'a Value> {
+    names.iter().find_map(|n| obj.get(*n))
+}
+
+fn require<'a>(obj: &'a Map<String, Value>, kind: &str, names: &[&str]) -> Result<&'a Value> {
+    field(obj, names).ok_or_else(|| format!("{kind} is missing {}", names[0]))
+}
+
+fn number(obj: &Map<String, Value>, names: &[&str], default: f64) -> f64 {
+    field(obj, names).and_then(Value::as_f64).unwrap_or(default)
+}
+
+fn integer(obj: &Map<String, Value>, kind: &str, names: &[&str]) -> Result<i32> {
+    require(obj, kind, names)?
+        .as_i64()
+        .and_then(|v| i32::try_from(v).ok())
+        .ok_or_else(|| format!("{kind}: {} is not an integer", names[0]))
+}
+
+fn string<'a>(obj: &'a Map<String, Value>, kind: &str, names: &[&str]) -> Result<&'a str> {
+    require(obj, kind, names)?
+        .as_str()
+        .ok_or_else(|| format!("{kind}: {} is not a string", names[0]))
+}
+
+/// Parses density functions, following references into packs and vanilla.
+pub struct DfParser<'a> {
+    set: &'a DatapackSet,
+    resolved: FxHashMap<String, Df>,
+    active: Vec<String>,
+    depth: usize,
+}
+
+impl<'a> DfParser<'a> {
+    #[must_use]
+    pub fn new(set: &'a DatapackSet) -> Self {
+        Self {
+            set,
+            resolved: FxHashMap::default(),
+            active: Vec::new(),
+            depth: 0,
+        }
+    }
+
+    /// Number of named density functions resolved so far.
+    #[must_use]
+    pub fn resolved_count(&self) -> usize {
+        self.resolved.len()
+    }
+
+    fn reference(&mut self, name: &str) -> Result<Df> {
+        match name {
+            "minecraft:y" => {
+                return Ok(Df::Gradient {
+                    axis: Tag(Axis::Y),
+                    tiling: Tag(Tiling::ClampToEdge),
+                    from_coordinate: Y_RANGE.0,
+                    to_coordinate: Y_RANGE.1,
+                    from_value: F32(Y_RANGE.0 as f32),
+                    to_value: F32(Y_RANGE.1 as f32),
+                });
+            }
+            "minecraft:zero" => return Ok(Df::constant(0.0)),
+            _ => {}
+        }
+        let id = normalize_id(name);
+        if let Some(df) = self.resolved.get(&id) {
+            return Ok(df.clone());
+        }
+        if self.active.contains(&id) {
+            return Err(format!("density function {id} refers to itself"));
+        }
+        let json = self
+            .set
+            .json("density_function", &id)
+            .ok_or_else(|| format!("unknown density function {id}"))?;
+        self.active.push(id.clone());
+        let parsed = self.parse(&json).map_err(|e| format!("{id}: {e}"));
+        self.active.pop();
+        let df = parsed?;
+        self.resolved.insert(id, df.clone());
+        Ok(df)
+    }
+
+    fn parse(&mut self, value: &Value) -> Result<Df> {
+        self.depth += 1;
+        let result = if self.depth > MAX_DEPTH {
+            Err("density function is nested too deeply".to_string())
+        } else {
+            self.parse_node(value)
+        };
+        self.depth -= 1;
+        result
+    }
+
+    fn child(&mut self, obj: &Map<String, Value>, kind: &str, names: &[&str]) -> Result<Df> {
+        let value = require(obj, kind, names)?;
+        self.parse(value)
+    }
+
+    fn parse_node(&mut self, value: &Value) -> Result<Df> {
+        match value {
+            Value::Number(n) => Ok(Df::constant(n.as_f64().unwrap_or(0.0) as f32)),
+            Value::String(name) => self.reference(name),
+            Value::Object(obj) => {
+                let type_name = obj
+                    .get("type")
+                    .and_then(Value::as_str)
+                    .ok_or("density function object has no type")?;
+                let kind = type_name.strip_prefix("minecraft:").unwrap_or(type_name);
+                self.parse_typed(obj, kind)
+            }
+            _ => Err("unsupported JSON value for a density function".to_string()),
+        }
+    }
+
+    #[expect(clippy::too_many_lines)]
+    fn parse_typed(&mut self, obj: &Map<String, Value>, kind: &str) -> Result<Df> {
+        Ok(match kind {
+            "constant" => Df::constant(number(obj, &["value", "argument"], 0.0) as f32),
+            "y_clamped_gradient" => Df::Gradient {
+                axis: Tag(Axis::Y),
+                tiling: Tag(Tiling::ClampToEdge),
+                from_coordinate: number(obj, &["from_y"], -64.0) as i32,
+                to_coordinate: number(obj, &["to_y"], 320.0) as i32,
+                from_value: F32(number(obj, &["from_value"], 0.0) as f32),
+                to_value: F32(number(obj, &["to_value"], 0.0) as f32),
+            },
+            "gradient" => Df::Gradient {
+                axis: Tag(parse_axis(
+                    field(obj, &["axis"]).and_then(Value::as_str).unwrap_or("y"),
+                )?),
+                tiling: Tag(parse_tiling(
+                    field(obj, &["tiling"])
+                        .and_then(Value::as_str)
+                        .unwrap_or("clamp_to_edge"),
+                )),
+                from_coordinate: integer(obj, kind, &["from_coordinate", "from_y"])?,
+                to_coordinate: integer(obj, kind, &["to_coordinate", "to_y"])?,
+                from_value: F32(require(obj, kind, &["from_value"])?.as_f64().unwrap_or(0.0) as f32),
+                to_value: F32(require(obj, kind, &["to_value"])?.as_f64().unwrap_or(0.0) as f32),
+            },
+            "distance_to_point" => {
+                let point = require(obj, kind, &["point"])?
+                    .as_array()
+                    .filter(|p| p.len() == 3)
+                    .ok_or("distance_to_point needs a 3 element point")?;
+                let coordinate = |i: usize| point[i].as_i64().unwrap_or(0) as i32;
+                Df::DistanceToPoint {
+                    point: [coordinate(0), coordinate(1), coordinate(2)],
+                    metric: Tag(parse_metric(
+                        field(obj, &["metric"])
+                            .and_then(Value::as_str)
+                            .unwrap_or("euclidean"),
+                    )?),
+                }
+            }
+            "lerp" => Df::Lerp {
+                alpha: boxed(self.child(obj, kind, &["alpha"])?),
+                first: boxed(self.child(obj, kind, &["first"])?),
+                second: boxed(self.child(obj, kind, &["second"])?),
+            },
+            "floor" | "round" | "ceil" | "truncate" => {
+                let operation = match kind {
+                    "floor" => RoundingOperation::Floor,
+                    "round" => RoundingOperation::Round,
+                    "ceil" => RoundingOperation::Ceil,
+                    _ => RoundingOperation::Truncate,
+                };
+                let multiple = match obj.get("multiple") {
+                    Some(m) => self.parse(m)?,
+                    None => Df::constant(1.0),
+                };
+                Df::Rounding {
+                    input: boxed(self.child(obj, kind, &["input", "argument"])?),
+                    multiple: boxed(multiple),
+                    operation: Tag(operation),
+                }
+            }
+            "slice" => Df::Slice {
+                axis: Tag(parse_axis(
+                    field(obj, &["axis"]).and_then(Value::as_str).unwrap_or("y"),
+                )?),
+                coordinate: integer(obj, kind, &["coordinate"])?,
+                input: boxed(self.child(obj, kind, &["input"])?),
+            },
+            "old_blended_noise" => Df::InterpolatedNoise {
+                xz_scale: F64(number(obj, &["xz_scale"], 0.25)),
+                y_scale: F64(number(obj, &["y_scale"], 0.125)),
+                xz_factor: F64(number(obj, &["xz_factor"], 80.0)),
+                y_factor: F64(number(obj, &["y_factor"], 160.0)),
+                smear_scale_multiplier: F64(number(obj, &["smear_scale_multiplier"], 8.0)),
+            },
+            "add" | "mul" | "min" | "max" | "sub" | "div" | "pow" => {
+                let arg1 = self.child(obj, kind, &["left", "argument1", "base"])?;
+                let arg2 = self.child(obj, kind, &["right", "argument2", "exponent"])?;
+                let linear = match kind {
+                    "add" => Some(LinearOperation::Add),
+                    "mul" => Some(LinearOperation::Mul),
+                    _ => None,
+                };
+                match (linear, arg1, arg2) {
+                    (Some(operation), Df::Constant(c), input)
+                    | (Some(operation), input, Df::Constant(c)) => Df::Linear {
+                        input: boxed(input),
+                        operation: Tag(operation),
+                        argument: c,
+                    },
+                    (_, arg1, arg2) => Df::Binary {
+                        argument1: boxed(arg1),
+                        argument2: boxed(arg2),
+                        operation: Tag(match kind {
+                            "add" => BinaryOperation::Add,
+                            "mul" => BinaryOperation::Mul,
+                            "min" => BinaryOperation::Min,
+                            "max" => BinaryOperation::Max,
+                            "sub" => BinaryOperation::Sub,
+                            "div" => BinaryOperation::Div,
+                            _ => BinaryOperation::Pow,
+                        }),
+                    },
+                }
+            }
+            "abs" | "square" | "cube" | "half_negative" | "quarter_negative" | "squeeze"
+            | "invert" | "reciprocal" | "negate" | "sqrt" | "log" | "sign" => Df::Unary {
+                input: boxed(self.child(obj, kind, &["argument", "input"])?),
+                operation: Tag(match kind {
+                    "abs" => UnaryOperation::Abs,
+                    "square" => UnaryOperation::Square,
+                    "cube" => UnaryOperation::Cube,
+                    "half_negative" => UnaryOperation::HalfNegative,
+                    "quarter_negative" => UnaryOperation::QuarterNegative,
+                    "squeeze" => UnaryOperation::Squeeze,
+                    "invert" | "reciprocal" => UnaryOperation::Invert,
+                    "negate" => UnaryOperation::Negate,
+                    "sqrt" => UnaryOperation::Sqrt,
+                    "log" => UnaryOperation::Log,
+                    _ => UnaryOperation::Sign,
+                }),
+            },
+            "clamp" => Df::Clamp {
+                input: boxed(self.child(obj, kind, &["input", "argument"])?),
+                min_value: F32(number(obj, &["min", "min_value"], f64::NEG_INFINITY) as f32),
+                max_value: F32(number(obj, &["max", "max_value"], f64::INFINITY) as f32),
+            },
+            "range_choice" => Df::RangeChoice {
+                input: boxed(self.child(obj, kind, &["input"])?),
+                when_in_range: boxed(self.child(obj, kind, &["when_in_range"])?),
+                when_out_range: boxed(self.child(obj, kind, &["when_out_of_range"])?),
+                min_inclusive: F32(number(obj, &["min_inclusive"], f64::NEG_INFINITY) as f32),
+                max_exclusive: F32(number(obj, &["max_exclusive"], f64::INFINITY) as f32),
+            },
+            "interval_select" => {
+                let thresholds = require(obj, kind, &["thresholds"])?
+                    .as_array()
+                    .ok_or("interval_select thresholds are not a list")?
+                    .iter()
+                    .map(|v| F32(v.as_f64().unwrap_or(0.0) as f32))
+                    .collect();
+                let functions = require(obj, kind, &["functions"])?
+                    .as_array()
+                    .ok_or("interval_select functions are not a list")?
+                    .iter()
+                    .map(|v| self.parse(v))
+                    .collect::<Result<Vec<_>>>()?;
+                Df::IntervalSelect {
+                    input: boxed(self.child(obj, kind, &["input"])?),
+                    thresholds,
+                    functions: functions.into_boxed_slice(),
+                }
+            }
+            "spline" => Df::Spline(self.parse_spline(require(obj, kind, &["spline"])?)?),
+            "noise" => {
+                let noise = string(obj, kind, &["noise"])?.to_string();
+                let xz_scale = F64(number(obj, &["xz_scale"], 1.0));
+                let y_scale = F64(number(obj, &["y_scale"], 1.0));
+                if ["shift_x", "shift_y", "shift_z"]
+                    .iter()
+                    .any(|k| obj.contains_key(*k))
+                {
+                    let mut shift = |name: &str| {
+                        obj.get(name).map_or_else(
+                            || Ok(boxed(Df::constant(0.0))),
+                            |v| self.parse(v).map(boxed),
+                        )
+                    };
+                    Df::ShiftedNoise {
+                        shift_x: shift("shift_x")?,
+                        shift_y: shift("shift_y")?,
+                        shift_z: shift("shift_z")?,
+                        noise,
+                        xz_scale,
+                        y_scale,
+                    }
+                } else {
+                    Df::Noise {
+                        noise,
+                        xz_scale,
+                        y_scale,
+                    }
+                }
+            }
+            "shifted_noise" => Df::ShiftedNoise {
+                shift_x: boxed(self.child(obj, kind, &["shift_x"])?),
+                shift_y: boxed(self.child(obj, kind, &["shift_y"])?),
+                shift_z: boxed(self.child(obj, kind, &["shift_z"])?),
+                noise: string(obj, kind, &["noise"])?.to_string(),
+                xz_scale: F64(number(obj, &["xz_scale"], 1.0)),
+                y_scale: F64(number(obj, &["y_scale"], 1.0)),
+            },
+            "shift_a" | "shift" => {
+                Df::ShiftA(string(obj, kind, &["noise", "argument"])?.to_string())
+            }
+            "shift_b" => Df::ShiftB(string(obj, kind, &["noise", "argument"])?.to_string()),
+            "blend_alpha" => Df::BlendAlpha,
+            "blend_offset" => Df::BlendOffset,
+            "blend_density" => {
+                Df::BlendDensity(boxed(self.child(obj, kind, &["input", "argument"])?))
+            }
+            "end_islands" | "end_outer_islands" => Df::EndIslands,
+            "beardifier" => Df::Beardifier,
+            "cache" | "interpolated" | "flat_cache" | "cache_flat" | "cache_2d" | "cache_once"
+            | "cache_all_in_cell" => {
+                let wrapper = if kind == "interpolated" {
+                    Wrapper::Interpolated {
+                        cell_size_xz: integer(obj, kind, &["cell_size_xz"])?,
+                        cell_size_y: integer(obj, kind, &["cell_size_y"])?,
+                    }
+                } else {
+                    Wrapper::Cache
+                };
+                Df::Wrapper {
+                    input: boxed(self.child(obj, kind, &["input", "argument"])?),
+                    wrapper,
+                }
+            }
+            "find_top_surface" | "weird_utility_density" => Df::FindTopSurface {
+                density: boxed(self.child(obj, kind, &["density"])?),
+                upper_bound: boxed(self.child(obj, kind, &["upper_bound"])?),
+                lower_bound: number(obj, &["lower_bound"], -64.0) as i32,
+                cell_height: number(obj, &["cell_height"], 8.0) as i32,
+            },
+            "tectonic:config_constant" => {
+                let key = string(obj, kind, &["key"])?;
+                Df::constant(self.set.config().tectonic_value(key) as f32)
+            }
+            "tectonic:config_noise" => self.config_noise(obj)?,
+            "tectonic:config_clamp" => Df::Binary {
+                argument1: boxed(Df::Binary {
+                    argument1: boxed(self.child(obj, kind, &["input"])?),
+                    argument2: boxed(self.child(obj, kind, &["min"])?),
+                    operation: Tag(BinaryOperation::Max),
+                }),
+                argument2: boxed(self.child(obj, kind, &["max"])?),
+                operation: Tag(BinaryOperation::Min),
+            },
+            "tectonic:invert" => Df::Unary {
+                input: boxed(self.child(obj, kind, &["argument", "input"])?),
+                operation: Tag(UnaryOperation::Invert),
+            },
+            other => return Err(format!("unknown density function type {other}")),
+        })
+    }
+
+    /// Tectonic's `ConfigNoise` after its `mapChildren`: `shifted_noise_2d * multiplier + offset`
+    /// with the scale, multiplier and offset taken from the config.
+    /// Ported from Tectonic by Apollo (MIT License), <https://github.com/Apollounknowndev/tectonic>.
+    fn config_noise(&mut self, obj: &Map<String, Value>) -> Result<Df> {
+        let kind = "tectonic:config_noise";
+        let key = string(obj, kind, &["key"])?;
+        let state = self
+            .set
+            .config()
+            .tectonic_noise_state(key)
+            .ok_or_else(|| format!("{kind}: unknown config noise {key}"))?;
+        if state.smoother_scaling {
+            return Err(format!("{kind}: smoother scaling ({key}) is not supported"));
+        }
+        let shifted = Df::ShiftedNoise {
+            shift_x: boxed(self.child(obj, kind, &["shift_x"])?),
+            shift_y: boxed(Df::constant(0.0)),
+            shift_z: boxed(self.child(obj, kind, &["shift_z"])?),
+            noise: string(obj, kind, &["noise"])?.to_string(),
+            xz_scale: F64(state.scale),
+            y_scale: F64(0.0),
+        };
+        Ok(Df::Linear {
+            input: boxed(Df::Linear {
+                input: boxed(shifted),
+                operation: Tag(LinearOperation::Mul),
+                argument: F32(state.multiplier as f32),
+            }),
+            operation: Tag(LinearOperation::Add),
+            argument: F32(state.offset as f32),
+        })
+    }
+
+    fn parse_spline(&mut self, value: &Value) -> Result<Spline> {
+        if let Some(n) = value.as_f64() {
+            return Ok(Spline::Fixed(F32(n as f32)));
+        }
+        let obj = value.as_object().ok_or("unsupported spline node")?;
+        if let Some(inner) = obj.get("value")
+            && !obj.contains_key("points")
+        {
+            return self.parse_spline(inner);
+        }
+        let location_function = boxed(self.child(obj, "spline", &["coordinate"])?);
+        let points = require(obj, "spline", &["points"])?
+            .as_array()
+            .ok_or("spline points are not a list")?;
+        let mut locations = Vec::with_capacity(points.len());
+        let mut values = Vec::with_capacity(points.len());
+        let mut derivatives = Vec::with_capacity(points.len());
+        for point in points {
+            locations.push(F32(point
+                .get("location")
+                .and_then(Value::as_f64)
+                .ok_or("spline point has no location")?
+                as f32));
+            values.push(self.parse_spline(point.get("value").ok_or("spline point has no value")?)?);
+            derivatives.push(F32(point
+                .get("derivative")
+                .and_then(Value::as_f64)
+                .unwrap_or(0.0) as f32));
+        }
+        Ok(Spline::Standard {
+            location_function,
+            locations: locations.into_boxed_slice(),
+            values: values.into_boxed_slice(),
+            derivatives: derivatives.into_boxed_slice(),
+        })
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Optimisation
+// ---------------------------------------------------------------------------------------------
+
+const AXIS_X: u8 = 1;
+const AXIS_Y: u8 = 2;
+const AXIS_Z: u8 = 4;
+const AXES_XZ: u8 = AXIS_X | AXIS_Z;
+const AXES_ALL: u8 = AXIS_X | AXIS_Y | AXIS_Z;
+
+const fn axis_bit(axis: Axis) -> u8 {
+    match axis {
+        Axis::X => AXIS_X,
+        Axis::Y => AXIS_Y,
+        Axis::Z => AXIS_Z,
+    }
+}
+
+fn noise_domain_axes(xz_scale: f64, y_scale: f64) -> u8 {
+    let mut axes = AXES_ALL;
+    if y_scale == 0.0 {
+        axes &= !AXIS_Y;
+    }
+    if xz_scale == 0.0 {
+        axes &= !AXES_XZ;
+    }
+    axes
+}
+
+impl Spline {
+    fn for_each_function(&mut self, f: &mut dyn FnMut(&mut Df)) {
+        if let Self::Standard {
+            location_function,
+            values,
+            ..
+        } = self
+        {
+            f(location_function);
+            for value in values.iter_mut() {
+                value.for_each_function(f);
+            }
+        }
+    }
+
+    fn domain_axes(&self) -> u8 {
+        match self {
+            Self::Fixed(_) => 0,
+            Self::Standard {
+                location_function,
+                values,
+                ..
+            } => values
+                .iter()
+                .fold(location_function.domain_axes(), |axes, v| {
+                    axes | v.domain_axes()
+                }),
+        }
+    }
+}
+
+impl Df {
+    /// The axes this function's value varies along.
+    fn domain_axes(&self) -> u8 {
+        match self {
+            Self::Constant(_) => 0,
+            Self::BlendAlpha
+            | Self::BlendOffset
+            | Self::EndIslands
+            | Self::ShiftA(_)
+            | Self::ShiftB(_) => AXES_XZ,
+            Self::Beardifier | Self::InterpolatedNoise { .. } | Self::DistanceToPoint { .. } => {
+                AXES_ALL
+            }
+            Self::Gradient { axis, .. } => axis_bit(axis.0),
+            Self::Noise {
+                xz_scale, y_scale, ..
+            } => noise_domain_axes(xz_scale.0, y_scale.0),
+            Self::ShiftedNoise {
+                shift_x,
+                shift_y,
+                shift_z,
+                xz_scale,
+                y_scale,
+                ..
+            } => {
+                noise_domain_axes(xz_scale.0, y_scale.0)
+                    | shift_x.domain_axes()
+                    | shift_y.domain_axes()
+                    | shift_z.domain_axes()
+            }
+            Self::BlendDensity(input)
+            | Self::Wrapper { input, .. }
+            | Self::Linear { input, .. }
+            | Self::Unary { input, .. }
+            | Self::Clamp { input, .. } => input.domain_axes(),
+            Self::Slice { axis, input, .. } => input.domain_axes() & !axis_bit(axis.0),
+            Self::FindTopSurface {
+                density,
+                upper_bound,
+                ..
+            } => (density.domain_axes() | upper_bound.domain_axes()) & !AXIS_Y,
+            Self::IntervalSelect {
+                input, functions, ..
+            } => functions
+                .iter()
+                .fold(input.domain_axes(), |axes, f| axes | f.domain_axes()),
+            Self::Lerp {
+                alpha,
+                first,
+                second,
+            } => alpha.domain_axes() | first.domain_axes() | second.domain_axes(),
+            Self::Rounding {
+                input, multiple, ..
+            } => input.domain_axes() | multiple.domain_axes(),
+            Self::Binary {
+                argument1,
+                argument2,
+                ..
+            } => argument1.domain_axes() | argument2.domain_axes(),
+            Self::RangeChoice {
+                input,
+                when_in_range,
+                when_out_range,
+                ..
+            } => input.domain_axes() | when_in_range.domain_axes() | when_out_range.domain_axes(),
+            Self::Spline(spline) => spline.domain_axes(),
+        }
+    }
+
+    fn for_each_child(&mut self, f: &mut dyn FnMut(&mut Self)) {
+        match self {
+            Self::Beardifier
+            | Self::BlendAlpha
+            | Self::BlendOffset
+            | Self::EndIslands
+            | Self::Noise { .. }
+            | Self::ShiftA(_)
+            | Self::ShiftB(_)
+            | Self::InterpolatedNoise { .. }
+            | Self::Constant(_)
+            | Self::Gradient { .. }
+            | Self::DistanceToPoint { .. } => {}
+            Self::BlendDensity(input)
+            | Self::Wrapper { input, .. }
+            | Self::Linear { input, .. }
+            | Self::Unary { input, .. }
+            | Self::Clamp { input, .. }
+            | Self::Slice { input, .. } => f(input),
+            Self::FindTopSurface {
+                density,
+                upper_bound,
+                ..
+            } => {
+                f(density);
+                f(upper_bound);
+            }
+            Self::ShiftedNoise {
+                shift_x,
+                shift_y,
+                shift_z,
+                ..
+            } => {
+                f(shift_x);
+                f(shift_y);
+                f(shift_z);
+            }
+            Self::IntervalSelect {
+                input, functions, ..
+            } => {
+                f(input);
+                for function in functions.iter_mut() {
+                    f(function);
+                }
+            }
+            Self::Lerp {
+                alpha,
+                first,
+                second,
+            } => {
+                f(alpha);
+                f(first);
+                f(second);
+            }
+            Self::Rounding {
+                input, multiple, ..
+            } => {
+                f(input);
+                f(multiple);
+            }
+            Self::Binary {
+                argument1,
+                argument2,
+                ..
+            } => {
+                f(argument1);
+                f(argument2);
+            }
+            Self::RangeChoice {
+                input,
+                when_in_range,
+                when_out_range,
+                ..
+            } => {
+                f(input);
+                f(when_in_range);
+                f(when_out_range);
+            }
+            Self::Spline(spline) => spline.for_each_function(f),
+        }
+    }
+
+    fn existing_removed_axes(&self) -> u8 {
+        let mut axes = 0;
+        let mut function = self;
+        while let Self::Slice { axis, input, .. } = function {
+            axes |= axis_bit(axis.0);
+            function = input;
+        }
+        axes
+    }
+
+    /// Wraps the function in slices at 0 for the axes it does not depend on.
+    fn remove_axes(&mut self, axes: u8) {
+        let filtered = axes & !self.existing_removed_axes();
+        for (bit, axis) in [(AXIS_X, Axis::X), (AXIS_Z, Axis::Z), (AXIS_Y, Axis::Y)] {
+            if filtered & bit != 0 {
+                let input = std::mem::replace(self, Self::constant(0.0));
+                *self = Self::Slice {
+                    axis: Tag(axis),
+                    coordinate: 0,
+                    input: boxed(input),
+                };
+            }
+        }
+    }
+
+    fn slice_uniform_axes(&mut self, parent_axes: u8) {
+        if matches!(self, Self::Constant(_) | Self::Gradient { .. }) {
+            return;
+        }
+        let axes = self.domain_axes();
+        if let Self::FindTopSurface {
+            density,
+            upper_bound,
+            ..
+        } = self
+        {
+            density.slice_uniform_axes(axes | AXIS_Y);
+            upper_bound.slice_uniform_axes(axes);
+        } else {
+            self.for_each_child(&mut |child| child.slice_uniform_axes(axes));
+        }
+        if parent_axes != axes {
+            self.remove_axes(parent_axes & !axes);
+        }
+    }
+
+    /// Folds operations on constants. Like the build-time pass it leaves splines alone.
+    fn optimize(&mut self) {
+        if matches!(self, Self::Spline(_)) {
+            return;
+        }
+        self.for_each_child(&mut Self::optimize);
+        let folded = match self {
+            Self::Linear {
+                input,
+                operation,
+                argument,
+            } => match **input {
+                Self::Constant(F32(value)) => Some(
+                    LinearData {
+                        operation: operation.0,
+                        argument: argument.0,
+                    }
+                    .apply_density(value),
+                ),
+                _ => None,
+            },
+            Self::Binary {
+                argument1,
+                argument2,
+                operation,
+            } => match (&**argument1, &**argument2) {
+                (Self::Constant(F32(a)), Self::Constant(F32(b))) => Some(match operation.0 {
+                    BinaryOperation::Pow => a.powf(*b),
+                    op => BinaryData { operation: op }.apply_density(*a, *b),
+                }),
+                _ => None,
+            },
+            Self::Unary { input, operation } => match **input {
+                Self::Constant(F32(value)) => Some(
+                    UnaryData {
+                        operation: operation.0,
+                    }
+                    .apply_density(value),
+                ),
+                _ => None,
+            },
+            Self::Clamp {
+                input,
+                min_value,
+                max_value,
+            } => match **input {
+                Self::Constant(F32(value)) => Some(
+                    ClampData {
+                        min_value: min_value.0,
+                        max_value: max_value.0,
+                    }
+                    .apply_density(value),
+                ),
+                _ => None,
+            },
+            _ => None,
+        };
+        if let Some(value) = folded {
+            *self = Self::constant(value);
+        }
+    }
+
+    fn unique_id(&self) -> u64 {
+        let mut hasher = DefaultHasher::new();
+        self.hash(&mut hasher);
+        hasher.finish()
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Component stacks
+// ---------------------------------------------------------------------------------------------
+
+fn leak<T>(value: T) -> &'static T {
+    Box::leak(Box::new(value))
+}
+
+fn leak_slice<T>(values: Vec<T>) -> &'static [T] {
+    Box::leak(values.into_boxed_slice())
+}
+
+/// Builds one component stack, deduplicating identical subtrees.
+struct Emitter<'a, 'b> {
+    stack: Vec<BaseNoiseFunctionComponent>,
+    index: BTreeMap<u64, usize>,
+    noises: &'a mut NoiseTable<'b>,
+}
+
+impl<'a, 'b> Emitter<'a, 'b> {
+    const fn new(noises: &'a mut NoiseTable<'b>) -> Self {
+        Self {
+            stack: Vec::new(),
+            index: BTreeMap::new(),
+            noises,
+        }
+    }
+
+    fn index_for(&mut self, df: &Df) -> Result<usize> {
+        let id = df.unique_id();
+        if let Some(index) = self.index.get(&id) {
+            return Ok(*index);
+        }
+        let component = self.component(df)?;
+        self.stack.push(component);
+        let index = self.stack.len() - 1;
+        self.index.insert(id, index);
+        Ok(index)
+    }
+
+    fn noise(&mut self, name: &str) -> Result<DoublePerlinNoiseParameters> {
+        self.noises.get(name)
+    }
+
+    fn spline(&mut self, spline: &Spline) -> Result<SplineRepr> {
+        match spline {
+            Spline::Fixed(F32(value)) => Ok(SplineRepr::Fixed { value: *value }),
+            Spline::Standard {
+                location_function,
+                locations,
+                values,
+                derivatives,
+            } => {
+                let location_function_index = self.index_for(location_function)?;
+                let mut points = Vec::with_capacity(values.len());
+                for ((location, value), derivative) in locations.iter().zip(values).zip(derivatives)
+                {
+                    points.push(SplinePoint {
+                        location: location.0,
+                        value: leak(self.spline(value)?),
+                        derivative: derivative.0,
+                    });
+                }
+                Ok(SplineRepr::Standard {
+                    location_function_index,
+                    points: leak_slice(points),
+                })
+            }
+        }
+    }
+
+    #[expect(clippy::too_many_lines)]
+    fn component(&mut self, df: &Df) -> Result<BaseNoiseFunctionComponent> {
+        use BaseNoiseFunctionComponent as C;
+        Ok(match df {
+            Df::Spline(spline) => C::Spline {
+                spline: leak(self.spline(spline)?),
+            },
+            Df::FindTopSurface {
+                density,
+                upper_bound,
+                lower_bound,
+                cell_height,
+            } => C::FindTopSurface {
+                density_index: self.index_for(density)?,
+                upper_bound_index: self.index_for(upper_bound)?,
+                data: leak(FindTopSurfaceData {
+                    lower_bound: *lower_bound,
+                    cell_height: *cell_height,
+                }),
+            },
+            Df::EndIslands => C::EndIslands,
+            Df::Noise {
+                noise,
+                xz_scale,
+                y_scale,
+            } => C::Noise {
+                data: leak(NoiseData {
+                    noise_id: self.noise(noise)?,
+                    xz_scale: xz_scale.0,
+                    y_scale: y_scale.0,
+                }),
+            },
+            Df::ShiftA(noise) => C::ShiftA {
+                noise_id: self.noise(noise)?,
+            },
+            Df::ShiftB(noise) => C::ShiftB {
+                noise_id: self.noise(noise)?,
+            },
+            Df::BlendDensity(input) => C::BlendDensity {
+                input_index: self.index_for(input)?,
+            },
+            Df::BlendAlpha => C::BlendAlpha,
+            Df::BlendOffset => C::BlendOffset,
+            Df::Beardifier => C::Beardifier,
+            Df::ShiftedNoise {
+                shift_x,
+                shift_y,
+                shift_z,
+                noise,
+                xz_scale,
+                y_scale,
+            } => C::ShiftedNoise {
+                shift_x_index: self.index_for(shift_x)?,
+                shift_y_index: self.index_for(shift_y)?,
+                shift_z_index: self.index_for(shift_z)?,
+                data: leak(ShiftedNoiseData {
+                    xz_scale: xz_scale.0,
+                    y_scale: y_scale.0,
+                    noise_id: self.noise(noise)?,
+                }),
+            },
+            Df::RangeChoice {
+                input,
+                when_in_range,
+                when_out_range,
+                min_inclusive,
+                max_exclusive,
+            } => C::RangeChoice {
+                input_index: self.index_for(input)?,
+                when_in_range_index: self.index_for(when_in_range)?,
+                when_out_range_index: self.index_for(when_out_range)?,
+                data: leak(RangeChoiceData {
+                    min_inclusive: min_inclusive.0,
+                    max_exclusive: max_exclusive.0,
+                }),
+            },
+            Df::Binary {
+                argument1,
+                argument2,
+                operation,
+            } => C::Binary {
+                argument1_index: self.index_for(argument1)?,
+                argument2_index: self.index_for(argument2)?,
+                data: leak(BinaryData {
+                    operation: operation.0,
+                }),
+            },
+            Df::Gradient {
+                axis,
+                tiling,
+                from_coordinate,
+                to_coordinate,
+                from_value,
+                to_value,
+            } => C::Gradient {
+                data: leak(GradientData {
+                    axis: axis.0,
+                    tiling: tiling.0,
+                    from_coordinate: *from_coordinate,
+                    to_coordinate: *to_coordinate,
+                    from_value: from_value.0,
+                    to_value: to_value.0,
+                }),
+            },
+            Df::DistanceToPoint { point, metric } => C::DistanceToPoint {
+                data: leak(DistanceToPointData {
+                    point: *point,
+                    metric: metric.0,
+                }),
+            },
+            Df::Lerp {
+                alpha,
+                first,
+                second,
+            } => C::Lerp {
+                alpha_index: self.index_for(alpha)?,
+                first_index: self.index_for(first)?,
+                second_index: self.index_for(second)?,
+            },
+            Df::Rounding {
+                input,
+                multiple,
+                operation,
+            } => C::Rounding {
+                input_index: self.index_for(input)?,
+                multiple_index: self.index_for(multiple)?,
+                data: leak(RoundingData {
+                    operation: operation.0,
+                }),
+            },
+            Df::Slice {
+                axis,
+                coordinate,
+                input,
+            } => C::Slice {
+                input_index: self.index_for(input)?,
+                axis: axis.0,
+                coordinate: *coordinate,
+            },
+            Df::Constant(F32(value)) => C::Constant { value: *value },
+            Df::Wrapper { input, wrapper } => C::Wrapper {
+                input_index: self.index_for(input)?,
+                wrapper: match *wrapper {
+                    Wrapper::Interpolated {
+                        cell_size_xz,
+                        cell_size_y,
+                    } => WrapperType::Interpolated {
+                        cell_size_xz,
+                        cell_size_y,
+                    },
+                    Wrapper::Cache => WrapperType::Cache,
+                },
+            },
+            Df::Linear {
+                input,
+                operation,
+                argument,
+            } => C::Linear {
+                input_index: self.index_for(input)?,
+                data: leak(LinearData {
+                    operation: operation.0,
+                    argument: argument.0,
+                }),
+            },
+            Df::Clamp {
+                input,
+                min_value,
+                max_value,
+            } => C::Clamp {
+                input_index: self.index_for(input)?,
+                data: leak(ClampData {
+                    min_value: min_value.0,
+                    max_value: max_value.0,
+                }),
+            },
+            Df::Unary { input, operation } => C::Unary {
+                input_index: self.index_for(input)?,
+                data: leak(UnaryData {
+                    operation: operation.0,
+                }),
+            },
+            Df::IntervalSelect {
+                input,
+                thresholds,
+                functions,
+            } => {
+                let input_index = self.index_for(input)?;
+                let functions_indices = functions
+                    .iter()
+                    .map(|f| self.index_for(f))
+                    .collect::<Result<Vec<_>>>()?;
+                C::IntervalSelect {
+                    input_index,
+                    thresholds: leak_slice(thresholds.iter().map(|t| t.0).collect()),
+                    functions_indices: leak_slice(functions_indices),
+                }
+            }
+            Df::InterpolatedNoise {
+                xz_scale,
+                y_scale,
+                xz_factor,
+                y_factor,
+                smear_scale_multiplier,
+            } => C::InterpolatedNoiseSampler {
+                data: leak(InterpolatedNoiseSamplerData {
+                    xz_scale: xz_scale.0,
+                    y_scale: y_scale.0,
+                    xz_factor: xz_factor.0,
+                    y_factor: y_factor.0,
+                    smear_scale_multiplier: smear_scale_multiplier.0,
+                }),
+            },
+        })
+    }
+}
+
