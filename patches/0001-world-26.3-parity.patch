+    fn concentric_rings_placement_reads_its_fields_and_wraps_large_salts() {
+        let json = serde_json::json!({
+            "type": "minecraft:concentric_rings",
+            "distance": 32, "spread": 3, "count": 219,
+            "preferred_biomes": "t:voids",
+            "salt": 5_615_891_543_i64,
+        });
+        let parsed = placement(&json).expect("rings");
+        let StructurePlacementType::ConcentricRings(rings) = parsed.placement_type else {
+            panic!("not rings");
+        };
+        assert_eq!(
