+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn vanilla_spawn_floor_predicates_are_preserved() {
+        for (block, entity_type, expected) in [
+            (&Block::BEDROCK, &EntityType::CREEPER, false),
+            (&Block::STONE, &EntityType::CREEPER, true),
+            (&Block::GLASS, &EntityType::CREEPER, false),
+            (&Block::OAK_LEAVES, &EntityType::OCELOT, true),
+            (&Block::OAK_LEAVES, &EntityType::CREEPER, false),
+            (&Block::ICE, &EntityType::POLAR_BEAR, true),
+            (&Block::ICE, &EntityType::CREEPER, false),
+            (&Block::MAGMA_BLOCK, &EntityType::BLAZE, true),
+            (&Block::MAGMA_BLOCK, &EntityType::CREEPER, false),
+            (&Block::JACK_O_LANTERN, &EntityType::CREEPER, true),
+        ] {
+            assert_eq!(
+                is_valid_spawn_floor(block.default_state, entity_type),
+                expected,
+                "{}",
+                block.name
+            );
+        }
+    }
+
+    #[test]
+    fn weighted_pick_follows_the_weights() {
+        let spawners = [
+            Spawner {
+                r#type: "minecraft:sheep",
+                min_count: 4,
+                max_count: 4,
+                weight: 12,
+            },
+            Spawner {
+                r#type: "minecraft:cow",
+                min_count: 4,
+                max_count: 4,
+                weight: 8,
+            },
+            Spawner {
+                r#type: "minecraft:donkey",
+                min_count: 1,
+                max_count: 3,
+                weight: 0,
+            },
+        ];
+        let mut random = LegacyRand::from_seed(7);
+        let mut counts = [0u32; 3];
+        for _ in 0..20_000 {
+            let picked = pick_weighted(&spawners, &mut random).expect("a spawner");
+            counts[spawners
+                .iter()
+                .position(|s| std::ptr::eq(s, picked))
+                .unwrap()] += 1;
+        }
+        assert_eq!(counts[2], 0);
+        let sheep_share = f64::from(counts[0]) / 20_000.0;
+        assert!(
+            (sheep_share - 0.6).abs() < 0.02,
+            "sheep share {sheep_share}"
+        );
+        assert!(pick_weighted(&[], &mut random).is_none());
+    }
+
+    const SAMPLE_STRIDE: i32 = 7;
+
+    struct Counting {
+        counts: std::sync::Mutex<std::collections::BTreeMap<&'static str, u32>>,
+        seed: u64,
+    }
+
+    struct CountingSpawner<'a>(&'a Counting);
+
+    impl ChunkGenerationSpawner for CountingSpawner<'_> {
+        fn start_group(&mut self) {}
+
+        fn spawn(
+            &mut self,
+            entity_type: &'static EntityType,
+            _pos: Vector3<f64>,
+            _yaw: f32,
+            _biome: &'static Biome,
+        ) -> bool {
+            *self
+                .0
+                .counts
+                .lock()
+                .unwrap()
+                .entry(entity_type.resource_name)
+                .or_default() += 1;
+            true
+        }
+    }
+
+    impl crate::world::WorldPortalExt for Counting {
+        fn can_place_at(
+            &self,
+            _block: &Block,
+            _state: &BlockState,
+            _block_accessor: &dyn crate::world::BlockAccessor,
+            _block_pos: &BlockPos,
+        ) -> bool {
+            true
+        }
+
+        fn mirror(
+            &self,
+            block: &Block,
+            state_id: pumpkin_data::BlockStateId,
+            mirror: pumpkin_data::Mirror,
+        ) -> &'static BlockState {
+            block.mirror(state_id, mirror)
+        }
+
+        fn rotate(
+            &self,
+            block: &Block,
+            state_id: pumpkin_data::BlockStateId,
+            rotation: pumpkin_data::Rotation,
+        ) -> &'static BlockState {
+            block.rotate(state_id, rotation)
+        }
+
+        fn spawn_mobs_for_chunk_generation(
+            &self,
+            cache: &mut dyn GenerationCache,
+            biome: &'static Biome,
+            chunk_x: i32,
+            chunk_z: i32,
+        ) {
+            let level = ChunkGenerationSpawnLevel {
+                seed: self.seed,
+                min_y: -64,
+                sea_level: 63,
+                has_ceiling: false,
+            };
+            spawn_mobs_for_chunk_generation(
+                cache,
+                &level,
+                biome,
+                chunk_x,
+                chunk_z,
+                &mut CountingSpawner(self),
+            );
+        }
+    }
+
+    /// Generates a grid of overworld chunks and reports how many mobs of each type the
+    /// generation loop places: `PUMPKIN_SPAWN_GRID` chunks per side, default 4.
+    #[test]
+    #[ignore = "evidence tool: generates real chunks"]
+    fn overworld_chunks_get_animals_in_the_vanilla_range() {
+        use pumpkin_data::dimension::Dimension;
+        use pumpkin_util::world_seed::Seed;
+
+        let side: i32 = std::env::var("PUMPKIN_SPAWN_GRID")
+            .ok()
+            .and_then(|v| v.parse().ok())
+            .unwrap_or(4);
+        let seed = 42069;
+        let world_gen = crate::generation::get_world_gen(
+            Seed(seed),
+            Dimension::OVERWORLD,
+            false,
+            Vec::new(),
+            String::new(),
+        );
+        let counting = Counting {
+            counts: std::sync::Mutex::default(),
+            seed,
+        };
+        let pool = rayon::ThreadPoolBuilder::new()
+            .num_threads(2)
+            .build()
+            .unwrap();
+        pool.scope(|scope| {
+            for cx in 0..side {
+                for cz in 0..side {
+                    let (world_gen, counting) = (&world_gen, &counting);
+                    // Spread the sample so it crosses several biomes.
+                    let (cx, cz) = (
+                        (cx - side / 2) * SAMPLE_STRIDE,
+                        (cz - side / 2) * SAMPLE_STRIDE,
+                    );
+                    scope.spawn(move |_| {
+                        crate::chunk_system::generate_single_chunk(
+                            world_gen,
+                            counting,
+                            cx,
+                            cz,
+                            crate::chunk_system::StagedChunkEnum::Full,
+                        );
+                    });
+                }
+            }
+        });
+        let counts = counting.counts.lock().unwrap();
+        let chunks = side * side;
+        eprintln!("{chunks} chunks: {counts:?}");
+        let total: u32 = counts.values().sum();
+        assert!(total > 0, "no mob was placed in {chunks} chunks");
+    }
+}
