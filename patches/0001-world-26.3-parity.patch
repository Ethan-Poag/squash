+//! Trial spawner configs (`data/<namespace>/trial_spawner/**.json`) of the world's datapacks.
+
+use std::path::Path;
+use std::sync::{Arc, LazyLock, PoisonError, RwLock};
+
+use rustc_hash::FxHashMap;
+use serde_json::Value;
+
+use super::{DatapackSet, TRIAL_SPAWNER, normalize_id};
+
+static CONFIGS: LazyLock<RwLock<FxHashMap<String, Arc<Value>>>> =
+    LazyLock::new(|| RwLock::new(FxHashMap::default()));
+
+/// Registers the trial spawner configs of `set`, a pack replacing an earlier config of its id.
+pub fn register(set: &DatapackSet) {
+    let mut configs = CONFIGS.write().unwrap_or_else(PoisonError::into_inner);
+    for id in set.pack_ids(TRIAL_SPAWNER) {
+        if let Some(json) = set.pack_json(TRIAL_SPAWNER, id) {
+            configs.insert(id.to_string(), Arc::new(json.clone()));
+        }
+    }
+}
+
+/// Reads the packs in `world_dir` and registers their trial spawner configs.
+pub fn load_world(world_dir: &Path) {
+    if let Some(set) = DatapackSet::load(world_dir) {
+        register(&set);
+    }
+}
+
+/// The config JSON a pack defines for `key` (`namespace:path`, namespace optional).
+#[must_use]
+pub fn get(key: &str) -> Option<Arc<Value>> {
+    CONFIGS
+        .read()
+        .unwrap_or_else(PoisonError::into_inner)
+        .get(&normalize_id(key))
+        .cloned()
+}
