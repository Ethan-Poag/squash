--- /dev/null
+++ b/crates/pumpkin-world/src/generation/feature/features/drip_stone/large_dripstone.rs
@@ -0,0 +1,299 @@
+use std::collections::HashSet;
+
+use pumpkin_data::{Block, tag};
+use pumpkin_util::{
+    math::{float_provider::FloatProvider, int_provider::IntProvider, position::BlockPos},
+    random::{RandomGenerator, RandomImpl},
+};
+
+use super::{
+    Column, at_y, block_state, get_speleothem_height, is_base_or_lava,
+    is_circle_mostly_embedded_in_stone, is_empty_or_water, is_empty_or_water_or_lava,
+    is_empty_or_water_state,
+};
+use crate::generation::feature::features::spring_feature::BlockWrapper;
+use crate::generation::proto_chunk::GenerationCache;
+
+/// Vanilla `LargeDripstoneFeature` (`minecraft:large_dripstone`).
+pub struct LargeDripstoneFeature {
+    replaceable_blocks: HashSet<u16>,
+    pub floor_to_ceiling_search_range: i32,
+    pub column_radius: IntProvider,
+    pub height_scale: FloatProvider,
+    pub max_column_radius_to_cave_height_ratio: f32,
+    pub stalactite_bluntness: FloatProvider,
+    pub stalagmite_bluntness: FloatProvider,
+    pub wind_speed: FloatProvider,
+    pub min_radius_for_wind: i32,
+    pub min_bluntness_for_wind: f32,
+}
+
+#[expect(clippy::too_many_arguments)]
+impl LargeDripstoneFeature {
+    #[must_use]
+    pub fn new(
+        replaceable_blocks: &BlockWrapper,
+        floor_to_ceiling_search_range: i32,
+        column_radius: IntProvider,
+        height_scale: FloatProvider,
+        max_column_radius_to_cave_height_ratio: f32,
+        stalactite_bluntness: FloatProvider,
+        stalagmite_bluntness: FloatProvider,
+        wind_speed: FloatProvider,
+        min_radius_for_wind: i32,
+        min_bluntness_for_wind: f32,
+    ) -> Self {
+        Self {
+            replaceable_blocks: replaceable_blocks.block_ids(),
+            floor_to_ceiling_search_range,
+            column_radius,
+            height_scale,
+            max_column_radius_to_cave_height_ratio,
+            stalactite_bluntness,
+            stalagmite_bluntness,
+            wind_speed,
+            min_radius_for_wind,
+            min_bluntness_for_wind,
+        }
+    }
+
+    pub fn generate<T: GenerationCache>(
+        &self,
+        chunk: &mut T,
+        random: &mut RandomGenerator,
+        origin: BlockPos,
+    ) -> bool {
+        if !is_empty_or_water(chunk, origin) {
+            return false;
+        }
+        let Some(Column {
+            floor: Some(floor),
+            ceiling: Some(ceiling),
+        }) = Column::scan(
+            chunk,
+            origin,
+            self.floor_to_ceiling_search_range,
+            is_empty_or_water_state,
+            |state| is_base_or_lava(state, &Block::DRIPSTONE_BLOCK, &self.replaceable_blocks),
+        )
+        else {
+            return false;
+        };
+        let column_height = ceiling - floor - 1;
+        if column_height < 4 {
+            return false;
+        }
+
+        let max_column_radius_based_on_column_height =
+            (column_height as f32 * self.max_column_radius_to_cave_height_ratio) as i32;
+        let max_column_radius = max_column_radius_based_on_column_height
+            .clamp(self.column_radius.get_min(), self.column_radius.get_max());
+        let radius = random.next_inbetween_i32(self.column_radius.get_min(), max_column_radius);
+        let mut stalactite = Self::make_dripstone(
+            at_y(origin, ceiling - 1),
+            false,
+            random,
+            radius,
+            &self.stalactite_bluntness,
+            &self.height_scale,
+        );
+        let mut stalagmite = Self::make_dripstone(
+            at_y(origin, floor + 1),
+            true,
+            random,
+            radius,
+            &self.stalagmite_bluntness,
+            &self.height_scale,
+        );
+        let wind = if stalactite
+            .is_suitable_for_wind(self.min_radius_for_wind, self.min_bluntness_for_wind)
+            && stalagmite
+                .is_suitable_for_wind(self.min_radius_for_wind, self.min_bluntness_for_wind)
+        {
+            WindOffsetter::new(origin.0.y, random, &self.wind_speed, 16 - radius)
+        } else {
+            WindOffsetter::no_wind()
+        };
+
+        let stalactite_base_embedded_in_stone = stalactite
+            .move_back_until_base_is_inside_stone_and_shrink_radius_if_necessary(chunk, &wind);
+        let stalagmite_base_embedded_in_stone = stalagmite
+            .move_back_until_base_is_inside_stone_and_shrink_radius_if_necessary(chunk, &wind);
+        if stalactite_base_embedded_in_stone {
+            stalactite.place_blocks(chunk, random, &wind);
+        }
+        if stalagmite_base_embedded_in_stone {
+            stalagmite.place_blocks(chunk, random, &wind);
+        }
+        true
+    }
+
+    fn make_dripstone(
+        root: BlockPos,
+        pointing_up: bool,
+        random: &mut RandomGenerator,
+        radius: i32,
+        bluntness: &FloatProvider,
+        height_scale: &FloatProvider,
+    ) -> LargeDripstone {
+        LargeDripstone {
+            root,
+            pointing_up,
+            radius,
+            bluntness: f64::from(bluntness.get(random)),
+            scale: f64::from(height_scale.get(random)),
+        }
+    }
+}
+
+struct LargeDripstone {
+    root: BlockPos,
+    pointing_up: bool,
+    radius: i32,
+    bluntness: f64,
+    scale: f64,
+}
+
+impl LargeDripstone {
+    fn height(&self) -> i32 {
+        self.height_at_radius(0.0)
+    }
+
+    fn height_at_radius(&self, check_radius: f32) -> i32 {
+        get_speleothem_height(
+            f64::from(check_radius),
+            f64::from(self.radius),
+            self.scale,
+            self.bluntness,
+        ) as i32
+    }
+
+    fn move_back_until_base_is_inside_stone_and_shrink_radius_if_necessary<T: GenerationCache>(
+        &mut self,
+        chunk: &T,
+        wind: &WindOffsetter,
+    ) -> bool {
+        while self.radius > 1 {
+            let mut new_root = self.root;
+            let max_tries = 10.min(self.height());
+            for _ in 0..max_tries {
+                if block_state(chunk, new_root).to_block_id() == Block::LAVA.id {
+                    return false;
+                }
+                if is_circle_mostly_embedded_in_stone(chunk, wind.offset(new_root), self.radius) {
+                    self.root = new_root;
+                    return true;
+                }
+                new_root = if self.pointing_up {
+                    new_root.down()
+                } else {
+                    new_root.up()
+                };
+            }
+            self.radius /= 2;
+        }
+        false
+    }
+
+    fn place_blocks<T: GenerationCache>(
+        &self,
+        chunk: &mut T,
+        random: &mut RandomGenerator,
+        wind: &WindOffsetter,
+    ) {
+        for dx in -self.radius..=self.radius {
+            for dz in -self.radius..=self.radius {
+                let current_radius = ((dx * dx + dz * dz) as f32).sqrt();
+                if current_radius > self.radius as f32 {
+                    continue;
+                }
+                let mut height = self.height_at_radius(current_radius);
+                if height <= 0 {
+                    continue;
+                }
+                if f64::from(random.next_f32()) < 0.2 {
+                    height = (height as f32 * random.next_inbetween_f32(0.8, 1.0)) as i32;
+                }
+                let mut pos = self.root.add(dx, 0, dz);
+                let mut has_been_out_of_stone = false;
+                let max_y = if self.pointing_up {
+                    chunk.top_block_wg_height_exclusive(pos.0.x, pos.0.z)
+                } else {
+                    i32::MAX
+                };
+                let mut i = 0;
+                while i < height && pos.0.y < max_y {
+                    let wind_adjusted_pos = wind.offset(pos);
+                    if is_empty_or_water_or_lava(chunk, wind_adjusted_pos) {
+                        has_been_out_of_stone = true;
+                        chunk.set_block_state(
+                            &wind_adjusted_pos.0,
+                            Block::DRIPSTONE_BLOCK.default_state,
+                        );
+                    } else if has_been_out_of_stone
+                        && block_state(chunk, wind_adjusted_pos)
+                            .to_block_id()
+                            .has_tag(tag::Block::MINECRAFT_BASE_STONE_OVERWORLD)
+                    {
+                        break;
+                    }
+                    pos = if self.pointing_up {
+                        pos.up()
+                    } else {
+                        pos.down()
+                    };
+                    i += 1;
+                }
+            }
+        }
+    }
+
+    fn is_suitable_for_wind(&self, min_radius_for_wind: i32, min_bluntness_for_wind: f32) -> bool {
+        self.radius >= min_radius_for_wind && self.bluntness >= f64::from(min_bluntness_for_wind)
+    }
+}
+
+/// Vanilla `LargeDripstoneFeature.WindOffsetter`.
+struct WindOffsetter {
+    origin_y: i32,
+    wind_speed: Option<(f64, f64)>,
+    max_offset: i32,
+}
+
+impl WindOffsetter {
+    fn new(
+        origin_y: i32,
+        random: &mut RandomGenerator,
+        wind_speed_range: &FloatProvider,
+        max_offset: i32,
+    ) -> Self {
+        let speed = wind_speed_range.get(random);
+        let direction = random.next_inbetween_f32(0.0, std::f32::consts::PI);
+        Self {
+            origin_y,
+            wind_speed: Some((
+                f64::from(pumpkin_util::math::cos(direction) * speed),
+                f64::from(pumpkin_util::math::sin(direction) * speed),
+            )),
+            max_offset,
+        }
+    }
+
+    const fn no_wind() -> Self {
+        Self {
+            origin_y: 0,
+            wind_speed: None,
+            max_offset: 0,
+        }
+    }
+
+    fn offset(&self, pos: BlockPos) -> BlockPos {
+        let Some((speed_x, speed_z)) = self.wind_speed else {
+            return pos;
+        };
+        let dy = f64::from(self.origin_y - pos.0.y);
+        let dx = ((speed_x * dy).floor() as i32).clamp(-self.max_offset, self.max_offset);
+        let dz = ((speed_z * dy).floor() as i32).clamp(-self.max_offset, self.max_offset);
+        pos.add(dx, 0, dz)
+    }
+}
