@@ -66,6 +66,34 @@ pub const LONG_ARRAY_ID: u8 = 0x0C;
 
 /// Maximum number of elements accepted when decoding a list or array.
 pub const MAX_ARRAY_LENGTH: usize = 512_000;
+/// Maximum number of list elements accepted while [`with_trusted_list_lengths`] runs.
+pub const MAX_TRUSTED_LIST_LENGTH: usize = 64 * 1024 * 1024;
+
+std::thread_local! {
+    static LIST_LENGTH_LIMIT: std::cell::Cell<usize> = const { std::cell::Cell::new(MAX_ARRAY_LENGTH) };
+}
+
+/// The list length limit on this thread: [`MAX_ARRAY_LENGTH`], or [`MAX_TRUSTED_LIST_LENGTH`]
+/// inside [`with_trusted_list_lengths`].
+#[must_use]
+pub fn max_list_length() -> usize {
+    LIST_LENGTH_LIMIT.with(std::cell::Cell::get)
+}
+
+/// Decodes trusted local files (structure templates from datapacks) with a far larger list
+/// limit: vanilla reads those without a size quota, and big templates hold more than
+/// [`MAX_ARRAY_LENGTH`] blocks. Network data keeps the default limit.
+pub fn with_trusted_list_lengths<R>(read: impl FnOnce() -> R) -> R {
+    struct Restore(usize);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            LIST_LENGTH_LIMIT.with(|limit| limit.set(self.0));
+        }
+    }
+    let _restore = Restore(LIST_LENGTH_LIMIT.with(|limit| limit.replace(MAX_TRUSTED_LIST_LENGTH)));
+    read()
+}
+
 /// Maximum nesting depth allowed when decoding NBT compound or list tags.
 pub const MAX_NBT_DEPTH: usize = 512;
 
