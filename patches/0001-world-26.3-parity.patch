+fn block_state_name(id: pumpkin_data::BlockStateId) -> String {
+    let block = pumpkin_data::Block::from_state_id(id);
+    let mut name = format!("minecraft:{}", block.name);
+    if let Some(properties) = block.properties(id) {
+        let mut props: Vec<(String, String)> = properties
+            .to_props()
+            .into_iter()
+            .map(|p| (p.key_str().to_string(), p.value_str().to_string()))
+            .collect();
+        props.sort();
+        if !props.is_empty() {
+            let list: Vec<String> = props.iter().map(|(k, v)| format!("{k}={v}")).collect();
+            let _ = write!(name, "[{}]", list.join(","));
+        }
+    }
+    name
+}
+
+fn write_palette(out: &mut Vec<u8>, names: &[String]) {
+    out.extend((names.len() as u16).to_le_bytes());
+    for name in names {
+        out.extend((name.len() as u16).to_le_bytes());
+        out.extend(name.as_bytes());
+    }
+}
