+        let at = |x, y, z| {
+            lookup_vanilla(
+                |_| Some(structures.clone()),
+                &BlockPos::new(x, y, z),
+                "monster",
+            )
+        };
+        assert_eq!(
+            at(2, 65, 2).overridden.unwrap()[0].r#type,
+            "minecraft:witch"
+        );
+        assert!(at(8, 65, 8).overridden.is_none());
+    }
