index 0000000..0d87b19
--- /dev/null
+++ b/crates/pumpkin-world/tests/vanilla_structure_spawns_26_3.rs
@@ -0,0 +1,142 @@
+//! Resolves spawn positions inside Nether fortress pieces of a real Fabric world through the
+//! starts and references vanilla chunks keep.
+//!
+//! Needs `PUMPKIN_2603_NETHER_REGION` (a copy of a nether `region` dir; only read). Ignored by
+//! default.
+
+use std::collections::HashMap;
+use std::io::Read;
+use std::path::Path;
+use std::sync::Arc;
+
+use pumpkin_nbt::compound::NbtCompound;
+use pumpkin_nbt::tag::NbtTag;
+use pumpkin_util::math::position::BlockPos;
+use pumpkin_world::chunk::structure_spawns::{VanillaStructures, lookup_vanilla};
+
+fn read_region(path: &Path) -> Vec<(i32, i32, Vec<u8>)> {
+    let data = std::fs::read(path).unwrap();
+    let name = path.file_name().unwrap().to_str().unwrap();
+    let parts: Vec<&str> = name.split('.').collect();
+    let (rx, rz): (i32, i32) = (parts[1].parse().unwrap(), parts[2].parse().unwrap());
+    let mut out = Vec::new();
+    for i in 0..1024 {
+        let off = u32::from_be_bytes([0, data[i * 4], data[i * 4 + 1], data[i * 4 + 2]]) as usize;
+        if off == 0 {
+            continue;
+        }
+        let o = off * 4096;
+        let len = u32::from_be_bytes(data[o..o + 4].try_into().unwrap()) as usize;
+        let raw = &data[o + 5..o + 4 + len];
+        let mut v = Vec::new();
+        match data[o + 4] {
+            1 => drop(
+                flate2::read::GzDecoder::new(raw)
+                    .read_to_end(&mut v)
+                    .unwrap(),
+            ),
+            2 => drop(
+                flate2::read::ZlibDecoder::new(raw)
+                    .read_to_end(&mut v)
+                    .unwrap(),
+            ),
+            3 => v = raw.to_vec(),
+            other => panic!("unsupported compression {other} in {name}"),
+        }
+        out.push((rx * 32 + (i % 32) as i32, rz * 32 + (i / 32) as i32, v));
+    }
+    out
+}
+
+fn parse(bytes: &[u8]) -> NbtCompound {
+    let mut reader = pumpkin_nbt::deserializer::NbtReadHelperJava::new(std::io::Cursor::new(bytes));
+    if bytes.starts_with(&[0x0a, 0x00, 0x00]) {
+        pumpkin_nbt::Nbt::read(&mut reader)
+    } else {
+        pumpkin_nbt::Nbt::read_unnamed(&mut reader)
+    }
+    .unwrap()
+    .root_tag
+}
+
+#[test]
+#[ignore = "needs PUMPKIN_2603_NETHER_REGION"]
+fn fortress_pieces_of_a_fabric_world_resolve_to_the_fortress_list() {
+    let Some(dir) = std::env::var_os("PUMPKIN_2603_NETHER_REGION").map(std::path::PathBuf::from)
+    else {
+        eprintln!("PUMPKIN_2603_NETHER_REGION unset; skipping");
+        return;
+    };
+    let mut statuses: HashMap<(i32, i32), String> = HashMap::new();
+    let mut chunks: HashMap<(i32, i32), Arc<VanillaStructures>> = HashMap::new();
+    // (chunk holding the start, piece boxes)
+    let mut pieces: Vec<[i32; 6]> = Vec::new();
+    for entry in std::fs::read_dir(dir).unwrap() {
+        let path = entry.unwrap().path();
+        if path.extension().is_none_or(|e| e != "mca") {
+            continue;
+        }
+        for (cx, cz, bytes) in read_region(&path) {
+            let root = parse(&bytes);
+            statuses.insert(
+                (cx, cz),
+                root.get_string("Status").unwrap_or("?").to_string(),
+            );
+            let Some(structures) = root.get_compound("structures") else {
+                continue;
+            };
+            if let Some(start) = structures
+                .get_compound("starts")
+                .and_then(|s| s.get_compound("minecraft:fortress"))
+            {
+                for child in start.get_list("Children").unwrap_or_default() {
+                    if let NbtTag::Compound(child) = child
+                        && let Some(NbtTag::IntArray(bb)) = child.get("BB")
+                        && bb.len() == 6
+                    {
+                        pieces.push([bb[0], bb[1], bb[2], bb[3], bb[4], bb[5]]);
+                    }
+                }
+            }
+            chunks.insert((cx, cz), Arc::new(VanillaStructures::parse(structures)));
+        }
+    }
+    let at = |x: i32, y: i32, z: i32| {
+        lookup_vanilla(
+            |c| chunks.get(&(c.x, c.y)).cloned(),
+            &BlockPos::new(x, y, z),
+            "monster",
+        )
+    };
+    let (mut inside, mut resolved, mut skipped) = (0, 0, 0);
+    for bb in &pieces {
+        let (x, y, z) = (
+            (bb[0] + bb[3]) / 2,
+            (bb[1] + bb[4]) / 2,
+            (bb[2] + bb[5]) / 2,
+        );
+        // Edge chunks stop at structure_starts and hold no references; mobs only spawn in full ones.
+        if statuses
+            .get(&(x >> 4, z >> 4))
+            .is_none_or(|s| s != "minecraft:full")
+        {
+            skipped += 1;
+            continue;
+        }
+        inside += 1;
+        if at(x, y, z).in_fortress_piece {
+            resolved += 1;
+        }
+    }
+    println!(
+        "{} fortress pieces: {inside} centres in full chunks, {resolved} resolve to the fortress, {skipped} in chunks that are not full",
+        pieces.len()
+    );
+    assert!(!pieces.is_empty(), "no fortress start in the region copy");
+    assert!(inside > 0);
+    // A piece centre lies inside the piece, so every one resolves unless the chunk lost its reference.
+    assert_eq!(resolved, inside);
+    // Far above the nether the same columns hold no piece.
+    let bb = pieces[0];
+    assert!(!at((bb[0] + bb[3]) / 2, 1000, (bb[2] + bb[5]) / 2).in_fortress_piece);
+}
