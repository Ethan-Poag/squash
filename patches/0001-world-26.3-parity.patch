+#[cfg(test)]
+mod pool_alias_tests {
+    use super::PoolAliasLookup;
+    use pumpkin_util::random::{RandomGenerator, legacy_rand::LegacyRand};
+    use std::sync::mpsc;
+    use std::time::Duration;
+
+    /// Dungeons and Taverns `cave_chamber_colony` binds `cave_chamber/cave_and_chamber` to
+    /// itself. The lookup used to follow aliases until it reached a non-alias and froze the
+    /// chunk-generation thread on that structure start forever.
+    #[test]
+    fn an_alias_bound_to_itself_resolves_to_itself() {
+        let (tx, rx) = mpsc::channel();
+        std::thread::spawn(move || {
+            let mut lookup = PoolAliasLookup::new();
+            lookup.add_direct(
+                "nova_structures:cave_chamber/cave_and_chamber".into(),
+                "nova_structures:cave_chamber/cave_and_chamber".into(),
+            );
+            let mut random = RandomGenerator::Legacy(LegacyRand::from_seed(1));
+            let got = lookup
+                .lookup("nova_structures:cave_chamber/cave_and_chamber", &mut random)
+                .to_string();
+            let _ = tx.send(got);
+        });
+        let got = rx
+            .recv_timeout(Duration::from_secs(10))
+            .expect("pool alias lookup did not return (alias cycle)");
+        assert_eq!(got, "nova_structures:cave_chamber/cave_and_chamber");
+    }
+
+    #[test]
+    fn aliases_resolve_one_step_like_vanilla() {
+        let mut lookup = PoolAliasLookup::new();
+        lookup.add_direct("a:x".into(), "a:y".into());
+        lookup.add_direct("a:y".into(), "a:z".into());
+        let mut random = RandomGenerator::Legacy(LegacyRand::from_seed(1));
+        assert_eq!(lookup.lookup("a:x", &mut random), "a:y");
+        assert_eq!(lookup.lookup("a:q", &mut random), "a:q");
+    }
+}
