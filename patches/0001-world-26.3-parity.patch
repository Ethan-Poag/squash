diff --git a/crates/pumpkin-core/tests/vanilla_26_3_packets.rs b/crates/pumpkin-core/tests/vanilla_26_3_packets.rs
new file mode 100644
index 0000000..2dfbbd4
--- /dev/null
+++ b/crates/pumpkin-core/tests/vanilla_26_3_packets.rs
@@ -0,0 +1,143 @@
+//! Loads real Minecraft 26.3 chunks, wakes every block entity (signs included)
+//! through Pumpkin's normal decode path, and writes the exact 26.3 packet
+//! payloads Pumpkin would send. A strict Java-semantics decoder
+//! (tools/check_packets.py) then verifies them.
+//!
+//! Needs `PUMPKIN_2603_WORLD` and `PUMPKIN_2603_PACKETS_OUT`; skipped otherwise.
+
+use std::io::Read;
+use std::path::PathBuf;
+
+use pumpkin_core::block::entities::block_entity_from_nbt;
+use pumpkin_protocol::ClientPacket;
+use pumpkin_protocol::codec::var_int::VarInt;
+use pumpkin_protocol::java::client::play::CBlockEntityData;
+use pumpkin_util::math::vector2::Vector2;
+use pumpkin_util::version::JavaMinecraftVersion;
+use pumpkin_world::chunk::ChunkData;
+
+const CHUNKS: &[(i32, i32)] = &[(-3, 0), (0, 0), (-1, -1), (-1, -3), (-6, 1), (-5, 5), (-4, 4), (5, -3), (-2, 4), (-5, 1)];
+
+fn read_chunk(world: &std::path::Path, cx: i32, cz: i32) -> Option<Vec<u8>> {
+    let (rx, rz) = (cx.div_euclid(32), cz.div_euclid(32));
+    let data = std::fs::read(world.join("region").join(format!("r.{rx}.{rz}.mca"))).ok()?;
+    let i = (cx.rem_euclid(32) + cz.rem_euclid(32) * 32) as usize;
+    let off = u32::from_be_bytes([0, data[i * 4], data[i * 4 + 1], data[i * 4 + 2]]) as usize;
+    if off == 0 {
+        return None;
+    }
+    let o = off * 4096;
+    let len = u32::from_be_bytes(data[o..o + 4].try_into().unwrap()) as usize;
+    assert_eq!(data[o + 4], 2, "test expects zlib chunks");
+    let mut v = Vec::new();
+    flate2::read::ZlibDecoder::new(&data[o + 5..o + 4 + len]).read_to_end(&mut v).unwrap();
+    Some(v)
+}
+
+#[test]
+fn encode_26_3_chunk_and_block_entity_packets() {
+    let (Some(world), Some(out)) = (
+        std::env::var_os("PUMPKIN_2603_WORLD").map(PathBuf::from),
+        std::env::var_os("PUMPKIN_2603_PACKETS_OUT").map(PathBuf::from),
+    ) else {
+        eprintln!("PUMPKIN_2603_WORLD / PUMPKIN_2603_PACKETS_OUT not set; skipping");
+        return;
+    };
+    std::fs::create_dir_all(&out).unwrap();
+    let version = JavaMinecraftVersion::V_26_3;
+    let mut be_total = 0;
+    let mut be_sent = 0;
+    let mut signs = 0;
+    for &(cx, cz) in CHUNKS {
+        let bytes = read_chunk(&world, cx, cz).expect("chunk present");
+        let chunk = ChunkData::internal_from_bytes(&bytes, Vector2::new(cx, cz)).unwrap();
+
+        // Full chunk packet body (LEVEL_CHUNK_WITH_LIGHT) as Pumpkin builds it.
+        let mut buf = Vec::new();
+        pumpkin_core::net::java::chunk_data::v1_18::write_chunk_data(&chunk, &mut buf, &version)
+            .unwrap();
+        std::fs::write(out.join(format!("chunk_{cx}_{cz}.bin")), &buf).unwrap();
+
+        // Every block entity through the BLOCK_ENTITY_DATA path.
+        let pending: Vec<_> = chunk.pending_block_entities.lock().unwrap().values().cloned().collect();
+        for nbt in pending {
+            be_total += 1;
+            let be = block_entity_from_nbt(&nbt)
+                .unwrap_or_else(|| panic!("no block entity for {:?}", nbt.get_string("id")));
+            if be.resource_location().contains("sign") {
+                signs += 1;
+            }
+            let Some(data) = be.chunk_data_nbt() else { continue };
+            let payload = pumpkin_nbt::Nbt::from(data).write_unnamed();
+            let pkt = CBlockEntityData::new(be.get_position(), VarInt(be.get_id() as i32), payload.as_ref().into());
+            let mut pbuf = Vec::new();
+            pkt.write_packet_data(&mut pbuf, &version).unwrap();
+            let p = be.get_position().0;
+            std::fs::write(
+                out.join(format!("be_{}_{}_{}_{}.bin", be.resource_location().replace(':', "-"), p.x, p.y, p.z)),
+                &pbuf,
+            )
+            .unwrap();
+            be_sent += 1;
+        }
+    }
+    println!("block entities: {be_total} decoded ({signs} signs), {be_sent} BLOCK_ENTITY_DATA packets written");
+    assert!(signs > 0);
+}
+
+/// Every block entity in every chunk of the copied regions, written as the
+/// BLOCK_ENTITY_DATA packet body Pumpkin sends (`update_block_entity` /
+/// `add_block_entity` use the same `chunk_data_nbt` + `write_unnamed`).
+/// Needs `PUMPKIN_2603_ALL_BE_OUT`; decode the output with tools/vanilla-decode.
+#[test]
+fn encode_every_block_entity_packet_in_world() {
+    let (Some(world), Some(out)) = (
+        std::env::var_os("PUMPKIN_2603_WORLD").map(PathBuf::from),
+        std::env::var_os("PUMPKIN_2603_ALL_BE_OUT").map(PathBuf::from),
+    ) else {
+        eprintln!("PUMPKIN_2603_WORLD / PUMPKIN_2603_ALL_BE_OUT not set; skipping");
+        return;
+    };
+    std::fs::create_dir_all(&out).unwrap();
+    let version = JavaMinecraftVersion::V_26_3;
+    let (mut total, mut written) = (0, 0);
+    for rx in -1..=0 {
+        for rz in -1..=0 {
+            for i in 0..1024 {
+                let (cx, cz) = (rx * 32 + i % 32, rz * 32 + i / 32);
+                let Some(bytes) = read_chunk(&world, cx, cz) else { continue };
+                let chunk = ChunkData::internal_from_bytes(&bytes, Vector2::new(cx, cz)).unwrap();
+                let pending: Vec<_> = chunk.pending_block_entities.lock().unwrap().values().cloned().collect();
+                for nbt in pending {
+                    total += 1;
+                    let Some(be) = block_entity_from_nbt(&nbt) else { continue };
+                    let Some(data) = be.chunk_data_nbt() else { continue };
+                    let payload = pumpkin_nbt::Nbt::from(data).write_unnamed();
+                    let pkt = CBlockEntityData::new(be.get_position(), VarInt(be.get_id() as i32), payload.as_ref().into());
+                    let mut pbuf = Vec::new();
+                    pkt.write_packet_data(&mut pbuf, &version).unwrap();
+                    let p = be.get_position().0;
+                    std::fs::write(
+                        out.join(format!("be_{}_{}_{}_{}.bin", be.resource_location().replace(':', "-"), p.x, p.y, p.z)),
+                        &pbuf,
+                    )
+                    .unwrap();
+                    written += 1;
+                    // The same block entity as Pumpkin saves it to the region file.
+                    let mut saved = pumpkin_nbt::compound::NbtCompound::new();
+                    be.write_nbt(&mut saved);
+                    let payload = pumpkin_nbt::Nbt::from(saved).write_unnamed();
+                    let pkt = CBlockEntityData::new(be.get_position(), VarInt(be.get_id() as i32), payload.as_ref().into());
+                    let mut pbuf = Vec::new();
+                    pkt.write_packet_data(&mut pbuf, &version).unwrap();
+                    std::fs::write(
+                        out.join(format!("be_save_{}_{}_{}_{}.bin", be.resource_location().replace(':', "-"), p.x, p.y, p.z)),
+                        &pbuf,
+                    )
+                    .unwrap();
+                }
+            }
+        }
+    }
