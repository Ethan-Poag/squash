+//! Worlds made with biome mods (Terralith, Incendium, Nullscape) store biome
+//! names Pumpkin has no data for. Loading and saving such a chunk must write
+//! those names back unchanged, never `minecraft:badlands` (id 0), and clients
+//! must still only receive vanilla biome ids.
+//!
+//! Needs `PUMPKIN_2603_WORLD` (dir with `region/*.mca`); skipped when unset.
+
+use std::io::Read;
+use std::path::Path;
+
+use pumpkin_nbt::compound::NbtCompound;
+use pumpkin_util::math::vector2::Vector2;
+use pumpkin_world::chunk::ChunkData;
+use pumpkin_world::chunk::palette::NetworkPalette;
+
+fn read_region(path: &Path) -> Vec<(i32, i32, Vec<u8>)> {
+    let data = std::fs::read(path).unwrap();
+    let name = path.file_name().unwrap().to_str().unwrap();
+    let parts: Vec<&str> = name.split('.').collect();
+    let (rx, rz): (i32, i32) = (parts[1].parse().unwrap(), parts[2].parse().unwrap());
+    let mut out = Vec::new();
+    for i in 0..1024 {
+        let off = u32::from_be_bytes([0, data[i * 4], data[i * 4 + 1], data[i * 4 + 2]]) as usize;
+        if off == 0 {
+            continue;
+        }
+        let o = off * 4096;
+        let len = u32::from_be_bytes(data[o..o + 4].try_into().unwrap()) as usize;
+        let raw = &data[o + 5..o + 4 + len];
+        let mut v = Vec::new();
+        match data[o + 4] {
+            1 => drop(flate2::read::GzDecoder::new(raw).read_to_end(&mut v).unwrap()),
+            2 => drop(flate2::read::ZlibDecoder::new(raw).read_to_end(&mut v).unwrap()),
+            3 => v = raw.to_vec(),
+            other => panic!("unsupported compression {other} in {name}"),
+        }
+        out.push((rx * 32 + (i % 32) as i32, rz * 32 + (i / 32) as i32, v));
+    }
+    out
+}
+
+fn parse(bytes: &[u8]) -> NbtCompound {
+    let mut reader = pumpkin_nbt::deserializer::NbtReadHelperJava::new(std::io::Cursor::new(bytes));
+    if bytes.starts_with(&[0x0a, 0x00, 0x00]) {
+        pumpkin_nbt::Nbt::read(&mut reader)
+    } else {
+        pumpkin_nbt::Nbt::read_unnamed(&mut reader)
+    }
+    .unwrap()
+    .root_tag
+}
+
+/// `(section_y, palette, the 64 biome names of the section)` straight from chunk NBT.
+fn biome_sections(chunk: &NbtCompound) -> Vec<(i8, Vec<String>, Vec<String>)> {
+    let mut out = Vec::new();
+    for section in chunk.get_list("sections").unwrap_or(&[]) {
+        let section = section.extract_compound().unwrap();
+        let Some(biomes) = section.get_compound("biomes") else { continue };
+        let y = section.get_byte("Y").unwrap();
+        let palette: Vec<String> = biomes
+            .get_list("palette")
+            .unwrap()
+            .iter()
+            .map(|t| t.extract_string().expect("biome palette entry is a string").to_string())
+            .collect();
+        let cells = match biomes.get("data").and_then(|d| d.extract_long_array()) {
+            None => vec![palette[0].clone(); 64],
+            Some(longs) => {
+                let bits = usize::BITS - (palette.len() - 1).leading_zeros();
+                let per_long = 64 / bits as usize;
+                (0..64)
+                    .map(|i| {
+                        let word = longs[i / per_long] as u64;
+                        let idx = (word >> ((i % per_long) as u32 * bits)) & ((1 << bits) - 1);
+                        palette[idx as usize].clone()
+                    })
+                    .collect()
+            }
+        };
+        out.push((y, palette, cells));
+    }
+    out.sort_by_key(|s| s.0);
+    out
+}
+
+#[test]
+fn unknown_biome_names_survive_load_save_reload() {
+    let Some(world) = std::env::var_os("PUMPKIN_2603_WORLD").map(std::path::PathBuf::from) else {
+        eprintln!("PUMPKIN_2603_WORLD unset; skipping");
+        return;
+    };
+    let mut regions: Vec<_> = std::fs::read_dir(world.join("region"))
+        .unwrap()
+        .map(|e| e.unwrap().path())
+        .filter(|p| p.extension().is_some_and(|e| e == "mca"))
+        .collect();
+    regions.sort();
+    let (mut chunks, mut sections, mut cells, mut modded_cells) = (0usize, 0usize, 0usize, 0usize);
+    let (mut src_badlands, mut saved_badlands) = (0usize, 0usize);
+    let mut modded_names = std::collections::BTreeSet::new();
+    for region in &regions {
+        for (cx, cz, bytes) in read_region(region) {
+            let source = biome_sections(&parse(&bytes));
+            let first = ChunkData::internal_from_bytes(&bytes, Vector2::new(cx, cz)).unwrap();
+            // Clients may only see vanilla biome ids (0..=66), whatever is stored.
+            for palette in first.section.biome_sections.read().unwrap().iter() {
+                let net = palette.convert_network();
+                match &net.palette {
+                    NetworkPalette::Single(id) => assert!(*id < pumpkin_world::biome::unknown::FIRST_UNKNOWN_ID, "chunk {cx},{cz}: network biome {id}"),
+                    NetworkPalette::Indirect(ids) => {
+                        assert!(ids.iter().all(|&id| id < pumpkin_world::biome::unknown::FIRST_UNKNOWN_ID), "chunk {cx},{cz}: network palette {ids:?}")
+                    }
+                    NetworkPalette::Direct => assert!(net.bits_per_entry <= 7),
+                }
+            }
+            let saved_once = first.internal_to_bytes();
+            let second = ChunkData::internal_from_bytes(&saved_once, Vector2::new(cx, cz)).unwrap();
+            let saved_twice = second.internal_to_bytes();
+            for saved in [&saved_once, &saved_twice] {
+                let saved = biome_sections(&parse(saved));
+                let saved: Vec<_> = saved.into_iter().filter(|s| source.iter().any(|t| t.0 == s.0)).collect();
+                assert_eq!(saved.len(), source.len(), "chunk {cx},{cz}: biome section count changed");
+                for ((y, src_pal, src_cells), (_, out_pal, out_cells)) in source.iter().zip(&saved) {
+                    let mut a = src_pal.clone();
+                    let mut b = out_pal.clone();
+                    a.sort();
+                    b.sort();
+                    assert_eq!(a, b, "chunk {cx},{cz} section {y}: biome palette changed");
+                    assert_eq!(src_cells, out_cells, "chunk {cx},{cz} section {y}: biome cells changed");
+                    saved_badlands += out_pal.iter().filter(|n| *n == "minecraft:badlands").count();
+                }
+            }
+            for (_, pal, sec_cells) in &source {
+                sections += 1;
+                cells += sec_cells.len();
+                src_badlands += pal.iter().filter(|n| *n == "minecraft:badlands").count();
+                for name in sec_cells.iter().filter(|n| !n.starts_with("minecraft:")) {
+                    modded_cells += 1;
+                    modded_names.insert(name.clone());
+                }
+            }
+            chunks += 1;
+        }
+    }
+    println!(
+        "{} regions, {chunks} chunks, {sections} biome sections, {cells} biome cells ({modded_cells} modded) identical after save and save-reload-save",
+    regions.len());
+    println!("{} modded biome names kept: {modded_names:?}", modded_names.len());
+    println!("minecraft:badlands palette entries: source {src_badlands}, saved {saved_badlands} (two saves)");
+    assert!(chunks > 0);
+    assert!(!modded_names.is_empty(), "fixture world has no modded biomes");
+    assert_eq!(saved_badlands, 2 * src_badlands, "saving introduced minecraft:badlands");
+}
diff --git a/crates/pumpkin-world/tests/vanilla_26_3_region.rs b/crates/pumpkin-world/tests/vanilla_26_3_region.rs
new file mode 100644
index 0000000..a8ced67
--- /dev/null
+++ b/crates/pumpkin-world/tests/vanilla_26_3_region.rs
@@ -0,0 +1,294 @@
+//! Loads real Minecraft 26.3 region files and checks every block against
+//! ground truth decoded independently (tools/make_fixtures.py).
+//!
+//! Needs `PUMPKIN_2603_WORLD` (dir with `region/*.mca`) and
+//! `PUMPKIN_2603_FIXTURES` (dir with `sections.txt`, `region_counts.txt`).
+//! Skipped when they are unset.
+
+use std::collections::HashMap;
+use std::io::Read;
+use std::path::PathBuf;
+
+use pumpkin_data::Block;
+use pumpkin_util::math::vector2::Vector2;
+use pumpkin_world::chunk::ChunkData;
+
+fn env_dir(key: &str) -> Option<PathBuf> {
+    std::env::var_os(key).map(PathBuf::from)
+}
+
+/// Returns `(chunk_x, chunk_z, nbt_bytes)` for every chunk in a region file.
+fn read_region(path: &std::path::Path) -> Vec<(i32, i32, Vec<u8>)> {
+    let data = std::fs::read(path).unwrap();
+    let name = path.file_name().unwrap().to_str().unwrap();
+    let parts: Vec<&str> = name.split('.').collect();
+    let (rx, rz): (i32, i32) = (parts[1].parse().unwrap(), parts[2].parse().unwrap());
+    let mut out = Vec::new();
+    for i in 0..1024 {
+        let off = u32::from_be_bytes([0, data[i * 4], data[i * 4 + 1], data[i * 4 + 2]]) as usize;
+        if off == 0 {
+            continue;
+        }
+        let o = off * 4096;
+        let len = u32::from_be_bytes(data[o..o + 4].try_into().unwrap()) as usize;
+        let ct = data[o + 4];
+        let raw = &data[o + 5..o + 4 + len];
+        let bytes = match ct {
+            2 => {
+                let mut v = Vec::new();
+                flate2::read::ZlibDecoder::new(raw).read_to_end(&mut v).unwrap();
+                v
+            }
+            1 => {
+                let mut v = Vec::new();
+                flate2::read::GzDecoder::new(raw).read_to_end(&mut v).unwrap();
+                v
+            }
+            3 => raw.to_vec(),
+            other => panic!("unsupported compression {other} in {name}"),
+        };
+        let cx = rx * 32 + (i % 32) as i32;
+        let cz = rz * 32 + (i / 32) as i32;
+        out.push((cx, cz, bytes));
+    }
+    out
+}
+
+fn short(name: &str) -> &str {
+    name.strip_prefix("minecraft:").unwrap_or(name)
+}
+
+fn is_air(name: &str) -> bool {
+    matches!(short(name), "air" | "cave_air" | "void_air")
+}
+
+struct Section {
+    palette: Vec<(String, Vec<(String, String)>)>,
+    idx: Vec<usize>,
+}
+
+fn load_fixtures(dir: &std::path::Path) -> (HashMap<(i32, i32, i32), Section>, Vec<(i32, i32, i32, i32, i32, String, String)>) {
+    let text = std::fs::read_to_string(dir.join("sections.txt")).unwrap();
+    let mut sections = HashMap::new();
+    let mut signs = Vec::new();
+    let mut cur: Option<((i32, i32, i32), Section)> = None;
+    for line in text.lines() {
+        let (tag, rest) = line.split_at(2);
+        match tag {
+            "S " => {
+                if let Some((k, s)) = cur.take() {
+                    sections.insert(k, s);
+                }
+                let v: Vec<i32> = rest.split(' ').map(|x| x.parse().unwrap()).collect();
+                cur = Some(((v[0], v[1], v[2]), Section { palette: vec![], idx: vec![] }));
+            }
+            "P " => {
+                let (name, props) = rest.split_once('|').unwrap();
+                let props = props
+                    .split(',')
+                    .filter(|s| !s.is_empty())
+                    .map(|kv| {
+                        let (k, v) = kv.split_once('=').unwrap();
+                        (k.to_string(), v.to_string())
+                    })
+                    .collect();
+                cur.as_mut().unwrap().1.palette.push((name.to_string(), props));
+            }
+            "I " => {
+                cur.as_mut().unwrap().1.idx = rest.split(' ').map(|x| x.parse().unwrap()).collect();
+            }
+            "B " => {
+                let mut it = rest.splitn(7, ' ');
+                let v: Vec<i32> = (0..5).map(|_| it.next().unwrap().parse().unwrap()).collect();
+                let id = it.next().unwrap().to_string();
+                let text = it.next().unwrap_or("").to_string();
+                signs.push((v[0], v[1], v[2], v[3], v[4], id, text));
+            }
+            _ => panic!("bad fixture line"),
+        }
+    }
+    if let Some((k, s)) = cur.take() {
+        sections.insert(k, s);
+    }
+    (sections, signs)
+}
+
+fn setup() -> Option<(PathBuf, PathBuf)> {
+    let (Some(world), Some(fixtures)) = (env_dir("PUMPKIN_2603_WORLD"), env_dir("PUMPKIN_2603_FIXTURES")) else {
+        eprintln!("PUMPKIN_2603_WORLD / PUMPKIN_2603_FIXTURES not set; skipping");
+        return None;
+    };
+    Some((world, fixtures))
+}
+
+#[test]
+fn every_block_in_selected_26_3_chunks_matches_source_nbt() {
+    let Some((world, fixtures)) = setup() else { return };
+    let (sections, signs) = load_fixtures(&fixtures);
+    let wanted: std::collections::HashSet<(i32, i32)> = sections.keys().map(|k| (k.0, k.1)).collect();
+
+    let mut checked_blocks = 0usize;
+    let mut checked_non_air = 0usize;
+    let mut checked_sections = 0usize;
+    let mut mismatches = Vec::new();
+    let mut signs_found = 0usize;
+
+    for entry in std::fs::read_dir(world.join("region")).unwrap() {
+        let path = entry.unwrap().path();
+        for (cx, cz, bytes) in read_region(&path) {
+            if !wanted.contains(&(cx, cz)) {
+                continue;
+            }
+            let chunk = ChunkData::internal_from_bytes(&bytes, Vector2::new(cx, cz))
+                .unwrap_or_else(|e| panic!("chunk {cx},{cz} failed to parse: {e:?}"));
+            for (&(sx, sz, sy), sec) in sections.iter().filter(|(k, _)| k.0 == cx && k.1 == cz) {
+                let _ = (sx, sz);
+                checked_sections += 1;
+                for (i, &pi) in sec.idx.iter().enumerate() {
+                    let (x, z, y) = (i % 16, (i / 16) % 16, i / 256);
+                    let abs_y = sy * 16 + y as i32;
+                    let (ref want_name, ref want_props) = sec.palette[pi];
+                    let got = chunk.section.get_block_absolute_y(x, abs_y, z).unwrap();
+                    let block = Block::from_state_id(got);
+                    checked_blocks += 1;
+                    if !is_air(want_name) {
+                        checked_non_air += 1;
+                    }
+                    let mut ok = short(block.name) == short(want_name);
+                    if ok {
+                        if want_props.is_empty() {
+                            ok = got == block.default_state.id;
+                        } else if let Some(props) = block.properties(got) {
+                            let got_props: Vec<(String, String)> = props
+                                .to_props()
+                                .into_iter()
+                                .map(|p| (p.key_str().to_string(), p.value_str().to_string()))
+                                .collect();
+                            ok = want_props.iter().all(|wp| got_props.contains(wp));
+                        } else {
+                            ok = false;
+                        }
+                    }
+                    if !ok && mismatches.len() < 20 {
+                        mismatches.push(format!(
+                            "chunk {cx},{cz} y={abs_y} x={x} z={z}: want {want_name} {want_props:?}, got {} (state {})",
+                            block.name,
+                            got.as_u16()
+                        ));
+                    }
+                }
+            }
+            let pending = chunk.pending_block_entities.lock().unwrap();
+            for s in signs.iter().filter(|s| s.0 == cx && s.1 == cz) {
+                let pos = pumpkin_util::math::position::BlockPos::new(s.2, s.3, s.4);
+                let nbt = pending.get(&pos).unwrap_or_else(|| panic!("sign at {pos:?} missing"));
+                assert_eq!(nbt.get_string("id"), Some(s.5.as_str()));
+                let front = nbt.get_compound("front_text").expect("front_text");
+                let joined: String = front
+                    .get_list("messages")
+                    .expect("messages")
+                    .iter()
+                    .map(|t| t.extract_string().expect("message is a string").to_string())
+                    .collect::<Vec<_>>()
+                    .join("\u{1f}");
+                assert_eq!(joined, s.6, "sign text at {pos:?}");
+                signs_found += 1;
+            }
+        }
+    }
+    println!(
+        "checked {checked_sections} sections, {checked_blocks} blocks ({checked_non_air} non-air), {signs_found} signs, {} mismatches",
+        mismatches.len()
+    );
+    assert!(checked_sections > 0 && checked_non_air > 0);
+    assert!(mismatches.is_empty(), "mismatches:\n{}", mismatches.join("\n"));
+    assert_eq!(signs_found, signs.len());
+}
+
+#[test]
+fn whole_region_non_air_counts_match_source_nbt() {
+    let Some((world, fixtures)) = setup() else { return };
+    let text = std::fs::read_to_string(fixtures.join("region_counts.txt")).unwrap();
+    for line in text.lines() {
+        let v: Vec<&str> = line.split(' ').collect();
+        let (file, want_chunks, want_non_air): (&str, usize, usize) = (v[0], v[1].parse().unwrap(), v[2].parse().unwrap());
+        let chunks = read_region(&world.join("region").join(file));
+        let mut non_air = 0usize;
+        for (cx, cz, bytes) in &chunks {
+            let chunk = ChunkData::internal_from_bytes(bytes, Vector2::new(*cx, *cz))
+                .unwrap_or_else(|e| panic!("chunk {cx},{cz} failed to parse: {e:?}"));
+            let min_y = chunk.section.min_y;
+            let height = (chunk.section.count * 16) as i32;
+            for y in min_y..min_y + height {
+                for z in 0..16 {
+                    for x in 0..16 {
+                        let id = chunk.section.get_block_absolute_y(x, y, z).unwrap();
+                        if !is_air(Block::from_state_id(id).name) {
+                            non_air += 1;
+                        }
+                    }
+                }
+            }
+        }
+        println!("{file}: {} chunks, non-air pumpkin={non_air} source={want_non_air}", chunks.len());
+        assert_eq!(chunks.len(), want_chunks);
+        assert_eq!(non_air, want_non_air, "{file}");
+    }
+}
+
+/// Pumpkin stamps saved chunks with DataVersion 5023 (26.3). Vanilla 26.3 only
+/// renames `Name`/`Properties` -> `id`/`properties` for older DataVersions, so the
+/// saved palette must already use the 26.3 keys, and must still load back identically.
+#[test]
+fn saved_26_3_chunks_use_26_3_palette_keys_and_round_trip() {
+    let Some((world, fixtures)) = setup() else { return };
+    let (sections, _) = load_fixtures(&fixtures);
+    let wanted: std::collections::HashSet<(i32, i32)> = sections.keys().map(|k| (k.0, k.1)).collect();
+    let (mut entries, mut legacy, mut chunks_checked, mut blocks_checked) = (0usize, 0usize, 0usize, 0usize);
+    for entry in std::fs::read_dir(world.join("region")).unwrap() {
+        for (cx, cz, bytes) in read_region(&entry.unwrap().path()) {
+            if !wanted.contains(&(cx, cz)) {
+                continue;
+            }
+            let original = ChunkData::internal_from_bytes(&bytes, Vector2::new(cx, cz)).unwrap();
+            let saved = original.internal_to_bytes();
+            let nbt = if saved.starts_with(&[0x0a, 0x00, 0x00]) {
+                pumpkin_nbt::Nbt::read(&mut pumpkin_nbt::deserializer::NbtReadHelperJava::new(&mut std::io::Cursor::new(&saved[..])))
+            } else {
+                pumpkin_nbt::Nbt::read_unnamed(&mut pumpkin_nbt::deserializer::NbtReadHelperJava::new(&mut std::io::Cursor::new(&saved[..])))
+            }
+            .unwrap();
+            assert_eq!(nbt.root_tag.get_int("DataVersion"), Some(5023));
+            for section in nbt.root_tag.get_list("sections").unwrap() {
+                let section = section.extract_compound().unwrap();
+                let Some(bs) = section.get_compound("block_states") else { continue };
+                for e in bs.get_list("palette").unwrap() {
+                    let c = e.extract_compound().expect("compound palette entry");
+                    entries += 1;
+                    assert!(c.get_string("id").is_some(), "palette entry without id: {c:?}");
+                    if c.get_string("Name").is_some() || c.get_compound("Properties").is_some() {
+                        legacy += 1;
+                    }
+                }
+            }
+            let reloaded = ChunkData::internal_from_bytes(&saved, Vector2::new(cx, cz)).unwrap();
+            let min_y = original.section.min_y;
+            for y in min_y..min_y + (original.section.count * 16) as i32 {
+                for z in 0..16 {
+                    for x in 0..16 {
+                        assert_eq!(
+                            original.section.get_block_absolute_y(x, y, z),
+                            reloaded.section.get_block_absolute_y(x, y, z),
+                            "chunk {cx},{cz} block {x},{y},{z} changed across save"
+                        );
+                        blocks_checked += 1;
+                    }
+                }
+            }
+            chunks_checked += 1;
+        }
+    }
+    println!("saved {chunks_checked} chunks: {entries} palette entries, {legacy} with legacy Name/Properties keys, {blocks_checked} blocks identical after reload");
+    assert!(chunks_checked > 0);
+    assert_eq!(legacy, 0, "saved palette still uses pre-26.3 Name/Properties keys");
+}
diff --git a/crates/pumpkin-world/tests/vanilla_structure_spawns_26_3.rs b/crates/pumpkin-world/tests/vanilla_structure_spawns_26_3.rs
