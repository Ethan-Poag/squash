+/// A pack that repeats vanilla's End settings, biomes and the features they list must place the
+/// same blocks as the generated tables, through the whole feature stage.
+#[test]
+fn vanilla_end_features_in_a_pack_generate_identical_chunks() {
+    let world = tempfile::tempdir().expect("tempdir");
+    let pack = world.path().join("datapacks/copy");
+    let settings = pack.join("data/minecraft/worldgen/noise_settings");
+    fs::create_dir_all(&settings).expect("dirs");
+    let text = VANILLA_WORLDGEN
+        .iter()
+        .find(|(kind, path, _)| *kind == "noise_settings" && *path == "end")
+        .map(|(_, _, text)| *text)
+        .expect("embedded end settings");
+    fs::write(settings.join("end.json"), text).expect("write");
+
+    let biomes = pack.join("data/minecraft/worldgen/biome");
+    fs::create_dir_all(&biomes).expect("dirs");
+    let assets = Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("../../assets/datapack/data/minecraft/worldgen/biome");
+    let mut listed = Vec::new();
+    for name in [
+        "the_end",
+        "end_highlands",
+        "end_midlands",
+        "end_barrens",
+        "small_end_islands",
+    ] {
+        let text = fs::read_to_string(assets.join(format!("{name}.json"))).expect("vanilla biome");
+        fs::write(biomes.join(format!("{name}.json")), &text).expect("write");
+        listed.extend(
+            text.split('"')
+                .filter_map(|part| part.strip_prefix("minecraft:"))
+                .map(str::to_string),
+        );
+    }
+    let listed: Vec<&str> = listed.iter().map(String::as_str).collect();
+    copy_vanilla_features(&pack, &listed);
+
+    let runtime = load_dimension_generation(world.path(), &Dimension::THE_END, "minecraft:end")
+        .expect("pack should override the End");
+    let features = runtime.features.expect("the pack defines the End biomes");
+    assert!(
+        features.loaded() >= 4,
+        "{} placed features",
+        features.loaded()
+    );
+    assert!(
+        features.unsupported().is_empty(),
+        "{:?}",
+        features.unsupported()
+    );
+
+    let from_pack = end_world_gen(Some(runtime));
+    let vanilla = end_world_gen(None);
+    let mut from_world = FeatureWorld::new(&from_pack, false);
+    let mut vanilla_world = FeatureWorld::new(&vanilla, false);
+    let mut decorated = false;
+    for (x, z) in [
+        (0, 0),
+        (2, 0),
+        (0, 2),
+        (-3, -1),
+        (-1, -3),
+        (80, 0),
+        (100, 100),
+        (-90, 40),
+    ] {
+        let a = from_world.chunk(x, z);
+        let b = vanilla_world.chunk(x, z);
+        let (blocks, _) = chunk_blocks_and_biomes(a);
+        decorated |= blocks.contains(&pumpkin_data::Block::OBSIDIAN.default_state.id.as_u16());
+        assert!(
+            blocks == chunk_blocks_and_biomes(b).0,
+            "chunk ({x}, {z}) differs"
+        );
+    }
+    assert!(decorated, "no spike was generated, so nothing was compared");
+}
