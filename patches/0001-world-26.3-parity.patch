@@ -0,0 +1,709 @@
+//! The structures overlapping a chunk that override natural mob spawns, kept in the chunk's
+//! `extra_nbt` so they survive a restart (vanilla keeps the structure starts and references).
+
+use std::sync::{Arc, LazyLock, Mutex, Weak};
+
+use dashmap::DashMap;
+use pumpkin_data::chunk::Spawner;
+use pumpkin_data::structures::{
+    BoundingBoxType, SpawnEntry, SpawnOverride, Structure, StructureKeys,
+};
+use pumpkin_data::structures_dynamic;
+use pumpkin_nbt::{compound::NbtCompound, tag::NbtTag};
+use pumpkin_util::math::{block_box::BlockBox, position::BlockPos, vector2::Vector2};
+use rustc_hash::FxHashMap;
+
+use crate::chunk::ChunkData;
+use crate::generation::structure::structures::StructurePiecesCollector;
+
+/// Key in the chunk's `extra_nbt` that lists the records.
+pub const SPAWN_STRUCTURES_KEY: &str = "pumpkin:spawn_structures";
+/// `BuiltinStructures.FORTRESS`.
+const FORTRESS: &str = "minecraft:fortress";
+/// `NetherFortressStructure.FORTRESS_ENEMIES` as (type, min count, max count, weight).
+const FORTRESS_ENEMIES: [(&str, i32, i32, i32); 5] = [
+    ("minecraft:blaze", 2, 3, 10),
+    ("minecraft:zombified_piglin", 4, 4, 5),
+    ("minecraft:wither_skeleton", 5, 5, 8),
+    ("minecraft:skeleton", 5, 5, 2),
+    ("minecraft:magma_cube", 4, 4, 3),
+];
+
+fn box_tag(bounds: &BlockBox) -> NbtTag {
+    NbtTag::IntArray(vec![
+        bounds.min.x,
+        bounds.min.y,
+        bounds.min.z,
+        bounds.max.x,
+        bounds.max.y,
+        bounds.max.z,
+    ])
+}
+
+fn read_box(tag: &NbtTag) -> Option<BlockBox> {
+    match tag {
+        NbtTag::IntArray(v) if v.len() == 6 => {
+            Some(BlockBox::new(v[0], v[1], v[2], v[3], v[4], v[5]))
+        }
+        _ => None,
+    }
+}
+
+fn full_name(key: StructureKeys) -> String {
+    let name = key.to_name();
+    if name.contains(':') {
+        name.to_string()
+    } else {
+        format!("minecraft:{name}")
+    }
+}
+
+/// Leaks each entity type name once; the names come from structure JSON.
+fn intern(text: &str) -> &'static str {
+    static NAMES: LazyLock<Mutex<FxHashMap<Box<str>, &'static str>>> =
+        LazyLock::new(|| Mutex::new(FxHashMap::default()));
+    let mut names = NAMES
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if let Some(name) = names.get(text) {
+        return name;
+    }
+    let leaked: &'static str = Box::leak(text.to_string().into_boxed_str());
+    names.insert(text.into(), leaked);
+    leaked
+}
+
+fn record(
+    key: StructureKeys,
+    collector: &Mutex<StructurePiecesCollector>,
+    chunk: (i32, i32),
+) -> Option<NbtCompound> {
+    let structure = Structure::get(&key);
+    let name = full_name(key);
+    if structure.spawn_overrides.is_empty() && name != FORTRESS {
+        return None;
+    }
+    let mut collector = collector
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let full = collector.get_bounding_box();
+    let (min_x, min_z) = (chunk.0 * 16, chunk.1 * 16);
+    let pieces: Vec<NbtTag> = collector
+        .pieces
+        .iter()
+        .map(|piece| piece.bounding_box())
+        .filter(|piece| piece.intersects_raw_xz(min_x, min_z, min_x + 15, min_z + 15))
+        .map(|piece| box_tag(&piece))
+        .collect();
+    if pieces.is_empty() {
+        return None;
+    }
+    let overrides: Vec<NbtTag> = structure
+        .spawn_overrides
+        .iter()
+        .map(|entry| {
+            let mut nbt = NbtCompound::new();
+            nbt.put_string("category", entry.category.to_string());
+            nbt.put_bool("piece", entry.bounding_box == BoundingBoxType::Piece);
+            let spawns = entry
+                .spawns
+                .iter()
+                .map(|spawn| {
+                    let mut s = NbtCompound::new();
+                    s.put_string("type", spawn.entity_type.to_string());
+                    s.put_int("min", i32::try_from(spawn.min_count).unwrap_or(1));
+                    s.put_int("max", i32::try_from(spawn.max_count).unwrap_or(1));
+                    s.put_int("weight", i32::try_from(spawn.weight).unwrap_or(1));
+                    NbtTag::Compound(s)
+                })
+                .collect();
+            nbt.put_list("spawns", spawns);
+            NbtTag::Compound(nbt)
+        })
+        .collect();
+    let mut nbt = NbtCompound::new();
+    nbt.put_string("id", name);
+    nbt.put("box", box_tag(&full));
+    nbt.put_list("pieces", pieces);
+    nbt.put_list("overrides", overrides);
+    Some(nbt)
+}
+
+/// Stores the spawn records of the structures that overlap chunk `chunk` in `extra_nbt`.
+pub fn store<'a>(
+    extra_nbt: &mut NbtCompound,
+    structures: impl IntoIterator<Item = (StructureKeys, &'a Arc<Mutex<StructurePiecesCollector>>)>,
+    chunk: (i32, i32),
+) {
+    let mut seen: Vec<StructureKeys> = Vec::new();
+    let mut records = Vec::new();
+    for (key, collector) in structures {
+        if seen.contains(&key) {
+            continue;
+        }
+        seen.push(key);
+        crate::generation::budget::tick();
+        if let Some(nbt) = record(key, collector, chunk) {
+            records.push(NbtTag::Compound(nbt));
+        }
+    }
+    if !records.is_empty() {
+        extra_nbt.put_list(SPAWN_STRUCTURES_KEY, records);
+    }
+}
+
+/// What the structures of a chunk say about natural spawns at a position.
+pub struct StructureSpawns {
+    /// Inside a piece of the nether fortress.
+    pub in_fortress_piece: bool,
+    /// The spawners of the first structure with an override for the category that contains the
+    /// position, as `ChunkGenerator.getMobsAt` picks them.
+    pub overridden: Option<Vec<Spawner>>,
+}
+
+/// Looks up `pos` in the records of `extra_nbt`.
+#[must_use]
+pub fn lookup(extra_nbt: &NbtCompound, pos: &BlockPos, category: &str) -> StructureSpawns {
+    let mut result = StructureSpawns {
+        in_fortress_piece: false,
+        overridden: None,
+    };
+    let Some(records) = extra_nbt.get_list(SPAWN_STRUCTURES_KEY) else {
+        return result;
+    };
+    for record in records {
+        let NbtTag::Compound(record) = record else {
+            continue;
+        };
+        let in_piece = record.get_list("pieces").is_some_and(|pieces| {
+            pieces
+                .iter()
+                .filter_map(read_box)
+                .any(|piece| piece.contains(pos.0.x, pos.0.y, pos.0.z))
+        });
+        if record.get_string("id") == Some(FORTRESS) && in_piece {
+            result.in_fortress_piece = true;
+        }
+        if result.overridden.is_some() {
+            continue;
+        }
+        let in_full = record
+            .get("box")
+            .and_then(read_box)
+            .is_some_and(|full| full.contains(pos.0.x, pos.0.y, pos.0.z));
+        for entry in record.get_list("overrides").unwrap_or_default() {
+            let NbtTag::Compound(entry) = entry else {
+                continue;
+            };
+            if entry.get_string("category") != Some(category) {
+                continue;
+            }
+            let inside = if entry.get_bool("piece").unwrap_or(false) {
+                in_piece
+            } else {
+                in_full
+            };
+            if inside {
+                result.overridden = Some(
+                    entry
+                        .get_list("spawns")
+                        .unwrap_or_default()
+                        .iter()
+                        .filter_map(|spawn| {
+                            let NbtTag::Compound(spawn) = spawn else {
+                                return None;
+                            };
+                            Some(Spawner {
+                                r#type: intern(spawn.get_string("type")?),
+                                min_count: spawn.get_int("min").unwrap_or(1),
+                                max_count: spawn.get_int("max").unwrap_or(1),
+                                weight: spawn.get_int("weight").unwrap_or(1),
+                            })
+                        })
+                        .collect(),
+                );
+                break;
+            }
+        }
+    }
+    result
+}
+
+/// A structure start read from the `structures.starts` of a vanilla chunk.
+struct VanillaStart {
+    id: Box<str>,
+    /// `StructureStart.getBoundingBox`: the box around all pieces.
+    full: BlockBox,
+    pieces: Vec<BlockBox>,
+}
+
+/// The structure starts held by a chunk and the chunks its structure references point to.
+#[derive(Default)]
+pub struct VanillaStructures {
+    starts: Vec<VanillaStart>,
+    references: Vec<(Box<str>, Vec<(i32, i32)>)>,
+}
+
+/// `ChunkPos.unpack`.
+const fn unpack_chunk_pos(packed: i64) -> (i32, i32) {
+    (packed as i32, (packed >> 32) as i32)
+}
+
+impl VanillaStructures {
+    /// Reads the `structures` compound of a chunk; entries that are invalid or empty are left out.
+    #[must_use]
+    pub fn parse(structures: &NbtCompound) -> Self {
+        let mut result = Self::default();
+        if let Some(starts) = structures.get_compound("starts") {
+            for (id, start) in &starts.child_tags {
+                let NbtTag::Compound(start) = start else {
+                    continue;
+                };
+                let pieces: Vec<BlockBox> = start
+                    .get_list("Children")
+                    .unwrap_or_default()
+                    .iter()
+                    .filter_map(|child| match child {
+                        NbtTag::Compound(child) => child.get("BB").and_then(read_box),
+                        _ => None,
+                    })
+                    .collect();
+                let Some(full) = BlockBox::encompass_all(pieces.iter().copied()) else {
+                    continue;
+                };
+                result.starts.push(VanillaStart {
+                    id: id.clone(),
+                    full,
+                    pieces,
+                });
+            }
+        }
+        if let Some(references) = structures.get_compound("References") {
+            for (id, chunks) in &references.child_tags {
+                if let NbtTag::LongArray(chunks) = chunks {
+                    let chunks = chunks.iter().map(|&c| unpack_chunk_pos(c)).collect();
+                    result.references.push((id.clone(), chunks));
+                }
+            }
+        }
+        result
+    }
+}
+
+/// Parsed `structures` compounds of the loaded chunks, so a spawn attempt reads no NBT.
+#[derive(Default)]
+pub struct StructureCache {
+    chunks: DashMap<Vector2<i32>, (Weak<ChunkData>, Arc<VanillaStructures>)>,
+}
+
+/// Entries kept before the ones of unloaded chunks are dropped.
+const CACHE_PRUNE_SIZE: usize = 4096;
+
+impl StructureCache {
+    fn get(&self, pos: Vector2<i32>, chunk: &Arc<ChunkData>) -> Arc<VanillaStructures> {
+        if let Some(entry) = self.chunks.get(&pos)
+            && entry.0.upgrade().is_some_and(|c| Arc::ptr_eq(&c, chunk))
+        {
+            return entry.1.clone();
+        }
+        let parsed = {
+            let extra = chunk
+                .extra_nbt
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            Arc::new(
+                extra
+                    .get_compound("structures")
+                    .map(VanillaStructures::parse)
+                    .unwrap_or_default(),
+            )
+        };
+        if self.chunks.len() >= CACHE_PRUNE_SIZE {
+            self.chunks.retain(|_, (chunk, _)| chunk.strong_count() > 0);
+        }
+        self.chunks
+            .insert(pos, (Arc::downgrade(chunk), parsed.clone()));
+        parsed
+    }
+}
+
+impl StructureCache {
+    /// What the structures around `pos` say about natural spawns, from the vanilla `structures` of
+    /// the loaded chunks. `chunk_at` gives a loaded chunk.
+    pub fn spawns_at(
+        &self,
+        chunk_at: impl Fn(Vector2<i32>) -> Option<Arc<ChunkData>>,
+        pos: &BlockPos,
+        category: &str,
+    ) -> StructureSpawns {
+        lookup_vanilla(
+            |chunk| Some(self.get(chunk, &chunk_at(chunk)?)),
+            pos,
+            category,
+        )
+    }
+}
+
+/// The structure registered as `id`: a vanilla one or a runtime one from a datapack.
+fn structure_by_id(id: &str) -> Option<&'static Structure> {
+    let key = StructureKeys::from_name(id).or_else(|| structures_dynamic::find(id))?;
+    Some(Structure::get(&key))
+}
+
+fn spawners_of(spawns: &[SpawnEntry]) -> Vec<Spawner> {
+    spawns
+        .iter()
+        .map(|spawn| Spawner {
+            r#type: intern(&spawn.entity_type.to_string()),
+            min_count: i32::try_from(spawn.min_count).unwrap_or(1),
+            max_count: i32::try_from(spawn.max_count).unwrap_or(1),
+            weight: i32::try_from(spawn.weight).unwrap_or(1),
+        })
+        .collect()
+}
+
+/// Like [`lookup`], for the structure starts a vanilla chunk keeps: the references of the chunk
+/// at `pos` name the chunks holding the starts (`StructureManager.startsForStructure`).
+/// `structures_in` gives the parsed structures of a chunk when it is loaded.
+pub fn lookup_vanilla(
+    structures_in: impl Fn(Vector2<i32>) -> Option<Arc<VanillaStructures>>,
+    pos: &BlockPos,
+    category: &str,
+) -> StructureSpawns {
+    let mut result = StructureSpawns {
+        in_fortress_piece: false,
+        overridden: None,
+    };
+    let chunk = Vector2::new(pos.0.x >> 4, pos.0.z >> 4);
+    let Some(own) = structures_in(chunk) else {
+        return result;
+    };
+    for (id, chunks) in &own.references {
+        let fortress = &**id == FORTRESS;
+        let overrides: Vec<&SpawnOverride> = if result.overridden.is_some() {
+            Vec::new()
+        } else {
+            structure_by_id(id).map_or_else(Vec::new, |structure| {
+                structure
+                    .spawn_overrides
+                    .iter()
+                    .filter(|entry| entry.category == category)
+                    .collect()
+            })
+        };
+        if !fortress && overrides.is_empty() {
+            continue;
+        }
+        for &(x, z) in chunks {
+            let Some(holder) = structures_in(Vector2::new(x, z)) else {
+                continue;
+            };
+            let Some(start) = holder.starts.iter().find(|start| *start.id == **id) else {
+                continue;
+            };
+            let in_piece = start
+                .pieces
+                .iter()
+                .any(|piece| piece.contains(pos.0.x, pos.0.y, pos.0.z));
+            let in_full = start.full.contains(pos.0.x, pos.0.y, pos.0.z);
+            if fortress && in_piece {
+                result.in_fortress_piece = true;
+            }
+            if result.overridden.is_none()
+                && let Some(entry) = overrides.iter().find(|entry| {
+                    if entry.bounding_box == BoundingBoxType::Piece {
+                        in_piece
+                    } else {
+                        in_full
+                    }
+                })
+            {
+                result.overridden = Some(spawners_of(entry.spawns));
+            }
+        }
+    }
+    result
+}
