diff --git a/crates/pumpkin-core/src/block/entities/container_loot.rs b/crates/pumpkin-core/src/block/entities/container_loot.rs
new file mode 100644
index 0000000..55caca2
--- /dev/null
+++ b/crates/pumpkin-core/src/block/entities/container_loot.rs
@@ -0,0 +1,263 @@
+//! Deferred loot tables for containers, mirroring vanilla's `RandomizableContainer`.
+
+use std::collections::HashSet;
+use std::sync::{Arc, Mutex, OnceLock};
+
+use pumpkin_data::attributes::Attributes;
+use pumpkin_data::item_stack::ItemStack;
+use pumpkin_nbt::compound::NbtCompound;
+use pumpkin_util::math::position::BlockPos;
+use tracing::warn;
+
+use super::BlockEntity;
+use crate::entity::player::Player;
+use crate::entity::player::advancement::trigger::AdvancementTrigger;
+use crate::world::World;
+use crate::world::loot::{LootContextParameters, LootTableHandle, generate_loot_from_handle};
+
+const LOOT_TABLE_KEY: &str = "LootTable";
+const LOOT_TABLE_SEED_KEY: &str = "LootTableSeed";
+
+/// The pending `LootTable` / `LootTableSeed` pair of a container block entity.
+#[derive(Default)]
+pub struct ContainerLoot(Mutex<Option<(String, i64)>>);
+
+impl ContainerLoot {
+    #[must_use]
+    pub const fn new() -> Self {
+        Self(Mutex::new(None))
+    }
+
+    /// Reads the pair like vanilla's `tryLoadLootTable`.
+    #[must_use]
+    pub fn from_nbt(nbt: &NbtCompound) -> Self {
+        let pending = nbt.get_string(LOOT_TABLE_KEY).map(|key| {
+            (
+                key.to_string(),
+                nbt.get_long(LOOT_TABLE_SEED_KEY).unwrap_or(0),
+            )
+        });
+        Self(Mutex::new(pending))
+    }
+
+    /// Writes the pair like vanilla's `trySaveLootTable`. Returns `true` when a table is pending,
+    /// in which case the items must not be saved.
+    pub fn write_nbt(&self, nbt: &mut NbtCompound) -> bool {
+        let Some((key, seed)) = self.peek() else {
+            return false;
+        };
+        nbt.put_string(LOOT_TABLE_KEY, key);
+        if seed != 0 {
+            nbt.put_long(LOOT_TABLE_SEED_KEY, seed);
+        }
+        true
+    }
+
+    #[must_use]
+    pub fn peek(&self) -> Option<(String, i64)> {
+        self.0
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .clone()
+    }
+
+    pub fn take(&self) -> Option<(String, i64)> {
+        self.0
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .take()
+    }
+
+    #[must_use]
+    pub fn is_pending(&self) -> bool {
+        self.0
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .is_some()
+    }
+
+    pub fn set(&self, key: String, seed: i64) {
+        *self
+            .0
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner) = Some((key, seed));
+    }
+}
+
+fn warn_missing_table(key: &str) {
+    static WARNED: OnceLock<Mutex<HashSet<String>>> = OnceLock::new();
+    let mut warned = WARNED
+        .get_or_init(Mutex::default)
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if warned.insert(key.to_string()) {
+        warn!("Unknown loot table {key} on a container, keeping it unopened");
+    }
+}
+
+/// Resolves a loot table id to a table, like [`World::get_loot_table`].
+pub type LootTableResolver<'a> = &'a dyn Fn(&str) -> Option<LootTableHandle>;
+
+/// Generates the pending loot of `entity` for `player` (or no player), like `unpackLootTable`.
+///
+/// The key is only consumed when the table resolves, so a missing datapack never loses the loot.
+/// Returns the generated stacks and the seed when a table was unpacked.
+pub fn generate_pending_loot_with(
+    resolve: LootTableResolver<'_>,
+    world: Option<&World>,
+    entity: &Arc<dyn BlockEntity>,
+    position: &BlockPos,
+    player: Option<&Player>,
+) -> Option<(Vec<ItemStack>, i64)> {
+    let (key, _) = entity.peek_loot_table()?;
+    let Some(handle) = resolve(&key) else {
+        warn_missing_table(&key);
+        return None;
+    };
+    let (key, seed) = entity.take_loot_table()?;
+    if let Some(player) = player {
+        player.trigger_advancement(AdvancementTrigger::PlayerGeneratesContainerLoot {
+            loot_table_id: key,
+        });
+    }
+    let params = LootContextParameters {
+        world,
+        position: Some(position.to_f64()),
+        this_entity: player.map(|p| p as &dyn crate::entity::EntityBase),
+        luck: player.map_or(0.0, |p| {
+            p.living_entity.get_attribute_value(&Attributes::LUCK) as f32
+        }),
+        ..Default::default()
+    };
+    Some((generate_loot_from_handle(&handle, seed, &params), seed))
+}
+
+pub fn generate_pending_loot(
+    world: &World,
+    entity: &Arc<dyn BlockEntity>,
+    position: &BlockPos,
+    player: Option<&Player>,
+) -> Option<(Vec<ItemStack>, i64)> {
+    generate_pending_loot_with(
+        &|key| world.get_loot_table(key),
+        Some(world),
+        entity,
+        position,
+        player,
+    )
+}
+
+/// Fills the inventory of a block entity from its pending loot table, if any.
+pub fn unpack_loot_with(
+    resolve: LootTableResolver<'_>,
+    world: Option<&World>,
+    entity: &Arc<dyn BlockEntity>,
+    position: &BlockPos,
+    player: Option<&Player>,
+) -> bool {
+    if !entity.has_loot_table() {
+        return false;
+    }
+    let Some(inventory) = entity.clone().get_inventory() else {
+        return false;
+    };
+    let Some((items, seed)) = generate_pending_loot_with(resolve, world, entity, position, player)
+    else {
+        return false;
+    };
+    crate::world::loot::place_items_in_chest(&inventory, items, seed);
+    inventory.mark_dirty();
+    true
+}
+
+/// Fills the inventory of a block entity from its pending loot table, if any.
+pub fn unpack_loot(
+    world: &World,
+    entity: &Arc<dyn BlockEntity>,
+    position: &BlockPos,
+    player: Option<&Player>,
+) -> bool {
+    unpack_loot_with(
+        &|key| world.get_loot_table(key),
+        Some(world),
+        entity,
+        position,
+        player,
+    )
+}
+
+#[cfg(test)]
+pub(crate) mod tests {
+    use super::*;
+    use crate::block::entities::barrel::BarrelBlockEntity;
+    use crate::block::entities::dispenser::DispenserBlockEntity;
+    use pumpkin_inventory::Inventory;
+
+    pub(crate) fn diamond_table() -> LootTableHandle {
+        let table = crate::data::datapack::loot_table_loader::parse_loot_table(
+            r#"{"pools":[{"rolls":1,"entries":[{"type":"minecraft:item","name":"minecraft:diamond"}]}]}"#,
+        )
+        .unwrap();
+        LootTableHandle::Dynamic(Arc::new(table))
+    }
+
+    pub(crate) fn loot_nbt(key: &str, seed: i64) -> NbtCompound {
+        let mut nbt = NbtCompound::new();
+        nbt.put_string("LootTable", key.to_string());
+        nbt.put_long("LootTableSeed", seed);
+        nbt
+    }
+
+    fn check_container(entity: Arc<dyn BlockEntity>) {
+        let pos = entity.get_position();
+        let mut saved = NbtCompound::new();
+        entity.write_nbt(&mut saved);
+        assert_eq!(saved.get_string("LootTable"), Some("test:chests/x"));
+        assert_eq!(saved.get_long("LootTableSeed"), Some(42));
+        assert!(saved.get_list("Items").is_none());
+
+        // A table that does not resolve keeps the key and does not panic.
+        assert!(!unpack_loot_with(&|_| None, None, &entity, &pos, None));
+        assert!(entity.has_loot_table());
+
+        assert!(unpack_loot_with(
+            &|key| (key == "test:chests/x").then(diamond_table),
+            None,
+            &entity,
+            &pos,
+            None
+        ));
+        assert!(!entity.has_loot_table());
+        assert!(!entity.clone().get_inventory().unwrap().is_empty());
+
+        let mut after = NbtCompound::new();
+        entity.write_nbt(&mut after);
+        assert!(after.get_string("LootTable").is_none());
+        assert!(after.get_list("Items").is_some());
+    }
+
+    #[test]
+    fn barrel_loot_round_trips_and_unpacks() {
+        check_container(Arc::new(BarrelBlockEntity::from_nbt(
+            &loot_nbt("test:chests/x", 42),
+            BlockPos::new(0, 64, 0),
+        )));
+    }
+
+    #[test]
+    fn dispenser_loot_round_trips_and_unpacks() {
+        check_container(Arc::new(DispenserBlockEntity::from_nbt(
+            &loot_nbt("test:chests/x", 42),
+            BlockPos::new(0, 64, 0),
+        )));
+    }
+
+    #[test]
+    fn chest_loot_resolves_through_dynamic_lookup() {
+        use crate::block::entities::chest::ChestBlockEntity;
+        check_container(Arc::new(ChestBlockEntity::from_nbt(
+            &loot_nbt("test:chests/x", 42),
+            BlockPos::new(0, 64, 0),
+        )));
+    }
+}
