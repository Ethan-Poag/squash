+        let min = self.min_inclusive.get_y(min_y as i16, height);
+        let max = self.max_inclusive.get_y(min_y as i16, height);
+        let inner = self.inner.map_or(1, std::num::NonZero::get) as i32;
+
+        if max - min - inner < 0 {
