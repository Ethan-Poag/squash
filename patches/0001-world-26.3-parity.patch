+impl StructureGeneratorContext<'_> {
+    /// Vanilla `getFirstOccupiedHeight` with `WORLD_SURFACE_WG`, or `fallback` without a height sampler.
+    fn first_occupied_height(&mut self, block_x: i32, block_z: i32, fallback: i32) -> i32 {
+        self.height_sampler
+            .as_deref_mut()
+            .map_or(fallback, |sampler| sampler.estimate_height(block_x, block_z) - 1)
+    }
+
+    /// Vanilla `Structure.onTopOfChunkCenter` (`WORLD_SURFACE_WG`): the chunk's middle column at
+    /// its surface. The biome of a single piece structure is checked there, not at the piece.
+    pub fn on_top_of_chunk_center(&mut self, fallback_y: i32) -> BlockPos {
+        let x = crate::generation::positions::chunk_pos::get_center_x(self.chunk_x);
+        let z = crate::generation::positions::chunk_pos::get_center_z(self.chunk_z);
+        BlockPos::new(x, self.first_occupied_height(x, z, fallback_y), z)
+    }
+
+    /// Vanilla `Structure.getLowestY`: the lowest surface of the four corners of a `size_x` x
+    /// `size_z` box at the chunk's minimum corner.
+    pub fn lowest_corner_height(&mut self, size_x: i32, size_z: i32) -> i32 {
+        let x = crate::generation::positions::chunk_pos::start_block_x(self.chunk_x);
+        let z = crate::generation::positions::chunk_pos::start_block_z(self.chunk_z);
+        let fallback = self.sea_level;
+        [(x, z), (x, z + size_z), (x + size_x, z), (x + size_x, z + size_z)]
+            .into_iter()
+            .map(|(cx, cz)| self.first_occupied_height(cx, cz, fallback))
+            .min()
+            .unwrap_or(fallback)
+    }
 }
 
