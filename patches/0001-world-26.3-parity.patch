+/// Leaves of a generated tree as list entries, in depth-first order.
+fn tree_entries(
+    tree: &pumpkin_data::chunk::BiomeTree,
+    out: &mut Vec<(
+        pumpkin_data::chunk::ParameterPoint,
+        &'static pumpkin_data::chunk::Biome,
+    )>,
+) {
+    use pumpkin_data::chunk::{BiomeTree, ParameterPoint};
+    match tree {
+        BiomeTree::Leaf { parameters, biome } => out.push((
+            ParameterPoint::new(
+                parameters[0],
+                parameters[1],
+                parameters[2],
+                parameters[3],
+                parameters[4],
+                parameters[5],
+                parameters[6].min,
+            ),
+            biome,
+        )),
+        BiomeTree::Branch { nodes, .. } => {
+            for node in *nodes {
+                tree_entries(node, out);
+            }
+        }
+    }
+}
+
+/// The tree built from vanilla's own leaves finds what the generated tree finds, with the same
+/// warm start from the previous result.
+#[test]
+fn runtime_biome_tree_matches_the_generated_tree() {
+    use pumpkin_data::chunk::{BiomeTree, OVERWORLD_BIOME_SOURCE};
+
+    use super::biome_tree::build_tree;
+    let mut entries = Vec::new();
+    tree_entries(&OVERWORLD_BIOME_SOURCE, &mut entries);
+    assert!(entries.len() > 1000);
+    let built = build_tree(&entries).expect("tree");
+
+    let mut state = 0x2545_F491_4F6C_DD1Du64;
+    let mut next = || {
+        state ^= state << 13;
+        state ^= state >> 7;
+        state ^= state << 17;
+        state
+    };
+    let (mut last_generated, mut last_built): (
+        Option<&'static BiomeTree>,
+        Option<&'static BiomeTree>,
+    ) = (None, None);
+    let mut ties = 0;
+    for i in 0..20_000 {
+        // Mostly near-by points, like consecutive biome cells, with some far jumps.
+        let mut point = [0i64; 7];
+        for (d, value) in point.iter_mut().enumerate() {
+            let range = if d == 4 { 11_000 } else { 20_000 };
+            *value = (next() % range) as i64 - if d == 4 { 0 } else { 10_000 };
+        }
+        point[6] = 0;
+        if i % 3 == 0 {
+            point[2] = point[2].clamp(-2_000, 2_000);
+        }
+        let a = OVERWORLD_BIOME_SOURCE.get(&point, &mut last_generated);
+        let b = built.get(&point, &mut last_built);
+        if a.id != b.id {
+            // Only an exact tie between two entries may be broken differently, because the
+            // original list order is not part of the generated tree.
+            let distance = |p: &pumpkin_data::chunk::ParameterPoint| -> i64 {
+                p.parameter_space()
+                    .iter()
+                    .zip(point)
+                    .map(|(space, v)| space.distance(v).pow(2))
+                    .sum()
+            };
+            let best = entries.iter().map(|(p, _)| distance(p)).min().unwrap_or(0);
+            let tied = |id: u8| {
+                entries
+                    .iter()
+                    .any(|(p, biome)| biome.id == id && distance(p) == best)
+            };
+            assert!(
+                tied(a.id) && tied(b.id),
+                "point {point:?}: {} vs {}",
+                a.id,
+                b.id
+            );
+            ties += 1;
+        }
+    }
+    assert!(ties < 40, "{ties} ties");
+}
