+pub(super) fn chunk_blocks_and_biomes(chunk: &ProtoChunk) -> (Vec<u16>, Vec<u8>) {
+    let mut blocks = Vec::new();
+    for y in 0..i32::from(chunk.height()) {
+        for z in 0..16 {
+            for x in 0..16 {
+                blocks.push(chunk.get_block_state_raw(x, y, z).as_u16());
+            }
+        }
+    }
+    let mut biomes = Vec::new();
+    let bottom = i32::from(chunk.bottom_y());
+    for y in 0..i32::from(chunk.height()) / 4 {
+        for z in 0..4 {
+            for x in 0..4 {
+                biomes.push(chunk.get_biome_id(x, bottom / 4 + y, z));
+            }
+        }
+    }
+    (blocks, biomes)
+}
