+
+    const FLOOR_Y: i32 = 40;
+    const CEILING_Y: i32 = 59;
+
+    /// Stone below `FLOOR_Y` and above `CEILING_Y`, an air cave in between.
+    fn cave_chunk() -> ProtoChunk {
+        let world_gen = WorldGenerator::Noise(Box::new(VanillaGenerator::new(
+            Seed(7),
+            pumpkin_data::dimension::Dimension::OVERWORLD,
+        )));
+        let mut chunk = ProtoChunk::new(0, 0, &world_gen);
+        for x in 0..16 {
+            for z in 0..16 {
+                for y in (0..FLOOR_Y).chain(CEILING_Y + 1..100) {
+                    chunk.set_block_state(x, y, z, Block::STONE.default_state);
+                }
+            }
+        }
+        chunk
+    }
+
+    fn block_at(chunk: &ProtoChunk, x: i32, y: i32, z: i32) -> &'static Block {
+        Block::from_state_id(GenerationCache::get_block_state(
+            chunk,
+            &Vector3::new(x, y, z),
+        ))
+    }
+
+    fn count(chunk: &ProtoChunk, block: &Block) -> usize {
+        let mut n = 0;
+        for x in 0..16 {
+            for z in 0..16 {
+                for y in 0..100 {
+                    n += usize::from(block_at(chunk, x, y, z).id == block.id);
+                }
+            }
+        }
+        n
+    }
+
+    fn dripstone_replaceable() -> HashSet<u16> {
+        BlockWrapper::Single("#minecraft:dripstone_replaceable_blocks".to_string()).block_ids()
+    }
+
+    fn random(seed: u64) -> RandomGenerator {
+        RandomGenerator::Xoroshiro(Xoroshiro::from_seed(seed))
+    }
+
+    #[test]
+    fn column_scan_finds_floor_and_ceiling() {
+        let chunk = cave_chunk();
+        let pos = BlockPos::new(3, 50, 3);
+        let column = Column::scan(
+            &chunk,
+            pos,
+            20,
+            is_empty_or_water_state,
+            is_neither_empty_nor_water,
+        )
+        .expect("origin is inside the cave");
+        assert_eq!(column.floor, Some(FLOOR_Y - 1));
+        assert_eq!(column.ceiling, Some(CEILING_Y + 1));
+        assert_eq!(column.height(), Some(CEILING_Y - FLOOR_Y + 1));
+
+        // The search range ends before the ceiling, so only the floor is an edge.
+        let short = Column::scan(
+            &chunk,
+            BlockPos::new(3, 42, 3),
+            8,
+            is_empty_or_water_state,
+            is_neither_empty_nor_water,
+        )
+        .expect("origin is inside the cave");
+        assert_eq!(short.floor, Some(FLOOR_Y - 1));
+        assert_eq!(short.ceiling, None);
+    }
+
+    #[test]
+    fn speleothem_height_shrinks_towards_the_rim() {
+        let radius = 8.0;
+        let heights: Vec<f64> = (0..=8)
+            .map(|d| get_speleothem_height(f64::from(d), radius, 1.0, 0.4))
+            .collect();
+        assert!(heights.windows(2).all(|pair| pair[0] >= pair[1]));
+        assert!(heights[0] > 4.0);
+        assert!(heights[8] < 1.0);
+    }
+
+    #[test]
+    fn grow_speleothem_builds_base_to_tip_column() {
+        let mut chunk = cave_chunk();
+        let replaceable = dripstone_replaceable();
+        grow_speleothem(
+            &mut chunk,
+            BlockPos::new(5, CEILING_Y, 5),
+            BlockDirection::Down,
+            4,
+            true,
+            &Block::DRIPSTONE_BLOCK,
+            &Block::POINTED_DRIPSTONE,
+            &replaceable,
