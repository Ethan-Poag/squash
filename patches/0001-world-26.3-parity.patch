+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn load(json: &Value) -> (Option<ConfiguredFeature>, Vec<String>) {
+        let set = DatapackSet::vanilla();
+        let mut loader = Loader::new(&set);
+        let feature = loader.configured_feature(json);
+        (feature, loader.warnings)
+    }
+
+    #[test]
+    fn template_feature_reads_weights_and_rotations() {
+        let (feature, warnings) = load(&serde_json::json!({
+            "type": "minecraft:template",
+            "templates": [
+                {"weight": 3, "data": {"id": "t:a", "rotations": ["clockwise_90", "180"]}},
+                {"data": {"id": "b"}}
+            ]
+        }));
+        assert!(warnings.is_empty(), "{warnings:?}");
+        let Some(ConfiguredFeature::Template(template)) = feature else {
+            panic!("not a template feature");
+        };
+        assert_eq!(template.templates[0].weight, 3);
+        assert_eq!(template.templates[0].template, "t:a");
+        assert_eq!(
+            template.templates[0].rotations,
+            [Rotation::Clockwise90, Rotation::Rotate180]
+        );
+        assert_eq!(template.templates[1].template, "minecraft:b");
+        assert_eq!(template.templates[1].rotations.len(), 4);
+    }
+
+    #[test]
+    fn pack_json_shorthands_load() {
+        // A bare vertical anchor is a constant height.
+        let set = DatapackSet::vanilla();
+        let mut loader = Loader::new(&set);
+        assert!(loader.height_provider(&serde_json::json!({"absolute": 64})).is_some());
+        // Provider types without a namespace and trapezoid `min`/`max`.
+        let provider = loader
+            .int_provider(Some(&serde_json::json!({"type": "trapezoid", "min": -7, "max": 7, "plateau": 0})))
+            .expect("trapezoid");
+        assert_eq!((provider.get_min(), provider.get_max()), (-7, 7));
+        let provider = loader
+            .int_provider(Some(&serde_json::json!({"type": "biased_to_bottom", "min_inclusive": 1, "max_inclusive": 2})))
+            .expect("biased");
+        assert_eq!(provider.get_max(), 2);
+        assert!(loader.warnings.is_empty());
+    }
+
+    #[test]
+    fn new_feature_types_load_from_pack_json() {
+        for json in [
+            serde_json::json!({"type": "minecraft:bamboo", "probability": 0.1}),
+            serde_json::json!({"type": "minecraft:vines"}),
+            serde_json::json!({"type": "minecraft:block_pile", "state_provider": {"id": "minecraft:birch_leaves"}}),
+            serde_json::json!({"type": "minecraft:block_blob", "state": "minecraft:mossy_cobblestone"}),
+            serde_json::json!({"type": "minecraft:underwater_magma", "floor_search_range": 2,
+                "placement_probability_per_valid_position": 0.3, "placement_radius_around_floor": 3}),
+            serde_json::json!({"type": "minecraft:spring_feature", "state": {"id": "minecraft:lava"},
+                "requires_block_below": true, "rock_count": 4, "hole_count": 1,
+                "valid_blocks": ["minecraft:blackstone", "basalt"]}),
+        ] {
+            let (feature, warnings) = load(&json);
+            assert!(feature.is_some() && warnings.is_empty(), "{json}: {warnings:?}");
+        }
+    }
+}
