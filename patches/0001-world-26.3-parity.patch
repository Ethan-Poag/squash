+/// Compares the runtime router for `settings_id` against the generated one at a grid of positions.
+fn assert_router_parity(settings_id: &str, dimension: &Dimension) {
+    let set = DatapackSet::vanilla();
+    let json = vanilla_json("noise_settings", settings_id).expect("vanilla noise settings");
+    let terrain = build_terrain(&set, &json, settings_id, dimension).expect("runtime terrain");
+    let generated = BaseNoiseRouters::from_name(settings_id).expect("generated router");
+    let settings = NoiseSettings::from_name(settings_id).expect("generated settings");
+    assert_eq!(
+        terrain.settings.legacy_random_source,
+        settings.legacy_random_source
+    );
+
+    let random_config = GlobalRandomConfig::new(SEED, settings.legacy_random_source);
+    let runtime = ProtoNoiseRouters::generate(terrain.router, &random_config);
+    let reference = ProtoNoiseRouters::generate(generated, &random_config);
+    let options = ChunkNoiseFunctionBuilderOptions::new(Vec::new(), Vec::new(), None);
+    let mut runtime_router = ChunkNoiseRouter::generate(&runtime.noise, &options);
+    let mut reference_router = ChunkNoiseRouter::generate(&reference.noise, &options);
+    let mut runtime_climate = MultiNoiseSampler::generate(&runtime.multi_noise);
+    let mut reference_climate = MultiNoiseSampler::generate(&reference.multi_noise);
+
+    let mut checked = 0;
+    for x in (-96..96).step_by(11) {
+        for y in (-64..320).step_by(19) {
+            for z in (-96..96).step_by(13) {
+                let pos = Vector3::new(x, y, z);
+                for (name, a, b) in [
+                    (
+                        "final_density",
+                        runtime_router.final_density(&pos),
+                        reference_router.final_density(&pos),
+                    ),
+                    (
+                        "vein_toggle",
+                        runtime_router.vein_toggle(&pos),
+                        reference_router.vein_toggle(&pos),
+                    ),
+                    (
+                        "vein_ridged",
+                        runtime_router.vein_ridged(&pos),
+                        reference_router.vein_ridged(&pos),
+                    ),
+                    (
+                        "vein_gap",
+                        runtime_router.vein_gap(&pos),
+                        reference_router.vein_gap(&pos),
+                    ),
+                ] {
+                    assert!(
+                        same_bits(a, b),
+                        "{settings_id} {name} at {pos:?}: {a} != {b}"
+                    );
+                }
+                // Biome coordinates are quarter positions.
+                let (qx, qy, qz) = (x >> 2, y >> 2, z >> 2);
+                assert_eq!(
+                    runtime_climate.sample(qx, qy, qz),
+                    reference_climate.sample(qx, qy, qz),
+                    "{settings_id} climate at {pos:?}"
+                );
+                checked += 1;
+            }
+        }
+    }
+    assert!(checked > 2000);
+}
