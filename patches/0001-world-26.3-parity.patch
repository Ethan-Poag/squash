+        };
+        let mut chunk = ProtoChunk::new(x, z, &world_gen);
+        chunk.step_to_biomes(generator);
+        chunk.set_structure_starts(generator);
+        let _ = write!(report, "{dimension} {name} {x},{z}:");
+        for (key, instance) in &chunk.structure_starts {
+            if let StructureInstance::Start(pos) = instance {
+                let pieces = pos.collector.lock().unwrap().pieces.len();
+                let bb = pos.get_bounding_box();
+                let _ = write!(
+                    report,
+                    " [{} pieces={pieces} start={:?} box=({},{},{})..({},{},{})]",
+                    normalize_id(key.to_name()),
+                    pos.start_pos,
+                    bb.min.x, bb.min.y, bb.min.z, bb.max.x, bb.max.y, bb.max.z
+                );
+            }
+        }
+        report.push('\n');
+    }
+    println!("{report}");
+}
