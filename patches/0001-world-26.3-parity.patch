+            (32, 3, 219, "#t:voids")
+        );
+        assert_eq!(parsed.salt, 1_320_924_247);
+
+        let mut bad = json;
+        bad["count"] = 0.into();
+        assert!(placement(&bad).is_err());
+    }
+}
