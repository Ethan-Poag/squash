@@ -0,0 +1,80 @@
+//! `minecraft:noise_threshold` with `is_3d: true` (vanilla 26.3 sulfur cave bands) samples the noise at the
+//! block's y. Sampling at y = 0 (the old behaviour) makes every column a single band: sulfur or cinnabar, never both.
+use crate::generation::{generator::WorldGenerator, get_world_gen, proto_chunk::ProtoChunk};
+use pumpkin_data::{Block, biome::Biome, dimension::Dimension};
+use pumpkin_util::{math::vector3::Vector3, world_seed::Seed};
+
+use super::surface_biomes;
+
+#[test]
+fn sulfur_cave_bands_vary_with_y() {
+    let seed = Seed(0);
+    let world_gen = get_world_gen(seed, Dimension::OVERWORLD, false, Vec::new(), String::new());
+    let WorldGenerator::Noise(generator) = &*world_gen else {
+        unreachable!()
+    };
+
+    // Find a chunk with the sulfur caves biome (cheap: biomes only).
+    let mut found = None;
+    'search: for r in 0..48i32 {
+        for cx in -r..=r {
+            for cz in [-r, r] {
+                for (x, z) in [(cx, cz), (cz, cx)] {
+                    let mut chunk = ProtoChunk::new(x * 4, z * 4, &world_gen);
+                    chunk.step_to_biomes(generator);
+                    let qmin = i32::from(chunk.bottom_y()) / 4;
+                    let qcount = i32::from(chunk.height()) / 4;
+                    let hits = (0..qcount)
+                        .flat_map(|qy| (0..16).map(move |q| (q & 3, qmin + qy, q >> 2)))
+                        .filter(|&(qx, qy, qz)| chunk.get_biome(qx, qy, qz).id == Biome::SULFUR_CAVES.id)
+                        .count();
+                    if hits >= 24 {
+                        found = Some((x * 4, z * 4));
+                        break 'search;
+                    }
+                }
+            }
+        }
+    }
+    let (chunk_x, chunk_z) = found.expect("no sulfur caves chunk found near spawn for seed 0");
+
+    let mut chunk = ProtoChunk::new(chunk_x, chunk_z, &world_gen);
+    chunk.step_to_biomes(generator);
+    chunk.stage = crate::chunk_system::chunk_state::StagedChunkEnum::StructureReferences;
+    chunk.step_to_noise(generator);
+    let surface_biomes = surface_biomes(&world_gen, chunk_x, chunk_z);
+    chunk.step_to_surface(generator, &surface_biomes);
+
+    let (bottom, top) = (
+        i32::from(chunk.bottom_y()),
+        i32::from(chunk.bottom_y()) + i32::from(chunk.height()),
+    );
+    let (mut band_blocks, mut mixed_columns) = (0, 0);
+    for x in 0..16 {
+        for z in 0..16 {
+            let (mut sulfur, mut cinnabar) = (false, false);
+            for y in bottom..top {
+                let id = chunk
+                    .get_block_state(&Vector3::new(chunk_x * 16 + x, y, chunk_z * 16 + z))
+                    .to_state()
+                    .id
+                    .to_block();
+                if *id == Block::SULFUR {
+                    sulfur = true;
+                    band_blocks += 1;
+                } else if *id == Block::CINNABAR {
+                    cinnabar = true;
+                    band_blocks += 1;
+                }
+            }
+            if sulfur && cinnabar {
+                mixed_columns += 1;
+            }
+        }
+    }
