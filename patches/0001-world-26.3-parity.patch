+impl ChunkData {
+    /// Resizes the sections to the dimension's `min_y` and `height`, for a chunk that was saved
+    /// while the dimension had another extent. Sections are matched by their section Y: the ones
+    /// the dimension lacks are dropped, the new ones are air that copies the biome of the nearest
+    /// stored section. Sky light above the old top is full when the dimension has skylight.
+    pub fn fit_to_dimension(&mut self, min_y: i32, height: i32, has_skylight: bool) {
+        let count = usize::try_from(height / 16).unwrap_or_default();
+        if self.section.count == count && self.section.min_y == min_y {
+            return;
+        }
+        let old_first = self.section.min_y.div_euclid(16);
+        let new_first = min_y.div_euclid(16);
+        // Stored sections in `old`, indexed from `old_first`; `at` maps a new index to one of them.
+        let at = |new_index: usize| {
+            let old_index = new_first + new_index as i32 - old_first;
+            usize::try_from(old_index).ok()
+        };
+
+        let blocks = self
+            .section
+            .block_sections
+            .get_mut()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let biomes = self
+            .section
+            .biome_sections
+            .get_mut()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let light = self
+            .light_engine
+            .get_mut()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let stored = blocks.len();
+        let new_blocks: Box<[BlockPalette]> = (0..count)
+            .map(|i| {
+                at(i)
+                    .filter(|j| *j < stored)
+                    .map_or_else(BlockPalette::default, |j| blocks[j].clone())
+            })
+            .collect();
+        let new_biomes: Box<[BiomePalette]> = (0..count)
+            .map(|i| {
+                let nearest = at(i).map_or(0, |j| j.min(stored.saturating_sub(1)));
+                biomes.get(nearest).cloned().unwrap_or_default()
+            })
+            .collect();
+        let relit = |old: &[LightContainer], above: LightContainer| -> Box<[LightContainer]> {
+            (0..count)
+                .map(|i| match at(i) {
+                    Some(j) if j < old.len() => old[j].clone(),
+                    Some(_) => above.clone(),
+                    None => LightContainer::Empty(0),
+                })
+                .collect()
+        };
+        let sky_above = LightContainer::Empty(if has_skylight { 15 } else { 0 });
+        light.sky_light = relit(&light.sky_light, sky_above);
+        light.block_light = relit(&light.block_light, LightContainer::Empty(0));
+
+        let (random_tick_sections, mask) =
+            ChunkSections::build_random_tick_sections_cache(&new_blocks);
+        *blocks = new_blocks;
+        *biomes = new_biomes;
+        *self
+            .section
+            .random_tick_sections
+            .get_mut()
+            .unwrap_or_else(std::sync::PoisonError::into_inner) = random_tick_sections;
+        self.section.randomly_ticking_mask = std::sync::atomic::AtomicU32::new(mask);
+        // Heights are stored relative to `min_y` and bounded by the height, so only a chunk whose
+        // bottom stays put and whose top does not shrink keeps them.
+        if self.section.min_y != min_y || count < self.section.count {
+            *self
+                .heightmap
+                .get_mut()
+                .unwrap_or_else(std::sync::PoisonError::into_inner) = ChunkHeightmaps {
+                world_surface: None,
+                motion_blocking: None,
+                motion_blocking_no_leaves: None,
+            };
+        }
+        self.section.count = count;
+        self.section.min_y = min_y;
+    }
+}
