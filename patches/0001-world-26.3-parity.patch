+
+    fn record_with(id: &str, pieces: &[BlockBox], overrides: Vec<NbtTag>) -> NbtTag {
+        let mut nbt = NbtCompound::new();
+        nbt.put_string("id", id.to_string());
+        nbt.put(
+            "box",
+            box_tag(&BlockBox::encompass_all(pieces.iter().copied()).unwrap()),
+        );
+        nbt.put_list("pieces", pieces.iter().map(box_tag).collect());
+        nbt.put_list("overrides", overrides);
+        NbtTag::Compound(nbt)
+    }
+
+    fn override_of(category: &str, piece: bool, types: &[&str]) -> NbtTag {
+        let mut nbt = NbtCompound::new();
+        nbt.put_string("category", category.to_string());
+        nbt.put_bool("piece", piece);
+        nbt.put_list(
+            "spawns",
+            types
+                .iter()
+                .map(|t| {
+                    let mut s = NbtCompound::new();
+                    s.put_string("type", (*t).to_string());
+                    NbtTag::Compound(s)
+                })
+                .collect(),
+        );
+        NbtTag::Compound(nbt)
+    }
+
+    #[test]
+    fn piece_overrides_need_a_piece_and_full_ones_the_whole_box() {
+        let pieces = [
+            BlockBox::new(0, 60, 0, 4, 70, 4),
+            BlockBox::new(10, 60, 10, 14, 70, 14),
+        ];
+        let mut nbt = NbtCompound::new();
+        nbt.put_list(
+            SPAWN_STRUCTURES_KEY,
+            vec![
+                record_with(
+                    "minecraft:fortress",
+                    &pieces,
+                    vec![override_of("monster", true, &["minecraft:blaze"])],
+                ),
+                record_with(
+                    "minecraft:swamp_hut",
+                    &pieces,
+                    vec![override_of("monster", false, &["minecraft:witch"])],
+                ),
+            ],
+        );
+        // In a fortress piece: the fortress list wins, as the first structure with an override.
+        let inside = lookup(&nbt, &BlockPos::new(2, 65, 2), "monster");
+        assert!(inside.in_fortress_piece);
+        assert_eq!(inside.overridden.unwrap()[0].r#type, "minecraft:blaze");
+        // Between the pieces but inside the full box: only the full-box override applies.
+        let gap = lookup(&nbt, &BlockPos::new(7, 65, 7), "monster");
+        assert!(!gap.in_fortress_piece);
+        assert_eq!(gap.overridden.unwrap()[0].r#type, "minecraft:witch");
+        // Other categories and positions outside the box fall back to the biome.
+        assert!(
+            lookup(&nbt, &BlockPos::new(2, 65, 2), "creature")
+                .overridden
+                .is_none()
+        );
+        assert!(
+            lookup(&nbt, &BlockPos::new(30, 65, 30), "monster")
+                .overridden
+                .is_none()
+        );
+    }
+
+    #[test]
+    fn stored_vanilla_structures_round_trip_to_their_overrides() {
+        use crate::generation::structure::{piece::StructurePieceType, structures::StructurePiece};
+        let mut collector = StructurePiecesCollector::new();
+        for bounds in [
+            BlockBox::new(0, 60, 0, 6, 70, 6),
+            BlockBox::new(40, 60, 40, 46, 70, 46),
+        ] {
+            collector.add_piece(Box::new(StructurePiece::new(
+                StructurePieceType::MineshaftRoom,
+                bounds,
+                0,
+            )));
+        }
+        let collector = Arc::new(Mutex::new(collector));
+        let mut nbt = NbtCompound::new();
+        store(&mut nbt, [(StructureKeys::Fortress, &collector)], (0, 0));
+        let mut hut_nbt = NbtCompound::new();
+        store(
+            &mut hut_nbt,
+            [(StructureKeys::SwampHut, &collector)],
+            (0, 0),
+        );
+        // The second piece lies in another chunk, so only the first is stored.
+        let spawns = lookup(&nbt, &BlockPos::new(3, 65, 3), "monster");
+        assert!(spawns.in_fortress_piece);
+        assert_eq!(spawns.overridden.unwrap()[0].r#type, "minecraft:blaze");
+        let hut = lookup(&hut_nbt, &BlockPos::new(3, 65, 3), "monster");
+        assert_eq!(hut.overridden.unwrap()[0].r#type, "minecraft:witch");
+        assert!(!lookup(&nbt, &BlockPos::new(8, 65, 8), "monster").in_fortress_piece);
+    }
+
+    fn pack(chunk: (i32, i32)) -> i64 {
+        i64::from(chunk.0 as u32) | (i64::from(chunk.1) << 32)
+    }
+
+    fn start_of(id: &str, children: &[BlockBox]) -> (String, NbtTag) {
+        let mut start = NbtCompound::new();
+        start.put_string("id", id.to_string());
+        start.put_list(
+            "Children",
+            children
+                .iter()
+                .map(|bounds| {
+                    let mut child = NbtCompound::new();
+                    child.put("BB", box_tag(bounds));
+                    NbtTag::Compound(child)
+                })
+                .collect(),
+        );
+        (id.to_string(), NbtTag::Compound(start))
+    }
+
+    /// `structures` of a vanilla chunk.
+    fn vanilla(
+        starts: Vec<(String, NbtTag)>,
+        references: &[(&str, &[(i32, i32)])],
+    ) -> VanillaStructures {
+        let mut starts_nbt = NbtCompound::new();
+        for (id, start) in starts {
+            starts_nbt.put(&id, start);
+        }
+        let mut refs = NbtCompound::new();
+        for (id, chunks) in references {
+            refs.put(
+                id,
+                NbtTag::LongArray(chunks.iter().map(|&c| pack(c)).collect()),
+            );
+        }
+        let mut nbt = NbtCompound::new();
+        nbt.put_compound("starts", starts_nbt);
+        nbt.put_compound("References", refs);
+        VanillaStructures::parse(&nbt)
+    }
+
+    #[test]
+    fn vanilla_starts_are_found_through_the_references_of_the_chunk() {
+        let fortress = [
+            BlockBox::new(0, 60, 0, 4, 70, 4),
+            BlockBox::new(40, 60, 0, 46, 70, 4),
+        ];
+        let outpost = [BlockBox::new(0, 60, 20, 6, 70, 26)];
+        let a = (0, 0);
+        let refs_a: &[(&str, &[(i32, i32)])] = &[
+            ("minecraft:fortress", &[a]),
+            ("minecraft:pillager_outpost", &[a]),
+        ];
+        let mut chunks = FxHashMap::default();
+        chunks.insert(
+            a,
+            Arc::new(vanilla(
+                vec![
+                    start_of("minecraft:fortress", &fortress),
+                    start_of("minecraft:pillager_outpost", &outpost),
+                ],
+                refs_a,
+            )),
+        );
+        // Chunks 1 and 2 only reference A.
+        for chunk in [(1, 0), (2, 0)] {
+            chunks.insert(
+                chunk,
+                Arc::new(vanilla(vec![], &[("minecraft:fortress", &[a])])),
+            );
+        }
+        chunks.insert(
+            (0, 1),
+            Arc::new(vanilla(vec![], &[("minecraft:pillager_outpost", &[a])])),
+        );
+        let at = |chunks: &FxHashMap<(i32, i32), Arc<VanillaStructures>>, x, y, z, category| {
+            lookup_vanilla(
+                |chunk| chunks.get(&(chunk.x, chunk.y)).cloned(),
+                &BlockPos::new(x, y, z),
+                category,
+            )
+        };
+        // Inside the second piece, seen from chunk B.
+        let piece = at(&chunks, 42, 65, 2, "monster");
+        assert!(piece.in_fortress_piece);
+        // Between the two pieces: inside the start box but in no piece.
+        let gap = at(&chunks, 20, 65, 2, "monster");
+        assert!(!gap.in_fortress_piece);
+        assert!(gap.overridden.is_none());
+        // Above the piece, outside the box.
+        assert!(!at(&chunks, 42, 90, 2, "monster").in_fortress_piece);
+        // The outpost override covers its whole box, and the chunk referencing it finds it.
+        let outpost_spawns = at(&chunks, 3, 65, 22, "monster");
+        assert_eq!(
+            outpost_spawns.overridden.unwrap()[0].r#type,
+            "minecraft:pillager"
+        );
+        assert!(at(&chunks, 3, 65, 22, "creature").overridden.is_none());
+        // Chunks without references fall back to the biome.
+        assert!(at(&chunks, 100, 65, 100, "monster").overridden.is_none());
+        // A start in a chunk that is not loaded is skipped.
+        chunks.remove(&a);
+        assert!(!at(&chunks, 42, 65, 2, "monster").in_fortress_piece);
+    }
+
+    #[test]
+    fn piece_overrides_of_vanilla_starts_need_a_piece() {
+        let hut = [
+            BlockBox::new(0, 60, 0, 6, 70, 6),
