+
+/// The overworld generator of `seed`, with the packs in `packs` when there are some.
+fn overworld_world_gen(seed: u64, packs: Option<&Path>) -> Box<WorldGenerator> {
+    let runtime = packs.and_then(|folder| {
+        let set = DatapackSet::load_folder(folder).expect("packs");
+        generation_for_set(&set, &Dimension::OVERWORLD, "minecraft:overworld")
+    });
+    get_world_gen_with_all_settings(
+        Seed(seed),
+        Dimension::OVERWORLD,
+        false,
+        Vec::new(),
+        String::new(),
+        Some("minecraft:overworld"),
+        None,
+        None,
+        runtime,
+    )
+}
+
+/// The generator of the dimension named `name` (`overworld`, `the_nether` or `the_end`), with the packs
+/// in `packs` when there are some.
+fn dimension_world_gen(seed: u64, name: &str, packs: Option<&Path>) -> Box<WorldGenerator> {
+    let (dimension, settings) = if name.ends_with("nether") {
+        (Dimension::THE_NETHER, "minecraft:nether")
+    } else if name.ends_with("end") {
+        (Dimension::THE_END, "minecraft:end")
+    } else {
+        return overworld_world_gen(seed, packs);
+    };
+    let runtime = packs.and_then(|folder| {
+        let set = DatapackSet::load_folder(folder).expect("packs");
+        generation_for_set(&set, &dimension, settings)
+    });
+    get_world_gen_with_all_settings(
+        Seed(seed),
+        dimension,
+        false,
+        Vec::new(),
+        String::new(),
+        Some(settings),
+        None,
+        None,
+        runtime,
+    )
+}
+
+/// Writes the structure starts (`<id> <chunk x> <chunk z>`) owned by the chunks named in
+/// `PUMPKIN_DUMP_CHUNKS` (`x,z;x,z`) to `PUMPKIN_DUMP_OUT/starts.txt`. Needs `PUMPKIN_DUMP_SEED` and
+/// optionally `PUMPKIN_DUMP_DATAPACKS` (a folder holding packs; without it the overworld is vanilla).
+#[test]
+#[ignore = "measurement tool, configured through PUMPKIN_DUMP_* variables"]
+fn dump_structure_starts() {
+    let var = |name: &str| std::env::var(name).unwrap_or_else(|_| panic!("{name} is not set"));
+    let seed: u64 = var("PUMPKIN_DUMP_SEED").parse().expect("seed");
+    let out_dir = std::path::PathBuf::from(var("PUMPKIN_DUMP_OUT"));
+    std::fs::create_dir_all(&out_dir).expect("out dir");
+    let packs = std::env::var("PUMPKIN_DUMP_DATAPACKS").ok();
+    let dimension_name = std::env::var("PUMPKIN_DUMP_DIMENSION").unwrap_or_default();
+    let world_gen = dimension_world_gen(seed, &dimension_name, packs.as_deref().map(Path::new));
+    let WorldGenerator::Noise(generator) = &*world_gen else {
+        unreachable!()
+    };
+    let mut enabled = String::new();
+    for (index, set) in generator.structure_sets.iter().enumerate() {
+        let names: Vec<_> = set
+            .structures
+            .iter()
+            .map(|e| e.structure.to_name())
+            .collect();
+        let _ = writeln!(
+            enabled,
+            "{index} enabled={} {}",
+            generator.enabled_structure_sets.contains(&index),
+            names.join(",")
+        );
+    }
+    std::fs::write(out_dir.join("sets.txt"), enabled).expect("write sets");
+    let mut text = String::new();
+    let mut pieces = String::new();
+    for pair in var("PUMPKIN_DUMP_CHUNKS")
+        .split(';')
+        .filter(|p| !p.is_empty())
+    {
+        let (x, z) = pair.split_once(',').expect("x,z");
+        let (x, z): (i32, i32) = (x.trim().parse().expect("x"), z.trim().parse().expect("z"));
+        let mut chunk = ProtoChunk::new(x, z, &world_gen);
+        chunk.step_to_biomes(generator);
+        chunk.set_structure_starts(generator);
+        for (key, instance) in &chunk.structure_starts {
+            if let StructureInstance::Start(start) = instance {
+                let pos = start.start_pos.0;
+                let biome = chunk.get_biome_id(
+                    (pos.x & 15) >> 2,
+                    (pos.y >> 2).clamp(
+                        chunk.bottom_y() as i32 >> 2,
+                        ((chunk.bottom_y() as i32 + chunk.height() as i32) >> 2) - 1,
+                    ),
+                    (pos.z & 15) >> 2,
+                );
+                for piece in &start
+                    .collector
+                    .lock()
+                    .unwrap_or_else(std::sync::PoisonError::into_inner)
+                    .pieces
+                {
+                    let b = piece.get_structure_piece().bounding_box;
+                    let detail = piece
+                        .as_any()
+                        .downcast_ref::<PoolElementStructurePiece>()
+                        .map_or_else(String::new, |jigsaw| {
+                            let mut names = Vec::new();
+                            jigsaw
+                                .element
+                                .for_each_template(|name, _, _, _| names.push(name.to_string()));
+                            format!("{:?} {}", jigsaw.rotation, names.join(","))
+                        });
+                    let _ = writeln!(
+                        pieces,
+                        "{} {x} {z} {} {} {} {} {} {} {detail}",
+                        key.to_name(),
+                        b.min.x,
+                        b.min.y,
+                        b.min.z,
+                        b.max.x,
+                        b.max.y,
+                        b.max.z
+                    );
+                }
+                let _ = writeln!(
+                    text,
+                    "{} {x} {z} # at {} {} {} {}",
+                    key.to_name(),
+                    pos.x,
+                    pos.y,
+                    pos.z,
+                    crate::biome::unknown::generation_biome(biome).registry_id
+                );
+            }
+        }
+    }
+    std::fs::write(out_dir.join("starts.txt"), text).expect("write starts");
+    std::fs::write(out_dir.join("pieces.txt"), pieces).expect("write pieces");
+}
