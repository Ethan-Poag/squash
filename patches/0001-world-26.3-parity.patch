+/// Copies the vanilla JSON `text` names, and what they refer to in turn, into `pack`.
+fn copy_vanilla_features(pack: &Path, names: &[&str]) {
+    let assets =
+        Path::new(env!("CARGO_MANIFEST_DIR")).join("../../assets/datapack/data/minecraft/worldgen");
+    let mut todo: Vec<String> = names.iter().map(|n| (*n).to_string()).collect();
+    let mut done = std::collections::HashSet::new();
+    while let Some(name) = todo.pop() {
+        if !done.insert(name.clone()) {
+            continue;
+        }
+        for kind in ["placed_feature", "feature"] {
+            let source = assets.join(kind).join(format!("{name}.json"));
+            let Ok(text) = fs::read_to_string(&source) else {
+                continue;
+            };
+            let target = pack.join("data/minecraft/worldgen").join(kind);
+            fs::create_dir_all(&target).expect("dirs");
+            fs::write(target.join(format!("{name}.json")), &text).expect("write");
+            for part in text.split('"') {
+                if let Some(referenced) = part.strip_prefix("minecraft:") {
+                    todo.push(referenced.to_string());
+                }
+            }
+        }
+    }
+}
