+/// The sampler a noise provider reads: vanilla builds it once per provider from the provider's
+/// seed and parameters. Building one costs far more than sampling it, and features ask for a state
+/// per block, so each thread keeps the samplers it has built.
+fn provider_sampler(
+    seed: i64,
+    noise: &DoublePerlinNoiseParametersCodec,
+) -> Rc<DoublePerlinNoiseSampler> {
+    type Built = Vec<(i64, i32, Vec<f64>, Rc<DoublePerlinNoiseSampler>)>;
+    thread_local! {
+        static SAMPLERS: RefCell<FxHashMap<u64, Built>> = RefCell::new(FxHashMap::default());
+    }
+    let mut hasher = FxHasher::default();
+    seed.hash(&mut hasher);
+    noise.first_octave.hash(&mut hasher);
+    for amplitude in &noise.amplitudes {
+        amplitude.to_bits().hash(&mut hasher);
+    }
+    let key = hasher.finish();
+    SAMPLERS.with_borrow_mut(|samplers| {
+        let built = samplers.entry(key).or_default();
+        if let Some((_, _, _, sampler)) = built.iter().find(|(s, octave, amplitudes, _)| {
+            *s == seed && *octave == noise.first_octave && *amplitudes == noise.amplitudes
+        }) {
+            return sampler.clone();
+        }
+        let sampler = Rc::new(DoublePerlinNoiseSampler::new(
+            &mut RandomGenerator::Legacy(LegacyRand::from_seed(seed as u64)),
+            noise.first_octave,
+            &noise.amplitudes,
+            false,
+        ));
+        built.push((seed, noise.first_octave, noise.amplitudes.clone(), sampler.clone()));
+        sampler
+    })
+}
