@@ -0,0 +1,121 @@
+use std::{
+    marker::PhantomData,
+    path::PathBuf,
+    sync::{Arc, PoisonError, RwLock},
+};
+
+use pumpkin_data::{Block, BlockState, tag, tag::Taggable};
+use pumpkin_util::math::vector2::Vector2;
+use rustc_hash::FxHashMap;
+
+use super::{BlendingSource, blending_data::BlendingData};
+use crate::chunk::{
+    ChunkData,
+    format::anvil::SingleChunkDataSerializer,
+    io::{RegionFile, region_chunk_index, region_of},
+};
+
+type CachedBlendingData = Option<Arc<BlendingData>>;
+
+/// Computed old-chunk results kept before the cache is dropped and refilled.
+const MAX_CACHED_CHUNKS: usize = 1 << 18;
+
+/// Reads old chunks straight from the region files and keeps their blending heights.
+///
+/// Chunks are only ever read, never written (vanilla treats old chunks as read-only too). A
+/// chunk's result is computed once; chunks that are missing or have no `blending_data` are
+/// cached as `None`, which stays right because a chunk generated later is a new chunk.
+pub struct RegionBlendingSource<R: RegionFile> {
+    region_folder: PathBuf,
+    cache: RwLock<FxHashMap<(i32, i32), CachedBlendingData>>,
+    _format: PhantomData<fn() -> R>,
+}
+
+impl<R: RegionFile> RegionBlendingSource<R> {
+    #[must_use]
+    pub fn new(region_folder: PathBuf) -> Self {
+        Self {
+            region_folder,
+            cache: RwLock::new(FxHashMap::default()),
+            _format: PhantomData,
+        }
+    }
+
+    /// Reads the chunk from its region file, `None` if it is missing or unreadable.
+    pub fn read_chunk_data(&self, chunk_x: i32, chunk_z: i32) -> Option<ChunkData> {
+        let pos = Vector2::new(chunk_x, chunk_z);
+        let region = region_of(pos);
+        let path = self.region_folder.join(R::file_name(region));
+        if !path.is_file() {
+            return None;
+        }
+        let file = R::open(&path, region).ok()?;
+        let raw = file.read_chunk(region_chunk_index(pos)).ok()??;
+        let bytes = R::decode_chunk(raw).ok()?;
+        ChunkData::from_bytes(&bytes, pos).ok()
+    }
+
+    fn load(&self, chunk_x: i32, chunk_z: i32) -> Option<Arc<BlendingData>> {
+        let chunk = self.read_chunk_data(chunk_x, chunk_z)?;
+        let mut data = chunk.blending_data.clone()?;
+        data.calculate_heights(&|x, y, z| {
+            chunk
+                .section
+                .get_block_absolute_y(x as usize, y, z as usize)
+                .is_some_and(|id| is_ground(BlockState::from_id(id)))
+        });
+        data.has_heights().then(|| Arc::new(data))
+    }
+}
+
+/// Whether a block counts as terrain when scanning an old chunk's surface.
+///
+/// Air, fluids, plants (no solid collision) and trees (leaves, logs) are skipped like vanilla's
+/// surface block filter, so tree tops do not become the old terrain height.
+#[must_use]
+pub fn is_ground(state: &BlockState) -> bool {
+    if state.is_air() || state.is_liquid() || !state.is_solid() {
+        return false;
+    }
+    let block = Block::from_state_id(state.id);
+    !(block.has_tag(&tag::Block::MINECRAFT_LEAVES) || block.has_tag(&tag::Block::MINECRAFT_LOGS))
+}
+
+impl<R: RegionFile> BlendingSource for RegionBlendingSource<R> {
+    fn get(&self, chunk_x: i32, chunk_z: i32) -> Option<Arc<BlendingData>> {
+        let key = (chunk_x, chunk_z);
+        if let Some(hit) = self
+            .cache
+            .read()
+            .unwrap_or_else(PoisonError::into_inner)
+            .get(&key)
+        {
+            return hit.clone();
+        }
+        let loaded = self.load(chunk_x, chunk_z);
+        let mut cache = self.cache.write().unwrap_or_else(PoisonError::into_inner);
+        if cache.len() >= MAX_CACHED_CHUNKS {
+            cache.clear();
+        }
+        cache.insert(key, loaded.clone());
+        loaded
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn surface_scan_ignores_trees_plants_air_and_water() {
+        let ground = |b: &Block| is_ground(BlockState::from_id(b.default_state.id));
+        assert!(ground(&Block::STONE));
+        assert!(ground(&Block::GRASS_BLOCK));
+        assert!(ground(&Block::DEEPSLATE));
+        assert!(!ground(&Block::OAK_LEAVES));
+        assert!(!ground(&Block::OAK_LOG));
+        assert!(!ground(&Block::SHORT_GRASS));
+        assert!(!ground(&Block::WATER));
+        assert!(!ground(&Block::AIR));
+    }
+}
