+pub(super) fn generate_end_chunk(world_gen: &WorldGenerator, x: i32, z: i32) -> ProtoChunk {
+    generate_chunk(world_gen, x, z, false)
+}
+
+/// A chunk up to the surface stage. With `structures` the structure starts and references are made
+/// first, so the terrain adapts to the structures of the neighbourhood like the chunk pipeline does.
+pub(super) fn generate_chunk(
+    world_gen: &WorldGenerator,
+    x: i32,
+    z: i32,
+    structures: bool,
+) -> ProtoChunk {
+    let WorldGenerator::Noise(generator) = world_gen else {
+        unreachable!()
+    };
+    let mut chunk = ProtoChunk::new(x, z, world_gen);
+    chunk.step_to_biomes(generator);
+    if structures {
+        chunk.set_structure_starts(generator);
+        chunk.set_structure_references(generator);
+    } else {
+        chunk.stage = StagedChunkEnum::StructureReferences;
+    }
+    chunk.step_to_noise(generator);
+    let neighborhood = surface_biomes(world_gen, x, z);
+    chunk.step_to_surface(generator, &neighborhood);
+    chunk
+}
