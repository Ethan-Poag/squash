+/// A pack that overrides a vanilla placed feature (Terralith sets `minecraft:ore_diorite_upper` to
+/// count 0) must have the override apply in the vanilla biomes it leaves alone too, and the feature
+/// must stay one entry in the step ordering, or every later feature's decorator seed shifts.
+#[test]
+fn pack_overrides_of_vanilla_placed_features_apply_in_untouched_vanilla_biomes() {
+    use std::fs;
+    use std::path::Path;
+
+    use pumpkin_data::placed_feature::PlacedFeature as VanillaPlacedFeature;
+
+    use super::feature::{FeatureRef, load_features};
+
+    let world = tempfile::tempdir().expect("tempdir");
+    let data = world.path().join("datapacks/ores/data/minecraft/worldgen");
+    let assets =
+        Path::new(env!("CARGO_MANIFEST_DIR")).join("../../assets/datapack/data/minecraft/worldgen");
+    fs::create_dir_all(data.join("biome")).expect("dirs");
+    fs::copy(
+        assets.join("biome/plains.json"),
+        data.join("biome/plains.json"),
+    )
+    .expect("plains");
+    fs::create_dir_all(data.join("placed_feature")).expect("dirs");
+    fs::write(
+        data.join("placed_feature/ore_diorite_upper.json"),
+        r#"{"feature":"minecraft:ore_diorite","placement":[{"type":"minecraft:count","count":0}]}"#,
+    )
+    .expect("override");
+    let set = DatapackSet::load_folder(&world.path().join("datapacks")).expect("packs");
+    let names = ["minecraft:plains".to_string(), "minecraft:desert".to_string()];
+    let features = load_features(&set, &names).expect("the pack defines plains");
+    assert!(
+        !features
+            .warnings()
+            .iter()
+            .any(|w| w.contains("does not exist")),
+        "{:?}",
+        features.warnings()
+    );
+
+    let vanilla = FeatureRef::Vanilla(
+        VanillaPlacedFeature::from_name("minecraft:ore_diorite_upper").expect("vanilla feature"),
+    );
+    let plains = crate::biome::unknown::id_for_name("minecraft:plains");
+    let desert = crate::biome::unknown::id_for_name("minecraft:desert");
+    let overridden = |ids: &[u8]| -> Vec<(usize, FeatureRef)> {
+        (0..11)
+            .flat_map(|step| features.select(ids, step))
+            .filter(|(_, f)| features.placed(*f).is_some())
+            .collect()
+    };
+    for ids in [&[plains][..], &[desert][..], &[plains, desert][..]] {
+        let found = overridden(ids);
+        assert_eq!(found.len(), 1, "biomes {ids:?}: {found:?}");
+        assert!(
+            !(0..11).any(|step| features.select(ids, step).iter().any(|(_, f)| *f == vanilla)),
+            "biomes {ids:?} still list the vanilla ore_diorite_upper"
+        );
+    }
+    assert_eq!(overridden(&[plains]), overridden(&[desert]));
+}
